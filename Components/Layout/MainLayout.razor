@inherits LayoutComponentBase
@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject HamiChap_MES_ERP.Services.PermissionService PermissionService
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService

<SessionActivityTracker />

<div class="app-layout">

    <button type="button" class="mobile-menu-btn" aria-controls="hc-sidebar"
            aria-expanded="@(menuOpen ? "true" : "false")"
            aria-label="@(LocalizationService.IsPersian ? "منوی اصلی" : "Main menu")"
            @onclick="ToggleMenu">
        <i class="bi @(menuOpen ? "bi-x-lg" : "bi-list")" aria-hidden="true"></i>
    </button>

    <div class="sidebar-backdrop @(menuOpen ? "show" : "")"
         @onclick="CloseMenu">
    </div>

    <aside id="hc-sidebar" class="sidebar @(menuOpen ? "show" : "")">

        @if (loading)
        {
            <div class="nav-menu">
        
                <div class="sidebar-header">
                    <a href="/" class="hc-sidebar-brand" @onclick="CloseMenu">
                        <span class="hc-sidebar-logo"><img src="images/Logo%20Wings%20navy%20blue.png" alt="" /></span>
                        <span class="hc-sidebar-wordmark"><strong>HAMICHAP</strong><small>MES / ERP</small></span>
                    </a>
                </div>
        
                <div class="text-light p-2">
                    @LocalizationService["Loading"]
                </div>
        
            </div>
        }
        else
        {
            <div class="nav-menu">
        
                <div class="sidebar-header">
                    <a href="/" class="hc-sidebar-brand" @onclick="CloseMenu">
                        <span class="hc-sidebar-logo"><img src="images/Logo%20Wings%20navy%20blue.png" alt="" /></span>
                        <span class="hc-sidebar-wordmark"><strong>HAMICHAP</strong><small>MES / ERP</small></span>
                    </a>
                </div>
        
                <nav class="side-menu" aria-label="@LocalizationService["ManagerMainNavigation"]">
                    <div class="menu-group-label"><i class="bi bi-grid" aria-hidden="true"></i> @LocalizationService["ManagerMainNavigation"]</div>
                    <a class="@NavClass("/")" href="/" @onclick="CloseMenu">
                        <i class="bi bi-house-door" aria-hidden="true"></i><span>@LocalizationService["Dashboard"]</span>
                    </a>
                    @if (showSalesDashboard)
                    {
                        <a class="@NavClass("/dashboard/sales")" href="/dashboard/sales" @onclick="CloseMenu">
                            <i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span>@LocalizationService["ManagerSalesDashboard"]</span>
                        </a>
                    }
                    @if (showWarehouseDashboard)
                    {
                        <a class="@NavClass("/dashboard/warehouse")" href="/dashboard/warehouse" @onclick="CloseMenu">
                            <i class="bi bi-box-seam" aria-hidden="true"></i><span>@LocalizationService["ManagerWarehouseDashboard"]</span>
                        </a>
                    }
                    @if (showCeoDashboard)
                    {
                        <a class="@NavClass("/dashboard/ceo")" href="/dashboard/ceo" @onclick="CloseMenu">
                            <i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>@LocalizationService["ManagerCeoDashboard"]</span>
                        </a>
                    }
                    @if (showProductionDashboard)
                    {
                        <a class="@NavClass("/dashboard/production")" href="/dashboard/production" @onclick="CloseMenu">
                            <i class="bi bi-kanban" aria-hidden="true"></i><span>@LocalizationService["ManagerProductionDashboard"]</span>
                        </a>
                    }
                    @if (showOperatorWorkspace)
                    {
                        <a class="@NavClass("/production/machine-operator")" href="/production/machine-operator" @onclick="CloseMenu">
                            <i class="bi bi-play-circle" aria-hidden="true"></i><span>@LocalizationService["OperatorDashboardTitle"]</span>
                        </a>
                    }

                    @if (canViewSales || canViewCustomers)
                    {
                        <div class="menu-group-label"><i class="bi bi-cart" aria-hidden="true"></i> @LocalizationService["Sales"]</div>
                        @if (canViewSalesRequests)
                        {
                            <a class="@NavClass("/sales/requests")" href="/sales/requests" @onclick="CloseMenu">
                                <i class="bi bi-clipboard-check" aria-hidden="true"></i><span>@LocalizationService["SalesRequests"]</span>
                            </a>
                            <a class="@NavClass("/production/jobs")" href="/production/jobs" @onclick="CloseMenu">
                                <i class="bi bi-search" aria-hidden="true"></i><span>@(LocalizationService.IsPersian ? "جستجوی شماره کار" : "Find job")</span>
                            </a>
                            <a class="@NavClass("/sales/quotations")" href="/sales/quotations" @onclick="CloseMenu">
                                <i class="bi bi-receipt" aria-hidden="true"></i><span>@LocalizationService["SalesQuotations"]</span>
                            </a>
                        }
                        @if (canViewSalesOrders)
                        {
                            <a class="@NavClass("/sales/orders")" href="/sales/orders" @onclick="CloseMenu">
                                <i class="bi bi-bag-check" aria-hidden="true"></i><span>@LocalizationService["SalesOrders"]</span>
                            </a>
                        }
                        @if (canViewCustomers)
                        {
                            <a class="@NavClass("/customers")" href="/customers" @onclick="CloseMenu">
                                <i class="bi bi-people" aria-hidden="true"></i><span>@LocalizationService["Customers"]</span>
                            </a>
                        }
                        @if (canViewSalesDeliveries || canViewSalesInvoices || canViewCustomers)
                        {
                            <details class="nav-more-group">
                                <summary>@LocalizationService["ManagerMoreSales"]</summary>
                                @if (canViewSalesDeliveries)
                                {
                                    <a href="/sales/deliveries/create" @onclick="CloseMenu"><i class="bi bi-truck" aria-hidden="true"></i><span>@LocalizationService["SalesDeliveries"]</span></a>
                                }
                                @if (canViewSalesInvoices)
                                {
                                    <a href="/sales/invoices" @onclick="CloseMenu"><i class="bi bi-receipt-cutoff" aria-hidden="true"></i><span>@LocalizationService["SalesInvoices"]</span></a>
                                }
                                @if (canViewCustomers)
                                {
                                    <a href="/customers/inventory" @onclick="CloseMenu"><i class="bi bi-boxes" aria-hidden="true"></i><span>@LocalizationService["CustomerInventory"]</span></a>
                                }
                            </details>
                        }
                    }

                    @if (canViewInventory)
                    {
                        <div class="menu-group-label"><i class="bi bi-boxes" aria-hidden="true"></i> @LocalizationService["Inventory"]</div>
                        @if (canViewSalesDeliveries)
                        {
                            <a class="@NavClass("/inventory/shipments")" href="/inventory/shipments" @onclick="CloseMenu"><i class="bi bi-truck"></i><span>@(LocalizationService.IsPersian ? "ارسال کالا" : "Ship orders")</span></a>
                        }
                        @if (canViewDocuments && canViewStock)
                        {
                            <a class="@NavClass("/inventory/material-requests")" href="/inventory/material-requests" @onclick="CloseMenu">
                                <i class="bi bi-inbox" aria-hidden="true"></i><span>@(LocalizationService.IsPersian ? "درخواست‌های مواد" : "Material requests")</span>
                            </a>
                            <a class="@NavClass("/inventory/material-settlement")" href="/inventory/material-settlement" @onclick="CloseMenu"><i class="bi bi-arrow-return-left"></i><span>@(LocalizationService.IsPersian ? "مصرف و برگشت" : "Usage & returns")</span></a>
                        }
                        @if (canViewDocuments)
                        {
                            <a class="@NavClass("/inventory/documents")" href="/inventory/documents" @onclick="CloseMenu">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>@LocalizationService["Documents"]</span>
                            </a>
                        }
                        @if (canViewStock)
                        {
                            <a class="@NavClass("/inventory/stock")" href="/inventory/stock" @onclick="CloseMenu">
                                <i class="bi bi-boxes" aria-hidden="true"></i><span>@LocalizationService["InventoryStock"]</span>
                            </a>
                        }
                        @if (canViewItems)
                        {
                            <a class="@NavClass("/inventory/items")" href="/inventory/items" @onclick="CloseMenu">
                                <i class="bi bi-box" aria-hidden="true"></i><span>@LocalizationService["Items"]</span>
                            </a>
                        }
                        <details class="nav-more-group">
                            <summary>@LocalizationService["ManagerMoreInventory"]</summary>
                            @if (canViewStock)
                            {
                                <a href="/inventory/stock/warehouse" @onclick="CloseMenu"><i class="bi bi-building" aria-hidden="true"></i><span>@LocalizationService["WarehouseStock"]</span></a>
                                <a href="/inventory/stock/lots" @onclick="CloseMenu"><i class="bi bi-box-seam" aria-hidden="true"></i><span>@LocalizationService["StockByLot"]</span></a>
                            }
                            @if (canViewTransactions)
                            {
                                <a href="/inventory/transactions" @onclick="CloseMenu"><i class="bi bi-arrow-left-right" aria-hidden="true"></i><span>@LocalizationService["Transactions"]</span></a>
                            }
                            @if (canViewLocations)
                            {
                                <a href="/inventory/locations" @onclick="CloseMenu"><i class="bi bi-geo-alt" aria-hidden="true"></i><span>@LocalizationService["Locations"]</span></a>
                            }
                            @if (canViewCategories)
                            {
                                <a href="/inventory/itemcategories" @onclick="CloseMenu"><i class="bi bi-tags" aria-hidden="true"></i><span>@LocalizationService["ItemCategories"]</span></a>
                            }
                            @if (canViewUnits)
                            {
                                <a href="/inventory/units" @onclick="CloseMenu"><i class="bi bi-rulers" aria-hidden="true"></i><span>@LocalizationService["Units"]</span></a>
                            }
                            @if (canViewLots)
                            {
                                <a href="/inventory/lots" @onclick="CloseMenu"><i class="bi bi-collection" aria-hidden="true"></i><span>@LocalizationService["Lots"]</span></a>
                            }
                        </details>
                    }

                    @if (canViewProduction || showProductionDashboard || showCeoDashboard)
                    {
                        <div class="menu-group-label"><i class="bi bi-gear" aria-hidden="true"></i> @LocalizationService["Production"]</div>
                        @if (canViewProduction || showCeoDashboard)
                        {
                            <a class="@NavClass("/production/orders")" href="/production/orders" @onclick="CloseMenu">
                                <i class="bi bi-list-check" aria-hidden="true"></i><span>@LocalizationService["ProductionOrders"]</span>
                            </a>
                        }
                        @if (showCeoDashboard || showProductionDashboard)
                        {
                            <a class="@NavClass("/production/planning")" href="/production/planning" @onclick="CloseMenu">
                                <i class="bi bi-calendar-event" aria-hidden="true"></i><span>@LocalizationService["CeoDeadlineCalendar"]</span>
                            </a>
                        }
                        @if (showProductionDashboard)
                        {
                            <a class="@NavClass("/production/machine-schedule")" href="/production/machine-schedule" @onclick="CloseMenu">
                                <i class="bi bi-calendar3" aria-hidden="true"></i><span>@LocalizationService["MachineSchedule"]</span>
                            </a>
                        }
                        @if (canViewProduction)
                        {
                            <details class="nav-more-group">
                                <summary>@LocalizationService["ManagerMoreProduction"]</summary>
                                <a href="/production/workflow" @onclick="CloseMenu"><i class="bi bi-diagram-3" aria-hidden="true"></i><span>@LocalizationService["ProductionWorkflow"]</span></a>
                                <a href="/production/jobs" @onclick="CloseMenu"><i class="bi bi-clipboard-data" aria-hidden="true"></i><span>@LocalizationService["JobOverview"]</span></a>
                                <a href="/production/imposition-optimizer" @onclick="CloseMenu"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i><span>@LocalizationService["Imposition Optimizer"]</span></a>
                                <a href="/production/quality-inspections" @onclick="CloseMenu"><i class="bi bi-patch-check" aria-hidden="true"></i><span>@LocalizationService["QualityInspectionManagement"]</span></a>
                            </details>
                        }
                    }

                    @if (canViewUsers || canViewRoles || canManagePermissions)
                    {
                        <div class="menu-group-label"><i class="bi bi-shield-lock" aria-hidden="true"></i> @LocalizationService["Administration"]</div>
                        @if (canViewUsers)
                        {
                            <a class="@NavClass("/administration/users")" href="/administration/users" @onclick="CloseMenu">
                                <i class="bi bi-person-gear" aria-hidden="true"></i><span>@LocalizationService["Users"]</span>
                            </a>
                        }
                        @if (canViewRoles || canManagePermissions)
                        {
                            <details class="nav-more-group">
                                <summary>@LocalizationService["ManagerMoreAdministration"]</summary>
                                @if (canViewRoles)
                                {
                                    <a href="/administration/roles" @onclick="CloseMenu"><i class="bi bi-person-badge" aria-hidden="true"></i><span>@LocalizationService["Roles"]</span></a>
                                }
                                @if (canManagePermissions)
                                {
                                    <a href="/administration/permission-management" @onclick="CloseMenu"><i class="bi bi-shield-lock" aria-hidden="true"></i><span>@LocalizationService["Permissions"]</span></a>
                                }
                            </details>
                        }
                    }
                </nav>
        
            </div>
        }

    </aside>

    <main class="main-content">
        <div class="hc-workspace-toolbar no-print">
            <div class="hc-workspace-caption"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>@(LocalizationService.IsPersian ? "فضای کاری" : "Workspace")</span></div>
            <div class="language-switcher" role="group" aria-label="@(LocalizationService.IsPersian ? "زبان" : "Language")">

        <button type="button"
                class="language-button @(LocalizationService.CurrentLanguage == "en" ? "active" : "")"
                @onclick='() => ChangeLanguage("en-US")'>
            @LocalizationService["English"]
        </button>

        <button type="button"
                class="language-button @(LocalizationService.CurrentLanguage == "fa" ? "active" : "")"
                @onclick='() => ChangeLanguage("fa-IR")'>
            فارسی
        </button>

    </div>
            <AuthorizeView>
                <Authorized><EmployeeInbox /></Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <a class="hc-account-link" href="/Account/Manage" aria-label="@(LocalizationService.IsPersian ? "حساب کاربری" : "My account")"><i class="bi bi-person-circle" aria-hidden="true"></i><span>@(LocalizationService.IsPersian ? "حساب کاربری" : "My account")</span></a>
                </Authorized>
                <NotAuthorized>
                    <a class="hc-account-link" href="/Account/Login" aria-label="@LocalizationService["Login"]"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span>@LocalizationService["Login"]</span></a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <div class="hc-workspace-body">
            @Body
        </div>
    </main>

    <InventoryAlertToast />

</div>

@code {

    private bool menuOpen = false;
    private bool showSalesDashboard;
    private bool showWarehouseDashboard;
    private bool showCeoDashboard;
    private bool showProductionDashboard;
    private bool showOperatorWorkspace;
    private string NavClass(string path) =>
        "menu-button" + (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') ==
            path.TrimStart('/').TrimEnd('/') ? " active" : "");

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged
            += OnAuthenticationStateChanged;

        Navigation.LocationChanged += OnLocationChanged;
        await LoadMenuPermissionsAsync();
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void CloseMenu()
    {
        menuOpen = false;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            menuOpen = false;
            StateHasChanged();
        });
    }

    private async void OnAuthenticationStateChanged(
        Task<AuthenticationState> task)
    {
        var state = await task;

        if (state.User.Identity?.IsAuthenticated != true)
        {
            await InvokeAsync(() =>
            {
                Navigation.NavigateTo(
                    "/Account/Login",
                    forceLoad: true);
            });
        }
    }

    private void ChangeLanguage(string culture)
    {
        var currentUri = new Uri(Navigation.Uri);

        var redirectUri =
            currentUri.PathAndQuery;

        Navigation.NavigateTo(
            $"/Culture/Set?culture={Uri.EscapeDataString(culture)}" +
            $"&redirectUri={Uri.EscapeDataString(redirectUri)}",
            forceLoad: true);
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged
            -= OnAuthenticationStateChanged;

        Navigation.LocationChanged -= OnLocationChanged;
    }

    // Consolidated navigation state and permission checks.
    private bool loading = true;


    // =========================================================
    // Inventory
    // =========================================================

    private bool canViewInventory;
    private bool canViewSalesRequests;
    private bool canViewDocuments;
    private bool canViewItems;
    private bool canViewUnits;
    private bool canViewCategories;
    private bool canViewLots;
    private bool canViewStock;
    private bool canViewLocations;
    private bool canViewTransactions;


    // =========================================================
    // Sales
    // =========================================================

    private bool canViewSales;

    private bool canViewSalesDeliveries;

    private bool canViewSalesOrders;

    private bool canViewSalesInvoices;

    // =========================================================
    // Production
    // =========================================================

    private bool canViewProduction;


    // =========================================================
    // Customers
    // =========================================================

    private bool canViewCustomers;


    // =========================================================
    // Administration
    // =========================================================

    private bool canViewUsers;
    private bool canViewRoles;
    private bool canManagePermissions;


    private async Task LoadMenuPermissionsAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }


            showSalesDashboard = user.IsInRole("Administrator") || user.IsInRole("Sales") ||
                user.IsInRole("SalesManager") || user.IsInRole("Sales Manager");
            showWarehouseDashboard = user.IsInRole("Administrator") || user.IsInRole("Warehouse") ||
                user.IsInRole("WarehouseManager") || user.IsInRole("Warehouse Manager");
            showCeoDashboard = user.IsInRole("Administrator") || user.IsInRole("CEO") ||
                user.IsInRole("Ceo") || user.IsInRole("Manager");
            showProductionDashboard = user.IsInRole("Administrator") ||
                user.IsInRole("ProductionManager") || user.IsInRole("Production Manager") ||
                user.IsInRole("FloorManager") || user.IsInRole("Floor Manager") ||
                user.IsInRole("Production") || user.IsInRole("Manager");
            showOperatorWorkspace = user.IsInRole("Administrator") || user.IsInRole("Operator") ||
                user.IsInRole("ProductionManager") || user.IsInRole("Production Manager") ||
                user.IsInRole("FloorManager") || user.IsInRole("Floor Manager") ||
                user.IsInRole("Production") || user.IsInRole("Manager");

            // =====================================================
            // Inventory
            // =====================================================

            canViewDocuments =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Documents.View");

            canViewItems =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Items.View");

            canViewUnits =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Units.View");

            canViewCategories =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Categories.View");

            canViewLots =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Lots.View");

            canViewStock =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Stock.View");

            canViewLocations =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Locations.View");

            canViewTransactions =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Inventory.Transactions.View");

            canViewInventory =
                canViewDocuments ||
                canViewItems ||
                canViewUnits ||
                canViewCategories ||
                canViewLots ||
                canViewStock ||
                canViewLocations ||
                canViewTransactions;


            // =====================================================
            // Sales
            // =====================================================

            canViewSalesRequests =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Sales.Requests.View");

            canViewSalesDeliveries =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Sales.Deliveries.View");

            canViewSalesInvoices =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Sales.Invoices.View");

            canViewSalesOrders =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Sales.Orders.View");

            canViewSales =
                canViewSalesRequests ||
                canViewSalesOrders ||
                canViewSalesDeliveries ||
                canViewSalesInvoices;


            // =====================================================
            // Production
            // =====================================================

            canViewProduction =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Production.Orders.View");


            // =====================================================
            // Customers
            // =====================================================

            canViewCustomers =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Customers.View");


            // =====================================================
            // Administration
            // =====================================================

            canViewUsers =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Users.View");

            canViewRoles =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Roles.View");

            canManagePermissions =
                await PermissionService.HasPermissionAsync(
                    user,
                    "Roles.ManagePermissions");
        }
        finally
        {
            loading = false;
        }
    }


    private void GoTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}
