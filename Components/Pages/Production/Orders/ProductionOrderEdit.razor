@page "/production/orders/edit/{Id:long}"

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Inventory

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService
@inject ProductionPostingService ProductionPostingService
@inject ProductionExecutionService ProductionExecutionService

<PageTitle>@LocalizationService["ProductionOrder"]</PageTitle>



<div class="page-container production-order-page">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mb-4">
            @errorMessage
        </div>
    }

    @if (productionOrder == null)
    {
        <div class="alert alert-info">
            @LocalizationService["LoadingProductionOrder"]
        </div>
    }
    else
    {
        <div class="erp-page-header">

            <div>
                <div class="d-flex align-items-center gap-3">

                    <h3 class="erp-page-title mb-0">
                        @LocalizationService["ProductionOrder"]
                    </h3>

                    <span class="@GetStatusClass(productionOrder.Status)">
                        @LocalizationService.TranslateEnum(productionOrder.Status)
                    </span>

                </div>

                <p class="erp-page-subtitle mb-0">
                    @productionOrder.OrderNumber
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end">

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="BackToList">
                    @LocalizationService["Back"]
                </button>
@if (productionOrder.Status == ProductionOrderStatus.ReadyToStart)
                {
                    <button type="button"
                            class="btn btn-primary"
                            disabled>
                        @LocalizationService["StartProduction"]
                    </button>
                }

                
                @if (productionOrder.Status == ProductionOrderStatus.ReadyToStart)
                {
                    <button type="button"
                            class="btn btn-warning"
                            @onclick="IssueMaterials"
                            disabled="@isIssuingMaterials">
                        @(isIssuingMaterials ? LocalizationService["IssuingMaterials"] : LocalizationService["IssueMaterials"])
                    </button>
                }

                @if (productionOrder.Status == ProductionOrderStatus.InProduction)
                {
                    <button type="button"
                            class="btn btn-primary"
                            disabled>
                        @LocalizationService["ProductionProgress"]
                    </button>
                }


                @if (productionOrder.Status == ProductionOrderStatus.QualityControl)
                {
                    <button type="button"
                            class="btn btn-info"
                            disabled>
                        @LocalizationService["QualityControl"]
                    </button>
                }

                @if (productionOrder.Status == ProductionOrderStatus.Completed)
                {
                    <span class="badge bg-success px-3 py-2">
                        @LocalizationService["ProductionCompleted"]
                    </span>
                }

            </div>

        </div>

        

        <!-- ===================================================== -->
        <!-- Production Order Information -->
        <!-- ===================================================== -->

        <div class="card mb-4">

            <div class="card-header">
                <strong>@LocalizationService["ProductionOrderInformation"]</strong>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["OrderNumber"]
                        </label>

                        <input class="form-control"
                               value="@productionOrder.OrderNumber"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["SalesOrder"]
                        </label>

                        <input class="form-control"
                               value="@productionOrder.SalesOrder?.OrderNumber"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["Customer"]
                        </label>

                        <input class="form-control"
                               value="@productionOrder.SalesOrder?.Customer?.Name"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["Status"]
                        </label>

                        <div class="pt-2">
                            <span class="@GetStatusClass(productionOrder.Status)">
                                @LocalizationService.TranslateEnum(productionOrder.Status)
                            </span>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["Created"]
                        </label>

                        <input class="form-control"
                               value="@productionOrder.CreatedDate.ToString("yyyy-MM-dd HH:mm")"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["PlannedStart"]
                        </label>

                        <input class="form-control"
                               value="@(productionOrder.PlannedStartDate?.ToString("yyyy-MM-dd") ?? "-")"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["PlannedEnd"]
                        </label>

                        <input class="form-control"
                               value="@(productionOrder.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "-")"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["ActualStart"]
                        </label>

                        <input class="form-control"
                               value="@(productionOrder.ActualStartDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")"
                               readonly />
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">
                            @LocalizationService["ActualEnd"]
                        </label>

                        <input class="form-control"
                               value="@(productionOrder.ActualEndDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")"
                               readonly />
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(productionOrder.Notes))
                {
                    <div class="mt-3">

                        <label class="form-label">
                            @LocalizationService["Notes"]
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  readonly>@productionOrder.Notes</textarea>

                    </div>
                }

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- Production Lines -->
        <!-- ===================================================== -->

        <div class="card mb-4">

            <div class="card-header">
                <strong>@LocalizationService["ProductionLines"]</strong>
            </div>

            <div class="card-body">

                @if (productionOrder.Lines.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        @LocalizationService["NoProductionLines"]
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>@LocalizationService["Item"]</th>
                                    <th>@LocalizationService["Code"]</th>
                                    <th>@LocalizationService["PlannedQuantity"]</th>
                                    <th>@LocalizationService["ProducedQuantity"]</th>
                                    <th>@LocalizationService["Remaining"]</th>
                                    <th>@LocalizationService["Unit"]</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var line in productionOrder.Lines)
                                {
                                    var remaining =
                                        Math.Max(
                                            0,
                                            line.PlannedQuantity -
                                            line.ProducedQuantity);

                                    <tr>

                                        <td>
                                            <strong>
                                                @line.Item?.Name
                                            </strong>
                                        </td>

                                        <td>
                                            @line.Item?.Code
                                        </td>

                                        <td>
                                            @line.PlannedQuantity.ToString("0.###")
                                        </td>

                                        <td>
                                            @line.ProducedQuantity.ToString("0.###")
                                        </td>

                                        <td>
                                            @remaining.ToString("0.###")
                                        </td>

                                        <td>
                                            @line.Unit?.Symbol
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- Production Progress -->
        <!-- ===================================================== -->

        <div class="card mb-4">

            <div class="card-header">
                <strong>@LocalizationService["ProductionProgress"]</strong>
            </div>

            <div class="card-body">

                @{
                    var totalPlanned =
                        productionOrder.Lines.Sum(x => x.PlannedQuantity);

                    var totalProduced =
                        productionOrder.Lines.Sum(x => x.ProducedQuantity);

                    var totalRemaining =
                        Math.Max(
                            0,
                            totalPlanned - totalProduced);

                    var progressPercentage =
                        totalPlanned > 0
                            ? Math.Min(
                                100,
                                (totalProduced / totalPlanned) * 100)
                            : 0;
                }

                <div class="row g-3">

                    <div class="col-md-3">

                        <div class="small text-muted">
                            @LocalizationService["Planned"]
                        </div>

                        <div class="fs-5 fw-semibold">
                            @totalPlanned.ToString("0.###")
                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="small text-muted">
                            @LocalizationService["Produced"]
                        </div>

                        <div class="fs-5 fw-semibold">
                            @totalProduced.ToString("0.###")
                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="small text-muted">
                            @LocalizationService["Remaining"]
                        </div>

                        <div class="fs-5 fw-semibold">
                            @totalRemaining.ToString("0.###")
                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="small text-muted">
                            @LocalizationService["Completion"]
                        </div>

                        <div class="fs-5 fw-semibold">
                            @progressPercentage.ToString("0.##")%
                        </div>

                    </div>

                </div>

                <div class="progress mt-4 erp-height-10"
                     >

                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @progressPercentage%;"
                         aria-valuenow="@progressPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- Production Operations -->
        <!-- ===================================================== -->

        <div class="card mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <strong>@LocalizationService["ProductionOperations"]</strong>

                <span class="badge bg-secondary">
                    @string.Format(LocalizationService["OperationsCount"], productionOperations.Count)
                </span>

            </div>

            <div class="card-body">

                @if (productionOperations.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No production operations have been defined for this
                        production order yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th class="erp-width-80" >
                                        @LocalizationService["Sequence"]
                                    </th>

                                    <th>
                                        @LocalizationService["Operation"]
                                    </th>

                                    <th>
                                        @LocalizationService["WorkCenter"]
                                    </th>

                                    <th>
                                        @LocalizationService["PlannedHours"]
                                    </th>

                                    <th>
                                        @LocalizationService["ActualHours"]
                                    </th>

                                    <th>
                                        @LocalizationService["Status"]
                                    </th>

                                    <th class="erp-width-180" >
                                        @LocalizationService["Action"]
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var operation in productionOperations)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @($"{operation.Sequence}. {operation.Name}")
                                            </strong>
                                        </td>

                                        <td>
                                            @if (operation.WorkCenterId.HasValue)
                                            {
                                                <span>
                                                    WC-@operation.WorkCenterId
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    @LocalizationService["NotAssigned"]
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @operation.PlannedHours.ToString("0.##")
                                        </td>

                                        <td>
                                            @operation.ActualHours.ToString("0.##")
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                @operation.Status
                                            </span>
                                        </td>

                                        <td>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    disabled>
                                                @LocalizationService["Open"]
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- Production Scheduling -->
        <!-- ===================================================== -->

        <div class="card mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <strong>@LocalizationService["ProductionSchedule"]</strong>

                <span class="badge bg-secondary">
                    @string.Format(LocalizationService["SchedulesCount"], productionSchedules.Count)
                </span>

            </div>

            <div class="card-body">

                @if (productionSchedules.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No production schedule has been created for this
                        production order yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>

                                    <th>
                                        @LocalizationService["Operation"]
                                    </th>

                                    <th>
                                        @LocalizationService["Machine"]
                                    </th>

                                    <th>
                                        @LocalizationService["PlannedStart"]
                                    </th>

                                    <th>
                                        @LocalizationService["PlannedEnd"]
                                    </th>

                                    <th>
                                        @LocalizationService["Priority"]
                                    </th>

                                    <th>
                                        @LocalizationService["Status"]
                                    </th>

                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var schedule in productionSchedules)
                                {
                                    var operation =
                                        productionOperations
                                            .FirstOrDefault(
                                                x => x.Id ==
                                                    schedule.ProductionOperationId);

                                    <tr>

                                        <td>
                                            @if (operation != null)
                                            {
                                                <strong>
                                                    @operation.Sequence.
                                                    @operation.Name
                                                </strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    @LocalizationService["Operation"] #@schedule.ProductionOperationId
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @LocalizationService["Machine"] @schedule.MachineId
                                        </td>

                                        <td>
                                            @schedule.PlannedStart.ToString(
                                                "yyyy-MM-dd HH:mm")
                                        </td>

                                        <td>
                                            @schedule.PlannedEnd.ToString(
                                                "yyyy-MM-dd HH:mm")
                                        </td>

                                        <td>
                                            @schedule.Priority
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                @schedule.Status
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>



        <!-- ===================================================== -->
        <!-- Operator Material Request -->
        <!-- ===================================================== -->
        @if (!string.IsNullOrWhiteSpace(materialIssueMessage))
        {
            <div class="alert alert-success mb-4">@materialIssueMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(materialRequestMessage))
        {
            <div class="alert alert-success mb-4">@materialRequestMessage</div>
        }

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Material Request</strong>
                <span class="badge bg-info">Operator entered</span>
            </div>
            <div class="card-body">
                <p class="section-hint">Select the materials needed for this production order and enter the requested quantities. Submitting this request does not reserve or issue inventory.</p>

                <datalist id="production-material-items">
                    @foreach (var item in activeItems)
                    {
                        <option value="@GetItemOption(item)" />
                    }
                </datalist>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="erp-min-width-280" >Material</th>
                                <th class="erp-min-width-130" >Requested quantity</th>
                                <th class="erp-width-120">Unit</th>
                                <th class="erp-min-width-180" >Note</th>
                                <th class="erp-width-70" ></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in requestLines)
                            {
                                <tr>
                                    <td>
                                        <input class="form-control" list="production-material-items"
                                               value="@line.ItemSearchText"
                                               @onchange="(e) => OnRequestItemChanged(line, e.Value?.ToString())"
                                               placeholder="Search by item name or code" />
                                        @if (line.ItemId == 0 && !string.IsNullOrWhiteSpace(line.ItemSearchText))
                                        {
                                            <small class="text-danger">Choose an item from the suggestions.</small>
                                        }
                                    </td>
                                    <td>
                                        <input class="form-control" type="number" min="0.001" step="0.001"
                                               @bind="line.Quantity" @bind:event="oninput" />
                                    </td>
                                    <td><input class="form-control" value="@line.UnitSymbol" readonly /></td>
                                    <td><input class="form-control" @bind="line.Notes" placeholder="Optional" /></td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                title="Remove line" @onclick="() => RemoveRequestLine(line)">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                    <button type="button" class="btn btn-outline-primary" @onclick="AddRequestLine">
                        + Add material line
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitMaterialRequest"
                            disabled="@isSavingMaterialRequest">
                        @(isSavingMaterialRequest ? "Submitting..." : "Submit material request")
                    </button>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><strong>Submitted Material Requests</strong></div>
            <div class="card-body">
                @if (materialRequests.Count == 0)
                {
                    <div class="text-muted">No material requests have been submitted for this production order.</div>
                }
                else
                {
                    @foreach (var request in materialRequests)
                    {
                        <div class="border rounded-3 p-3 p-md-4 mb-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                                <strong>Request #@request.Id</strong>
                                <span class="badge bg-warning text-dark">@request.Status</span>
                                <small class="text-muted">@request.RequestedDate.ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th>Material</th><th>Code</th><th>Quantity</th><th>Unit</th><th>Note</th></tr></thead>
                                    <tbody>
                                        @foreach (var requestedLine in request.Lines)
                                        {
                                            <tr>
                                                <td>@requestedLine.Item?.Name</td>
                                                <td>@requestedLine.Item?.Code</td>
                                                <td>@requestedLine.Quantity.ToString("0.###")</td>
                                                <td>@requestedLine.Unit?.Symbol</td>
                                                <td>@requestedLine.Notes</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- Material Reservations -->
        <!-- ===================================================== -->

        <div class="card mb-4">

            <div class="card-header">
                <strong>@LocalizationService["ReservationMessage"]</strong>
            </div>

            <div class="card-body">

                @if (materialReservations.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No material reservations have been created for this
                        production order.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>@LocalizationService["Material"]</th>
                                    <th>@LocalizationService["Code"]</th>
                                    <th>@LocalizationService["ReservedQuantity"]</th>
                                    <th>@LocalizationService["Unit"]</th>
                                    <th>@LocalizationService["ReservedDate"]</th>
                                    <th>@LocalizationService["Status"]</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var reservation in materialReservations)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @reservation.Item?.Name
                                            </strong>
                                        </td>

                                        <td>
                                            @reservation.Item?.Code
                                        </td>

                                        <td>
                                            @reservation.Quantity.ToString("0.###")
                                        </td>

                                        <td>
                                            @reservation.Unit?.Symbol
                                        </td>

                                        <td>
                                            @reservation.ReservedDate.ToString(
                                                "yyyy-MM-dd HH:mm")
                                        </td>

                                        <td>
                                            <span class="badge bg-success">
                                                @reservation.Status
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    }

</div>

@code {

    [Parameter]
    public long Id { get; set; }

    private long selectedProductionLineId;

    private decimal outputQuantity;

    private decimal wasteQuantity;

    private bool isRecordingOutput;

    private string? outputMessage;

    private ProductionOrder? productionOrder;


    private string? errorMessage;

    private bool isIssuingMaterials;

    private string? materialIssueMessage;

    private List<ProductionOperation> productionOperations = new();

    private List<ProductionSchedule> productionSchedules = new();

    private List<ProductionMaterialReservation> materialReservations = new();
    private List<Item> activeItems = new();
    private List<ProductionMaterialRequest> materialRequests = new();
    private List<MaterialRequestDraftLine> requestLines = new() { new() };
    private bool isSavingMaterialRequest;
    private string? materialRequestMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductionOrderAsync();
    }

    private async Task LoadProductionOrderAsync()
    {
        errorMessage = null;

        try
        {
            productionOrder = await Db.ProductionOrders

                .Include(x => x.SalesOrder)
                    .ThenInclude(x => x.Customer)

                .Include(x => x.Lines)
                    .ThenInclude(x => x.Item)
                        .ThenInclude(x => x.Unit)

                .Include(x => x.Lines)
                    .ThenInclude(x => x.Unit)

                .FirstOrDefaultAsync(x => x.Id == Id);

            if (productionOrder == null)
            {
                errorMessage = LocalizationService["ProductionOrderNotFound"];
                return;
            }

            materialReservations = await Db.ProductionMaterialReservations
                .Where(x => x.ProductionOrderId == Id)
                .Include(x => x.Item)
                .Include(x => x.Unit)
                .OrderBy(x => x.Item.Name)
                .ToListAsync();

            activeItems = await Db.Items
                .Include(x => x.Unit)
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .ToListAsync();

            materialRequests = await Db.ProductionMaterialRequests
                .Where(x => x.ProductionOrderId == Id)
                .Include(x => x.Lines).ThenInclude(x => x.Item)
                .Include(x => x.Lines).ThenInclude(x => x.Unit)
                .OrderByDescending(x => x.RequestedDate)
                .ToListAsync();

            productionOperations = await Db.ProductionOperations
                .Where(x => x.ProductionOrderId == Id)
                .OrderBy(x => x.Sequence)
                .ToListAsync();

            var operationIds = productionOperations
                .Select(x => x.Id)
                .ToList();

            productionSchedules = await Db.ProductionSchedules
                .Where(x => operationIds.Contains(x.ProductionOperationId))
                .OrderBy(x => x.PlannedStart)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetLocalizedErrorMessage(ex);
        }
    }


    private void AddRequestLine() => requestLines.Add(new MaterialRequestDraftLine());

    private void RemoveRequestLine(MaterialRequestDraftLine line)
    {
        requestLines.Remove(line);
        if (requestLines.Count == 0)
            requestLines.Add(new MaterialRequestDraftLine());
    }

    private string GetItemOption(Item item) => $"{item.Code} - {item.Name}";

    private void OnRequestItemChanged(MaterialRequestDraftLine line, string? selectedText)
    {
        line.ItemSearchText = selectedText ?? string.Empty;
        var selected = activeItems.FirstOrDefault(x =>
            string.Equals(GetItemOption(x), line.ItemSearchText, StringComparison.OrdinalIgnoreCase));

        line.ItemId = selected?.Id ?? 0;
        line.UnitId = selected?.UnitId ?? 0;
        line.UnitSymbol = selected?.Unit?.Symbol ?? string.Empty;
    }

    private async Task SubmitMaterialRequest()
    {
        if (productionOrder == null || isSavingMaterialRequest)
            return;

        materialRequestMessage = null;
        errorMessage = null;

        var linesToSave = requestLines
            .Where(x => x.ItemId > 0 || x.Quantity > 0 || !string.IsNullOrWhiteSpace(x.ItemSearchText))
            .ToList();

        if (linesToSave.Count == 0)
        {
            errorMessage = "Add at least one material before submitting the request.";
            return;
        }

        if (linesToSave.Any(x => x.ItemId <= 0 || x.UnitId <= 0 || x.Quantity <= 0))
        {
            errorMessage = "Select a valid material and enter a quantity greater than zero for every request line.";
            return;
        }

        try
        {
            isSavingMaterialRequest = true;
            var request = new ProductionMaterialRequest
            {
                ProductionOrderId = productionOrder.Id,
                RequestedDate = DateTime.Now,
                Status = "Requested",
                Lines = linesToSave.Select(x => new ProductionMaterialRequestLine
                {
                    ItemId = x.ItemId,
                    UnitId = x.UnitId,
                    Quantity = x.Quantity,
                    Notes = x.Notes?.Trim() ?? string.Empty
                }).ToList()
            };

            Db.ProductionMaterialRequests.Add(request);
            await Db.SaveChangesAsync();

            requestLines = new() { new MaterialRequestDraftLine() };
            materialRequestMessage = $"Material request #{request.Id} submitted. Inventory quantities have not been reserved or issued.";
            await LoadProductionOrderAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetLocalizedErrorMessage(ex);
        }
        finally
        {
            isSavingMaterialRequest = false;
        }
    }

    private sealed class MaterialRequestDraftLine
    {
        public string ItemSearchText { get; set; } = string.Empty;
        public int ItemId { get; set; }
        public int UnitId { get; set; }
        public decimal Quantity { get; set; }
        public string UnitSymbol { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }

    private async Task IssueMaterials()
    {
        if (productionOrder == null)
            return;

        if (isIssuingMaterials)
            return;

        errorMessage = null;
        materialIssueMessage = null;

        try
        {
            isIssuingMaterials = true;

            var reservations =
                await Db.ProductionMaterialReservations
                    .Where(x =>
                        x.ProductionOrderId == productionOrder.Id &&
                        x.Status == ReservationStatus.Reserved &&
                        x.Quantity > 0)
                    .AnyAsync();

            if (!reservations)
            {
                materialIssueMessage =
                    LocalizationService["NoReservedMaterialsForIssue"];

                return;
            }

            var productionLocation =
                await Db.InventoryLocations
                    .FirstOrDefaultAsync(x =>
                        x.Type == InventoryLocationType.Production &&
                        x.IsActive);

            if (productionLocation == null)
            {
                throw new InvalidOperationException(
                    LocalizationService["NoActiveProductionLocation"]);
            }

            var documentIds =
                await ProductionPostingService.PostMaterialIssueAsync(
                    productionOrder.Id,
                    productionLocation.Id,
                    "system");

            materialIssueMessage =
                string.Format(LocalizationService["MaterialIssuePosted"], documentIds.Count);

            await LoadProductionOrderAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetLocalizedErrorMessage(ex);
        }
        finally
        {
            isIssuingMaterials = false;
        }
    }

    private string GetLocalizedErrorMessage(Exception ex)
    {
        var message = ex.GetBaseException().Message;

        if (message.Contains("Production order not found", StringComparison.OrdinalIgnoreCase))
            return LocalizationService["ProductionOrderNotFound"];

        if (message.Contains("No active Production inventory location", StringComparison.OrdinalIgnoreCase))
            return LocalizationService["NoActiveProductionLocation"];

        if (message.Contains("No reserved materials", StringComparison.OrdinalIgnoreCase))
            return LocalizationService["NoReservedMaterialsForIssue"];

        if (message.Contains("No active BOM", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("No active BOM was found", StringComparison.OrdinalIgnoreCase))
            return LocalizationService["NoActiveBomForProductionItem"];

        if (message.Contains("has no component lines", StringComparison.OrdinalIgnoreCase))
            return LocalizationService["BomHasNoComponentLines"];

        if (message.Contains("planned quantity greater than zero", StringComparison.OrdinalIgnoreCase))
            return LocalizationService["PlannedQuantityMustBePositive"];

        // Avoid displaying untranslated exception text to users.
        return LocalizationService["UnexpectedError"];
    }

    private void BackToList()
    {
        Navigation.NavigateTo(
            "/production/orders");
    }


    private string GetStatusClass(
        ProductionOrderStatus status)
    {
        return status switch
        {
            ProductionOrderStatus.Planned =>
                "badge bg-secondary",

            ProductionOrderStatus.MaterialChecking =>
                "badge bg-info",

            ProductionOrderStatus.WaitingForMaterial =>
                "badge bg-warning text-dark",

            ProductionOrderStatus.ReadyToStart =>
                "badge bg-primary",

            ProductionOrderStatus.InProduction =>
                "badge bg-primary",

            ProductionOrderStatus.QualityControl =>
                "badge bg-info",

            ProductionOrderStatus.Completed =>
                "badge bg-success",

            ProductionOrderStatus.Cancelled =>
                "badge bg-danger",

            _ =>
                "badge bg-secondary"
        };
    }
