@page "/production/machine-schedule"
@using System.Globalization
@using System.Text.Json
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject LocalizationService L

<PageTitle>@L["MachineSchedule"]</PageTitle>
<div class="page-container production-planning machine-schedule">
    <div class="erp-page-header mb-4">
        <div><h2 class="erp-page-title">@L["MachineSchedule"]</h2><p class="erp-page-subtitle">@L["MachineScheduleHelp"]</p></div>
        @if (canEdit) { <button class="btn btn-outline-primary" @onclick="GenerateMissingOperations">@L["GenerateOperations"]</button> }
    </div>
    @if (!canView) { <div class="alert alert-warning">@L["AccessDenied"]</div> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-info">@message</div> }
        <div class="planning-layout">
            <aside class="planning-order-panel">
                <div class="card mb-3">
                    <div class="card-header"><strong>@L["UnscheduledOperations"]</strong><span class="badge bg-secondary">@operations.Count(x => !schedules.Any(s => s.ProductionOperationId == x.Id))</span></div>
                    <div class="card-body order-queue machine-return-zone"
                         @ondragover:preventDefault="true"
                         @ondrop:preventDefault="true"
                         @ondrop="DropBackToQueue">
                        <div class="machine-return-hint" role="status">@L["DropScheduledStepHere"]</div>
                        @if (operations.All(x => schedules.Any(s => s.ProductionOperationId == x.Id)))
                        {
                            <p class="small text-muted mt-2">@L["NoUnscheduledSteps"]</p>
                        }
                        @foreach (var operation in operations.Where(x => !schedules.Any(s => s.ProductionOperationId == x.Id)).OrderBy(x => x.ProductionOrder.PlannedEndDate).ThenBy(x => x.Sequence))
                        {
                            <div class="queue-order @(selectedOperationId == operation.Id ? "queue-order-selected" : "")" draggable="@canEdit" @ondragstart="() => SelectDraggedOperation(operation.Id)" @onclick="() => SelectOperation(operation.Id)">
                                <div class="d-flex justify-content-between gap-2"><strong>@operation.ProductionOrder.OrderNumber</strong><span class="badge bg-secondary">#@operation.Sequence</span></div>
                                <div class="small fw-semibold mt-1">@operation.Name</div>
                                <div class="small text-muted">@L["DueDate"]: @FormatDate(operation.ProductionOrder.PlannedEndDate)</div>
                                <div class="small text-muted">@L["EstimatedHours"]: @DurationLabel(ProductionPlanningTime.OperationMinutes(operation.PlannedHours))</div>
                                <div class="small text-muted">@L["MachineStepCount"]: @operation.Sequence / @OrderOperationCount(operation.ProductionOrderId)</div>
                                <div class="small text-muted">@L["CeoDuration"]: @DurationLabel(operation.ProductionOrder.EstimatedDurationMinutes)</div>
                                @if (canEdit)
                                {
                                    <label class="form-label mt-2">@L["AdjustStepHours"]</label>
                                    <input type="number" min="0.016667" step="any" class="form-control form-control-sm"
                                           value="@DurationInput(operation)"
                                           @onchange="e => SetDurationInput(operation.Id, e.Value?.ToString())" />
                                    <button type="button" class="btn btn-outline-primary btn-sm mt-2 w-100"
                                            @onclick="() => SaveOperationDuration(operation.Id)">@L["ApplyStepDuration"]</button>
                                    <label class="form-label mt-2">@L["Machine"]</label>
                                    <select class="form-select form-select-sm" value="@MachineChoice(operation.Id)" @onchange="e => SetMachineChoice(operation.Id, e.Value?.ToString())">
                                        <option value="0">@L["SelectMachine"]</option>
                                        @foreach (var machine in SuggestedMachines(operation)) { <option value="@machine.Id">@machine.Name</option> }
                                    </select>
                                    <label class="form-label mt-2">@L["PlannedStart"]</label>
                                    <input type="datetime-local" class="form-control form-control-sm" value="@StartChoice(operation.Id)" @onchange="e => SetStartChoice(operation.Id, e.Value?.ToString())" />
                                    <button class="btn btn-primary btn-sm mt-2 w-100" @onclick="() => Schedule(operation.Id)">@L["ScheduleOperation"]</button>
                                }
                            </div>
                        }
                    </div>
                </div>
                @if (canEdit)
                {
                    <div class="card">
                        <div class="card-header">@L["AddOperation"]</div>
                        <div class="card-body">
                            <select class="form-select mb-2" @bind="newOrderId">
                                <option value="0">@L["SelectOrder"]</option>
                                @foreach (var order in orders) { <option value="@order.Id">@order.OrderNumber</option> }
                            </select>
                            <input class="form-control mb-2" placeholder="@L["Operation"]" @bind="newOperationName" />
                            <label class="form-label">@L["EstimatedHours"]</label>
                            <input type="number" min="0.25" step="0.25" class="form-control mb-2" @bind="newHours" />
                            <button class="btn btn-primary w-100" @onclick="AddOperation">@L["AddOperation"]</button>
                        </div>
                    </div>
                }
            </aside>
            <section class="planning-calendar-panel">
                <div class="card mb-3"><div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShiftPeriod(-1)">‹</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => selectedDate = DateTime.Today">@L["Today"]</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShiftPeriod(1)">›</button>
                            <strong>@FormatDate(selectedDate)</strong>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn @(viewMode == CalendarView.Month ? "btn-primary" : "btn-outline-primary")" @onclick="() => viewMode = CalendarView.Month">@L["Month"]</button>
                            <button class="btn @(viewMode == CalendarView.Week ? "btn-primary" : "btn-outline-primary")" @onclick="() => viewMode = CalendarView.Week">@L["Week"]</button>
                            <button class="btn @(viewMode == CalendarView.Day ? "btn-primary" : "btn-outline-primary")" @onclick="() => viewMode = CalendarView.Day">@L["Day"]</button>
                        </div>
                    </div>
                    <div class="shift-legend mb-3">
                        <span><i class="shift-dot work"></i> @L["RegularShift"]</span>
                        <span><i class="shift-dot overtime"></i> @L["OvertimeShift"]</span>
                        <span><i class="shift-dot night"></i> @L["NightShift"]</span>
                    </div>
                    @if (operations.Count > 0)
                    {
                        <div class="machine-order-overview mb-3">
                            @foreach (var order in orders.Where(x => operations.Any(op => op.ProductionOrderId == x.Id)))
                            {
                                <div class="machine-order-totals" draggable="@canEdit" @ondragstart="() => StartScheduledOrderDrag(order.Id)">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <strong>@order.OrderNumber</strong>
                                        <span class="badge bg-secondary">@OrderScheduledCount(order.Id) / @OrderOperationCount(order.Id) @L["MachineStepCount"]</span>
                                    </div>
                                    <div class="small">@L["CeoDuration"]: <strong>@DurationLabel(order.EstimatedDurationMinutes)</strong></div>
                                    <div class="small @(OrderStepMinutes(order.Id) == order.EstimatedDurationMinutes ? "text-success" : "text-danger")">
                                        @L["MachineDuration"]: <strong>@DurationLabel(OrderStepMinutes(order.Id))</strong>
                                    </div>
                                    <div class="small text-muted">@FormatDate(order.PlannedStartDate) – @FormatDate(order.PlannedEndDate)</div>
                                    @if (canEdit && OrderScheduledCount(order.Id) > 0)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm mt-2"
                                                @onclick="() => UnscheduleOrder(order.Id)">@L["ReturnWholeOrder"]</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <label class="form-label" for="machine-filter">@L["Machine"]</label>
                    <select id="machine-filter" class="form-select mb-3" @bind="machineFilter">
                        <option value="0">@L["AllMachines"]</option>
                        @foreach (var machine in machines) { <option value="@machine.Id">@machine.Name (@machine.Code)</option> }
                    </select>
                    @if (machines.Count == 0)
                    {
                        <div class="alert alert-warning">@L["NoActiveMachines"]</div>
                        <div class="machine-calendar-section mb-4">
                            <h5 class="machine-calendar-section-title">@L["MachineSchedule"]</h5>
                            <div class="month-grid">
                                @foreach (var dayName in new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" })
                                {
                                    <div class="month-weekday">@L[dayName]</div>
                                }
                                @foreach (var day in MonthDays)
                                {
                                    <div class="month-day @(day.Date == DateTime.Today ? "today" : "")">
                                        <div class="month-day-number">@Persian.GetDayOfMonth(day)</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (viewMode == CalendarView.Month)
                    {
                        @foreach (var machine in machines.Where(m => IsSelectedMachine(m.Id)))
                        {
                            <div class="machine-calendar-section mb-4">
                                <h5 class="machine-calendar-section-title">@machine.Name <small>(@machine.Code)</small></h5>
                                <div class="month-grid">
                                    @foreach (var dayName in new[] { "Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri" })
                                    {
                                        <div class="month-weekday">@L[dayName]</div>
                                    }
                                    @foreach (var day in CalendarDays)
                                    {
                                        <div class="month-day @(day.Date == DateTime.Today ? "today" : "")"
                                             @onclick="() => DropOperation(machine.Id, day.Date.AddHours(8))"
                                             @ondragover:preventDefault="true"
                                             @ondrop:preventDefault="true"
                                             @ondrop="() => DropOperation(machine.Id, day.Date.AddHours(8))">
                                            <div class="month-day-number">@Persian.GetDayOfMonth(day)</div>
                                            @foreach (var slot in DaySchedules(day, machine.Id))
                                            {
                                                <div class="month-order-chip @ShiftColor(slot.PlannedStart)"
                                                     draggable="@canEdit"
                                                     @ondragstart="() => StartScheduledDrag(slot.ProductionOperationId)"
                                                     title="@slot.ProductionOperation.Name"
                                                     @onclick:stopPropagation="true"
                                                     @onclick="() => SelectOperation(slot.ProductionOperationId)">
                                                    <strong>@slot.ProductionOperation.ProductionOrder.OrderNumber</strong>
                                                    <span>@slot.ProductionOperation.Name</span>
                                                    <small>@slot.PlannedStart.ToString("HH:mm")–@slot.PlannedEnd.ToString("HH:mm")</small>
                                                    <small>@DurationLabel(ProductionPlanningTime.OperationMinutes(slot.ProductionOperation.PlannedHours))</small>
                                                    @if (canEdit)
                                                    {
                                                        <button type="button" class="machine-unschedule-button"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => UnscheduleOperation(slot.ProductionOperationId)">@L["ReturnToQueue"]</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var machine in machines.Where(m => IsSelectedMachine(m.Id)))
                        {
                            <div class="machine-calendar-section mb-4">
                                <h5 class="machine-calendar-section-title">@machine.Name <small>(@machine.Code)</small></h5>
                                <div class="timeline-scroll">
                                    <div class="timeline" style="--day-count:@CalendarDays.Count()">
                                        <div class="timeline-time-head"></div>
                                        @foreach (var day in CalendarDays)
                                        {
                                            <div class="timeline-day-head"><strong>@Persian.GetDayOfMonth(day)</strong><small>@FormatDay(day)</small></div>
                                        }
                                        @for (var hour = 0; hour < 24; hour++)
                                        {
                                            var slotHour = hour;
                                            <div class="timeline-hour">@hour.ToString("00"):00</div>
                                            @foreach (var day in CalendarDays)
                                            {
                                                <div class="timeline-slot @ShiftClass(hour)"
                                                     @onclick="() => DropOperation(machine.Id, day.Date.AddHours(slotHour))"
                                                     @ondragover:preventDefault="true"
                                                     @ondrop:preventDefault="true"
                                                     @ondrop="() => DropOperation(machine.Id, day.Date.AddHours(slotHour))">
                                                    @foreach (var slot in HourSchedules(day, hour, machine.Id))
                                                    {
                                                        <div class="timeline-order @ShiftColor(slot.PlannedStart)"
                                                             draggable="@canEdit"
                                                             @ondragstart="() => StartScheduledDrag(slot.ProductionOperationId)"
                                                             @onclick:stopPropagation="true"
                                                             @onclick="() => SelectOperation(slot.ProductionOperationId)"
                                                             title="@slot.ProductionOperation.Name">
                                                            <strong>@slot.ProductionOperation.ProductionOrder.OrderNumber</strong>
                                                            <span>@slot.ProductionOperation.Name</span>
                                                            <small>@slot.PlannedStart.ToString("HH:mm")–@slot.PlannedEnd.ToString("HH:mm")</small>
                                                            <small>@DurationLabel(ProductionPlanningTime.OperationMinutes(slot.ProductionOperation.PlannedHours))</small>
                                                            @if (canEdit)
                                                            {
                                                                <button type="button" class="machine-unschedule-button"
                                                                        @onclick:stopPropagation="true"
                                                                        @onclick="() => UnscheduleOperation(slot.ProductionOperationId)">@L["ReturnToQueue"]</button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    <p class="small text-muted">@L["DragOperationHelp"]</p>
                </div></div>
            </section>
        </div>
    }
</div>

@code {
    private long? selectedOperationId;
    private long? draggedOperationId;
    private long? draggedScheduledOperationId;
    private long? draggedScheduledOrderId;

    private void SelectOperation(long id) => selectedOperationId = id;

    private void SelectDraggedOperation(long id)
    {
        if (!canEdit) return;
        selectedOperationId = id;
        draggedOperationId = id;
        draggedScheduledOperationId = null;
        draggedScheduledOrderId = null;
    }

    private void StartScheduledDrag(long id)
    {
        if (!canEdit) return;
        selectedOperationId = id;
        draggedOperationId = id;
        draggedScheduledOperationId = id;
        draggedScheduledOrderId = null;
    }

    private void StartScheduledOrderDrag(long orderId)
    {
        if (!canEdit) return;
        draggedScheduledOrderId = orderId;
        draggedScheduledOperationId = null;
        draggedOperationId = null;
    }

    private async Task DropOperation(int machineId, DateTime start)
    {
        if (!canEdit || draggedScheduledOrderId.HasValue) return;
        var id = draggedOperationId ?? selectedOperationId;
        draggedOperationId = null;
        draggedScheduledOperationId = null;
        draggedScheduledOrderId = null;
        if (!id.HasValue) return;

        machineChoices[id.Value] = machineId;
        startChoices[id.Value] = start.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        await Schedule(id.Value);
    }

    private async Task DropBackToQueue()
    {
        if (!canEdit) return;
        var orderId = draggedScheduledOrderId;
        var operationId = draggedScheduledOperationId;
        draggedOperationId = null;
        draggedScheduledOperationId = null;
        draggedScheduledOrderId = null;

        if (orderId.HasValue) await UnscheduleOrder(orderId.Value);
        else if (operationId.HasValue) await UnscheduleOperation(operationId.Value);
    }

    private async Task UnscheduleOperation(long operationId)
    {
        if (!canEdit) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var step = await db.ProductionOperations.FirstOrDefaultAsync(x => x.Id == operationId);
        if (step == null) return;

        // Downstream planned steps depend on this step. Return them too, never silently
        // invalidate released, running or completed machine assignments.
        var downstreamIds = await db.ProductionOperations
            .Where(x => x.ProductionOrderId == step.ProductionOrderId && x.Sequence >= step.Sequence)
            .Select(x => x.Id).ToListAsync();
        var active = await db.ProductionSchedules
            .Where(x => downstreamIds.Contains(x.ProductionOperationId) && x.Status != ScheduleStatus.Cancelled)
            .ToListAsync();
        if (active.Any(x => x.Status != ScheduleStatus.Planned))
        {
            message = L["CannotUnscheduleActive"];
            return;
        }

        foreach (var item in active) item.Status = ScheduleStatus.Cancelled;
        await db.SaveChangesAsync();
        selectedOperationId = operationId;
        message = L["OperationsReturnedToQueue"];
        await Reload();
    }

    private async Task UnscheduleOrder(long orderId)
    {
        if (!canEdit) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var stepIds = await db.ProductionOperations.Where(x => x.ProductionOrderId == orderId)
            .Select(x => x.Id).ToListAsync();
        var active = await db.ProductionSchedules.Where(x => stepIds.Contains(x.ProductionOperationId)
            && x.Status != ScheduleStatus.Cancelled).ToListAsync();
        if (active.Any(x => x.Status != ScheduleStatus.Planned))
        {
            message = L["CannotUnscheduleActive"];
            return;
        }
        foreach (var item in active) item.Status = ScheduleStatus.Cancelled;
        await db.SaveChangesAsync();
        selectedOperationId = null;
        draggedScheduledOperationId = null;
        draggedScheduledOrderId = null;
        draggedOperationId = null;
        message = L["OperationsReturnedToQueue"];
        await Reload();
    }

    private int OrderStepMinutes(long orderId) => operations
        .Where(x => x.ProductionOrderId == orderId)
        .Sum(x => ProductionPlanningTime.OperationMinutes(x.PlannedHours));
    private int OrderScheduledCount(long orderId) => schedules
        .Count(s => s.ProductionOperation.ProductionOrderId == orderId);
    private int OrderOperationCount(long orderId) => operations
        .Count(x => x.ProductionOrderId == orderId);
    private static string DurationLabel(int minutes) =>
        $"{minutes / 60m:0.##}h ({minutes} min)";
    private string ShiftClass(int hour) => hour >= 8 && hour < 13 || hour >= 14 && hour < 17 ? "work" : hour == 13 ? "break" : hour >= 17 && hour < 22 ? "overtime" : "night";
    private string FormatDay(DateTime date) => L.IsPersian ? $"{Persian.GetYear(date)}/{Persian.GetMonth(date):00}/{Persian.GetDayOfMonth(date):00}" : date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private IEnumerable<ProductionSchedule> HourSchedules(DateTime day, int hour, int machineId) =>
        schedules.Where(s => s.MachineId == machineId &&
            ScheduleVisibleDuring(s, day.Date.AddHours(hour), day.Date.AddHours(hour + 1)))
            .OrderBy(s => s.PlannedStart);

    private static bool ScheduleVisibleDuring(ProductionSchedule schedule, DateTime start, DateTime end)
    {
        var order = schedule.ProductionOperation.ProductionOrder;
        return ProductionPlanningTime.HasProductiveTime(schedule.PlannedStart, schedule.PlannedEnd,
            order.AvoidOvertime, order.AvoidNightShift, start, end);
    }
    private bool IsSelectedMachine(int id) => machineFilter == 0 || machineFilter == id;
    private bool canView;
    private bool canEdit;
    private string? message;
    private int machineFilter;
    private CalendarView viewMode = CalendarView.Month;
    private enum CalendarView { Month, Week, Day }
    private DateTime Anchor => viewMode == CalendarView.Week ? selectedDate.Date.AddDays(-(((int)selectedDate.DayOfWeek + 1) % 7)) : selectedDate.Date;
    private IEnumerable<DateTime> CalendarDays => viewMode switch
    {
        CalendarView.Day => new[] { selectedDate.Date },
        CalendarView.Week => Enumerable.Range(0, 7).Select(i => Anchor.AddDays(i)),
        _ => MonthDays
    };
    private IEnumerable<DateTime> MonthDays
    {
        get
        {
            var first = new DateTime(Persian.GetYear(selectedDate), Persian.GetMonth(selectedDate), 1, Persian);
            var offset = ((int)first.DayOfWeek + 1) % 7;
            return Enumerable.Range(0, 42).Select(i => first.AddDays(i - offset));
        }
    }
    private void ShiftPeriod(int direction) => selectedDate = viewMode == CalendarView.Month ? Persian.AddMonths(selectedDate, direction) : selectedDate.AddDays(direction * (viewMode == CalendarView.Week ? 7 : 1));
    private void ChooseDay(DateTime day) { selectedDate = day; viewMode = CalendarView.Day; }
    private string ShiftColor(DateTime date) => date.Hour >= 8 && date.Hour < 17 ? "order-work" : date.Hour >= 17 && date.Hour < 22 ? "order-overtime" : "order-night";
    private IEnumerable<ProductionSchedule> DaySchedules(DateTime day, int machineId) =>
        schedules.Where(s => s.MachineId == machineId &&
            ScheduleVisibleDuring(s, day.Date, day.Date.AddDays(1))).OrderBy(s => s.PlannedStart);

    private DateTime selectedDate = DateTime.Today;
    private long newOrderId;
    private string newOperationName = "";
    private decimal newHours = 1m;
    private List<Machine> machines = new();
    private List<ProductionOrder> orders = new();
    private List<ProductionOperation> operations = new();
    private List<ProductionSchedule> schedules = new();
    private Dictionary<long, int> machineChoices = new();
    private Dictionary<long, string> startChoices = new();
    private Dictionary<long, string> durationChoices = new();
    private static readonly PersianCalendar Persian = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        canEdit = user.Identity?.IsAuthenticated == true && (user.IsInRole("Administrator") ||
            user.IsInRole("ProductionManager") || user.IsInRole("Production Manager") || user.IsInRole("Manager"));
        canView = canEdit || (user.Identity?.IsAuthenticated == true &&
            (user.IsInRole("FloorManager") || user.IsInRole("Floor Manager") || user.IsInRole("Production")));
        if (canView) await Reload();
    }

    private async Task Reload()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        machines = await db.Machines.Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        orders = await db.ProductionOrders.Include(x => x.SalesOrder).ThenInclude(x => x.Quotation)
            .ThenInclude(x => x.SalesRequest).OrderBy(x => x.PlannedEndDate).ToListAsync();
        operations = await db.ProductionOperations.Include(x => x.ProductionOrder)
            .OrderBy(x => x.ProductionOrderId).ThenBy(x => x.Sequence).ToListAsync();
        schedules = await db.ProductionSchedules.Include(x => x.ProductionOperation)
            .ThenInclude(x => x.ProductionOrder).Where(x => x.Status != ScheduleStatus.Cancelled).ToListAsync();
    }

    private string FormatDate(DateTime? value)
    {
        if (!value.HasValue) return "—";
        var v = value.Value;
        return L.IsPersian
            ? $"{Persian.GetYear(v)}/{Persian.GetMonth(v):00}/{Persian.GetDayOfMonth(v):00} {v:HH:mm}"
            : v.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private void SetMachineChoice(long operationId, string? value) =>
        machineChoices[operationId] = int.TryParse(value, out var machineId) ? machineId : 0;

    private void SetStartChoice(long operationId, string? value) =>
        startChoices[operationId] = value ?? string.Empty;

    private string DurationInput(ProductionOperation operation) =>
        durationChoices.GetValueOrDefault(operation.Id,
            operation.PlannedHours.ToString("0.######", CultureInfo.InvariantCulture));

    private void SetDurationInput(long operationId, string? value) =>
        durationChoices[operationId] = value ?? string.Empty;

    private async Task SaveOperationDuration(long operationId)
    {
        if (!canEdit || !durationChoices.TryGetValue(operationId, out var input) ||
            !decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out var hours) ||
            hours <= 0)
        {
            message = L["InvalidStepDuration"];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var operation = await db.ProductionOperations.FirstOrDefaultAsync(x => x.Id == operationId);
        if (operation == null || operation.Status is ProductionOperationStatus.Running
            or ProductionOperationStatus.Completed or ProductionOperationStatus.Cancelled)
        {
            message = L["CannotChangeActiveSchedule"];
            return;
        }

        var order = await db.ProductionOrders.FirstOrDefaultAsync(x => x.Id == operation.ProductionOrderId);
        if (order == null) return;
        var steps = await db.ProductionOperations.Where(x => x.ProductionOrderId == order.Id)
            .OrderBy(x => x.Sequence).ToListAsync();
        var ids = steps.Select(x => x.Id).ToList();
        if (await db.ProductionSchedules.AnyAsync(x => ids.Contains(x.ProductionOperationId)
            && x.Status != ScheduleStatus.Cancelled))
        {
            message = L["UnscheduleBeforeAdjusting"];
            return;
        }

        var minutes = (int)Math.Round(hours * 60m, MidpointRounding.AwayFromZero);
        if (minutes < 1 || minutes > order.EstimatedDurationMinutes - (steps.Count - 1))
        {
            message = L["StepDurationBudget"];
            return;
        }

        var others = steps.Where(x => x.Id != operationId).ToList();
        var remaining = order.EstimatedDurationMinutes - minutes;
        if (others.Count == 0 && remaining != 0)
        {
            message = L["StepDurationBudget"];
            return;
        }
        var rest = ProductionPlanningTime.AllocateOperationMinutes(
            remaining, others.Select(x => x.PlannedHours).ToArray());
        operation.PlannedHours = Math.Round(minutes / 60m, 6);
        for (var i = 0; i < others.Count; i++)
            others[i].PlannedHours = Math.Round(rest[i] / 60m, 6);

        await db.SaveChangesAsync();
        durationChoices.Remove(operationId);
        message = L["OperationsRebalanced"];
        await Reload();
    }

    private int MachineChoice(long id) => machineChoices.GetValueOrDefault(id);
    private string StartChoice(long id) => startChoices.GetValueOrDefault(id, "");

    // Machine names are routing recommendations. Actual machine choice remains editable.
    private static IEnumerable<string> RouteService(string service, bool sheet)
    {
        if (string.IsNullOrWhiteSpace(service)) yield break;
        if (service.Contains("سلفون") || service.Contains("لمینیت") || service.Contains("laminat", StringComparison.OrdinalIgnoreCase))
            yield return "Wenchun | Lamination / film";
        else if (service.Contains("یووی") || service.Contains("UV", StringComparison.OrdinalIgnoreCase))
            yield return "Tops 102 / Heidelberg | Spot UV";
        else if (service.Contains("جعبه‌چسبانی") || service.Contains("چسبانی"))
            yield return "Folder-gluer | Folding and assembly";
        else if (service.Contains("برش و بسته‌بندی"))
            yield return "Polar | Cutting and packing";
        else if (service.Contains("قالب") || service.Contains("دیلن"))
            yield return sheet ? "SBL | Die cutting" : "Nilpeter | Rotary / flat die";
        else
            yield return "Review | " + service;
    }

    private static bool CompatibleMachine(string operationName, Machine machine)
    {
        var name = (machine.Name + " " + machine.Code).ToLowerInvariant();
        var operation = operationName.ToLowerInvariant();
        if (operation.StartsWith("polar")) return name.Contains("polar") || name.Contains("guillotine");
        if (operation.StartsWith("heidelberg")) return name.Contains("heidelberg");
        if (operation.StartsWith("nilpeter")) return name.Contains("nilpeter");
        if (operation.StartsWith("wenchun")) return name.Contains("wenchun");
        if (operation.StartsWith("tops 102 / heidelberg")) return name.Contains("tops") || name.Contains("heidelberg");
        if (operation.StartsWith("sbl")) return name.Contains("sbl");
        if (operation.StartsWith("folder-gluer")) return name.Contains("folder") || name.Contains("gluer");
        if (operation.StartsWith("sakurai")) return name.Contains("sakurai");
        return true; // Unclassified work requires manual review.
    }
    private IEnumerable<Machine> SuggestedMachines(ProductionOperation operation) =>
        machines.Where(m => CompatibleMachine(operation.Name, m));

    private async Task GenerateMissingOperations()
    {
        if (!canEdit) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var workCenters = await db.ProductionWorkCenters.Where(x => x.IsActive).ToListAsync();
        var existing = await db.ProductionOperations.OrderBy(x => x.Sequence).ToListAsync();
        var scheduledIds = await db.ProductionSchedules.Where(x => x.Status != ScheduleStatus.Cancelled)
            .Select(x => x.ProductionOperationId).Distinct().ToListAsync();
        var added = 0;
        var synchronized = 0;
        var blocked = 0;
        foreach (var order in orders)
        {
            var current = existing.Where(x => x.ProductionOrderId == order.Id)
                .OrderBy(x => x.Sequence).ToList();
            if (current.Count > 0)
            {
                if (current.Any(x => scheduledIds.Contains(x.Id))) continue;
                if (order.EstimatedDurationMinutes < current.Count) { blocked++; continue; }
                if (current.Sum(x => ProductionPlanningTime.OperationMinutes(x.PlannedHours))
                    == order.EstimatedDurationMinutes) continue;
                var allocation = ProductionPlanningTime.AllocateOperationMinutes(
                    order.EstimatedDurationMinutes, current.Select(x => x.PlannedHours).ToArray());
                for (var i = 0; i < current.Count; i++)
                    current[i].PlannedHours = Math.Round(allocation[i] / 60m, 6);
                synchronized++;
                continue;
            }

            var request = order.SalesOrder?.Quotation?.SalesRequest;
            if (request == null || string.IsNullOrWhiteSpace(request.JobSpecificationJson)) continue;
            var steps = new List<string>();
            try
            {
                if (request.JobType == SalesJobType.Sheet)
                {
                    var spec = JsonSerializer.Deserialize<SheetJobSpecification>(request.JobSpecificationJson);
                    if (spec != null)
                    {
                        if (spec.BeforeCutLengthCm.HasValue || spec.BeforeCutWidthCm.HasValue || spec.CutLengthCm.HasValue || spec.CutWidthCm.HasValue)
                            steps.Add("Polar | Cutting");
                        if (!string.IsNullOrWhiteSpace(spec.PrintingNotes) || !string.IsNullOrWhiteSpace(spec.Zinc))
                            steps.Add("Heidelberg | Sheet offset printing");
                        foreach (var service in spec.SelectedServices ?? new())
                            steps.AddRange(RouteService(service, true));
                        using (var details = JsonDocument.Parse(request.JobSpecificationJson))
                        {
                            if (details.RootElement.TryGetProperty("FinishType", out var finish) && finish.ValueKind == JsonValueKind.String)
                            {
                                var finishText = finish.GetString() ?? "";
                                if (finishText.Contains("screen", StringComparison.OrdinalIgnoreCase) || finishText.Contains("سیلک")) steps.Add("Sakurai | Screen printing");
                                if (finishText.Contains("cylinder", StringComparison.OrdinalIgnoreCase) || finishText.Contains("سیلندر")) steps.Add("Heidelberg | Cylinder coating");
                            }
                        }
                        if (!string.IsNullOrWhiteSpace(spec.Die))
                            steps.Add("SBL | Die cutting");
                    }
                }
                else if (request.JobType == SalesJobType.Roll)
                {
                    var spec = JsonSerializer.Deserialize<RollJobSpecification>(request.JobSpecificationJson);
                    if (spec != null)
                    {
                        if (spec.ColorCount.GetValueOrDefault() > 0 || !string.IsNullOrWhiteSpace(spec.PrintingNotes))
                            steps.Add("Nilpeter | Roll offset/flexo printing");
                        foreach (var service in spec.SelectedServices ?? new())
                            steps.AddRange(RouteService(service, false));
                        if (spec.MachineGluing)
                            steps.Add("Folder-gluer | Machine gluing");
                        else if (spec.HandGluing)
                            steps.Add("Manual | Hand gluing");
                    }
                }
            }
            catch (JsonException) { continue; }
            var uniqueSteps = steps.Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (uniqueSteps.Count == 0) continue;
            if (order.EstimatedDurationMinutes < uniqueSteps.Count) { blocked++; continue; }

            var durations = ProductionPlanningTime.AllocateOperationMinutes(
                order.EstimatedDurationMinutes, uniqueSteps.Select(_ => 1m).ToArray());
            for (var i = 0; i < uniqueSteps.Count; i++)
            {
                var step = uniqueSteps[i];
                var center = workCenters.FirstOrDefault(x => string.Equals(x.Name, step, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(x.Code, step, StringComparison.OrdinalIgnoreCase));
                db.ProductionOperations.Add(new ProductionOperation
                {
                    ProductionOrderId = order.Id, Sequence = i + 1, Name = step,
                    WorkCenterId = center?.Id, PlannedHours = Math.Round(durations[i] / 60m, 6),
                    Status = ProductionOperationStatus.Pending
                });
                added++;
            }
        }

        await db.SaveChangesAsync();
        message = blocked > 0 ? L["DurationTooShortForSteps"]
            : added + synchronized > 0 ? L["OperationsGenerated"] : L["NoRoutingFound"];
        await Reload();
    }

    private async Task AddOperation()
    {
        if (!canEdit || newOrderId == 0 || string.IsNullOrWhiteSpace(newOperationName) || newHours <= 0)
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var order = await db.ProductionOrders.FirstOrDefaultAsync(x => x.Id == newOrderId);
        if (order == null) return;
        var existing = await db.ProductionOperations.Where(x => x.ProductionOrderId == newOrderId)
            .OrderBy(x => x.Sequence).ToListAsync();
        var ids = existing.Select(x => x.Id).ToList();
        if (await db.ProductionSchedules.AnyAsync(x => ids.Contains(x.ProductionOperationId)
            && x.Status != ScheduleStatus.Cancelled))
        {
            message = L["UnscheduleBeforeAdding"];
            return;
        }
        if (order.EstimatedDurationMinutes < existing.Count + 1)
        {
            message = L["DurationTooShortForSteps"];
            return;
        }

        var weights = existing.Select(x => x.PlannedHours).Append(newHours).ToArray();
        var duration = ProductionPlanningTime.AllocateOperationMinutes(order.EstimatedDurationMinutes, weights);
        for (var i = 0; i < existing.Count; i++)
            existing[i].PlannedHours = Math.Round(duration[i] / 60m, 6);
        db.ProductionOperations.Add(new ProductionOperation
        {
            ProductionOrderId = newOrderId, Sequence = (existing.LastOrDefault()?.Sequence ?? 0) + 1,
            Name = newOperationName.Trim(), PlannedHours = Math.Round(duration[^1] / 60m, 6),
            Status = ProductionOperationStatus.Pending
        });

        await db.SaveChangesAsync();
        newOperationName = "";
        message = L["OperationsRebalanced"];
        await Reload();
    }

    private async Task Schedule(long operationId)
    {
        if (!canEdit || !machineChoices.TryGetValue(operationId, out var machineId) || machineId == 0 ||
            !startChoices.TryGetValue(operationId, out var startText) ||
            !DateTime.TryParse(startText, CultureInfo.InvariantCulture, DateTimeStyles.None, out var requestedStart))
        {
            message = L["SelectMachineAndTime"];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var operation = await db.ProductionOperations.Include(x => x.ProductionOrder)
            .FirstOrDefaultAsync(x => x.Id == operationId);
        if (operation == null || !await db.Machines.AnyAsync(x => x.Id == machineId && x.IsActive))
            return;
        var assignedMachine = machines.FirstOrDefault(x => x.Id == machineId);
        if (assignedMachine == null || !CompatibleMachine(operation.Name, assignedMachine))
        {
            message = L["MachineMismatch"];
            return;
        }

        var order = operation.ProductionOrder;
        if (!order.PlannedStartDate.HasValue || !order.PlannedEndDate.HasValue)
        {
            message = L["CeoPlanRequired"];
            return;
        }

        var steps = await db.ProductionOperations.Where(x => x.ProductionOrderId == order.Id)
            .OrderBy(x => x.Sequence).ToListAsync();
        if (steps.Sum(x => ProductionPlanningTime.OperationMinutes(x.PlannedHours))
            != order.EstimatedDurationMinutes)
        {
            message = L["MachineDurationMismatch"];
            return;
        }

        var start = ProductionPlanningTime.NextAllowedProductionMinute(
            requestedStart, order.AvoidOvertime, order.AvoidNightShift);
        var end = ProductionPlanningTime.CalculateEndDateTime(start,
            ProductionPlanningTime.OperationMinutes(operation.PlannedHours),
            order.AvoidOvertime, order.AvoidNightShift);
        if (start < order.PlannedStartDate.Value || end > order.PlannedEndDate.Value)
        {
            message = L["MachineOutsideCeoWindow"];
            return;
        }

        var current = await db.ProductionSchedules.Where(x => x.ProductionOperationId == operationId
            && x.Status != ScheduleStatus.Cancelled).ToListAsync();
        if (current.Any(x => x.Status != ScheduleStatus.Planned))
        {
            message = L["CannotChangeActiveSchedule"];
            return;
        }
        var otherMachineSteps = await db.ProductionSchedules
            .Include(x => x.ProductionOperation).ThenInclude(x => x.ProductionOrder)
            .Where(x => x.MachineId == machineId && x.ProductionOperationId != operationId &&
                x.Status != ScheduleStatus.Cancelled && x.PlannedStart < end && x.PlannedEnd > start)
            .ToListAsync();
        if (otherMachineSteps.Any(x => ProductionPlanningTime.ProductiveConflict(
            start, end, order.AvoidOvertime, order.AvoidNightShift,
            x.PlannedStart, x.PlannedEnd,
            x.ProductionOperation.ProductionOrder.AvoidOvertime,
            x.ProductionOperation.ProductionOrder.AvoidNightShift)))
        {
            message = L["MachineConflict"];
            return;
        }

        var beforeIds = steps.Where(x => x.Sequence < operation.Sequence).Select(x => x.Id).ToList();
        var afterIds = steps.Where(x => x.Sequence > operation.Sequence).Select(x => x.Id).ToList();
        var dependencySchedules = await db.ProductionSchedules.Where(x =>
            (beforeIds.Contains(x.ProductionOperationId) || afterIds.Contains(x.ProductionOperationId)) &&
            x.Status != ScheduleStatus.Cancelled).ToListAsync();
        if (beforeIds.Any(id => !dependencySchedules.Any(x => x.ProductionOperationId == id
            && x.PlannedEnd <= start)) ||
            dependencySchedules.Any(x => afterIds.Contains(x.ProductionOperationId) && x.PlannedStart < end))
        {
            message = L["OperationSequenceConflict"];
            return;
        }

        if (current.Count > 0)
        {
            current[0].MachineId = machineId;
            current[0].PlannedStart = start;
            current[0].PlannedEnd = end;
            foreach (var duplicate in current.Skip(1))
                duplicate.Status = ScheduleStatus.Cancelled;
        }
        else
        {
            db.ProductionSchedules.Add(new ProductionSchedule
            {
                ProductionOperationId = operationId,
                MachineId = machineId,
                PlannedStart = start,
                PlannedEnd = end,
                Status = ScheduleStatus.Planned
            });
        }
        await db.SaveChangesAsync();
        selectedOperationId = operationId;
        message = L["OperationScheduled"];
        await Reload();
    }
}
