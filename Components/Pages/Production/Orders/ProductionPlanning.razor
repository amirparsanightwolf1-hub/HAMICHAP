@page "/production/planning"
@using System.Globalization
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject LocalizationService L

<PageTitle>@L["CeoDeadlineCalendar"]</PageTitle>
<div class="page-container">
    <div class="erp-page-header">
        <div>
            <h2 class="erp-page-title">@L["CeoDeadlineCalendar"]</h2>
            <p class="erp-page-subtitle">@L["CeoDeadlineHelp"]</p>
        </div>
    </div>
    @if (!allowed)
    {
        <div class="alert alert-warning">@L["AccessDenied"]</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(message)) { <div class="alert alert-info">@message</div> }
        <div class="card">
            <div class="card-header">@L["ProductionOrders"]</div>
            <div class="card-body table-responsive">
                <table class="table table-hover">
                    <thead><tr><th>@L["OrderNumber"]</th><th>@L["Customer"]</th><th>@L["DueDate"]</th><th>@L["Action"]</th></tr></thead>
                    <tbody>
                    @foreach (var item in orders)
                    {
                        <tr>
                            <td>@item.OrderNumber</td>
                            <td>@item.SalesOrder?.Customer?.Name</td>
                            <td>
                                <input class="form-control" type="date" aria-label="@L["DueDate"]"
                                       value="@DateValue(item.PlannedEndDate)"
                                       @onchange="e => SetDueDate(item.Id, e.Value?.ToString())" />
                                <small class="text-muted">@FormatPersianDate(item.PlannedEndDate)</small>
                            </td>
                            <td><button class="btn btn-primary btn-sm" @onclick="() => SaveDeadline(item.Id)">@L["SaveDeadline"]</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool allowed;
    private string? message;
    private List<ProductionOrder> orders = new();
    private readonly Dictionary<long, DateTime?> edited = new();
    private static readonly PersianCalendar Persian = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        allowed = user.Identity?.IsAuthenticated == true &&
            (user.IsInRole("Administrator") || user.IsInRole("CEO") || user.IsInRole("Ceo"));
        if (!allowed) return;
        await Reload();
    }

    private async Task Reload()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        orders = await db.ProductionOrders
            .Include(x => x.SalesOrder).ThenInclude(x => x.Customer)
            .OrderBy(x => x.PlannedEndDate).ThenBy(x => x.OrderNumber).ToListAsync();
    }

    private static string DateValue(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
    private string FormatPersianDate(DateTime? value) =>
        !value.HasValue ? "" : L.IsPersian
            ? $"{Persian.GetYear(value.Value)}/{Persian.GetMonth(value.Value):00}/{Persian.GetDayOfMonth(value.Value):00}"
            : DateValue(value);

    private void SetDueDate(long id, string? value)
    {
        edited[id] = DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var parsed) ? parsed : null;
    }

    private async Task SaveDeadline(long id)
    {
        if (!edited.TryGetValue(id, out var due) || !due.HasValue)
        {
            message = L["SelectDueDate"];
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var order = await db.ProductionOrders.FindAsync(id);
        if (order == null) return;
        order.PlannedEndDate = due.Value;
        await db.SaveChangesAsync();
        message = L["DeadlineSaved"];
        await Reload();
    }
}
