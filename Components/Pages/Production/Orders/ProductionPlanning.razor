@page "/production/planning"
@inject LocalizationService L

@using System.Globalization
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Production
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db

<PageTitle>@L["Production Planning"]</PageTitle>

<div class="page-container production-planning">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border"></div></div>
    }
    else
    {
        <div class="erp-page-header mb-4">
            <div>
                <div class="erp-page-title">@L["Production Planning"]</div>
                <div class="erp-page-subtitle">
                    @L["Select an order from the queue, then click a calendar slot or drag it onto the calendar."]
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary" @onclick="GoToToday">@L["Today"]</button>
            </div>
        </div>

        <div class="planning-layout">
            <aside class="planning-order-panel">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@L["Production orders"]</strong>
                        <span class="badge bg-secondary">@orderQueue.Count</span>
                    </div>
                    <div class="card-body order-queue">
                        <p class="small text-muted">@L["Select an order, then click a calendar slot, or drag it onto the calendar. Scheduled orders can also be dragged to a new start."]</p>
                        @if (orderQueue.Count == 0)
                        {
                            <div class="text-muted small">@L["There are no active production orders."]</div>
                        }
                        @foreach (var order in orderQueue)
                        {
                            <div class="queue-order @(selectedOrderId == order.Id ? "queue-order-selected" : "")"
                                 draggable="true"
                                 @ondragstart="() => StartDrag(order.Id)"
                                 @onclick="() => SelectOrder(order.Id)">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>@order.OrderNumber</strong>
                                    <small>@(order.PlannedStartDate.HasValue ? "Scheduled" : "Unscheduled")</small>
                                </div>
                                <div class="small text-muted">@order.SalesOrder?.Customer?.Name</div>
                                <div class="small">Duration: @FormatDuration(order.EstimatedDurationMinutes)</div>
                                <div class="small text-muted">
                                    @(order.AvoidOvertime ? "Avoids overtime" : "Overtime allowed")
                                    <span> · </span>
                                    @(order.AvoidNightShift ? "Avoids night shift" : "Night shift allowed")
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><strong>@L["Order settings"]</strong></div>
                    <div class="card-body">
                        @if (selectedOrder == null)
                        {
                            <div class="text-muted small">@L["Select an order first."]</div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <strong>@selectedOrder.OrderNumber</strong>
                                <label class="form-label mt-2">@L["Estimated duration (hours)"]</label>
                                <input type="number" class="form-control" min="0.25" step="0.25" @bind="estimatedDurationHours" />
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="avoidOvertime" @bind="avoidOvertime" />
                                <label class="form-check-label" for="avoidOvertime">@L["Avoid overtime (17:00–22:00)"]</label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="avoidNight" @bind="avoidNightShift" />
                                <label class="form-check-label" for="avoidNight">@L["Avoid night shift (22:00–08:00)"]</label>
                            </div>
                            <button class="btn btn-outline-primary btn-sm w-100" @onclick="SaveOrderSettings">@L["Save settings"]</button>
                            <div class="small text-muted mt-2">@L["The lunch break is always excluded. Prohibited shifts are skipped and are not shown as active production time."]</div>
                        }
                    </div>
                </div>
            </aside>

            <section class="planning-calendar-panel">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPeriod">‹</button>
                        <h5 class="mb-0">@PeriodTitle</h5>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPeriod">›</button>
                    </div>
                    <div class="btn-group" role="group">
                        <button class="btn @(viewMode == CalendarView.Month ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(CalendarView.Month)">@L["Month"]</button>
                        <button class="btn @(viewMode == CalendarView.Week ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(CalendarView.Week)">@L["Week"]</button>
                        <button class="btn @(viewMode == CalendarView.Day ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(CalendarView.Day)">@L["Day"]</button>
                    </div>
                </div>

                <div class="shift-legend mb-3">
                    <span><i class="shift-dot work"></i> @L["Regular work 08:00–13:00 / 14:00–17:00"]</span>
                    <span><i class="shift-dot break"></i> @L["Break 13:00–14:00"]</span>
                    <span><i class="shift-dot overtime"></i> @L["Overtime 17:00–22:00"]</span>
                    <span><i class="shift-dot night"></i> @L["Night 22:00–08:00"]</span>
                </div>

                @if (viewMode == CalendarView.Month)
                {
                    <div class="month-grid">
                        @foreach (var dayName in PersianWeekDays)
                        {
                            <div class="month-weekday">@dayName</div>
                        }
                        @foreach (var date in MonthDates)
                        {
                            var isCurrentMonth = Persian.GetMonth(date) == Persian.GetMonth(displayMonth) &&
                                                 Persian.GetYear(date) == Persian.GetYear(displayMonth);
                            <div class="month-day @(isCurrentMonth ? "" : "outside-month") @(date.Date == DateTime.Today ? "today" : "")"
                                 @onclick="() => PlaceSelectedOrder(date.Date, new TimeSpan(8, 0, 0))"
                                 @ondragover:preventDefault="true"
                                 @ondrop:preventDefault="true"
                                 @ondrop="() => DropOrder(date.Date, new TimeSpan(8, 0, 0))">
                                <div class="month-day-number">@Persian.GetDayOfMonth(date)</div>
                                @foreach (var order in OrdersForDate(date))
                                {
                                    <div class="month-order-chip @OrderColor(order)"
                                         draggable="true"
                                         title="@OrderTooltip(order)"
                                         @ondragstart="() => StartDrag(order.Id)"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => SelectOrder(order.Id)">
                                        @order.OrderNumber
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="small text-muted mt-2">@L["In Month view, click or drop an order on a date to schedule it from 08:00. Use Week or Day view to choose a specific start time."]</div>
                }
                else
                {
                    <div class="timeline-scroll">
                        <div class="timeline" style="--day-count:@VisibleDates.Count">
                            <div class="timeline-time-head"></div>
                            @foreach (var date in VisibleDates)
                            {
                                <div class="timeline-day-head">
                                    <strong>@Persian.GetDayOfMonth(date)</strong>
                                    <small>@PersianMonthNames[Persian.GetMonth(date) - 1]</small>
                                </div>
                            }

                            @for (var hour = 0; hour < 24; hour++)
                            {
                                <div class="timeline-hour">@hour.ToString("00"):00</div>
                                @foreach (var date in VisibleDates)
                                {
                                    var slotOrders = OrdersForHour(date, hour);
                                    <div class="timeline-slot @ShiftClass(hour)"
                                         title="@ShiftName(hour) — click or drop to schedule"
                                         @onclick="() => PlaceSelectedOrder(date.Date, TimeSpan.FromHours(hour))"
                                         @ondragover:preventDefault="true"
                                         @ondrop:preventDefault="true"
                                         @ondrop="() => DropOrder(date.Date, TimeSpan.FromHours(hour))">
                                        @foreach (var order in slotOrders)
                                        {
                                            <div class="timeline-order @OrderColor(order)"
                                                 draggable="true"
                                                 title="@OrderTooltip(order)"
                                                 @ondragstart="() => StartDrag(order.Id)"
                                                 @onclick:stopPropagation="true"
                                                 @onclick="() => SelectOrder(order.Id)">
                                                @order.OrderNumber
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="small text-muted mt-2">@L["Click a time slot or drop an order onto it to set the start time. Multiple orders may occupy the same time slot."]</div>
                }
            </div>
        </div>
            </section>
        </div>
    }
</div>


@code {
    private static readonly PersianCalendar Persian = new();
    private static readonly string[] PersianWeekDays = { "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
    private static readonly string[] PersianMonthNames = { "Farvardin", "Ordibehesht", "Khordad", "Tir", "Mordad", "Shahrivar", "Mehr", "Aban", "Azar", "Dey", "Bahman", "Esfand" };

    private ProductionOrder? selectedOrder;
    private List<ProductionOrder> orderQueue = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;
    private CalendarView viewMode = CalendarView.Month;
    private DateTime displayMonth = DateTime.Today;
    private DateTime displayDate = DateTime.Today;
    private long? selectedOrderId;
    private long? draggedOrderId;
    private decimal estimatedDurationHours = 1m;
    private bool avoidOvertime;
    private bool avoidNightShift;

    private string PeriodTitle => viewMode switch
    {
        CalendarView.Month => $"{Persian.GetYear(displayMonth)}/{Persian.GetMonth(displayMonth):00}",
        CalendarView.Week => $"{FormatJalali(VisibleDates.First())} – {FormatJalali(VisibleDates.Last())}",
        _ => FormatJalali(displayDate)
    };

    private List<DateTime> MonthDates
    {
        get
        {
            var first = new DateTime(Persian.GetYear(displayMonth), Persian.GetMonth(displayMonth), 1, Persian);
            var offset = ((int)first.DayOfWeek + 1) % 7;
            return Enumerable.Range(0, 42).Select(i => first.AddDays(-offset + i)).ToList();
        }
    }

    private List<DateTime> VisibleDates
    {
        get
        {
            if (viewMode == CalendarView.Day) return new() { displayDate.Date };
            var offset = ((int)displayDate.DayOfWeek + 1) % 7;
            var saturday = displayDate.Date.AddDays(-offset);
            return Enumerable.Range(0, 7).Select(i => saturday.AddDays(i)).ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            await ReloadQueueAsync();

            // This page is independent of any individual ProductionOrder.
            // Select an order from the queue only when the user wants to schedule it.
            selectedOrderId = null;
            selectedOrder = null;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private void SelectOrder(long orderId)
    {
        selectedOrderId = orderId;
        selectedOrder = orderQueue.FirstOrDefault(x => x.Id == orderId);
        LoadSelectedOrderSettings();
        successMessage = null;
    }

    private void LoadSelectedOrderSettings()
    {
        selectedOrder = orderQueue.FirstOrDefault(x => x.Id == selectedOrderId);
        if (selectedOrder == null) return;
        estimatedDurationHours = Math.Max(0.25m, selectedOrder.EstimatedDurationMinutes / 60m);
        avoidOvertime = selectedOrder.AvoidOvertime;
        avoidNightShift = selectedOrder.AvoidNightShift;
    }

    private async Task SaveOrderSettings()
    {
        if (selectedOrderId == null || estimatedDurationHours < 0.25m) return;

        errorMessage = null;
        successMessage = null;
        var entity = await Db.ProductionOrders.FirstOrDefaultAsync(x => x.Id == selectedOrderId.Value);
        if (entity == null) return;

        var minutes = (int)Math.Round(estimatedDurationHours * 60m, MidpointRounding.AwayFromZero);
        var changed = entity.EstimatedDurationMinutes != minutes ||
                      entity.AvoidOvertime != avoidOvertime ||
                      entity.AvoidNightShift != avoidNightShift;
        var steps = await Db.ProductionOperations.Where(x => x.ProductionOrderId == entity.Id)
            .OrderBy(x => x.Sequence).ToListAsync();
        var stepIds = steps.Select(x => x.Id).ToList();
        var hasScheduledSteps = stepIds.Count > 0 && await Db.ProductionSchedules.AnyAsync(
            x => stepIds.Contains(x.ProductionOperationId) && x.Status != ScheduleStatus.Cancelled);

        if (changed && hasScheduledSteps)
        {
            errorMessage = "This order has machine operations scheduled. Unschedule them in Machine Schedule before changing the CEO duration or shift restrictions.";
            return;
        }
        if (steps.Count > minutes)
        {
            errorMessage = "The CEO duration must allow at least one minute for each machine operation.";
            return;
        }

        entity.EstimatedDurationMinutes = minutes;
        entity.AvoidOvertime = avoidOvertime;
        entity.AvoidNightShift = avoidNightShift;

        if (steps.Count > 0 && changed)
        {
            var allocation = ProductionPlanningTime.AllocateOperationMinutes(minutes, steps.Select(x => x.PlannedHours).ToArray());
            for (var i = 0; i < steps.Count; i++)
                steps[i].PlannedHours = Math.Round(allocation[i] / 60m, 6);
        }

        if (entity.PlannedStartDate.HasValue && changed)
        {
            entity.PlannedStartDate = ProductionPlanningTime.NextAllowedProductionMinute(
                entity.PlannedStartDate.Value, avoidOvertime, avoidNightShift);
            entity.PlannedEndDate = ProductionPlanningTime.CalculateEndDateTime(
                entity.PlannedStartDate.Value, minutes, avoidOvertime, avoidNightShift);
        }

        await Db.SaveChangesAsync();
        await ReloadQueueAsync();
        SelectOrder(entity.Id);
        successMessage = "CEO duration, machine-step allocations and permitted shifts are consistent.";
    }

    private void StartDrag(long orderId)
    {
        draggedOrderId = orderId;
        SelectOrder(orderId);
    }

    private async Task DropOrder(DateTime date, TimeSpan startTime)
    {
        if (draggedOrderId.HasValue)
        {
            SelectOrder(draggedOrderId.Value);
            await ScheduleOrderAsync(draggedOrderId.Value, date.Date.Add(startTime));
            draggedOrderId = null;
        }
        else if (selectedOrderId.HasValue)
        {
            await ScheduleOrderAsync(selectedOrderId.Value, date.Date.Add(startTime));
        }
    }

    private async Task PlaceSelectedOrder(DateTime date, TimeSpan startTime)
    {
        if (!selectedOrderId.HasValue) return;
        await ScheduleOrderAsync(selectedOrderId.Value, date.Date.Add(startTime));
    }

    private async Task ScheduleOrderAsync(long orderId, DateTime requestedStart)
    {
        try
        {
            errorMessage = null;
            successMessage = null;
            var entity = await Db.ProductionOrders.FirstOrDefaultAsync(x => x.Id == orderId);
            if (entity == null) return;

            var duration = Math.Max(1, entity.EstimatedDurationMinutes);
            var actualStart = ProductionPlanningTime.NextAllowedProductionMinute(requestedStart, entity.AvoidOvertime, entity.AvoidNightShift);
            var end = ProductionPlanningTime.CalculateEndDateTime(actualStart, duration, entity.AvoidOvertime, entity.AvoidNightShift);

            var operationIds = await Db.ProductionOperations.Where(x => x.ProductionOrderId == orderId)
                .Select(x => x.Id).ToListAsync();
            if (operationIds.Count > 0 &&
                (entity.PlannedStartDate != actualStart || entity.PlannedEndDate != end) &&
                await Db.ProductionSchedules.AnyAsync(x => operationIds.Contains(x.ProductionOperationId)
                    && x.Status != ScheduleStatus.Cancelled))
            {
                errorMessage = "This order has scheduled machine operations. Unschedule its machine steps before moving it on the CEO calendar.";
                return;
            }

            entity.PlannedStartDate = actualStart;
            entity.PlannedEndDate = end;
            await Db.SaveChangesAsync();

            await ReloadQueueAsync();
            SelectOrder(orderId);
            successMessage = $"{entity.OrderNumber} scheduled: {FormatJalaliDateTime(requestedStart)} – {FormatJalaliDateTime(end)}. Break time is excluded.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private List<ProductionOrder> OrdersForDate(DateTime date)
    {
        var dayStart = date.Date;
        var dayEnd = dayStart.AddDays(1);
        return orderQueue
            .Where(order => IsOrderActiveDuring(order, dayStart, dayEnd))
            .ToList();
    }

    private List<ProductionOrder> OrdersForHour(DateTime date, int hour)
    {
        // Reject shift windows that this specific order is not permitted to use.
        // The lunch break is never an active production slot.
        return orderQueue.Where(order =>
        {
            if (!order.PlannedStartDate.HasValue || !order.PlannedEndDate.HasValue)
                return false;

            var allowedHour =
                (hour >= 8 && hour < 13) ||
                (hour >= 14 && hour < 17) ||
                (hour >= 17 && hour < 22 && !order.AvoidOvertime) ||
                ((hour >= 22 || hour < 8) && !order.AvoidNightShift);

            if (!allowedHour)
                return false;

            var slotStart = date.Date.AddHours(hour);
            var slotEnd = slotStart.AddHours(1);

            return order.PlannedStartDate.Value < slotEnd &&
                   order.PlannedEndDate.Value > slotStart;
        }).ToList();
    }

    private static List<(DateTime Start, DateTime End)> GetActiveProductionSegments(ProductionOrder order)
    {
        var segments = new List<(DateTime Start, DateTime End)>();

        if (order.PlannedStartDate is not DateTime plannedStart ||
            order.PlannedEndDate is not DateTime plannedEnd ||
            plannedEnd <= plannedStart)
        {
            return segments;
        }

        // Build only the shift windows this order is allowed to use.
        // The lunch break is deliberately absent from this list.
        for (var date = plannedStart.Date; date <= plannedEnd.Date; date = date.AddDays(1))
        {
            AddAllowedWindow(date.AddHours(8), date.AddHours(13));   // Regular shift
            AddAllowedWindow(date.AddHours(14), date.AddHours(17));  // Regular shift

            if (!order.AvoidOvertime)
                AddAllowedWindow(date.AddHours(17), date.AddHours(22));

            if (!order.AvoidNightShift)
                AddAllowedWindow(date.AddHours(22), date.AddDays(1).AddHours(8));
        }

        return segments;

        void AddAllowedWindow(DateTime windowStart, DateTime windowEnd)
        {
            var segmentStart = windowStart > plannedStart ? windowStart : plannedStart;
            var segmentEnd = windowEnd < plannedEnd ? windowEnd : plannedEnd;

            if (segmentStart < segmentEnd)
                segments.Add((segmentStart, segmentEnd));
        }
    }

    private static bool IsOrderActiveDuring(ProductionOrder order, DateTime slotStart, DateTime slotEnd)
    {
        return GetActiveProductionSegments(order)
            .Any(segment => segment.Start < slotEnd && segment.End > slotStart);
    }

    private async Task ReloadQueueAsync()
    {
        orderQueue = await Db.ProductionOrders.AsNoTracking()
            .Include(x => x.SalesOrder).ThenInclude(x => x.Customer)
            .Where(x => x.Status != ProductionOrderStatus.Cancelled)
            .OrderBy(x => x.PlannedStartDate == null ? 0 : 1)
            .ThenBy(x => x.PlannedStartDate)
            .ToListAsync();
    }

    private void SetView(CalendarView view)
    {
        viewMode = view;
        if (view == CalendarView.Month) displayMonth = new DateTime(displayDate.Year, displayDate.Month, 1);
    }

    private void PreviousPeriod()
    {
        if (viewMode == CalendarView.Month) { displayMonth = Persian.AddMonths(displayMonth, -1); displayDate = displayMonth; }
        else displayDate = displayDate.AddDays(viewMode == CalendarView.Week ? -7 : -1);
    }

    private void NextPeriod()
    {
        if (viewMode == CalendarView.Month) { displayMonth = Persian.AddMonths(displayMonth, 1); displayDate = displayMonth; }
        else displayDate = displayDate.AddDays(viewMode == CalendarView.Week ? 7 : 1);
    }

    private void GoToToday()
    {
        displayDate = DateTime.Today;
        displayMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    }

    private string FormatJalali(DateTime date) =>
        $"{Persian.GetYear(date):0000}/{Persian.GetMonth(date):00}/{Persian.GetDayOfMonth(date):00}";

    private string FormatJalaliDateTime(DateTime? date) =>
        date.HasValue ? $"{FormatJalali(date.Value)} {date.Value:HH:mm}" : "-";

    private static string FormatDuration(int minutes) =>
        $"{minutes / 60m:0.##} hours";

    private string ShiftClass(int hour) =>
        hour >= 8 && hour < 13 || hour >= 14 && hour < 17 ? "work" :
        hour == 13 ? "break" :
        hour >= 17 && hour < 22 ? "overtime" : "night";

    private string ShiftName(int hour) =>
        ShiftClass(hour) switch
        {
            "work" => "Regular work",
            "break" => "Break",
            "overtime" => "Overtime",
            _ => "Night shift"
        };

    private string OrderColor(ProductionOrder order)
    {
        var hour = order.PlannedStartDate?.Hour ?? 8;
        return "order-" + ShiftClass(hour);
    }

    private string OrderTooltip(ProductionOrder order) =>
        $"{order.OrderNumber} | {order.SalesOrder?.Customer?.Name} | {FormatJalaliDateTime(order.PlannedStartDate)} – {FormatJalaliDateTime(order.PlannedEndDate)}";

    private enum CalendarView { Month, Week, Day }
}
