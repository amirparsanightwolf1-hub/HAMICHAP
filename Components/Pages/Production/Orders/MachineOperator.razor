@page "/production/machine-operator"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Inventory
@using HamiChap_MES_ERP.Models.Production
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject LocalizationService L

<PageTitle>@L["OperatorDashboardTitle"]</PageTitle>

<div class="container-fluid py-4 operator-dashboard">
    <div class="operator-hero mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="operator-eyebrow mb-2">@L["OperatorProductionArea"]</div>
                <h1 class="h3 fw-bold mb-2">@L["OperatorDashboardTitle"]</h1>
                <p class="mb-0 operator-hero-subtitle">@L["OperatorDashboardDescription"]</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="/production/workflow" class="btn btn-light btn-sm">@L["OperatorViewWorkflow"]</a>
                <button type="button" class="btn btn-outline-light btn-sm" disabled="@busy" @onclick="ReloadAsync">
                    @L["Refresh"]
                </button>
            </div>
        </div>
    </div>

    @if (!canOperate)
    {
        <div class="alert alert-danger" role="alert">@L["OperatorAccessDenied"]</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success")" role="status">@message</div>
        }
        @if (!executionSchemaReady)
        {
            <div class="alert alert-warning" role="alert">@L["OperatorMigrationRequired"]</div>
        }
        @if (!isAdministrator && !assignedMachineId.HasValue)
        {
            <div class="alert alert-warning" role="alert">@L["OperatorNoAssignedMachine"]</div>
        }

        <div class="card operator-filter-card mb-4">
            <div class="card-body d-flex flex-wrap align-items-end justify-content-between gap-3">
                <div class="operator-machine-filter">
                    <label class="form-label small fw-semibold text-muted" for="operator-machine">@L["Machine"]</label>
                    @if (isAdministrator)
                    {
                        <select id="operator-machine" class="form-select" @bind="machineId" @bind:after="ReloadAsync">
                            <option value="0">@L["OperatorAllMachines"]</option>
                            @foreach (var machine in machines)
                            {
                                <option value="@machine.Id">@machine.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="form-control operator-assigned-machine">
                            @(machines.FirstOrDefault()?.Name ?? L["OperatorUnassigned"])
                        </div>
                    }
                </div>
                <div class="text-muted small">@L["OperatorAutoRefresh"]</div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="card operator-stat operator-stat-ready h-100">
                    <div class="card-body">
                        <div class="operator-stat-icon"><span aria-hidden="true">✓</span></div>
                        <div class="text-muted small mt-3">@L["OperatorAvailableNow"]</div>
                        <div class="operator-stat-value">@AvailableOperations.Count(x => x.Status != ProductionOperationStatus.Running)</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card operator-stat operator-stat-active h-100">
                    <div class="card-body">
                        <div class="operator-stat-icon"><span aria-hidden="true">▶</span></div>
                        <div class="text-muted small mt-3">@L["OperatorInProgress"]</div>
                        <div class="operator-stat-value">@VisibleOperations.Count(x => x.Status == ProductionOperationStatus.Running)</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card operator-stat operator-stat-queue h-100">
                    <div class="card-body">
                        <div class="operator-stat-icon"><span aria-hidden="true">◷</span></div>
                        <div class="text-muted small mt-3">@L["OperatorNextUp"]</div>
                        <div class="operator-stat-value">@UpcomingOperations.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card operator-stat operator-stat-done h-100">
                    <div class="card-body">
                        <div class="operator-stat-icon"><span aria-hidden="true">✓</span></div>
                        <div class="text-muted small mt-3">@L["OperatorCompleted"]</div>
                        <div class="operator-stat-value">@VisibleOperations.Count(x => x.Status == ProductionOperationStatus.Completed)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xxl-8">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">@L["OperatorWorklist"]</h2>
                        <p class="text-muted small mb-0">@L["OperatorWorklistHelp"]</p>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">@PendingWorklist.Count</span>
                </div>
                @if (PendingWorklist.Count == 0)
                {
                    <div class="operator-empty card mb-3">
                        <div class="card-body text-center py-5">
                            <div class="operator-empty-symbol mb-3" aria-hidden="true">✓</div>
                            <h3 class="h6 fw-semibold">@L["OperatorNoPendingWork"]</h3>
                            <p class="text-muted small mb-0">@L["OperatorNoPendingWorkHint"]</p>
                        </div>
                    </div>
                }

                @foreach (var step in PendingWorklist)
                {
                    var last = LastEvent(step.Id);
                    var paused = last?.EventType == "Paused";
                    var booking = BookingFor(step.Id);
                    var blockedReason = step.Status is ProductionOperationStatus.Pending or ProductionOperationStatus.Ready
                        ? StartBlockedReason(step) : null;
                    <article class="card operator-job-card mb-3" @key="step.Id">
                        <div class="card-body p-3 p-lg-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <div class="small text-muted mb-1">@L["Order"] · @step.ProductionOrder.OrderNumber · @L["OperatorStep"] @step.Sequence</div>
                                    <h3 class="h5 fw-bold mb-1">@step.Name</h3>
                                    <div class="small text-muted">
                                        @L["Machine"]: @(machines.FirstOrDefault(x => x.Id == booking?.MachineId)?.Name ?? L["OperatorNotScheduled"])
                                    </div>
                                </div>
                                <span class="badge rounded-pill @(paused ? "text-bg-warning" : step.Status == ProductionOperationStatus.Running ? "text-bg-primary" : blockedReason == null ? "text-bg-success" : "text-bg-secondary")">
                                    @(paused ? L["OperatorPaused"] : step.Status == ProductionOperationStatus.Running ? L["OperatorInProgress"] : blockedReason == null ? L["OperatorAvailableNow"] : L["OperatorWaiting"])
                                </span>
                            </div>
                            <div class="operator-job-metadata mb-3">
                                <div>
                                    <span class="text-muted small d-block">@L["PlannedStart"]</span>
                                    <strong>@(booking?.PlannedStart.ToString("yyyy-MM-dd HH:mm") ?? "—")</strong>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">@L["PlannedEnd"]</span>
                                    <strong>@(booking?.PlannedEnd.ToString("yyyy-MM-dd HH:mm") ?? "—")</strong>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">@L["OperatorExpectedDuration"]</span>
                                    <strong>@step.PlannedHours.ToString("0.##") @L["OperatorHours"]</strong>
                                </div>
                            </div>
                            @if (booking != null && step.ProductionOrder.PlannedEndDate.HasValue &&
                                 booking.PlannedEnd > step.ProductionOrder.PlannedEndDate.Value)
                            {
                                <div class="alert alert-warning py-2 small">@L["OperatorOutsideCeoWindow"]</div>
                            }
                            @if (step.Status is ProductionOperationStatus.Pending or ProductionOperationStatus.Ready)
                            {
                                @if (blockedReason != null)
                                {
                                    <div class="operator-notice mb-3">@blockedReason</div>
                                }
                                <button type="button" class="btn btn-primary operator-main-action"
                                        disabled="@(busy || blockedReason != null)" @onclick='() => RecordAsync(step.Id, "Started")'>
                                    @L["OperatorStart"]
                                </button>
                            }
                            @if (step.Status == ProductionOperationStatus.Running)
                            {
                                @if (paused)
                                {
                                    <button type="button" class="btn btn-primary operator-main-action"
                                            disabled="@busy" @onclick='() => RecordAsync(step.Id, "Resumed")'>@L["OperatorResume"]</button>
                                }
                                else
                                {
                                    <div class="row g-2 align-items-end mb-3">
                                        <div class="col-sm-8">
                                            <label class="form-label small" for="@($"pause-{step.Id}")">@L["OperatorPauseReason"]</label>
                                            <input id="@($"pause-{step.Id}")" class="form-control"
                                                   @bind="pauseReasons[step.Id]" placeholder="@L["OperatorPauseReasonPlaceholder"]" />
                                        </div>
                                        <div class="col-sm-4">
                                            <button type="button" class="btn btn-outline-warning w-100"
                                                    disabled="@busy" @onclick='() => RecordAsync(step.Id, "Paused")'>@L["OperatorPause"]</button>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-success operator-main-action"
                                            disabled="@busy" @onclick='() => RecordAsync(step.Id, "Finished")'>@L["OperatorFinish"]</button>
                                }
                                <details class="operator-expander mt-3">
                                    <summary>@L["OperatorDelayReport"]</summary>
                                    <div class="pt-3">
                                        @if (HasOverrun(step))
                                        {
                                            <div class="alert alert-warning small py-2">@L["OperatorOverrunWarning"]</div>
                                        }
                                        <div class="row g-3">
                                            <div class="col-sm-4">
                                                <label class="form-label small" for="@($"minutes-{step.Id}")">@L["OperatorAdditionalMinutes"]</label>
                                                <input id="@($"minutes-{step.Id}")" type="number" min="1" max="10080"
                                                       step="1" class="form-control" @bind="overrunMinutes[step.Id]" />
                                            </div>
                                            <div class="col-sm-8">
                                                <label class="form-label small" for="@($"delay-{step.Id}")">@L["OperatorDelayReason"]</label>
                                                <textarea id="@($"delay-{step.Id}")" class="form-control" maxlength="1000"
                                                          rows="2" @bind="overrunReasons[step.Id]"></textarea>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-warning mt-3"
                                                disabled="@busy" @onclick="() => ExtendAsync(step.Id)">@L["OperatorSubmitDelay"]</button>
                                    </div>
                                </details>
                            }
                            <details class="operator-expander mt-3">
                                <summary>@L["OperatorWarehouseRequest"]</summary>
                                <div class="pt-3">
                                    <div class="row g-3">
                                        <div class="col-md-5">
                                            <label class="form-label small" for="@($"item-{step.Id}")">@L["OperatorItemOrTool"]</label>
                                            <select id="@($"item-{step.Id}")" class="form-select" @bind="requestItemIds[step.Id]">
                                                <option value="0">@L["OperatorChooseItem"]</option>
                                                @foreach (var item in items)
                                                {
                                                    <option value="@item.Id">@item.Name (@item.Code)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small" for="@($"quantity-{step.Id}")">@L["Quantity"]</label>
                                            <input id="@($"quantity-{step.Id}")" type="number" min="0.001" step="any"
                                                   class="form-control" @bind="requestQuantities[step.Id]" />
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small" for="@($"notes-{step.Id}")">@L["Notes"]</label>
                                            <input id="@($"notes-{step.Id}")" class="form-control" @bind="requestNotes[step.Id]" />
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary mt-3"
                                            disabled="@busy" @onclick="() => RequestItemAsync(step.Id)">@L["OperatorSubmitWarehouseRequest"]</button>
                                    <p class="text-muted small mt-2 mb-0">@L["OperatorWarehouseDisclaimer"]</p>
                                </div>
                            </details>
                            @if (eventsByOperation.TryGetValue(step.Id, out var history) && history.Count > 0)
                            {
                                <details class="operator-expander mt-3">
                                    <summary>@L["OperatorActivityLog"] (@history.Count)</summary>
                                    <div class="operator-history pt-3">
                                        @foreach (var entry in history)
                                        {
                                            <div class="operator-history-entry">
                                                <strong>@EventLabel(entry.EventType)</strong>
                                                <small class="text-muted">@entry.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                                                @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                                {
                                                    <div class="small mt-1">@entry.Reason</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="col-12 col-xxl-4">
                <section class="card operator-side-card mb-4">
                    <div class="card-header bg-transparent border-bottom-0 pt-3 px-3">
                        <h2 class="h6 fw-bold mb-0">@L["OperatorNextUp"]</h2>
                    </div>
                    <div class="card-body pt-2">
                        @if (UpcomingOperations.Count == 0)
                        {
                            <p class="text-muted small mb-0">@L["OperatorNoUpcoming"]</p>
                        }
                        @foreach (var next in UpcomingOperations.Take(8))
                        {
                            var booking = BookingFor(next.Id);
                            <div class="operator-queue-item">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong class="small">@next.Name</strong>
                                    <span class="text-muted small">@next.ProductionOrder.OrderNumber</span>
                                </div>
                                <div class="text-muted small mt-1">
                                    @(booking?.PlannedStart.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </div>
                                <div class="small mt-1">@UpcomingReason(next)</div>
                            </div>
                        }
                    </div>
                </section>

                <section class="card operator-side-card mb-4">
                    <div class="card-header bg-transparent border-bottom-0 pt-3 px-3">
                        <h2 class="h6 fw-bold mb-0">@L["OperatorProductionOrders"]</h2>
                    </div>
                    <div class="card-body pt-2">
                        @if (visibleOrders.Count == 0)
                        {
                            <p class="text-muted small mb-0">@L["OperatorNoOrders"]</p>
                        }
                        @foreach (var order in visibleOrders.Take(12))
                        {
                            var count = operations.Count(x => x.ProductionOrderId == order.Id);
                            var booked = operations.Count(x => x.ProductionOrderId == order.Id && BookingFor(x.Id) != null);
                            <div class="operator-queue-item">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong class="small">@order.OrderNumber</strong>
                                    <span class="badge text-bg-light border">@OrderStatusLabel(order.Status)</span>
                                </div>
                                <div class="text-muted small mt-2">
                                    @L["OperatorOperationCount"]: @count · @L["OperatorScheduledCount"]: @booked
                                </div>
                                @if (count == 0)
                                {
                                    <div class="small mt-1">@L["OperatorAwaitingRoute"]</div>
                                }
                                else if (booked == 0)
                                {
                                    <div class="small mt-1">@L["OperatorAwaitingSchedule"]</div>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="card operator-side-card">
                    <div class="card-header bg-transparent border-bottom-0 pt-3 px-3">
                        <h2 class="h6 fw-bold mb-0">@L["OperatorRecentlyCompleted"]</h2>
                    </div>
                    <div class="card-body pt-2">
                        @{
                            var recentlyCompleted = VisibleOperations.Where(x => x.Status == ProductionOperationStatus.Completed)
                                .OrderByDescending(x => eventsByOperation.GetValueOrDefault(x.Id)?.FirstOrDefault(e => e.EventType == "Finished")?.OccurredAtUtc)
                                .Take(8).ToList();
                        }
                        @if (recentlyCompleted.Count == 0)
                        {
                            <p class="text-muted small mb-0">@L["OperatorNoCompleted"]</p>
                        }
                        @foreach (var completed in recentlyCompleted)
                        {
                            var log = eventsByOperation.GetValueOrDefault(completed.Id) ?? new();
                            <div class="operator-queue-item">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong class="small">@completed.Name</strong>
                                    <span class="text-muted small">@completed.ProductionOrder.OrderNumber</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    @(log.FirstOrDefault(x => x.EventType == "Finished")?.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </div>
                                @foreach (var report in log.Where(x => x.EventType == "Overrun"))
                                {
                                    <div class="small mt-2">@L["OperatorDelayReport"]: @report.Reason</div>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource refreshCancellation = new();
    private bool canOperate;
    private bool isAdministrator;
    private int? assignedMachineId;
    private bool executionSchemaReady = true;
    private bool busy;
    private bool isError;
    private string message = "";
    private string userId = "";
    private int machineId;
    private List<Machine> machines = new();
    private List<Item> items = new();
    private List<ProductionOperation> operations = new();
    private List<ProductionOrder> visibleOrders = new();
    private Dictionary<long, List<ProductionOperationEvent>> eventsByOperation = new();
    private Dictionary<long, string> pauseReasons = new();
    private Dictionary<long, int> requestItemIds = new();
    private Dictionary<long, decimal> requestQuantities = new();
    private Dictionary<long, string> requestNotes = new();
    private Dictionary<long, string> overrunReasons = new();
    private Dictionary<long, int> overrunMinutes = new();
    private Dictionary<long, ProductionSchedule> bookingsByOperation = new();

    private string EventLabel(string eventType) => eventType switch
    {
        "Started" => L["OperatorStarted"],
        "Paused" => L["OperatorPaused"],
        "Resumed" => L["OperatorResumed"],
        "Finished" => L["OperatorFinished"],
        "Overrun" => L["OperatorDelayReport"],
        _ => eventType
    };

    private string OrderStatusLabel(ProductionOrderStatus status) => status switch
    {
        ProductionOrderStatus.Planned => L["Planned"],
        ProductionOrderStatus.ReadyToStart => L["ReadyToStart"],
        ProductionOrderStatus.InProduction => L["InProduction"],
        ProductionOrderStatus.WaitingForMaterial => L["WaitingForMaterial"],
        ProductionOrderStatus.MaterialChecking => L["MaterialChecking"],
        ProductionOrderStatus.QualityControl => L["QualityControl"],
        ProductionOrderStatus.Completed => L["Completed"],
        ProductionOrderStatus.Cancelled => L["Cancelled"],
        _ => status.ToString()
    };

    private string UpcomingReason(ProductionOperation step)
    {
        if (BookingFor(step.Id) == null) return L["OperatorAwaitingSchedule"];
        if (!PreviousCompleted(step)) return L["OperatorWaitingPrevious"];
        return L["OperatorWaitingMachine"];
    }

    private List<ProductionOperation> PendingWorklist =>
        VisibleOperations.Where(x => x.Status is ProductionOperationStatus.Pending or ProductionOperationStatus.Ready or ProductionOperationStatus.Running).ToList();

    private List<ProductionOperation> VisibleOperations =>
        operations.Where(x => x.Status != ProductionOperationStatus.Cancelled)
            .OrderBy(x => BookingFor(x.Id)?.PlannedStart ?? DateTime.MaxValue)
            .ThenBy(x => x.Sequence).ToList();
    private List<ProductionOperation> AvailableOperations =>
        VisibleOperations.Where(x => x.Status == ProductionOperationStatus.Running ||
            ((x.Status is ProductionOperationStatus.Ready or ProductionOperationStatus.Pending) &&
             StartBlockedReason(x) == null)).ToList();
    private string? StartBlockedReason(ProductionOperation step)
    {
        if (!executionSchemaReady) return "Database migration required before recording work / نیاز به به‌روزرسانی پایگاه داده";
        if (!isAdministrator && (!assignedMachineId.HasValue || BookingFor(step.Id)?.MachineId != assignedMachineId.Value))
            return "This operation belongs to another machine / این عملیات متعلق به دستگاه شما نیست";
        if (!PreviousCompleted(step)) return "Waiting for earlier operation to finish / در انتظار اتمام مرحله قبل";
        var booking = BookingFor(step.Id);
        if (booking == null) return "No confirmed machine booking. Production manager must schedule this operation / نیازمند برنامه‌ریزی مدیر تولید";
        if (booking.Status != ScheduleStatus.Planned) return "Machine booking is not available for starting / برنامه دستگاه آماده شروع نیست";
        if (step.ProductionOrder.OperationsSequenceConfirmedAt == null) return "Production manager must confirm the sequence / نیازمند تأیید ترتیب مراحل";
        var now = DateTime.Now;
        if (!step.ProductionOrder.PlannedStartDate.HasValue || !step.ProductionOrder.PlannedEndDate.HasValue)
            return "CEO must approve the production window / نیازمند برنامه مدیرعامل";
        if (now < step.ProductionOrder.PlannedStartDate.Value) return "CEO-approved start time has not arrived / زمان شروع تعیین‌شده فرا نرسیده";
        if (now >= step.ProductionOrder.PlannedEndDate.Value) return "CEO-approved production window has ended / مهلت برنامه مدیرعامل پایان یافته";
        if (ProductionPlanningTime.NextAllowedProductionMinute(
                now, step.ProductionOrder.AvoidOvertime, step.ProductionOrder.AvoidNightShift) > now)
            return "Outside an approved production shift / خارج از شیفت مجاز";
        if (bookingsByOperation.Values.Any(x =>
                x.MachineId == booking.MachineId && x.ProductionOperationId != step.Id &&
                x.Status == ScheduleStatus.Running))
            return "Machine is currently running another operation / دستگاه مشغول است";
        if (now < booking.PlannedStart && bookingsByOperation.Values.Any(x =>
                x.Id != booking.Id && x.MachineId == booking.MachineId &&
                x.Status != ScheduleStatus.Cancelled &&
                x.PlannedStart < booking.PlannedStart && x.PlannedEnd > now))
            return "Another booking occupies this machine before the planned start / رزرو دیگر دستگاه";
        return null;
    }

    private bool IsAllowedToStartNow(ProductionOperation step)
    {
        var start = step.ProductionOrder.PlannedStartDate;
        if (!start.HasValue || DateTime.Now < start.Value ||
            step.ProductionOrder.OperationsSequenceConfirmedAt == null ||
            (step.ProductionOrder.PlannedEndDate.HasValue &&
             DateTime.Now >= step.ProductionOrder.PlannedEndDate.Value))
            return false;
        return ProductionPlanningTime.NextAllowedProductionMinute(DateTime.Now,
            step.ProductionOrder.AvoidOvertime, step.ProductionOrder.AvoidNightShift) <= DateTime.Now;
    }
    private List<ProductionOperation> UpcomingOperations =>
        VisibleOperations.Where(x => (x.Status is ProductionOperationStatus.Pending or ProductionOperationStatus.Ready) &&
            !AvailableOperations.Any(a => a.Id == x.Id)).ToList();
    private ProductionSchedule? BookingFor(long id) =>
        bookingsByOperation.GetValueOrDefault(id);
    private bool HasOverrun(ProductionOperation step)
    {
        var booking = BookingFor(step.Id);
        return step.Status == ProductionOperationStatus.Running &&
            (booking != null && DateTime.Now > booking.PlannedEnd ||
             ActiveMinutes(eventsByOperation.GetValueOrDefault(step.Id) ?? new(),
                 DateTime.UtcNow) > ProductionPlanningTime.OperationMinutes(step.PlannedHours));
    }
    private static double ActiveMinutes(IEnumerable<ProductionOperationEvent> events, DateTime nowUtc)
    {
        DateTime? activeFrom = null;
        double minutes = 0;
        foreach (var entry in events.OrderBy(x => x.OccurredAtUtc).ThenBy(x => x.Id))
        {
            if (entry.EventType is "Started" or "Resumed") activeFrom = entry.OccurredAtUtc;
            else if (entry.EventType is "Paused" or "Finished")
            {
                if (activeFrom.HasValue)
                    minutes += Math.Max(0, (entry.OccurredAtUtc - activeFrom.Value).TotalMinutes);
                activeFrom = null;
            }
        }
        if (activeFrom.HasValue) minutes += Math.Max(0, (nowUtc - activeFrom.Value).TotalMinutes);
        return minutes;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        isAdministrator = user.IsInRole("Administrator");
        canOperate = !string.IsNullOrEmpty(userId) &&
            (user.IsInRole("Administrator") || user.IsInRole("ProductionManager") ||
             user.IsInRole("Production Manager") || user.IsInRole("Manager") ||
             user.IsInRole("FloorManager") || user.IsInRole("Floor Manager") ||
             user.IsInRole("Production") || user.IsInRole("Operator"));
        if (!canOperate) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        assignedMachineId = await db.Users.AsNoTracking()
            .Where(x => x.Id == userId && x.IsActive)
            .Select(x => x.AssignedMachineId).FirstOrDefaultAsync();
        machines = await db.Machines.AsNoTracking()
            .Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        if (!isAdministrator)
        {
            machines = machines.Where(x => x.Id == assignedMachineId).ToList();
            machineId = machines.FirstOrDefault()?.Id ?? 0;
        }
        else machineId = 0;
        items = await db.Items.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        await ReloadAsync();
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
            {
                if (busy) continue;
                await InvokeAsync(async () =>
                {
                    if (busy) return;
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public ValueTask DisposeAsync()
    {
        refreshCancellation.Cancel();
        refreshCancellation.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        if (!canOperate) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!isAdministrator)
        {
            assignedMachineId = await db.Users.AsNoTracking()
                .Where(x => x.Id == userId && x.IsActive)
                .Select(x => x.AssignedMachineId).FirstOrDefaultAsync();
            machines = await db.Machines.AsNoTracking()
                .Where(x => x.IsActive && x.Id == assignedMachineId).ToListAsync();
            machineId = machines.FirstOrDefault()?.Id ?? 0;
            if (machineId == 0)
            {
                operations = new();
                visibleOrders = new();
                bookingsByOperation = new();
                eventsByOperation = new();
                predecessors = new();
                return;
            }
        }
        var machineBookings = await db.ProductionSchedules.AsNoTracking()
            .Where(x => x.Status != ScheduleStatus.Cancelled)
            .ToListAsync();
        bookingsByOperation = machineBookings.GroupBy(x => x.ProductionOperationId)
            .ToDictionary(x => x.Key, x => x.OrderByDescending(b => b.Id).First());
        var allOpenOrders = await db.ProductionOrders.AsNoTracking()
            .Where(x => x.Status != ProductionOrderStatus.Cancelled &&
                        x.Status != ProductionOrderStatus.Completed)
            .OrderBy(x => x.PlannedStartDate).ToListAsync();
        var allIds = allOpenOrders.Select(x => x.Id).ToList();
        var allOperations = await db.ProductionOperations.AsNoTracking()
            .Include(x => x.ProductionOrder).Include(x => x.WorkCenter)
            .Where(x => allIds.Contains(x.ProductionOrderId) && !x.IsOutsourced)
            .ToListAsync();
        if (machineId == 0 && isAdministrator)
        {
            operations = allOperations;
            visibleOrders = allOpenOrders;
        }
        else
        {
            var machine = machines.FirstOrDefault(x => x.Id == machineId);
            var matchingIds = machineBookings.Where(x => x.MachineId == machineId)
                .Select(x => x.ProductionOperationId).ToHashSet();
            operations = allOperations.Where(x =>
                matchingIds.Contains(x.Id) ||
                (machine != null && x.WorkCenter?.Code == "MC-" + machine.Code)).ToList();
            visibleOrders = allOpenOrders.Where(x =>
                operations.Any(op => op.ProductionOrderId == x.Id)).ToList();
        }
        var orderIds = operations.Select(x => x.ProductionOrderId).Distinct().ToList();
        var allSteps = await db.ProductionOperations.AsNoTracking()
            .Where(x => orderIds.Contains(x.ProductionOrderId)).ToListAsync();
        predecessors = allSteps;
        var operationIds = operations.Select(x => x.Id).ToList();
        try
        {
            eventsByOperation = (await db.ProductionOperationEvents.AsNoTracking()
                .Where(x => operationIds.Contains(x.ProductionOperationId))
                .OrderByDescending(x => x.OccurredAtUtc).ToListAsync())
                .GroupBy(x => x.ProductionOperationId)
                .ToDictionary(x => x.Key, x => x.ToList());
            executionSchemaReady = true;
        }
        catch (Microsoft.Data.SqlClient.SqlException ex) when (ex.Number == 208)
        {
            // The operator audit table is created by the execution-tracking migration.
            // Keep the dashboard viewable without allowing unaudited actions.
            executionSchemaReady = false;
            eventsByOperation = new();
        }
        foreach (var step in operations)
        {
            requestItemIds.TryAdd(step.Id, 0);
            requestQuantities.TryAdd(step.Id, 1m);
            pauseReasons.TryAdd(step.Id, "");
            requestNotes.TryAdd(step.Id, "");
            overrunReasons.TryAdd(step.Id, "");
            overrunMinutes.TryAdd(step.Id, 15);
        }
    }

    private List<ProductionOperation> predecessors = new();
    private bool PreviousCompleted(ProductionOperation step) =>
        !predecessors.Any(x => x.ProductionOrderId == step.ProductionOrderId &&
                               x.Sequence < step.Sequence && x.Status != ProductionOperationStatus.Completed);
    private ProductionOperationEvent? LastEvent(long id) =>
        eventsByOperation.GetValueOrDefault(id)?.FirstOrDefault();

    private async Task AssertMachinePermissionAsync(ApplicationDbContext db, int actualMachineId)
    {
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        if (principal.Identity?.IsAuthenticated != true ||
            principal.FindFirstValue(ClaimTypes.NameIdentifier) != userId)
            throw new UnauthorizedAccessException("Authentication is required.");

        var account = await db.Users.AsNoTracking()
            .Where(x => x.Id == userId && x.IsActive)
            .Select(x => new { x.AssignedMachineId }).FirstOrDefaultAsync();
        if (account == null)
            throw new UnauthorizedAccessException("Operator account is disabled or unavailable.");

        if (principal.IsInRole("Administrator")) return;
        if (!(principal.IsInRole("ProductionManager") ||
              principal.IsInRole("Production Manager") ||
              principal.IsInRole("Manager") ||
              principal.IsInRole("FloorManager") ||
              principal.IsInRole("Floor Manager") ||
              principal.IsInRole("Production") ||
              principal.IsInRole("Operator")))
            throw new UnauthorizedAccessException("Production operator role is required.");
        if (!account.AssignedMachineId.HasValue ||
            account.AssignedMachineId.Value != actualMachineId)
            throw new UnauthorizedAccessException(
                "You may only execute operations on your assigned machine.");
    }

    private async Task RecordAsync(long operationId, string action)
    {
        if (!canOperate || !executionSchemaReady || busy || !new[] { "Started", "Paused", "Resumed", "Finished" }.Contains(action)) return;
        busy = true;
        message = "";
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var step = await db.ProductionOperations
                .Include(x => x.ProductionOrder).FirstOrDefaultAsync(x => x.Id == operationId && !x.IsOutsourced);
            var booking = await db.ProductionSchedules.FirstOrDefaultAsync(x =>
                x.ProductionOperationId == operationId &&
                (machineId == 0 || x.MachineId == machineId) &&
                x.Status != ScheduleStatus.Cancelled);
            if (step == null || booking == null)
                throw new InvalidOperationException("Operation is not scheduled for this machine.");
            await AssertMachinePermissionAsync(db, booking.MachineId);
            if (step.ProductionOrder.Status is ProductionOrderStatus.Cancelled or ProductionOrderStatus.Completed)
                throw new InvalidOperationException("Production order is closed.");
            if (step.ProductionOrder.OperationsSequenceConfirmedAt == null)
                throw new InvalidOperationException("Manager sequence confirmation is required.");
            var previous = await db.ProductionOperations.AnyAsync(x =>
                x.ProductionOrderId == step.ProductionOrderId && x.Sequence < step.Sequence &&
                x.Status != ProductionOperationStatus.Completed);
            if (previous) throw new InvalidOperationException("The preceding operation must finish first.");
            var last = await db.ProductionOperationEvents
                .Where(x => x.ProductionOperationId == operationId)
                .OrderByDescending(x => x.Id).FirstOrDefaultAsync();
            var paused = last?.EventType == "Paused";
            string reason = "";
            if (action == "Started")
            {
                if (step.Status is not (ProductionOperationStatus.Pending or ProductionOperationStatus.Ready))
                    throw new InvalidOperationException("Operation has already started.");
                var now = DateTime.Now;
                if (step.ProductionOrder.PlannedStartDate is not DateTime approvedStart ||
                    step.ProductionOrder.PlannedEndDate is not DateTime approvedEnd ||
                    now < approvedStart || now >= approvedEnd ||
                    ProductionPlanningTime.NextAllowedProductionMinute(now,
                        step.ProductionOrder.AvoidOvertime, step.ProductionOrder.AvoidNightShift) > now)
                    throw new InvalidOperationException("The CEO has not approved this time or shift.");
                if (booking.Status != ScheduleStatus.Planned)
                    throw new InvalidOperationException("The machine booking is not available to start.");
                if (await db.ProductionSchedules.AnyAsync(x =>
                    x.Id != booking.Id && x.MachineId == booking.MachineId &&
                    x.Status == ScheduleStatus.Running))
                    throw new InvalidOperationException(
                        "Another operation is still running on this machine.");

                // An early start is permitted as soon as the preceding operation has
                // finished, but it must not overlap any other reservation on this machine.
                if (now < booking.PlannedStart)
                {
                    var collision = await db.ProductionSchedules.AnyAsync(x =>
                        x.Id != booking.Id && x.MachineId == booking.MachineId &&
                        x.Status != ScheduleStatus.Cancelled &&
                        x.PlannedStart < booking.PlannedStart && x.PlannedEnd > now);
                    if (collision)
                        throw new InvalidOperationException(
                            "The machine is reserved for another operation. Early start is not yet possible.");
                    booking.PlannedStart = now;
                }
                step.Status = ProductionOperationStatus.Running;
                booking.Status = ScheduleStatus.Running;
                step.ProductionOrder.Status = ProductionOrderStatus.InProduction;
                step.ProductionOrder.ActualStartDate ??= DateTime.UtcNow;
            }
            else if (action == "Paused")
            {
                reason = pauseReasons.GetValueOrDefault(operationId, "").Trim();
                if (step.Status != ProductionOperationStatus.Running || paused || reason.Length == 0)
                    throw new InvalidOperationException("A pause reason is required for a running operation.");
                if (reason.Length > 1000) throw new InvalidOperationException("Pause reason is too long.");
            }
            else if (action == "Resumed")
            {
                if (step.Status != ProductionOperationStatus.Running || !paused)
                    throw new InvalidOperationException("Operation is not paused.");
            }
            else if (action == "Finished")
            {
                if (step.Status != ProductionOperationStatus.Running || paused)
                    throw new InvalidOperationException("Resume the operation before finishing.");
                var events = await db.ProductionOperationEvents
                    .Where(x => x.ProductionOperationId == operationId)
                    .OrderBy(x => x.Id).ToListAsync();
                var durationExceeded = ActiveMinutes(events, DateTime.UtcNow) >
                    ProductionPlanningTime.OperationMinutes(step.PlannedHours);
                var needsExtension = DateTime.Now > booking.PlannedEnd;
                var alreadyReported = events.Any(x => x.EventType == "Overrun");
                if (needsExtension || (durationExceeded && !alreadyReported))
                {
                    reason = overrunReasons.GetValueOrDefault(operationId, "").Trim();
                    if (string.IsNullOrWhiteSpace(reason) || reason.Length > 1000)
                        throw new InvalidOperationException("Explain why the operation exceeded its estimated duration before finishing.");
                    if (needsExtension)
                        await ProductionOperationOverrunScheduler.ExtendAsync(
                            db, step, booking, DateTime.Now);
                    db.ProductionOperationEvents.Add(new ProductionOperationEvent
                    {
                        ProductionOperationId = operationId, EventType = "Overrun",
                        OccurredAtUtc = DateTime.UtcNow, OperatorUserId = userId,
                        Reason = reason
                    });
                }
                step.Status = ProductionOperationStatus.Completed;
                booking.Status = ScheduleStatus.Completed;
                if (DateTime.Now < booking.PlannedEnd)
                {
                    booking.PlannedEnd = DateTime.Now;
                    await ProductionOperationEarlyCompletionScheduler.AdvanceFollowingAsync(
                        db, step, booking.PlannedEnd);
                }
                var next = await db.ProductionOperations.Where(x =>
                    x.ProductionOrderId == step.ProductionOrderId && x.Sequence > step.Sequence)
                    .OrderBy(x => x.Sequence).FirstOrDefaultAsync();
                if (next != null && next.Status == ProductionOperationStatus.Pending)
                    next.Status = ProductionOperationStatus.Ready;
                // The production order's final completion is still handled by QC and order workflow.
            }
            db.ProductionOperationEvents.Add(new ProductionOperationEvent
            {
                ProductionOperationId = operationId,
                EventType = action,
                OccurredAtUtc = DateTime.UtcNow,
                OperatorUserId = userId,
                Reason = reason
            });
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            message = action + " recorded.";
            isError = false;
            pauseReasons[operationId] = "";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally { busy = false; }
    }

    private async Task ExtendAsync(long operationId)
    {
        if (!canOperate || !executionSchemaReady || busy) return;
        busy = true;
        message = "";
        try
        {
            var reason = overrunReasons.GetValueOrDefault(operationId, "").Trim();
            var minutes = overrunMinutes.GetValueOrDefault(operationId);
            if (reason.Length == 0 || reason.Length > 1000 || minutes <= 0 || minutes > 10080)
                throw new InvalidOperationException("Enter an overtime reason and 1–10080 additional minutes.");
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var step = await db.ProductionOperations.Include(x => x.ProductionOrder)
                .FirstOrDefaultAsync(x => x.Id == operationId && !x.IsOutsourced);
            var booking = await db.ProductionSchedules.FirstOrDefaultAsync(x =>
                x.ProductionOperationId == operationId &&
                (machineId == 0 || x.MachineId == machineId) &&
                x.Status == ScheduleStatus.Running);
            if (step == null || booking == null)
                throw new InvalidOperationException("The operation is not running on your selected machine.");
            await AssertMachinePermissionAsync(db, booking.MachineId);
            var last = await db.ProductionOperationEvents
                .Where(x => x.ProductionOperationId == operationId)
                .OrderByDescending(x => x.Id).FirstOrDefaultAsync();
            if (last?.EventType == "Paused")
                throw new InvalidOperationException("Resume the operation before extending its schedule.");
            var requestedEnd = booking.PlannedEnd.AddMinutes(minutes);
            if (DateTime.Now > requestedEnd) requestedEnd = DateTime.Now.AddMinutes(minutes);
            await ProductionOperationOverrunScheduler.ExtendAsync(db, step, booking, requestedEnd);
            db.ProductionOperationEvents.Add(new ProductionOperationEvent
            {
                ProductionOperationId = operationId,
                EventType = "Overrun",
                OccurredAtUtc = DateTime.UtcNow,
                OperatorUserId = userId,
                Reason = "Additional " + minutes + " minutes. " + reason
            });
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            message = "Overrun recorded. Later planned operations have been moved to feasible machine slots.";
            isError = false;
            overrunReasons[operationId] = "";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally { busy = false; }
    }

    private async Task RequestItemAsync(long operationId)
    {
        if (!canOperate || !executionSchemaReady || busy) return;
        busy = true;
        try
        {
            var itemId = requestItemIds.GetValueOrDefault(operationId);
            var quantity = requestQuantities.GetValueOrDefault(operationId);
            if (itemId == 0 || quantity <= 0 || quantity > 100000000)
                throw new InvalidOperationException("Select an item and enter a positive quantity.");
            await using var db = await DbFactory.CreateDbContextAsync();
            var step = await db.ProductionOperations.AsNoTracking().Include(x => x.ProductionOrder)
                .FirstOrDefaultAsync(x => x.Id == operationId);
            var booking = await db.ProductionSchedules.AsNoTracking().FirstOrDefaultAsync(x =>
                x.ProductionOperationId == operationId &&
                (machineId == 0 || x.MachineId == machineId) &&
                x.Status != ScheduleStatus.Cancelled);
            if (step == null || step.IsOutsourced || booking == null)
                throw new InvalidOperationException("Operation is not scheduled on the selected machine.");
            await AssertMachinePermissionAsync(db, booking.MachineId);
            if (step.Status is ProductionOperationStatus.Completed or ProductionOperationStatus.Cancelled ||
                step.ProductionOrder.Status is ProductionOrderStatus.Completed or ProductionOrderStatus.Cancelled)
                throw new InvalidOperationException("This operation or production order is closed.");
            var item = await db.Items.AsNoTracking().FirstOrDefaultAsync(x => x.Id == itemId && x.IsActive);
            if (item == null) throw new InvalidOperationException("Item is not available.");
            var notes = requestNotes.GetValueOrDefault(operationId, "").Trim();
            if (notes.Length > 1000) throw new InvalidOperationException("Notes are too long.");
            db.ProductionMaterialRequests.Add(new ProductionMaterialRequest
            {
                ProductionOrderId = step.ProductionOrderId,
                ProductionOperationId = step.Id,
                RequestedDate = DateTime.Now,
                Status = "Requested",
                RequestedByUserId = userId,
                Lines = new List<ProductionMaterialRequestLine>
                {
                    new() { ItemId = item.Id, UnitId = item.UnitId, Quantity = quantity, Notes = notes }
                }
            });
            await db.SaveChangesAsync();
            message = "Warehouse request submitted.";
            isError = false;
            requestNotes[operationId] = "";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally { busy = false; }
    }
}
