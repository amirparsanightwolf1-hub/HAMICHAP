@page "/production/orders"

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

<PageTitle>@L["ProductionOrders"]</PageTitle>

<div class="page-container operational-page production-order-page">

    <div class="erp-page-header operational-hero">
        <div class="operational-hero-icon"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></div>

        <div>
            <h3 class="erp-page-title">
                @L["ProductionOrders"]
            </h3>

            <p class="erp-page-subtitle">
                @L["Workflow_Description"]
            </p>
        </div>

    </div>

    @if (productionOrders != null)
    {
        <div class="operational-kpis">
            <div class="operational-kpi"><span>@L["Workflow_OpenOrders"]</span><strong>@productionOrders.Count(x => x.Status != ProductionOrderStatus.Cancelled && x.Status != ProductionOrderStatus.Completed)</strong></div>
            <div class="operational-kpi"><span>@L["InProduction"]</span><strong>@productionOrders.Count(x => x.Status == ProductionOrderStatus.InProduction)</strong></div>
            <div class="operational-kpi"><span>@L["QualityControl"]</span><strong>@productionOrders.Count(x => x.Status == ProductionOrderStatus.QualityControl)</strong></div>
            <div class="operational-kpi"><span>@L["Completed"]</span><strong>@productionOrders.Count(x => x.Status == ProductionOrderStatus.Completed)</strong></div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mb-4">
            @errorMessage
        </div>
    }

    @if (productionOrders == null)
    {
        <div class="alert alert-info">
            @L["Workflow_LoadingOrders"]
        </div>
    }
    else if (productionOrders.Count == 0)
    {
        <div class="card">
            <div class="card-body operational-empty">
                @L["NoProductionOrdersFound"]
            </div>
        </div>
    }
    else
    {
        <div class="card operational-card">
            <div class="card-body">
                <div class="operational-toolbar">
                    <div class="operational-search">
                        <label for="production-order-search" class="form-label">@L["Search"]</label>
                        <input id="production-order-search" class="form-control" @bind="searchText" @bind:event="oninput" placeholder="@L["OperationalSearchOrders"]" />
                    </div>
                    <div class="operational-filter">
                        <label for="production-order-status" class="form-label">@L["Status"]</label>
                        <select id="production-order-status" class="form-select" @bind="statusFilter">
                            <option value="">@L["AllStatuses"]</option>
                            @foreach (var status in Enum.GetValues<ProductionOrderStatus>())
                            {
                                <option value="@status.ToString()">@LocalizationService.TranslateEnum(status)</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-outline-secondary operational-clear" type="button" @onclick="ClearFilters">@L["Workflow_ClearFilters"]</button>
                </div>
                <div class="operational-result-count">@FilteredOrders.Count @L["OperationalResults"]</div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle operational-table">

                        <thead>
                            <tr>
                                <th>@L["OrderNumber"]</th>
                                <th>@L["SalesOrder"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Created"]</th>
                                <th>@L["PlannedStart"]</th>
                                <th>@L["PlannedEnd"]</th>
                                <th>@L["Lines"]</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (FilteredOrders.Count == 0)
                            {
                                <tr><td colspan="8" class="operational-empty">@L["Workflow_NoMatchingOrders"]</td></tr>
                            }
                            @foreach (var order in FilteredOrders)
                            {
                                <tr>

                                    <td data-label="@L["OrderNumber"]">
                                        <strong>
                                            @order.OrderNumber
                                        </strong>
                                    </td>

                                    <td data-label="@L["SalesOrder"]">
                                        @order.SalesOrder?.OrderNumber
                                    </td>

                                    <td data-label="@L["Status"]">
                                        <span class="@GetStatusClass(order.Status)">
                                            @LocalizationService.TranslateEnum(order.Status)
                                        </span>
                                    </td>

                                    <td data-label="@L["Created"]">
                                        @order.CreatedDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td data-label="@L["PlannedStart"]">
                                        @(order.PlannedStartDate?.ToString("yyyy-MM-dd") ?? "-")
                                    </td>

                                    <td data-label="@L["PlannedEnd"]">
                                        @(order.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "-")
                                    </td>

                                    <td data-label="@L["Lines"]">
                                        @order.Lines.Count
                                    </td>

                                    <td class="text-end">

                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenOrder(order.Id)">
                                            @L["Open"]
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@code {
    private LocalizationService L => LocalizationService;


    private List<ProductionOrder>? productionOrders;

    private string? errorMessage;
    private string searchText = "";
    private string statusFilter = "";

    private List<ProductionOrder> FilteredOrders => (productionOrders ?? new())
        .Where(x => (string.IsNullOrWhiteSpace(statusFilter) || x.Status.ToString() == statusFilter) &&
            (string.IsNullOrWhiteSpace(searchText) || x.OrderNumber.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
             (x.SalesOrder?.OrderNumber?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)))
        .ToList();

    private void ClearFilters() { searchText = ""; statusFilter = ""; }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductionOrdersAsync();
    }

    private async Task LoadProductionOrdersAsync()
    {
        errorMessage = null;

        try
        {
            productionOrders = await Db.ProductionOrders
                .Include(x => x.SalesOrder)
                .Include(x => x.Lines)
                .OrderByDescending(x => x.CreatedDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void OpenOrder(long id)
    {
        Navigation.NavigateTo(
            $"/production/orders/edit/{id}");
    }

    private string GetStatusClass(
        ProductionOrderStatus status)
    {
        return status switch
        {
            ProductionOrderStatus.Planned =>
                "badge bg-secondary",

            ProductionOrderStatus.MaterialChecking =>
                "badge bg-info",

            ProductionOrderStatus.WaitingForMaterial =>
                "badge bg-warning text-dark",

            ProductionOrderStatus.ReadyToStart =>
                "badge bg-primary",

            ProductionOrderStatus.InProduction =>
                "badge bg-primary",

            ProductionOrderStatus.QualityControl =>
                "badge bg-info",

            ProductionOrderStatus.Completed =>
                "badge bg-success",

            ProductionOrderStatus.Cancelled =>
                "badge bg-danger",

            _ =>
                "badge bg-secondary"
        };
    }
}