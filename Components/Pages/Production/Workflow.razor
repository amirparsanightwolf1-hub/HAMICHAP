@page "/production/workflow"
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using HamiChap_MES_ERP.Models.Shared.Services
@inject ApplicationDbContext Db
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService

<PageTitle>@T("Workflow_ProductionWorkflow", "Production Workflow")</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">@T("Workflow_ProductionWorkflow", "Production Workflow")</h1>
            <p class="text-muted mb-0">@T("Workflow_Description", "Track orders from material readiness through quality control and completion.")</p>
        </div>
        <a class="btn btn-outline-secondary" href="/production/orders">@T("ProductionOrders", "All Production Orders")</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">@T("Workflow_OpenOrders", "Open Orders")</div><div class="fs-3 fw-semibold">@openCount</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">@T("ReadyToStart", "Ready to Start")</div><div class="fs-3 fw-semibold">@CountStatus(ProductionOrderStatus.ReadyToStart)</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">@T("InProduction", "In Production")</div><div class="fs-3 fw-semibold">@CountStatus(ProductionOrderStatus.InProduction)</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">@T("QualityControl", "Quality Control")</div><div class="fs-3 fw-semibold">@CountStatus(ProductionOrderStatus.QualityControl)</div></div></div></div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-body"><h2 class="h5 mb-0">@T("Workflow_Stages", "Workflow stages")</h2></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-1">1. @T("Workflow_MaterialReadiness", "Material readiness")</div><div class="small text-muted mb-3">@T("Workflow_MaterialReadinessDescription", "Review the order, BOM/MRP results, and reservations.")</div><a href="/production/orders" class="btn btn-sm btn-outline-primary">@T("Workflow_ReviewOrders", "Review orders")</a></div></div>
                <div class="col-12 col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-1">2. @T("Workflow_IssueMaterials", "Issue materials")</div><div class="small text-muted mb-3">@T("Workflow_IssueMaterialsDescription", "Issue reserved materials to production.")</div><a href="@OrdersForStatusUrl(ProductionOrderStatus.ReadyToStart)" class="btn btn-sm btn-outline-primary">@T("Workflow_ViewReadyOrders", "View ready orders")</a></div></div>
                <div class="col-12 col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-1">3. @T("Workflow_ProductionExecution", "Production execution")</div><div class="small text-muted mb-3">@T("Workflow_ProductionExecutionDescription", "Record and monitor production output.")</div><a href="@OrdersForStatusUrl(ProductionOrderStatus.InProduction)" class="btn btn-sm btn-outline-primary">@T("Workflow_ViewActiveOrders", "View active orders")</a></div></div>
                <div class="col-12 col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-1">4. @T("QualityControl", "Quality control")</div><div class="small text-muted mb-3">@T("Workflow_QualityControlDescription", "Record accepted, rejected, and rework quantities.")</div><a href="@OrdersForStatusUrl(ProductionOrderStatus.QualityControl)" class="btn btn-sm btn-outline-primary">@T("Workflow_ViewQcOrders", "View QC orders")</a></div></div>
                <div class="col-12 col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-1">5. @T("Workflow_FinishedGoods", "Finished goods")</div><div class="small text-muted mb-3">@T("Workflow_FinishedGoodsDescription", "Post accepted quantities into finished-goods inventory.")</div><a href="/inventory/documents" class="btn btn-sm btn-outline-primary">@T("InventoryDocuments", "Inventory documents")</a></div></div>
                <div class="col-12 col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><div class="fw-semibold mb-1">6. @T("Workflow_CompleteOrder", "Complete order")</div><div class="small text-muted mb-3">@T("Workflow_CompleteOrderDescription", "Complete after production quantities and QC checks pass.")</div><a href="/production/orders" class="btn btn-sm btn-outline-primary">@T("Workflow_ReviewCompletion", "Review completion")</a></div></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-body d-flex flex-wrap justify-content-between align-items-center gap-2"><h2 class="h5 mb-0">@T("ProductionOrders", "Production orders")</h2><button class="btn btn-sm btn-outline-secondary" type="button" @onclick="LoadOrdersAsync" disabled="@isLoading">@(isLoading ? T("Workflow_Refreshing", "Refreshing...") : T("Refresh", "Refresh"))</button></div>
        <div class="card-body border-bottom">
            <div class="row g-2">
                <div class="col-12 col-md-6"><label for="orderSearch" class="form-label">@T("Search", "Search")</label><input id="orderSearch" class="form-control" @bind="searchText" @bind:event="oninput" placeholder="@T("Workflow_SearchPlaceholder", "Order number, notes, or status")" /></div>
                <div class="col-12 col-md-4"><label for="statusFilter" class="form-label">@T("Status", "Status")</label><select id="statusFilter" class="form-select" @bind="statusFilter"><option value="">@T("Workflow_AllStatuses", "All statuses")</option>@foreach (var status in Enum.GetValues<ProductionOrderStatus>()) {
                    <option value="@status.ToString()">@StatusLabel(status)</option>
                }
            </select></div>
            <div class="col-12 col-md-2 d-flex align-items-end"><button class="btn btn-outline-secondary w-100" type="button" @onclick="ClearFilters">@T("Workflow_ClearFilters", "Clear filters")</button></div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-4 text-center text-muted">@T("Workflow_LoadingOrders", "Loading production orders...")</div>
    }
    else if (FilteredOrders.Count == 0)
    {
        <div class="p-4 text-center text-muted">@T("Workflow_NoMatchingOrders", "No production orders match these filters.")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>@T("Order", "Order")</th><th>@T("Status", "Status")</th><th>@T("Progress", "Progress")</th><th>@T("Workflow_PlannedEnd", "Planned end")</th><th class="text-end">@T("Action", "Action")</th></tr></thead>
                <tbody>
                    @foreach (var order in FilteredOrders)
                    {
                        var planned = order.Lines.Sum(x => x.PlannedQuantity);
                        var produced = order.Lines.Sum(x => x.ProducedQuantity);
                        var progress = planned > 0 ? (int)Math.Clamp(decimal.ToDouble(produced / planned * 100m), 0d, 100d) : 0;
                        <tr>
                            <td><div class="fw-semibold">@order.OrderNumber</div><div class="small text-muted">@order.Lines.Count @T("Workflow_Lines", "line(s)")</div></td>
                            <td><span class="badge @StatusBadgeClass(order.Status)">@StatusLabel(order.Status)</span></td>
                        <td style="min-width: 150px;"><div class="d-flex justify-content-between small mb-1"><span>@produced.ToString("0.###") / @planned.ToString("0.###")</span><span>@progress%</span></div><div class="progress" role="progressbar" aria-label="@T("Workflow_ProductionProgress", "Production progress")" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100" style="height: 6px;"><div class="progress-bar" style="@($"width: {progress}%")"></div></div></td>
                            <td>@(order.PlannedEndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-end"><a class="btn btn-sm btn-primary" href="@($"/production/orders/edit/{order.Id}")">@T("Workflow_OpenOrder", "Open order")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private List<ProductionOrder> orders = new();
    private bool isLoading = true;
    private string? loadError;
    private string searchText = string.Empty;
    private string statusFilter = string.Empty;

    private int openCount => orders.Count(x => x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled);

    private List<ProductionOrder> FilteredOrders
    {
        get
        {
            IEnumerable<ProductionOrder> query = orders;
            if (!string.IsNullOrWhiteSpace(statusFilter) && Enum.TryParse<ProductionOrderStatus>(statusFilter, out var selectedStatus))
                query = query.Where(x => x.Status == selectedStatus);
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                query = query.Where(x => x.OrderNumber.Contains(term, StringComparison.OrdinalIgnoreCase) || x.Notes.Contains(term, StringComparison.OrdinalIgnoreCase) || StatusLabel(x.Status).Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return query.OrderBy(x => x.Status == ProductionOrderStatus.Completed || x.Status == ProductionOrderStatus.Cancelled).ThenBy(x => x.PlannedEndDate ?? DateTime.MaxValue).ThenByDescending(x => x.CreatedDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Enum.TryParse<ProductionOrderStatus>(StatusQuery, out var requestedStatus))
            statusFilter = requestedStatus.ToString();
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            orders = await Db.ProductionOrders.AsNoTracking().Include(x => x.Lines).OrderByDescending(x => x.CreatedDate).ToListAsync();
        }
        catch (Exception ex)
        {
            loadError = $"{T("Workflow_LoadError", "Could not load production orders")}: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private int CountStatus(ProductionOrderStatus status) => orders.Count(x => x.Status == status);
    private void ClearFilters() { searchText = string.Empty; statusFilter = string.Empty; }

    private string StatusLabel(ProductionOrderStatus status) => status switch
    {
        ProductionOrderStatus.ReadyToStart => T("ReadyToStart", "Ready to Start"),
        ProductionOrderStatus.InProduction => T("InProduction", "In Production"),
        ProductionOrderStatus.QualityControl => T("QualityControl", "Quality Control"),
        ProductionOrderStatus.MaterialChecking => T("MaterialChecking", "Material Checking"),
        ProductionOrderStatus.WaitingForMaterial => T("WaitingForMaterial", "Waiting for Material"),
        ProductionOrderStatus.Planned => T("Planned", "Planned"),
        ProductionOrderStatus.Completed => T("Completed", "Completed"),
        ProductionOrderStatus.Cancelled => T("Cancelled", "Cancelled"),
        _ => LocalizationService.TranslateEnum(status)
    };

    private string T(string key, string fallback)
    {
        var localized = LocalizationService[key];
        return string.Equals(localized, key, StringComparison.Ordinal) ? fallback : localized;
    }

    private static string StatusBadgeClass(ProductionOrderStatus status) => status switch
    {
        ProductionOrderStatus.Planned => "text-bg-secondary",
        ProductionOrderStatus.MaterialChecking => "text-bg-info",
        ProductionOrderStatus.WaitingForMaterial => "text-bg-warning",
        ProductionOrderStatus.ReadyToStart => "text-bg-primary",
        ProductionOrderStatus.InProduction => "text-bg-success",
        ProductionOrderStatus.QualityControl => "text-bg-warning",
        ProductionOrderStatus.Completed => "text-bg-success",
        ProductionOrderStatus.Cancelled => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static string OrdersForStatusUrl(ProductionOrderStatus status) => $"/production/workflow?status={Uri.EscapeDataString(status.ToString())}";
}
