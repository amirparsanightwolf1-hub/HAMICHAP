@page "/production/imposition-optimizer"
@using HamiChap_MES_ERP.Services.Imposition
@inject ImpositionOptimizerService Optimizer

<PageTitle>Imposition Optimizer</PageTitle>
<div class="imp-shell">
    <div class="imp-topline">
        <div class="imp-tabs">
            <button class="imp-tab @(tab == 0 ? "active" : "")" @onclick="() => GoTo(0)"><span>▤</span>Sheet</button>
            <button class="imp-tab @(tab == 1 ? "active" : "")" @onclick="() => GoTo(1)"><span>▦</span>Parts</button>
            <button class="imp-tab @(tab == 2 ? "active" : "")" @onclick="() => GoTo(2)"><span>⚙</span>Setup</button>
            <button class="imp-tab @(tab == 3 ? "active" : "")" @onclick="() => GoTo(3)"><span>◉</span>View</button>
        </div>
        <div class="imp-stats">
            <div class="imp-stat"><b>@D(PreviewStockW) × @D(PreviewStockH) @unit</b><small>Sheet format</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.PiecesPerSheet ?? 0)</b><small>Parts on sheet</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.SheetsRequired ?? 0)</b><small>Sheet copies</small></div>
            <div class="imp-stat"><b>@(results.Count > 0 ? $"{ActiveResult!.UtilizationPercent:0}% / {ActiveResult!.WastePercent:0}%" : "—")</b><small>Fill / waste</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.SheetsRequired ?? 0)</b><small>Total sheets</small></div>
            <div class="imp-stat"><b>@(EstimatedPaperKg.HasValue ? EstimatedPaperKg.Value.ToString("0.##") + " kg" : "—")</b><small>Paper weight required</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.ProducedQuantity ?? 0) / @TotalQty</b><small>Total placed</small></div>
        </div>
    </div>

    <div class="imp-workspace">
        <aside class="imp-sidebar">
            @if (tab == 0)
            {
                <section class="imp-section">
                    <h3>Material</h3>
                    <label>Material type</label><select class="form-select" @bind="mode" @bind:after="ModeChanged"><option>Sheet</option><option>Roll</option></select>
                    <label>Format</label><select class="form-select" @bind="formatName" @bind:after="ApplyFormat"><option value="Custom">Custom</option>@foreach (var f in Formats){
                    <option value="@f.Name">@f.Name — @f.W × @f.H mm</option>
                }
            </select>
            <div class="imp-grid2"><div><label>Width (mm)</label><InputNumber class="form-control" @bind-Value="stockW" @bind-Value:after="RefreshPreview" /></div><div><label>@(mode == "Sheet" ? "Height" : "Repeat") (mm)</label><InputNumber class="form-control" @bind-Value="stockH" @bind-Value:after="RefreshPreview" /></div></div>
            <div class="imp-grid2 mt-2">
                <div><label>Paper weight (gsm)</label><InputNumber class="form-control" min="1" step="1" @bind-Value="paperGsm" @bind-Value:after="RefreshPreview" /></div>
                <div><label>@(mode == "Sheet" ? "Sheets available" : "Repeats available")</label><InputNumber class="form-control" min="0" step="1" @bind-Value="availableStockUnits" @bind-Value:after="RefreshPreview" /></div>
            </div>
            <div class="imp-material-summary">
                <div><span>Required @(mode == "Sheet" ? "sheets" : "repeats")</span><b>@RequiredStockUnits.ToString("N0")</b></div>
                <div><span>Available</span><b>@(availableStockUnits.HasValue ? availableStockUnits.Value.ToString("N0") : "—")</b></div>
                <div><span>Shortage</span><b class="@(StockShortage.GetValueOrDefault() > 0 ? "text-danger" : "text-success")">@(StockShortage.HasValue ? StockShortage.Value.ToString("N0") : "—")</b></div>
                <div><span>Remaining</span><b class="text-success">@(StockRemaining.HasValue ? StockRemaining.Value.ToString("N0") : "—")</b></div>
                <div><span>Material area</span><b>@RequiredMaterialAreaM2.ToString("0.##") m²</b></div>
                <div><span>Estimated paper weight</span><b>@(EstimatedPaperKg.HasValue ? EstimatedPaperKg.Value.ToString("N2") + " kg" : "—")</b></div>
            </div>
            <p class="imp-hint mb-0">Weight is calculated from the full sheet/repeat area × paper grammage × required quantity. It is an estimate and excludes any extra allowance for makeready or spoilage.</p>
        </section>
    }
            else if (tab == 1)
    {
        <section class="imp-section">
            <div class="imp-section-head"><h3>Parts / Required quantities</h3><button class="imp-add" @onclick="AddPart">＋ Add part</button></div>
            <p class="imp-hint">Enter the required production quantity for each part. The optimizer uses these quantities together to calculate the number of sheets or roll repeats needed.</p>
            @foreach (var part in parts)
            {
                <div class="imp-part-row" @key="part.Id">
                    <div class="imp-part-title">
                        <span class="imp-dot" style="background:@PartStroke(parts.IndexOf(part))"></span>
                        <InputText class="form-control" @bind-Value="part.Name" @bind-Value:after="RefreshPreview" placeholder="Part name" />
                        <button class="imp-remove" title="Remove part" disabled="@(parts.Count == 1)" @onclick="() => RemovePart(parts.IndexOf(part))">×</button>
                    </div>
                    <div class="imp-grid2">
                        <div><label>Width (mm)</label><InputNumber class="form-control" min="0.1" step="0.1" @bind-Value="part.W" @bind-Value:after="RefreshPreview" /></div>
                        <div><label>Height (mm)</label><InputNumber class="form-control" min="0.1" step="0.1" @bind-Value="part.H" @bind-Value:after="RefreshPreview" /></div>
                    </div>
                    <div class="imp-quantity-field">
                        <label>Required quantity (pieces)</label>
                        <InputNumber class="form-control" min="1" step="1" @bind-Value="part.Qty" @bind-Value:after="RefreshPreview" />
                        <small>How many finished pieces of this part are needed?</small>
                    </div>
                    <label class="imp-check"><InputCheckbox @bind-Value="part.Rotate" @bind-Value:after="RefreshPreview" /> Allow 90° rotation</label>
                    <div class="imp-part-demand"><span>Required pieces</span><b>@Math.Max(0, part.Qty).ToString("N0")</b></div>
                </div>
            }
            <div class="imp-demand-summary">
                <div><span>Total required pieces</span><b>@TotalQty.ToString("N0")</b></div>
                <div><span>Sheets / repeats needed</span><b>@(ActiveResult?.SheetsRequired.ToString("N0") ?? "—")</b></div>
                <div><span>Pieces planned</span><b>@(ActiveResult?.ProducedQuantity.ToString("N0") ?? "—")</b></div>
                <div><span>Extra pieces</span><b>@(results.FirstOrDefault() is { } r ? Math.Max(0, r.ProducedQuantity - TotalQty).ToString("N0") : "—")</b></div>
            </div>
        </section>
    }
    else if (tab == 2)
    {
        <section class="imp-section">
            <div class="imp-section-head"><h3>Units</h3><span class="imp-help">ⓘ</span></div><p class="imp-hint">All sizes are given in them.</p>
            <div class="imp-setting-line"><label>Unit</label><div class="imp-segment"><button class="@(unit == "mm" ? "selected" : "")" @onclick='() => SetUnit("mm")'>mm</button><button class="@(unit == "in" ? "selected" : "")" @onclick='() => SetUnit("in")'>in</button></div></div>
        </section>
        <section class="imp-section">
            <div class="imp-section-head"><h3>Sheet margin</h3><span class="imp-help">ⓘ</span></div>
            <div class="imp-grid2"><div><label>Top</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginTop" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div><div><label>Right</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginRight" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div><div><label>Bottom</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginBottom" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div><div><label>Left</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginLeft" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div></div>
        </section>
        <section class="imp-section">
            <div class="imp-section-head"><h3>Cutting</h3></div>
            <label class="imp-toggle"><span>Identical sheets</span><InputCheckbox @bind-Value="identicalSheets" /></label>
            <label class="imp-toggle"><span>Center on sheet</span><InputCheckbox @bind-Value="centerOnSheet" @bind-Value:after="RefreshPreview" /></label>
        </section>
        <section class="imp-section">
            <div class="imp-section-head"><h3>Part spacing</h3></div><div><label>Gap between parts</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="gap" @bind-Value:after="RefreshPreview" /><small>mm</small></div></div>
            <label class="imp-hint">Minimum copies per @(mode == "Sheet" ? "sheet" : "repeat")</label>
            @foreach (var a in parts)
            {
                <div class="imp-min-row" @key="a.Id"><span>@a.Name</span><InputNumber class="form-control" min="1" @bind-Value="a.MinPerRepeat" @bind-Value:after="RefreshPreview" /></div>
            }
        </section>
    }
    else
    {
        <section class="imp-section"><h3>Optimization</h3><p class="imp-hint">Generate layouts using the selected sheet, parts, and setup.</p><button class="imp-primary" @onclick="Calculate">Find best layout</button><button class="imp-secondary" @onclick="ResetResults">Clear results</button>@if(!string.IsNullOrWhiteSpace(error)){
            <div class="imp-error">@error</div>
        }
    </section>
}
<div class="imp-sidebar-bottom"><span>Step @(tab + 1) of 4</span><div>@if(tab > 0){
    <button class="imp-secondary" @onclick="() => GoTo(tab - 1)">Back</button>
}
@if (tab < 3)
{
    <button class="imp-primary small" @onclick="() => GoTo(tab + 1)">Next</button>
}
</div></div>
</aside>

<main class="imp-preview-card">
    <div class="imp-preview-toolbar"><div class="imp-layout-label">Layout <button type="button" @onclick="PreviousLayout" disabled="@(results.Count == 0 || selectedLayoutIndex == 0)">‹</button><b>@(results.Count == 0 ? "0 of 0" : $"{selectedLayoutIndex + 1} of {results.Count}")</b><button type="button" @onclick="NextLayout" disabled="@(results.Count == 0 || selectedLayoutIndex >= results.Count - 1)">›</button></div><div class="imp-zoom">−　⌕ 100%　＋　▣</div><div class="imp-actions"><button class="imp-primary" @onclick="Calculate">⇩ Save / Calculate</button></div></div>
    <div class="imp-canvas">
        <svg viewBox="-35 -35 @S(PreviewStockW + 100) @S(PreviewStockH + 95)" role="img" aria-label="Sheet imposition preview">
            <defs><pattern id="impHatch" patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="8" stroke="#d5d9e0" stroke-width="2" /></pattern></defs>
            <rect x="0" y="0" width="@S(PreviewStockW)" height="@S(PreviewStockH)" fill="#fff" stroke="#64748b" stroke-width="1.5" />
            <rect x="0" y="0" width="@S(PreviewStockW)" height="@S(MTop)" fill="url(#impHatch)" />
            <rect x="0" y="@S(PreviewStockH - MBottom)" width="@S(PreviewStockW)" height="@S(MBottom)" fill="url(#impHatch)" />
            <rect x="0" y="@S(MTop)" width="@S(MLeft)" height="@S(Math.Max(0, PreviewStockH - MTop - MBottom))" fill="url(#impHatch)" />
            <rect x="@S(PreviewStockW - MRight)" y="@S(MTop)" width="@S(MRight)" height="@S(Math.Max(0, PreviewStockH - MTop - MBottom))" fill="url(#impHatch)" />
            <rect x="@S(MLeft)" y="@S(MTop)" width="@S(Math.Max(0, PreviewStockW - MLeft - MRight))" height="@S(Math.Max(0, PreviewStockH - MTop - MBottom))" fill="#f8fafc" stroke="#94a3b8" stroke-dasharray="5 4" />
            @if (results.Count > 0 && ActiveResult is not null && ActiveResult.Placements.Count > 0)
            {
                <g transform="translate(@S(PreviewOffsetX) @S(PreviewOffsetY))">
                    @foreach (var p in ActiveResult!.Placements)
                    {
                        <rect x="@S(p.X)" y="@S(p.Y)" width="@S(p.Width)" height="@S(p.Height)" fill="@PartFill(p.ArtworkIndex)" stroke="@PartStroke(p.ArtworkIndex)" stroke-width="1.4" />
                        <foreignObject x="@S(p.X)" y="@S(p.Y + p.Height / 2 - 10)" width="@S(p.Width)" height="20"><div xmlns="http://www.w3.org/1999/xhtml" style="width:100%;height:20px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:7px;color:#26364d;overflow:hidden;white-space:nowrap;">@p.ArtworkName</div></foreignObject>
                    }
                </g>
            }
            <g fill="#008b91" stroke="#008b91" stroke-width="1" font-size="12"><path d="M0 -15 V-22 M@S(PreviewStockW) -15 V-22 M0 -19 H@S(PreviewStockW)" fill="none" /><text x="@S(PreviewStockW / 2)" y="-24" text-anchor="middle">@D(PreviewStockW) @unit</text><path d="M@S(PreviewStockW+20) 0 H@S(PreviewStockW+26) M@S(PreviewStockW+20) @S(PreviewStockH) H@S(PreviewStockW+26) M@S(PreviewStockW+23) 0 V@S(PreviewStockH)" fill="none" /><text x="@S(PreviewStockW + 29)" y="@S(PreviewStockH / 2)" transform="rotate(90 @S(PreviewStockW + 29) @S(PreviewStockH / 2))" text-anchor="middle">@D(PreviewStockH) @unit</text><path d="M0 @S(PreviewStockH + 18) V@S(PreviewStockH+24) M@S(PreviewStockW) @S(PreviewStockH + 18) V@S(PreviewStockH+24) M0 @S(PreviewStockH + 21) H@S(PreviewStockW)" fill="none" /><text x="@S(PreviewStockW / 2)" y="@S(PreviewStockH + 38)" text-anchor="middle">@D(PreviewStockW) @unit</text></g>
        </svg>
    </div>
    <div class="imp-preview-footer"><span>Usable area: @D(Math.Max(0, PreviewStockW - MLeft - MRight)) × @D(Math.Max(0, PreviewStockH - MTop - MBottom)) @unit</span><span>@(ActiveResult is not null ? $"{ActiveResult.Name} · {ActiveResult.WastePercent:0.##}% waste" : "Sheet format preview")</span></div>
</main>
</div>
    @if (results.Count > 0)
{
    <div class="imp-results"><h3>Best 3 layouts — ranked by waste (lowest first)</h3><div class="row g-3">@foreach(var item in results){
        <div class="col-xl-6"><ImpositionAlternativeCard Item="item" RequestedQuantity="TotalQty" RequestedQuantities="RequestedQtyByName" /></div>
    }
</div></div>
    }
</div>

<style>
    .imp-shell {
        padding: 12px 16px 24px;
        background: #f4f5f8;
        min-height: calc(100vh - 70px);
        color: #172033
    }

    .imp-topline {
        display: flex;
        gap: 18px;
        align-items: stretch;
        margin-bottom: 12px
    }

    .imp-tabs {
        display: flex;
        flex: 0 0 292px;
        background: #fff;
        border: 1px solid #e1e4eb;
        border-radius: 13px;
        padding: 5px;
        box-shadow: 0 1px 3px #17203312
    }

    .imp-tab {
        border: 0;
        background: transparent;
        color: #68738a;
        border-radius: 9px;
        flex: 1;
        font-size: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px
    }

        .imp-tab span {
            font-size: 18px
        }

        .imp-tab.active {
            background: #5145f5;
            color: #fff
        }

    .imp-stats {
        display: grid;
        grid-template-columns: repeat(7,minmax(100px,1fr));
        gap: 7px;
        flex: 1
    }

    .imp-stat {
        background: #fff;
        border: 1px solid #e1e4eb;
        border-radius: 12px;
        padding: 9px 11px;
        min-width: 0;
        box-shadow: 0 1px 3px #1720330b
    }

        .imp-stat b {
            display: block;
            font-size: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .imp-stat small {
            display: block;
            color: #788398;
            font-size: 11px;
            margin-top: 3px
        }

    .imp-workspace {
        display: grid;
        grid-template-columns: 292px minmax(0,1fr);
        gap: 18px;
        min-height: calc(100vh - 250px)
    }

    .imp-sidebar {
        background: #fff;
        border: 1px solid #e1e4eb;
        border-radius: 14px;
        padding: 0 16px;
        display: flex;
        flex-direction: column;
        min-height: 600px;
        box-shadow: 0 1px 3px #1720330b
    }

    .imp-section {
        padding: 17px 2px;
        border-bottom: 1px solid #e7e9ef
    }

        .imp-section h3 {
            font-size: 13px;
            font-weight: 700;
            margin: 0
        }

        .imp-section label {
            font-size: 11px;
            color: #45516a;
            margin: 12px 0 5px;
            display: block
        }

        .imp-section .form-control, .imp-section .form-select {
            font-size: 12px;
            min-height: 31px;
            border-color: #dce1ea;
            padding: 5px 8px
        }

    .imp-section-head, .imp-setting-line, .imp-section-head {
        display: flex;
        justify-content: space-between;
        align-items: center
    }

    .imp-help {
        color: #a3aabd
    }

    .imp-hint {
        font-size: 10px;
        color: #8b94a7;
        margin: 7px 0 12px
    }

    .imp-segment {
        display: flex;
        border: 1px solid #dce1ea;
        border-radius: 8px;
        overflow: hidden
    }

        .imp-segment button {
            border: 0;
            background: #fff;
            padding: 5px 18px;
            font-size: 11px;
            color: #58647b
        }

            .imp-segment button.selected {
                background: #5145f5;
                color: white
            }

    .imp-grid2 {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 5px;
        width: 100%;
    }

        .imp-grid2 > div {
            min-width: 0;
            width: 100%;
        }

        .imp-grid2 .form-control {
            width: 100%;
            min-width: 0;
            max-width: 100%;
            padding: 3px 4px;
            font-size: 10px;
            box-sizing: border-box;
        }

    .imp-grid3 {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 8px
    }

    .imp-unit-input {
        position: relative
    }

        .imp-unit-input small {
            position: absolute;
            right: 8px;
            top: 8px;
            color: #8791a4;
            font-size: 10px
        }

        .imp-unit-input .form-control {
            padding-right: 27px
        }

    .imp-toggle {
        display: flex !important;
        justify-content: space-between;
        align-items: center;
        margin: 12px 0 !important
    }

        .imp-toggle input {
            width: 34px;
            height: 18px;
            accent-color: #5145f5
        }

    .imp-min-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin: 7px 0
    }

        .imp-min-row span {
            font-size: 11px
        }

        .imp-min-row .form-control {
            max-width: 76px
        }

    .imp-check {
        display: flex !important;
        align-items: center;
        gap: 7px
    }

        .imp-check input {
            accent-color: #5145f5
        }

    .imp-part-row {
        padding: 12px 0;
        border-bottom: 1px solid #edf0f4
    }

    .imp-part-title {
        display: flex;
        align-items: center;
        gap: 7px
    }

        .imp-part-title .form-control {
            flex: 1
        }

    .imp-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%
    }

    .imp-remove {
        border: 0;
        background: none;
        color: #d44b55;
        font-size: 18px
    }

    .imp-add {
        border: 0;
        background: #f0efff;
        color: #5145f5;
        border-radius: 7px;
        padding: 5px 9px;
        font-size: 11px
    }

    .imp-primary, .imp-secondary {
        border: 1px solid #5145f5;
        background: #5145f5;
        color: #fff;
        border-radius: 8px;
        padding: 8px 13px;
        font-size: 11px
    }

    .imp-secondary {
        background: #fff;
        color: #59647a;
        border-color: #dce1ea
    }

    .imp-primary.small {
        padding: 6px 12px
    }

    .imp-sidebar-bottom {
        margin-top: auto;
        padding: 13px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #8791a4;
        font-size: 11px
    }

        .imp-sidebar-bottom div {
            display: flex;
            gap: 7px
        }

    .imp-preview-card {
        background: #fff;
        border: 1px solid #e1e4eb;
        border-radius: 14px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        min-width: 0;
        box-shadow: 0 1px 3px #1720330b
    }

    .imp-preview-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px
    }

    .imp-layout-label, .imp-zoom {
        border: 1px solid #e5e8ef;
        border-radius: 20px;
        padding: 8px 12px;
        font-size: 11px;
        color: #657087
    }

        .imp-layout-label span {
            padding: 0 12px;
            color: #aab1bf
        }

        .imp-layout-label b {
            color: #202b40
        }

    .imp-actions {
        display: flex;
        gap: 7px
    }

        .imp-actions button {
            border: 1px solid #dce1ea;
            background: #fff;
            border-radius: 22px;
            padding: 8px 13px;
            font-size: 11px;
            color: #344056
        }

            .imp-actions button.imp-primary {
                background: #5145f5;
                color: white;
                border-color: #5145f5
            }

    .imp-canvas {
        background: #f2f3f6;
        border-radius: 8px;
        flex: 1;
        min-height: 550px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: auto;
        padding: 25px
    }

        .imp-canvas svg {
            width: 100%;
            height: auto;
            max-height: calc(100vh - 320px);
            min-height: 430px;
            overflow: visible
        }

    .imp-preview-footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 3px 0;
        color: #818ba0;
        font-size: 10px
    }

    .imp-results {
        margin-top: 18px
    }

        .imp-results h3 {
            font-size: 17px
        }

    .imp-error {
        margin-top: 12px;
        padding: 10px;
        border-radius: 8px;
        background: #fff0f0;
        color: #a92e38;
        font-size: 11px
    }

    .imp-material-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 13px;
        padding: 10px;
        background: #f7f8fc;
        border: 1px solid #e8ebf2;
        border-radius: 9px
    }

        .imp-material-summary div {
            display: flex;
            flex-direction: column;
            gap: 3px
        }

        .imp-material-summary span {
            font-size: 10px;
            color: #818ba0
        }

        .imp-material-summary b {
            font-size: 13px;
            color: #263248
        }

    .imp-quantity-field {
        margin-top: 7px
    }

        .imp-quantity-field label {
            margin-top: 8px !important
        }

        .imp-quantity-field small {
            display: block;
