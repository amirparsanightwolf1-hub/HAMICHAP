@page "/production/imposition-optimizer"
@inject LocalizationService L
@using HamiChap_MES_ERP.Services.Imposition
@inject ImpositionOptimizerService Optimizer

<PageTitle>@L["Imposition Optimizer"]</PageTitle>
<div class="imp-shell">
    <div class="imp-topline">
        <div class="imp-tabs">
            <button class="imp-tab @(tab == 0 ? "active" : "")" @onclick="() => GoTo(0)"><span>▤</span>@L["Sheet"]</button>
            <button class="imp-tab @(tab == 1 ? "active" : "")" @onclick="() => GoTo(1)"><span>▦</span>Parts</button>
            <button class="imp-tab @(tab == 2 ? "active" : "")" @onclick="() => GoTo(2)"><span>⚙</span>Setup</button>
            <button class="imp-tab @(tab == 3 ? "active" : "")" @onclick="() => GoTo(3)"><span>◉</span>View</button>
        </div>
        <div class="imp-stats">
            <div class="imp-stat"><b>@D(PreviewStockW) × @D(PreviewStockH) @unit</b><small>@L["Sheet format"]</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.PiecesPerSheet ?? 0)</b><small>@L["Parts on sheet"]</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.SheetsRequired ?? 0)</b><small>@L["Sheet copies"]</small></div>
            <div class="imp-stat"><b>@(results.Count > 0 ? $"{ActiveResult!.UtilizationPercent:0}% / {ActiveResult!.WastePercent:0}%" : "—")</b><small>@L["Fill / waste"]</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.SheetsRequired ?? 0)</b><small>@L["Total sheets"]</small></div>
            <div class="imp-stat"><b>@(EstimatedPaperKg.HasValue ? EstimatedPaperKg.Value.ToString("0.##") + " kg" : "—")</b><small>@L["Paper weight required"]</small></div>
            <div class="imp-stat"><b>@(ActiveResult?.ProducedQuantity ?? 0) / @TotalQty</b><small>@L["Total placed"]</small></div>
        </div>
    </div>

    <div class="imp-workspace">
        <aside class="imp-sidebar">
            @if (tab == 0)
            {
                <section class="imp-section">
                    <h3>@L["Material"]</h3>
                    <label>@L["Material type"]</label><select class="form-select" @bind="mode" @bind:after="ModeChanged"><option>@L["Sheet"]</option><option>@L["Roll"]</option></select>
                    <label>@L["Format"]</label><select class="form-select" @bind="formatName" @bind:after="ApplyFormat"><option value="Custom">@L["Custom"]</option>@foreach (var f in Formats){
                    <option value="@f.Name">@f.Name — @f.W × @f.H mm</option>
                }
            </select>
            <div class="imp-grid2"><div><label>@L["Width (mm)"]</label><InputNumber class="form-control" @bind-Value="stockW" @bind-Value:after="RefreshPreview" /></div><div><label>@(mode == "Sheet" ? "Height" : "Repeat") (mm)</label><InputNumber class="form-control" @bind-Value="stockH" @bind-Value:after="RefreshPreview" /></div></div>
            <div class="imp-grid2 mt-2">
                <div><label>@L["Paper weight (gsm)"]</label><InputNumber class="form-control" min="1" step="1" @bind-Value="paperGsm" @bind-Value:after="RefreshPreview" /></div>
                <div><label>@(mode == "Sheet" ? "Sheets available" : "Repeats available")</label><InputNumber class="form-control" min="0" step="1" @bind-Value="availableStockUnits" @bind-Value:after="RefreshPreview" /></div>
            </div>
            <div class="imp-material-summary">
                <div><span>Required @(mode == "Sheet" ? "sheets" : "repeats")</span><b>@RequiredStockUnits.ToString("N0")</b></div>
                <div><span>@L["Available"]</span><b>@(availableStockUnits.HasValue ? availableStockUnits.Value.ToString("N0") : "—")</b></div>
                <div><span>@L["Shortage"]</span><b class="@(StockShortage.GetValueOrDefault() > 0 ? "text-danger" : "text-success")">@(StockShortage.HasValue ? StockShortage.Value.ToString("N0") : "—")</b></div>
                <div><span>@L["Remaining"]</span><b class="text-success">@(StockRemaining.HasValue ? StockRemaining.Value.ToString("N0") : "—")</b></div>
                <div><span>@L["Material area"]</span><b>@RequiredMaterialAreaM2.ToString("0.##") m²</b></div>
                <div><span>@L["Estimated paper weight"]</span><b>@(EstimatedPaperKg.HasValue ? EstimatedPaperKg.Value.ToString("N2") + " kg" : "—")</b></div>
            </div>
            <p class="imp-hint mb-0">@L["Weight is calculated from the full sheet/repeat area × paper grammage × required quantity. It is an estimate and excludes any extra allowance for makeready or spoilage."]</p>
        </section>
    }
            else if (tab == 1)
    {
        <section class="imp-section">
            <div class="imp-section-head"><h3>@L["Parts / Required quantities"]</h3><button class="imp-add" @onclick="AddPart">@L["＋ Add part"]</button></div>
            <p class="imp-hint">@L["Enter the required production quantity for each part. The optimizer uses these quantities together to calculate the number of sheets or roll repeats needed."]</p>
            @foreach (var part in parts)
            {
                <div class="imp-part-row" @key="part.Id">
                    <div class="imp-part-title">
                        <span class="imp-dot" style="background:@PartStroke(parts.IndexOf(part))"></span>
                        <InputText class="form-control" @bind-Value="part.Name" @bind-Value:after="RefreshPreview" placeholder="@L["Part name"]" />
                        <button class="imp-remove" title="@L["Remove part"]" disabled="@(parts.Count == 1)" @onclick="() => RemovePart(parts.IndexOf(part))">×</button>
                    </div>
                    <div class="imp-grid2">
                        <div><label>@L["Width (mm)"]</label><InputNumber class="form-control" min="0.1" step="0.1" @bind-Value="part.W" @bind-Value:after="RefreshPreview" /></div>
                        <div><label>@L["Height (mm)"]</label><InputNumber class="form-control" min="0.1" step="0.1" @bind-Value="part.H" @bind-Value:after="RefreshPreview" /></div>
                    </div>
                    <div class="imp-quantity-field">
                        <label>@L["Required quantity (pieces)"]</label>
                        <InputNumber class="form-control" min="1" step="1" @bind-Value="part.Qty" @bind-Value:after="RefreshPreview" />
                        <small>@L["How many finished pieces of this part are needed?"]</small>
                    </div>
                    <label class="imp-check"><InputCheckbox @bind-Value="part.Rotate" @bind-Value:after="RefreshPreview" /> @L["Allow 90° rotation"]</label>
                    <div class="imp-part-demand"><span>@L["Required pieces"]</span><b>@Math.Max(0, part.Qty).ToString("N0")</b></div>
                </div>
            }
            <div class="imp-demand-summary">
                <div><span>@L["Total required pieces"]</span><b>@TotalQty.ToString("N0")</b></div>
                <div><span>@L["Sheets / repeats needed"]</span><b>@(ActiveResult?.SheetsRequired.ToString("N0") ?? "—")</b></div>
                <div><span>@L["Pieces planned"]</span><b>@(ActiveResult?.ProducedQuantity.ToString("N0") ?? "—")</b></div>
                <div><span>@L["Extra pieces"]</span><b>@(results.FirstOrDefault() is { } r ? Math.Max(0, r.ProducedQuantity - TotalQty).ToString("N0") : "—")</b></div>
            </div>
        </section>
    }
    else if (tab == 2)
    {
        <section class="imp-section">
            <div class="imp-section-head"><h3>@L["Units"]</h3><span class="imp-help">ⓘ</span></div><p class="imp-hint">@L["All sizes are given in them."]</p>
            <div class="imp-setting-line"><label>@L["Unit"]</label><div class="imp-segment"><button class="@(unit == "mm" ? "selected" : "")" @onclick='() => SetUnit("mm")'>mm</button><button class="@(unit == "in" ? "selected" : "")" @onclick='() => SetUnit("in")'>in</button></div></div>
        </section>
        <section class="imp-section">
            <div class="imp-section-head"><h3>@L["Sheet margin"]</h3><span class="imp-help">ⓘ</span></div>
            <div class="imp-grid2"><div><label>@L["Top"]</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginTop" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div><div><label>@L["Right"]</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginRight" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div><div><label>@L["Bottom"]</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginBottom" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div><div><label>@L["Left"]</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="marginLeft" @bind-Value:after="RefreshPreview" /><small>@unit</small></div></div></div>
        </section>
        <section class="imp-section">
            <div class="imp-section-head"><h3>@L["Cutting"]</h3></div>
            <label class="imp-toggle"><span>@L["Identical sheets"]</span><InputCheckbox @bind-Value="identicalSheets" /></label>
            <label class="imp-toggle"><span>@L["Center on sheet"]</span><InputCheckbox @bind-Value="centerOnSheet" @bind-Value:after="RefreshPreview" /></label>
        </section>
        <section class="imp-section">
            <div class="imp-section-head"><h3>@L["Part spacing"]</h3></div><div><label>@L["Gap between parts"]</label><div class="imp-unit-input"><InputNumber class="form-control" @bind-Value="gap" @bind-Value:after="RefreshPreview" /><small>mm</small></div></div>
            <label class="imp-hint">Minimum copies per @(mode == "Sheet" ? "sheet" : "repeat")</label>
            @foreach (var a in parts)
            {
                <div class="imp-min-row" @key="a.Id"><span>@a.Name</span><InputNumber class="form-control" min="1" @bind-Value="a.MinPerRepeat" @bind-Value:after="RefreshPreview" /></div>
            }
        </section>
    }
    else
    {
        <section class="imp-section"><h3>@L["Optimization"]</h3><p class="imp-hint">@L["Generate layouts using the selected sheet, parts, and setup."]</p><button class="imp-primary" @onclick="Calculate">@L["Find best layout"]</button><button class="imp-secondary" @onclick="ResetResults">@L["Clear results"]</button>@if(!string.IsNullOrWhiteSpace(error)){
            <div class="imp-error">@error</div>
        }
    </section>
}
<div class="imp-sidebar-bottom"><span>Step @(tab + 1) of 4</span><div>@if(tab > 0){
    <button class="imp-secondary" @onclick="() => GoTo(tab - 1)">@L["Back"]</button>
}
@if (tab < 3)
{
    <button class="imp-primary small" @onclick="() => GoTo(tab + 1)">@L["Next"]</button>
}
</div></div>
</aside>

<main class="imp-preview-card">
    <div class="imp-preview-toolbar"><div class="imp-layout-label">@L["Layout"] <button type="button" @onclick="PreviousLayout" disabled="@(results.Count == 0 || selectedLayoutIndex == 0)">‹</button><b>@(results.Count == 0 ? "0 of 0" : $"{selectedLayoutIndex + 1} of {results.Count}")</b><button type="button" @onclick="NextLayout" disabled="@(results.Count == 0 || selectedLayoutIndex >= results.Count - 1)">›</button></div><div class="imp-zoom">−　⌕ 100%　＋　▣</div><div class="imp-actions"><button class="imp-primary" @onclick="Calculate">@L["⇩ Save / Calculate"]</button></div></div>
    <div class="imp-canvas">
        <svg viewBox="-35 -35 @S(PreviewStockW + 100) @S(PreviewStockH + 95)" role="img" aria-label="@L["Sheet imposition preview"]">
            <defs><pattern id="impHatch" patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="8" stroke="#d5d9e0" stroke-width="2" /></pattern></defs>
            <rect x="0" y="0" width="@S(PreviewStockW)" height="@S(PreviewStockH)" fill="#fff" stroke="#64748b" stroke-width="1.5" />
            <rect x="0" y="0" width="@S(PreviewStockW)" height="@S(MTop)" fill="url(#impHatch)" />
            <rect x="0" y="@S(PreviewStockH - MBottom)" width="@S(PreviewStockW)" height="@S(MBottom)" fill="url(#impHatch)" />
            <rect x="0" y="@S(MTop)" width="@S(MLeft)" height="@S(Math.Max(0, PreviewStockH - MTop - MBottom))" fill="url(#impHatch)" />
            <rect x="@S(PreviewStockW - MRight)" y="@S(MTop)" width="@S(MRight)" height="@S(Math.Max(0, PreviewStockH - MTop - MBottom))" fill="url(#impHatch)" />
            <rect x="@S(MLeft)" y="@S(MTop)" width="@S(Math.Max(0, PreviewStockW - MLeft - MRight))" height="@S(Math.Max(0, PreviewStockH - MTop - MBottom))" fill="#f8fafc" stroke="#94a3b8" stroke-dasharray="5 4" />
            @if (results.Count > 0 && ActiveResult is not null && ActiveResult.Placements.Count > 0)
            {
                <g transform="translate(@S(PreviewOffsetX) @S(PreviewOffsetY))">
                    @foreach (var p in ActiveResult!.Placements)
                    {
                        <rect x="@S(p.X)" y="@S(p.Y)" width="@S(p.Width)" height="@S(p.Height)" fill="@PartFill(p.ArtworkIndex)" stroke="@PartStroke(p.ArtworkIndex)" stroke-width="1.4" />
                        <foreignObject x="@S(p.X)" y="@S(p.Y + p.Height / 2 - 10)" width="@S(p.Width)" height="20"><div class="erp-imposition-piece-label" xmlns="http://www.w3.org/1999/xhtml" >@p.ArtworkName</div></foreignObject>
                    }
                </g>
            }
            <g fill="#008b91" stroke="#008b91" stroke-width="1" font-size="12"><path d="M0 -15 V-22 M@S(PreviewStockW) -15 V-22 M0 -19 H@S(PreviewStockW)" fill="none" /><text x="@S(PreviewStockW / 2)" y="-24" text-anchor="middle">@D(PreviewStockW) @unit</text><path d="M@S(PreviewStockW+20) 0 H@S(PreviewStockW+26) M@S(PreviewStockW+20) @S(PreviewStockH) H@S(PreviewStockW+26) M@S(PreviewStockW+23) 0 V@S(PreviewStockH)" fill="none" /><text x="@S(PreviewStockW + 29)" y="@S(PreviewStockH / 2)" transform="rotate(90 @S(PreviewStockW + 29) @S(PreviewStockH / 2))" text-anchor="middle">@D(PreviewStockH) @unit</text><path d="M0 @S(PreviewStockH + 18) V@S(PreviewStockH+24) M@S(PreviewStockW) @S(PreviewStockH + 18) V@S(PreviewStockH+24) M0 @S(PreviewStockH + 21) H@S(PreviewStockW)" fill="none" /><text x="@S(PreviewStockW / 2)" y="@S(PreviewStockH + 38)" text-anchor="middle">@D(PreviewStockW) @unit</text></g>
        </svg>
    </div>
    <div class="imp-preview-footer"><span>Usable area: @D(Math.Max(0, PreviewStockW - MLeft - MRight)) × @D(Math.Max(0, PreviewStockH - MTop - MBottom)) @unit</span><span>@(ActiveResult is not null ? $"{ActiveResult.Name} · {ActiveResult.WastePercent:0.##}% waste" : "Sheet format preview")</span></div>
</main>
</div>
    @if (results.Count > 0)
{
    <div class="imp-results"><h3>@L["Best 3 layouts — ranked by waste (lowest first)"]</h3><div class="row g-3">@foreach(var item in results){
        <div class="col-xl-6"><ImpositionAlternativeCard Item="item" RequestedQuantity="TotalQty" RequestedQuantities="RequestedQtyByName" /></div>
    }
</div></div>
    }
</div>



@code {
    private sealed class PartRow { public Guid Id { get; set; } = Guid.NewGuid(); public string Name { get; set; } = "Part 1"; public decimal W { get; set; } = 310; public decimal H { get; set; } = 160; public int Qty { get; set; } = 24; public int MinPerRepeat { get; set; } = 1; public bool Rotate { get; set; } = true; }
    private sealed record StockFormat(string Name, decimal W, decimal H);
    private readonly List<StockFormat> sheetFormats = new() { new("1400 × 1000", 1400, 1000), new("700 × 1000", 700, 1000), new("500 × 700", 500, 700), new("350 × 500", 350, 500), new("900 × 1200", 900, 1200), new("600 × 900", 600, 900), new("450 × 600", 450, 600), new("300 × 450", 300, 450) };
    private readonly List<StockFormat> rollFormats = new() { new("330 mm roll", 330, 500), new("440 mm roll", 440, 500), new("520 mm roll", 520, 500), new("640 mm roll", 640, 500), new("700 mm roll", 700, 500) };
    private List<PartRow> parts = new() { new PartRow() }; private int tab; private int selectedLayoutIndex; private string mode = "Sheet", formatName = "1400 × 1000", unit = "mm"; private decimal stockW = 1400, stockH = 1000, marginTop = 0, marginRight = 0, marginBottom = 0, marginLeft = 0, gap = 0, paperGsm = 300; private int? availableStockUnits; private bool identicalSheets, centerOnSheet; private string? error; private List<ImpositionAlternative> results = new();
    private IEnumerable<StockFormat> Formats => mode == "Sheet" ? sheetFormats : rollFormats; private int TotalQty => parts.Sum(x => Math.Max(0, x.Qty));
    private ImpositionAlternative? ActiveResult => results.Count == 0 ? null : results[Math.Clamp(selectedLayoutIndex, 0, results.Count - 1)];
    private decimal PreviewStockW => ActiveResult?.StockWidthMm ?? stockW;
    private decimal PreviewStockH => ActiveResult?.StockHeightMm ?? stockH;
    private void PreviousLayout() { if (selectedLayoutIndex > 0) selectedLayoutIndex--; }
    private void NextLayout() { if (selectedLayoutIndex < results.Count - 1) selectedLayoutIndex++; }
    private int RequiredStockUnits => ActiveResult?.SheetsRequired ?? 0;
    private int? StockShortage => availableStockUnits.HasValue ? Math.Max(0, RequiredStockUnits - availableStockUnits.Value) : null;
    private int? StockRemaining => availableStockUnits.HasValue ? Math.Max(0, availableStockUnits.Value - RequiredStockUnits) : null;
    private decimal RequiredMaterialAreaM2 => ActiveResult is { } r ? r.StockWidthMm * r.StockHeightMm / 1_000_000m * r.SheetsRequired : 0m;
    private decimal? EstimatedPaperKg => results.Count == 0 || paperGsm <= 0 ? null : RequiredMaterialAreaM2 * paperGsm / 1000m; private IReadOnlyDictionary<string, int> RequestedQtyByName => parts.GroupBy(x => x.Name.Trim(), StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.Sum(x => x.Qty), StringComparer.Ordinal);
    private decimal MTop => unit == "in" ? marginTop * 25.4m : marginTop; private decimal MRight => unit == "in" ? marginRight * 25.4m : marginRight; private decimal MBottom => unit == "in" ? marginBottom * 25.4m : marginBottom; private decimal MLeft => unit == "in" ? marginLeft * 25.4m : marginLeft;
    private static string S(decimal n) => n.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    // All solver geometry remains in millimetres; only the displayed dimension labels follow Setup > Units.
    private string D(decimal millimetres) => (unit == "in" ? millimetres / 25.4m : millimetres).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private decimal PreviewOffsetX
    {
        get
        {
            var placements = ActiveResult?.Placements;
            if (!centerOnSheet || placements is null || placements.Count == 0) return 0m;
            var min = placements.Min(p => p.X); var max = placements.Max(p => p.X + p.Width);
            var usableCenter = (MLeft + (PreviewStockW - MLeft - MRight) / 2m);
            return usableCenter - (min + max) / 2m;
        }
    }
    private decimal PreviewOffsetY
    {
        get
        {
            var placements = ActiveResult?.Placements;
            if (!centerOnSheet || mode == "Roll" || placements is null || placements.Count == 0) return 0m;
            var min = placements.Min(p => p.Y); var max = placements.Max(p => p.Y + p.Height);
            var usableCenter = (MTop + (PreviewStockH - MTop - MBottom) / 2m);
            return usableCenter - (min + max) / 2m;
        }
    }
    private void GoTo(int n) { tab = Math.Clamp(n, 0, 3); if (tab == 1) RefreshPreview(); }
    private void SetUnit(string value) { if (unit == value) return; if (value == "in") { marginTop /= 25.4m; marginRight /= 25.4m; marginBottom /= 25.4m; marginLeft /= 25.4m; } else { marginTop *= 25.4m; marginRight *= 25.4m; marginBottom *= 25.4m; marginLeft *= 25.4m; } unit = value; RefreshPreview(); }
    private void ModeChanged() { formatName = Formats.First().Name; ApplyFormat(); }
    private void ApplyFormat() { if (formatName == "Custom") return; var f = Formats.FirstOrDefault(x => x.Name == formatName); if (f is null) return; stockW = f.W; stockH = f.H; RefreshPreview(); }
    private void AddPart() { parts.Add(new PartRow { Name = $"Part {parts.Count + 1}" }); RefreshPreview(); }
    private void RemovePart(int i) { if (i >= 0 && i < parts.Count && parts.Count > 1) parts.RemoveAt(i); RefreshPreview(); }
    private void RefreshPreview()
    {
        results.Clear(); selectedLayoutIndex = 0; error = null;
        if (stockW <= 0 || stockH <= 0 || MTop < 0 || MRight < 0 || MBottom < 0 || MLeft < 0 || gap < 0 || MLeft + MRight >= stockW || MTop + MBottom >= stockH) return;
        if (parts.Count == 0 || parts.Any(x => string.IsNullOrWhiteSpace(x.Name) || x.W <= 0 || x.H <= 0 || x.Qty <= 0 || x.MinPerRepeat < 1)) return;
        try
        {
            var input = parts.Select(x => new ImpositionArtwork(x.Name.Trim(), x.W, x.H, x.Qty, x.Rotate, x.MinPerRepeat)).ToList();
            var conservativeMargin = Math.Max(Math.Max(MTop, MBottom), Math.Max(MLeft, MRight));
            results = Optimizer.OptimizeMixed(new MixedImpositionRequest(input, stockW, stockH, conservativeMargin, gap, mode == "Roll", 2)).ToList();
        }
        catch { results.Clear(); }
    }

    private void Calculate()
    {
        error = null; results.Clear(); selectedLayoutIndex = 0;
        try
        {
            if (mode != "Sheet")
            {
                var inputRoll = parts.Select(x => new ImpositionArtwork(x.Name.Trim(), x.W, x.H, x.Qty, x.Rotate, x.MinPerRepeat)).ToList();
                var rollMargin = Math.Max(Math.Max(MTop, MBottom), Math.Max(MLeft, MRight));
                results = Optimizer.OptimizeMixed(new MixedImpositionRequest(inputRoll, stockW, stockH, rollMargin, gap, true, 15)).ToList();
            }
            else
            {
                var input = parts.Select(x => new ImpositionArtwork(x.Name.Trim(), x.W, x.H, x.Qty, x.Rotate, x.MinPerRepeat)).ToList();
                var conservativeMargin = Math.Max(Math.Max(MTop, MBottom), Math.Max(MLeft, MRight));
                var candidates = new List<ImpositionAlternative>();
                foreach (var format in sheetFormats)
                {
                    try
                    {
                        var found = Optimizer.OptimizeMixed(new MixedImpositionRequest(input, format.W, format.H, conservativeMargin, gap, false, 2));
                        foreach (var layout in found)
                            if (layout.ProducedQuantity >= TotalQty && layout.SheetsRequired > 0)
                                candidates.Add(layout with { Name = format.Name });
                    }
                    catch { /* This stock size cannot produce a valid repeat; continue with the other defaults. */ }
                }
                results = candidates
                    .OrderBy(x => x.WastePercent)
                    .ThenBy(x => x.SheetsRequired)
                    .ThenBy(x => x.StockWidthMm * x.StockHeightMm)
                    .Take(3)
                    .ToList();
            }
            if (results.Count == 0 || results.All(x => x.ProducedQuantity < TotalQty))
                error = L["No valid layout was found for the default sheet sizes. Check part dimensions, quantities, margins, spacing and rotation."];
        }
        catch (Exception ex) { error = ex.Message; results.Clear(); }
    }
    private static readonly string[] PartColors = { "#dbeafe", "#dcfce7", "#fef3c7", "#fce7f3", "#ede9fe", "#ffedd5", "#cffafe", "#e2e8f0" }; private static readonly string[] PartBorders = { "#2563eb", "#16a34a", "#d97706", "#db2777", "#7c3aed", "#ea580c", "#0891b2", "#475569" }; private static string PartFill(int i) => PartColors[Math.Abs(i) % PartColors.Length]; private static string PartStroke(int i) => PartBorders[Math.Abs(i) % PartBorders.Length];
    private void ResetResults() { results.Clear(); selectedLayoutIndex = 0; error = null; }
}