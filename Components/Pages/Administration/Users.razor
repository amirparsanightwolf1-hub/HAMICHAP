@page "/administration/users"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using HamiChap_MES_ERP.Data

@attribute [Authorize(Roles = "Administrator")]

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav


<PageTitle>Users</PageTitle>

<h3>Users Management</h3>

<button class="btn btn-primary mb-3" @onclick="@(() => Nav.NavigateTo("/administration/users/create"))">
    Add Employee
</button>


@if (users == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Email</th>
                <th>Name</th>
                <th>Department</th>
                <th>Status</th>
                <th>Roles</th>
                <th></th>
            </tr>
        </thead>


        <tbody>

            @foreach (var user in users)
            {
                <tr>

                    <td>
                        @user.Email
                    </td>

                    <td>
                        @user.FirstName @user.LastName
                    </td>

                    <td>
                        @user.Department
                    </td>

                    <td>
                        @(user.IsActive ? "Active" : "Disabled")
                    </td>
                    
                    <td>

                        @if (userRoles.ContainsKey(user.Id))
                        {
                            @foreach(var role in userRoles[user.Id])
                            {
                                <span class="badge bg-primary me-1">
                                    @role
                                </span>
                            }
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>
}


@code {

    private List<ApplicationUser>? users;
   
    private Dictionary<string, IList<string>> userRoles = new();


    protected override async Task OnInitializedAsync()
    {
        users = UserManager.Users.ToList();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);

            userRoles[user.Id] = roles;
        }
    }

}