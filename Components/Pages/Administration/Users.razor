@page "/administration/users"
@using HamiChap_MES_ERP.Services
@inject LocalizationService L

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using HamiChap_MES_ERP.Data

@attribute [Authorize(Roles = "Administrator")]

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav


<PageTitle>@L["Users"]</PageTitle>

<div class="erp-page-header">
    <h3 class="erp-page-title">@L["Users Management"]</h3>
    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/administration/users/create"))">
        @L["Add Employee"]
    </button>
</div>

@if (users == null)
{
    <p>@L["Loading"]</p>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>@L["Email"]</th>
                <th>@L["Name"]</th>
                <th>@L["Department"]</th>
                <th>@L["Status"]</th>
                <th>@L["Roles"]</th>
                <th></th>
            </tr>
        </thead>


        <tbody>

            @foreach (var user in users)
            {
                <tr>

                    <td>
                        @user.Email
                    </td>

                    <td>
                        @user.FirstName @user.LastName
                    </td>

                    <td>
                        @user.Department
                    </td>

                    <td>
                        @(user.IsActive ? "Active" : "Disabled")
                    </td>
                    
                    <td>

                        @if (userRoles.ContainsKey(user.Id))
                        {
                            @foreach(var role in userRoles[user.Id])
                            {
                                <span class="badge bg-primary me-1">
                                    @role
                                </span>
                            }
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>
}


@code {

    private List<ApplicationUser>? users;
   
    private Dictionary<string, IList<string>> userRoles = new();


    protected override async Task OnInitializedAsync()
    {
        users = UserManager.Users.ToList();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);

            userRoles[user.Id] = roles;
        }
    }

}