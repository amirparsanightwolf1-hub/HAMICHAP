@page "/administration/users"
@using HamiChap_MES_ERP.Services
@inject LocalizationService L

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using Microsoft.EntityFrameworkCore

@attribute [Authorize(Roles = "Administrator")]

@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav


<PageTitle>@L["Users"]</PageTitle>

<div class="page-container hc-admin-page">
<div class="erp-page-header hc-standard-header">
    <div class="hc-heading-content">
        <span class="hc-heading-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
        <div><h1 class="erp-page-title">@L["Users Management"]</h1><p class="erp-page-subtitle">@(L.IsPersian ? "حساب‌های کارکنان، نقش‌ها و دستگاه‌ها" : "Employee accounts, roles and assigned machines.")</p></div>
    </div>
    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/administration/users/create"))">
        @L["Add Employee"]
    </button>
</div>

@if (!string.IsNullOrEmpty(assignmentMessage))
{
    <div class="alert @(assignmentError ? "alert-danger" : "alert-success")">@assignmentMessage</div>
}

@if (users == null)
{
    <p>@L["Loading"]</p>
}
else
{
    <div class="table-responsive"><table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>@L["Email"]</th>
                <th>@L["Name"]</th>
                <th>@L["Department"]</th>
                <th>@L["Status"]</th>
                <th>@L["Roles"]</th>
                <th>Assigned machine / دستگاه اختصاص‌یافته</th>
                <th></th>
            </tr>
        </thead>


        <tbody>

            @foreach (var user in users)
            {
                <tr>

                    <td>
                        @user.Email
                    </td>

                    <td>
                        @user.FirstName @user.LastName
                    </td>

                    <td>
                        @user.Department
                    </td>

                    <td>
                        @(user.IsActive ? "Active" : "Disabled")
                    </td>
                    
                    <td>

                        @if (userRoles.ContainsKey(user.Id))
                        {
                            @foreach(var role in userRoles[user.Id])
                            {
                                <span class="badge bg-primary me-1">
                                    @role
                                </span>
                            }
                        }

                    </td>
                    <td>
                        <select class="form-select form-select-sm" value="@(user.AssignedMachineId?.ToString() ?? "0")"
                                @onchange="e => AssignMachineAsync(user.Id, e.Value?.ToString())">
                            <option value="0">No machine assigned / بدون دستگاه</option>
                            @foreach (var machine in machines)
                            {
                                <option value="@machine.Id">@machine.Name</option>
                            }
                        </select>
                    </td>

                </tr>
            }

        </tbody>

    </table></div>
}
</div>

@code {

    private List<ApplicationUser>? users;
    private List<Machine> machines = new();
    private string? assignmentMessage;
    private bool assignmentError;
   
    private Dictionary<string, IList<string>> userRoles = new();


    protected override async Task OnInitializedAsync()
    {
        users = await UserManager.Users.ToListAsync();
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            machines = await db.Machines.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        }

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);

            userRoles[user.Id] = roles;
        }
    }

    private async Task AssignMachineAsync(string userId, string? value)
    {
        assignmentMessage = null;
        assignmentError = false;
        if (!int.TryParse(value, out var parsed) || parsed < 0)
        {
            assignmentError = true;
            assignmentMessage = "Invalid machine selection.";
            return;
        }

        var user = await UserManager.FindByIdAsync(userId);
        if (user == null)
        {
            assignmentError = true;
            assignmentMessage = "User not found.";
            return;
        }

        if (parsed != 0 && !machines.Any(x => x.Id == parsed))
        {
            assignmentError = true;
            assignmentMessage = "Machine is not active.";
            return;
        }

        user.AssignedMachineId = parsed == 0 ? null : parsed;
        var result = await UserManager.UpdateAsync(user);
        assignmentError = !result.Succeeded;
        assignmentMessage = result.Succeeded
            ? "Operator machine assignment saved."
            : string.Join("; ", result.Errors.Select(x => x.Description));
        if (result.Succeeded && users != null)
        {
            var displayed = users.FirstOrDefault(x => x.Id == userId);
            if (displayed != null) displayed.AssignedMachineId = user.AssignedMachineId;
        }
    }

}