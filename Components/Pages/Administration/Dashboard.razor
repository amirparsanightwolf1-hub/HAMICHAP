@page "/administration"
@using HamiChap_MES_ERP.Services
@inject LocalizationService L

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Administrator")]

<PageTitle>@L["Administration"]</PageTitle>

<div class="erp-page-header">
    <h3 class="erp-page-title">@L["Administration"]</h3>
</div>

<div class="row">

    <div class="col-md-4">
        <div class="card p-3 mb-3">
            <h5>@L["Users"]</h5>
            <p>
                @L["Manage employees and user accounts."]
            </p>

            <a href="/administration/users" class="btn btn-primary">
                @L["Manage Users"]
            </a>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card p-3 mb-3">
            <h5>@L["Roles"]</h5>
            <p>
                @L["Manage access levels."]
            </p>

            <a href="/administration/roles" class="btn btn-primary">
                @L["Manage Roles"]
            </a>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card p-3 mb-3">
            <h5>@L["Permissions"]</h5>
            <p>
                @L["Control access to system features."]
            </p>

            <a href="/administration/permissions" class="btn btn-primary">
                @L["ManagePermissions"]
            </a>
        </div>
    </div>

</div>