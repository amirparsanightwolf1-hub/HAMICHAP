@page "/administration"
@using HamiChap_MES_ERP.Services
@inject LocalizationService L

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Administrator")]

<PageTitle>@L["Administration"]</PageTitle>

<div class="page-container hc-admin-page">
    <header class="erp-page-header hc-standard-header">
        <div class="hc-heading-content">
            <span class="hc-heading-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
            <div><h1 class="erp-page-title">@L["Administration"]</h1><p class="erp-page-subtitle">@(L.IsPersian ? "مدیریت حساب‌ها، نقش‌ها و دسترسی‌ها" : "Manage employee accounts, roles and access.")</p></div>
        </div>
    </header>
    <div class="hc-admin-dashboard-grid">
        <a href="/administration/users" class="hc-admin-tile">
            <span class="hc-heading-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
            <h2>@L["Users"]</h2><p>@L["Manage employees and user accounts."]</p>
            <span class="hc-admin-tile-action">@L["Manage Users"] <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
        </a>
        <a href="/administration/roles" class="hc-admin-tile">
            <span class="hc-heading-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
            <h2>@L["Roles"]</h2><p>@L["Manage access levels."]</p>
            <span class="hc-admin-tile-action">@L["Manage Roles"] <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
        </a>
        <a href="/administration/permissions" class="hc-admin-tile">
            <span class="hc-heading-icon"><i class="bi bi-key" aria-hidden="true"></i></span>
            <h2>@L["Permissions"]</h2><p>@L["Control access to system features."]</p>
            <span class="hc-admin-tile-action">@L["ManagePermissions"] <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
        </a>
    </div>
</div>
