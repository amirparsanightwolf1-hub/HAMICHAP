@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Services
@inject LocalizationService LocalizationService

<div class="customer-profile">
    <div class="profile-type">
        <span class="profile-type-label" id="@(IdPrefix + "-type-label")">@T("Customer type", "نوع مشتری") <span class="profile-required">*</span></span>
        <div class="profile-type-options" role="group" aria-labelledby="@(IdPrefix + "-type-label")">
            <button type="button" class="profile-type-option @(Profile.CustomerType == CustomerType.Natural ? "selected" : "")"
                    aria-pressed="@(Profile.CustomerType == CustomerType.Natural)" @onclick="() => SelectType(CustomerType.Natural)">
                <i class="bi bi-person" aria-hidden="true"></i>
                <span>@T("Individual", "شخص حقیقی")</span>
                @if (Profile.CustomerType == CustomerType.Natural)
                {
                    <i class="bi bi-check-circle-fill profile-check" aria-hidden="true"></i>
                }
            </button>
            <button type="button" class="profile-type-option @(Profile.CustomerType == CustomerType.Legal ? "selected" : "")"
                    aria-pressed="@(Profile.CustomerType == CustomerType.Legal)" @onclick="() => SelectType(CustomerType.Legal)">
                <i class="bi bi-building" aria-hidden="true"></i>
                <span>@T("Company", "شخص حقوقی")</span>
                @if (Profile.CustomerType == CustomerType.Legal)
                {
                    <i class="bi bi-check-circle-fill profile-check" aria-hidden="true"></i>
                }
            </button>
        </div>
    </div>
    <section class="profile-section" aria-labelledby="@(IdPrefix + "-identity-heading")">
        <h3 id="@(IdPrefix + "-identity-heading")" class="profile-heading"><i class="bi bi-person-vcard" aria-hidden="true"></i> @T("Identity and registration", "اطلاعات هویتی و ثبتی")</h3>
        <div class="profile-grid">
            <div class="profile-field profile-field-wide">
                <label for="@(IdPrefix + "-name")">@(Profile.CustomerType == CustomerType.Legal ? T("Registered company name", "نام ثبتی شرکت") : T("Full name", "نام و نام خانوادگی")) <span class="profile-required">*</span></label>
                <input id="@(IdPrefix + "-name")" class="form-control" @bind="Profile.Name" @bind:event="oninput" @bind:after="NotifyChanged" />
            </div>
            @if (Profile.CustomerType == CustomerType.Natural)
            {
            <div class="profile-field">
                <label for="@(IdPrefix + "-national-id")">@T("National ID number", "کد ملی")</label>
                <InputText id="@(IdPrefix + "-national-id")" class="form-control" dir="ltr" inputmode="numeric" @bind-Value="Profile.NationalId" />
            </div>
            }
            else if (Profile.CustomerType == CustomerType.Legal)
            {
            <div class="profile-field">
                <label for="@(IdPrefix + "-national-code")">@T("National code", "شناسه ملی")</label>
                <InputText id="@(IdPrefix + "-national-code")" class="form-control" dir="ltr" inputmode="numeric" @bind-Value="Profile.NationalCode" />
            </div>
            <div class="profile-field">
                <label for="@(IdPrefix + "-economic-code")">@T("Economic code", "کد اقتصادی")</label>
                <InputText id="@(IdPrefix + "-economic-code")" class="form-control" dir="ltr" @bind-Value="Profile.EconomicCode" />
            </div>
            <div class="profile-field">
                <label for="@(IdPrefix + "-registration")">@T("Registration number", "شماره ثبت")</label>
                <InputText id="@(IdPrefix + "-registration")" class="form-control" dir="ltr" @bind-Value="Profile.RegistrationNumber" />
            </div>
            }
        </div>
    </section>
    <section class="profile-section" aria-labelledby="@(IdPrefix + "-contact-heading")">
        <h3 id="@(IdPrefix + "-contact-heading")" class="profile-heading"><i class="bi bi-telephone" aria-hidden="true"></i> @T("Contact information", "اطلاعات تماس")</h3>
        <div class="profile-grid">
            @if (Profile.CustomerType == CustomerType.Legal)
            {
            <div class="profile-field profile-field-wide">
                <label for="@(IdPrefix + "-contact")">@T("Contact person", "نام رابط شرکت")</label>
                <InputText id="@(IdPrefix + "-contact")" class="form-control" @bind-Value="Profile.ContactPerson" />
            </div>
            }
            <div class="profile-field">
                <label for="@(IdPrefix + "-mobile")">@T("Mobile number", "تلفن همراه")</label>
                <InputText id="@(IdPrefix + "-mobile")" class="form-control" type="tel" dir="ltr" autocomplete="tel-national" @bind-Value="Profile.Mobile" />
            </div>
            <div class="profile-field">
                <label for="@(IdPrefix + "-phone")">@T("Landline phone", "تلفن ثابت")</label>
                <InputText id="@(IdPrefix + "-phone")" class="form-control" type="tel" dir="ltr" @bind-Value="Profile.Phone" />
            </div>
            <div class="profile-field">
                <label for="@(IdPrefix + "-email")">@T("Email address", "ایمیل")</label>
                <InputText id="@(IdPrefix + "-email")" class="form-control" type="email" dir="ltr" autocomplete="email" @bind-Value="Profile.Email" />
            </div>
        </div>
    </section>
    <section class="profile-section" aria-labelledby="@(IdPrefix + "-address-heading")">
        <h3 id="@(IdPrefix + "-address-heading")" class="profile-heading"><i class="bi bi-geo-alt" aria-hidden="true"></i> @T("Address", "نشانی")</h3>
        <div class="profile-grid">
            <div class="profile-field">
                <label for="@(IdPrefix + "-province")">@T("Province / state", "استان")</label>
                <InputText id="@(IdPrefix + "-province")" class="form-control" autocomplete="address-level1" @bind-Value="Profile.Province" />
            </div>
            <div class="profile-field">
                <label for="@(IdPrefix + "-city")">@T("City", "شهر")</label>
                <InputText id="@(IdPrefix + "-city")" class="form-control" autocomplete="address-level2" @bind-Value="Profile.City" />
            </div>
            <div class="profile-field">
                <label for="@(IdPrefix + "-postal")">@T("Postal code", "کد پستی")</label>
                <InputText id="@(IdPrefix + "-postal")" class="form-control" dir="ltr" autocomplete="postal-code" @bind-Value="Profile.PostalCode" />
            </div>
            <div class="profile-field profile-field-wide">
                <label for="@(IdPrefix + "-address")">@T("Full address", "نشانی کامل")</label>
                <InputText id="@(IdPrefix + "-address")" class="form-control" autocomplete="street-address" @bind-Value="Profile.Address" />
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public Customer Profile { get; set; } = new();
    [Parameter] public string IdPrefix { get; set; } = "customer";
    [Parameter] public EventCallback Changed { get; set; }
    private string T(string en, string fa) => LocalizationService.IsPersian ? fa : en;
    private async Task SelectType(CustomerType type)
    {
        Profile.CustomerType = type;
        await NotifyChanged();
    }
    private Task NotifyChanged() => Changed.InvokeAsync();
}
