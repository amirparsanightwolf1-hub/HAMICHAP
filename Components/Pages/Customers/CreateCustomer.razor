@page "/customers/create"
@page "/customers/{CustomerId:int}/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Data
@attribute [Authorize]
@using HamiChap_MES_ERP.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject PermissionService Permissions
@inject NavigationManager Navigation
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService

<PageTitle>@Heading</PageTitle>
<div class="page-container customer-editor">
    <header class="customer-editor-heading">
        <div>
            <h3>@Heading</h3>
            <p>@T("Manage customer identity, contact and address details.", "مدیریت اطلاعات هویتی، تماس و نشانی مشتری.")</p>
        </div>
        <a class="btn btn-outline-secondary" href="/customers"><i class="bi bi-arrow-return-left" aria-hidden="true"></i> @LocalizationService["Customers"]</a>
    </header>
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (loading)
    {
        <p>@LocalizationService["Loading"]</p>
    }
    else if (customer is not null)
    {
        <EditForm Model="customer" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="card customer-editor-card mb-3"><div class="card-body">
                @if (CustomerId.HasValue)
                {
                    <p class="small text-muted">@LocalizationService["Code"]: @customer.Code</p>
                }
                else
                {
                    <p class="small text-muted">@T("Customer code is generated automatically when saved.", "کد مشتری هنگام ذخیره به صورت خودکار ایجاد می‌شود.")</p>
                }
                <CustomerProfileFields Profile="customer" IdPrefix="customer-profile" />
            </div></div>
            <div class="customer-editor-actions">
                <a href="/customers" class="btn btn-outline-secondary">@T("Cancel", "انصراف")</a>
                <button type="submit" class="btn btn-primary" disabled="@isSaving"><i class="bi bi-check2" aria-hidden="true"></i> @LocalizationService["SaveCustomer"]</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? CustomerId { get; set; }
    private Customer? customer;
    private bool loading = true;
    private bool isSaving;
    private string? errorMessage;
    private string Heading => CustomerId.HasValue ? T("Edit customer", "ویرایش مشتری") : LocalizationService["CreateCustomer"];
    private string T(string en, string fa) => LocalizationService.IsPersian ? fa : en;

    private async Task<bool> CanAccessAsync(int? customerId)
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        return customerId.HasValue
            ? await Permissions.HasPermissionAsync(user, "Customers.View") &&
                await Permissions.HasPermissionAsync(user, "Customers.Edit")
            : await Permissions.HasPermissionAsync(user, "Customers.Create");
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        errorMessage = null;
        customer = null;
        var customerId = CustomerId;
        if (!await CanAccessAsync(customerId))
        {
            errorMessage = LocalizationService["AccessDenied"];
            loading = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        customer = customerId.HasValue
            ? await db.Customers.AsNoTracking().FirstOrDefaultAsync(x => x.Id == customerId.Value)
            : new Customer { CustomerType = CustomerType.Natural };
        if (customer is null) errorMessage = T("Customer not found.", "مشتری یافت نشد.");
        loading = false;
    }

    private async Task Save()
    {
        var form = customer;
        var customerId = CustomerId;
        if (isSaving || form is null || form.Id != customerId.GetValueOrDefault()) return;
        errorMessage = null;
        if (form.CustomerType is not (CustomerType.Natural or CustomerType.Legal))
        {
            errorMessage = T("Select customer type.", "نوع مشتری را انتخاب کنید.");
            return;
        }
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            errorMessage = LocalizationService["CustomerNameIsRequired"];
            return;
        }
        try
        {
            isSaving = true;
            if (!await CanAccessAsync(customerId))
            {
                errorMessage = LocalizationService["AccessDenied"];
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            Customer target;
            if (customerId.HasValue)
            {
                target = await db.Customers.FirstOrDefaultAsync(x => x.Id == customerId.Value)
                    ?? throw new InvalidOperationException(T("Customer not found.", "مشتری یافت نشد."));
                db.Entry(target).Property(x => x.RowVersion).OriginalValue = form.RowVersion;
            }
            else
            {
                target = new Customer { Code = await CustomerCodeGenerator.GenerateAsync(db) };
                db.Customers.Add(target);
            }
            form.CopyProfileTo(target);
            await db.SaveChangesAsync();
            Navigation.NavigateTo("/customers");
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = T("Customer was changed elsewhere. Reload before editing.", "اطلاعات مشتری تغییر کرده است. صفحه را دوباره بارگذاری کنید.");
        }
        catch (Exception)
        {
            errorMessage = T("Customer could not be saved. Please try again.", "ذخیره مشتری انجام نشد. دوباره تلاش کنید.");
        }
        finally { isSaving = false; }
    }
}
