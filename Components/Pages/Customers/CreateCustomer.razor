@page "/customers/create"

@using Microsoft.AspNetCore.Authorization
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Data

@attribute [Authorize]

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService

<PageTitle>@LocalizationService["CreateCustomer"]</PageTitle>

<h3>@LocalizationService["CreateCustomer"]</h3>

<EditForm Model="customer"
          OnValidSubmit="Save">

    <DataAnnotationsValidator />

    <p class="text-muted small">@(LocalizationService.IsPersian ? "کد مشتری هنگام ذخیره به صورت خودکار ایجاد می‌شود." : "Customer code is generated automatically when saved.")</p>
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label">
            @LocalizationService["Name"]
        </label>

        <InputText class="form-control"
                   @bind-Value="customer.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            @LocalizationService["Phone"]
        </label>

        <InputText class="form-control"
                   @bind-Value="customer.Phone" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            @LocalizationService["Email"]
        </label>

        <InputText class="form-control"
                   @bind-Value="customer.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            @LocalizationService["Address"]
        </label>

        <InputText class="form-control"
                   @bind-Value="customer.Address" />
    </div>

    <button type="submit"
            class="btn btn-primary" disabled="@isSaving">
        @LocalizationService["SaveCustomer"]
    </button>

</EditForm>

@code {

    private Customer customer = new();
    private bool isSaving;
    private string? errorMessage;

    private async Task Save()
    {
        if (isSaving) return;
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(customer.Name))
        {
            errorMessage = LocalizationService["CustomerNameIsRequired"];
            return;
        }
        try
        {
            isSaving = true;
            customer.Name = customer.Name.Trim();
            customer.Code = await CustomerCodeGenerator.GenerateAsync(Db);
            Db.Customers.Add(customer);
            await Db.SaveChangesAsync();
            Navigation.NavigateTo("/customers");
        }
        catch (Exception)
        {
            Db.Entry(customer).State = Microsoft.EntityFrameworkCore.EntityState.Detached;
            errorMessage = LocalizationService.IsPersian ? "ذخیره مشتری انجام نشد. دوباره تلاش کنید." : "Customer could not be saved. Please try again.";
        }
        finally { isSaving = false; }
    }

}