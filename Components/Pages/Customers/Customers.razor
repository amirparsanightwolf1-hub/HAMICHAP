@page "/customers"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Data

@attribute [Authorize]

@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService

<PageTitle>@LocalizationService["Customers"]</PageTitle>

<div class="page-container">

    <div class="erp-page-header">

        <div>
            <h3 class="erp-page-title">
                @LocalizationService["Customers"]
            </h3>

            <p class="erp-page-subtitle">
                @LocalizationService["ManageCustomersAndInventory"]
            </p>
        </div>

        <div>
            <button type="button"
                    class="btn btn-primary"
                    @onclick="CreateCustomer">

                @LocalizationService["NewCustomer"]

            </button>
        </div>

    </div>

    @if (customers == null)
    {
        <p>@LocalizationService["Loading"]</p>
    }
    else if (totalCount == 0)
    {
        <div class="alert alert-info">
            @LocalizationService["NoCustomersCreated"]
        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-striped table-hover mb-0">

                        <thead>

                            <tr>
                                <th>@LocalizationService["Code"]</th>
                                <th>@LocalizationService["Name"]</th>
                                <th>@LocalizationService["Phone"]</th>
                                <th>@LocalizationService["Status"]</th>
                                <th>@LocalizationService["Inventory"]</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var customer in customers)
                            {
                                <tr>

                                    <td>
                                        @customer.Code
                                    </td>

                                    <td>
                                        <strong>
                                            @customer.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @customer.Phone
                                    </td>

                                    <td>

                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                @LocalizationService["Active"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @LocalizationService["Disabled"]
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                @onclick="() => OpenInventory(customer.Id)">

                                            @LocalizationService["Inventory"]

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        @if (totalPages > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">

                <div class="text-muted small">
                    @((currentPage - 1) * pageSize + 1)
                    -
                    @(Math.Min(currentPage * pageSize, totalCount))
                    /
                    @totalCount
                </div>

                <div class="d-flex align-items-center gap-2">

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="PreviousPage"
                            disabled="@(currentPage <= 1)">

                        @LocalizationService["Previous"]

                    </button>

                    <span class="small">
                        @currentPage / @totalPages
                    </span>

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="NextPage"
                            disabled="@(currentPage >= totalPages)">

                        @LocalizationService["Next"]

                    </button>

                </div>

            </div>
        }

    }

</div>

@code {

    private const int pageSize = 20;

    private List<Customer>? customers;

    private int currentPage = 1;

    private int totalCount;

    private int totalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(totalCount / (double)pageSize);


    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }


    private async Task LoadCustomers()
    {
        totalCount = await Db.Customers.CountAsync();

        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }

        if (totalPages == 0)
        {
            currentPage = 1;
        }

        customers = await Db.Customers
            .OrderBy(x => x.Name)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }


    private async Task PreviousPage()
    {
        if (currentPage <= 1)
            return;

        currentPage--;

        await LoadCustomers();
    }


    private async Task NextPage()
    {
        if (currentPage >= totalPages)
            return;

        currentPage++;

        await LoadCustomers();
    }


    private void CreateCustomer()
    {
        Nav.NavigateTo("/customers/create");
    }


    private void OpenInventory(int customerId)
    {
        Nav.NavigateTo(
            $"/customers/{customerId}/inventory");
    }

}