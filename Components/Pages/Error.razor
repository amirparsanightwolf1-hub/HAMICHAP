@page "/Error"
@attribute [AllowAnonymous]
@using HamiChap_MES_ERP.Services
@inject LocalizationService L
@using System.Diagnostics

<PageTitle>@L["Error"]</PageTitle>

<div class="hc-status-page">
    <section class="hc-status-card">
        <span class="hc-heading-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
        <h1>@L["Error."]</h1>
        <p>@L["An error occurred while processing your request."]</p>
        <p>@(L.IsPersian ? "در صورت تکرار مشکل، شناسه درخواست را به مسئول سیستم اطلاع دهید." : "If the issue continues, share the request ID with your system administrator.")</p>
        @if (ShowRequestId)
        {
            <p><strong>@L["Request ID:"]</strong> <code>@RequestId</code></p>
        }
        <a class="btn btn-primary" href="/"><i class="bi bi-house-door" aria-hidden="true"></i> @(L.IsPersian ? "بازگشت به خانه" : "Return home")</a>
    </section>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
