@page "/sales/invoices/edit/{Id:long}"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SalesInvoice.PageTitle"]</PageTitle>
<div class="page-container" dir="@LocalizationService["Common.TextDirection"]">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="erp-page-title">@LocalizationService["SalesInvoice.Title"]</h3>
            <p class="erp-page-subtitle">@invoice?.InvoiceNumber</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="Back">@LocalizationService["Common.Back"]</button>
            <button class="btn btn-primary" @onclick="Print">@LocalizationService["SalesInvoice.PrintSavePdf"]</button>
        </div>
    </div>
    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border" role="status">
            <span class="visually-hidden">@LocalizationService["Common.Loading"]</span>
        </div></div>
    }
    else if (invoice == null)
    {
        <div class="alert alert-danger">@LocalizationService["SalesInvoice.NotFound"]</div>
    }
    else
    {
        <article class="card shadow-sm p-4" id="invoice-document">
            <div class="d-flex justify-content-between gap-3 flex-wrap">
                <div>
                    <h1 class="h3">@LocalizationService["SalesInvoice.DocumentHeading"]</h1>
                    <div><strong>@invoice.InvoiceNumber</strong></div>
                    <div>@LocalizationService["Common.Date"]: @invoice.InvoiceDate.ToString("yyyy-MM-dd")</div>
                    <div>@LocalizationService["Common.Status"]: @LocalizationService[$"SalesInvoiceStatus.{invoice.Status}"]</div>
                </div>
                <div class="text-end"><h2 class="h5">@LocalizationService["SalesInvoice.BillTo"]</h2><div>@invoice.Customer?.Name</div></div>
            </div>
            <hr />
            <div class="row g-3 mb-4">
                <div class="col-md-4"><strong>@LocalizationService["SalesInvoice.ApprovedQuotation"]</strong><div>@invoice.Quotation?.QuotationNumber</div></div>
                <div class="col-md-4"><strong>@LocalizationService["SalesInvoice.SalesOrder"]</strong><div>@invoice.SalesOrder?.OrderNumber</div></div>
                <div class="col-md-4"><strong>@LocalizationService["SalesInvoice.SalesDelivery"]</strong><div>@invoice.SalesDelivery?.DeliveryNumber</div></div>
            </div>
            <div class="table-responsive"><table class="table table-bordered align-middle">
                <thead><tr>
                    <th>#</th><th>@LocalizationService["Common.Item"]</th>
                    <th>@LocalizationService["SalesInvoice.ApprovedUnitPrice"]</th>
                    <th class="text-end">@LocalizationService["Common.Quantity"]</th>
                    <th class="text-end">@LocalizationService["SalesInvoice.LineTotal"]</th>
                    <th>@LocalizationService["Common.Notes"]</th>
                </tr></thead>
                <tbody>
                @{ var row = 0; }
                @foreach (var line in invoice.Lines)
                {
                    row++;
                    <tr>
                        <td>@row</td><td>@(line.Item?.Name ?? $"#{line.ItemId}")</td>
                        <td>@line.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@line.Quantity.ToString("N2")</td>
                        <td class="text-end">@line.LineTotal.ToString("N2")</td><td>@line.Notes</td>
                    </tr>
                }
                </tbody>
            </table></div>
            <div class="ms-auto mt-3" style="max-width:360px">
                <div class="d-flex justify-content-between py-2"><span>@LocalizationService["Common.Subtotal"]</span><strong>@invoice.Subtotal.ToString("N2")</strong></div>
                <div class="d-flex justify-content-between border-top pt-3 fs-5"><span>@LocalizationService["Common.Total"]</span><strong>@invoice.TotalAmount.ToString("N2")</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(invoice.Notes))
            {
                <div class="mt-4"><strong>@LocalizationService["Common.Notes"]</strong><p class="mb-0">@invoice.Notes</p></div>
            }
            <p class="text-muted text-center mt-5 mb-0">@LocalizationService["SalesInvoice.GeneratedNotice"]</p>
        </article>
    }
</div>
<style>
    @@media print {
        .btn, .erp-page-header { display: none !important; }
        .page-container { padding: 0 !important; margin: 0 !important; }
        #invoice-document { border: 0 !important; box-shadow: none !important; }
    }
</style>
@code {
    [Parameter] public long Id { get; set; }
    private SalesInvoice? invoice;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        invoice = await Db.SalesInvoices.AsNoTracking()
            .Include(x => x.Customer)
            .Include(x => x.Quotation)
            .Include(x => x.SalesOrder)
            .Include(x => x.SalesDelivery)
            .Include(x => x.Lines).ThenInclude(x => x.Item)
            .FirstOrDefaultAsync(x => x.Id == Id);
        isLoading = false;
    }

    private void Back() => Navigation.NavigateTo("/sales/invoices");
    private Task Print() => JS.InvokeVoidAsync("window.print").AsTask();
}
