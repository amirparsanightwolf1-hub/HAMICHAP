@page "/sales/invoices/edit/{Id:long}"

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService
@inject IJSRuntime JS

<PageTitle>@T("SalesInvoicePreview") - @invoice?.InvoiceNumber</PageTitle>

<div class="container-fluid py-3 invoice-page">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <button class="btn btn-outline-secondary" @onclick="BackToInvoices">
            &larr; @T("BackToSalesInvoices")
        </button>
        <button class="btn btn-primary" @onclick="PrintInvoice">
            @T("PrintSavePdf")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 no-print">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">@T("Loading")</p>
        </div>
    }
    else if (invoice is null)
    {
        <div class="alert alert-warning no-print">@T("SalesInvoiceNotFound")</div>
    }
    else
    {
        <article class="invoice-document">
            <header class="document-header">
                <div>
                    <h1>@T("SalesInvoice")</h1>
                    <p class="document-subtitle">@T("SalesInvoicePreview")</p>
                </div>
                <div class="text-end invoice-number">
                    <div class="muted-label">@T("InvoiceNumber")</div>
                    <strong>@invoice.InvoiceNumber</strong>
                    <div class="mt-2">
                        <span class="status-label">@T(invoice.Status.ToString())</span>
                    </div>
                </div>
            </header>

            <hr />

            <section class="info-grid">
                <div>
                    <h2>@T("Customer")</h2>
                    <p class="info-value">@(invoice.Customer?.Name ?? "—")</p>
                </div>
                <div>
                    <h2>@T("InvoiceDate")</h2>
                    <p class="info-value">@FormatDate(invoice.InvoiceDate)</p>
                </div>
                <div>
                    <h2>@T("ApprovedQuotation")</h2>
                    <p class="info-value">@(invoice.Quotation?.QuotationNumber ?? "—")</p>
                </div>
                <div>
                    <h2>@T("SalesOrder")</h2>
                    <p class="info-value">@(invoice.SalesOrder?.OrderNumber ?? "—")</p>
                </div>
                <div>
                    <h2>@T("SalesDelivery")</h2>
                    <p class="info-value">@(invoice.SalesDelivery?.DeliveryNumber ?? "—")</p>
                </div>
            </section>

            <section class="mt-4">
                <h2 class="section-heading">@T("SalesInvoiceItems")</h2>
                <div class="table-responsive">
                    <table class="table invoice-table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>@T("Item")</th>
                                <th>@T("Description")</th>
                                <th class="text-end">@T("Quantity")</th>
                                <th class="text-end">@T("UnitPrice")</th>
                                <th class="text-end">@T("TotalAmount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (invoice.Lines.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center py-4">@T("NoSalesInvoiceLines")</td></tr>
                            }
                            else
                            {
                                var rowNumber = 0;
                                foreach (var line in invoice.Lines)
                                {
                                    rowNumber++;
                                    <tr>
                                        <td class="text-center">@rowNumber</td>
                                        <td>@(line.Item?.Name ?? $"#{line.ItemId}")</td>
                                        <td>@line.Notes</td>
                                        <td class="text-end">@line.Quantity.ToString("N2")</td>
                                        <td class="text-end">@FormatAmount(line.UnitPrice)</td>
                                        <td class="text-end">@FormatAmount(line.LineTotal)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="totals-section">
                <div class="total-row">
                    <span>@T("Subtotal")</span>
                    <span>@FormatAmount(invoice.Subtotal)</span>
                </div>
                <div class="total-row grand-total">
                    <span>@T("TotalAmount")</span>
                    <span>@FormatAmount(invoice.TotalAmount)</span>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(invoice.Notes))
            {
                <section class="notes-section">
                    <h2 class="section-heading">@T("Notes")</h2>
                    <p class="notes-text">@invoice.Notes</p>
                </section>
            }

            <footer class="document-footer"><p>@T("SalesInvoiceFooterMessage")</p></footer>
        </article>
    }
</div>



@code {
    [Parameter] public long Id { get; set; }

    private SalesInvoice? invoice;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        invoice = await Db.SalesInvoices.AsNoTracking()
            .Include(x => x.Customer)
            .Include(x => x.Quotation)
            .Include(x => x.SalesOrder)
            .Include(x => x.SalesDelivery)
            .Include(x => x.Lines).ThenInclude(x => x.Item)
            .FirstOrDefaultAsync(x => x.Id == Id);
        isLoading = false;
    }

    private string T(string key) => LocalizationService[key];
    private static string FormatDate(DateTime date) => date.ToString("yyyy-MM-dd");
    private static string FormatAmount(decimal amount) => amount.ToString("N2");
    private void BackToInvoices() => Navigation.NavigateTo("/sales/invoices");
    private async Task PrintInvoice() => await JS.InvokeVoidAsync("window.print");
}
