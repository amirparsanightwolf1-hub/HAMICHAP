@page "/sales/invoices/edit/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using HamiChap_MES_ERP.Models.Sales.Enums
@inject AuthenticationStateProvider Auth
@inject PermissionService Permissions
@inject ShipmentPaymentService ShipmentPayment

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService
@inject IJSRuntime JS

<PageTitle>@T("SalesInvoicePreview") - @invoice?.InvoiceNumber</PageTitle>

<div class="container-fluid py-3 invoice-page">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <button class="btn btn-outline-secondary" @onclick="BackToInvoices">
            &larr; @T("BackToSalesInvoices")
        </button>
        <button class="btn btn-primary" @onclick="PrintInvoice">
            @T("PrintSavePdf")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 no-print">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">@T("Loading")</p>
        </div>
    }
    else if (invoice is null)
    {
        <div class="alert alert-warning no-print">@T("SalesInvoiceNotFound")</div>
    }
    else
    {
        <section class="card mb-3 no-print">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div><strong>@PaymentText("Payment status", "وضعیت پرداخت")</strong>
                        <div class="small @(invoice.PaidAtUtc.HasValue ? "text-success" : "text-muted")">@(invoice.SalesDelivery.Status == SalesDeliveryStatus.Posted ? PaymentText("Shipment posted", "ارسال ثبت شده") : invoice.PaidAtUtc.HasValue ? PaymentText("Fully paid · ready for shipment", "پرداخت کامل · آماده ارسال") : PaymentText("Awaiting payment", "در انتظار پرداخت"))</div>
                        @if (invoice.PaidAtUtc.HasValue) { <div class="small">@invoice.PaymentReference · @invoice.PaidAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div> }
                    </div>
                    <a class="btn btn-outline-primary btn-sm" href="@($"/sales/deliveries/edit/{invoice.SalesDeliveryId}")">@PaymentText("Shipment", "ارسال")</a>
                </div>
                @if (canConfirm && invoice.Status == SalesInvoiceStatus.Issued && invoice.SalesDelivery.Status == SalesDeliveryStatus.Draft && !invoice.PaidAtUtc.HasValue)
                {
                    <div class="row g-2 align-items-end mt-2">
                        <div class="col-sm"><label class="form-label">@PaymentText("Payment reference", "مرجع پرداخت")</label><input class="form-control" maxlength="500" @bind="paymentReference" /></div>
                        <div class="col-sm-auto"><button class="btn btn-success" disabled="@(paymentBusy || string.IsNullOrWhiteSpace(paymentReference))" @onclick="ConfirmPaymentAsync">@PaymentText("Confirm full payment", "تأیید پرداخت کامل") · @FormatAmount(invoice.TotalAmount)</button></div>
                    </div>
                    <p class="small text-muted mt-2 mb-0">@PaymentText("Confirm only after verifying receipt of the entire invoice amount.", "تنها پس از بررسی دریافت کل مبلغ فاکتور تأیید کنید.")</p>
                }
                @if (!string.IsNullOrWhiteSpace(paymentError)) { <div class="alert alert-danger mt-2 mb-0">@paymentError</div> }
            </div>
        </section>
        <article class="invoice-document">
            <header class="document-header">
                <div>
                    <h1>@(invoice.InvoiceType switch
                    {
                        SalesInvoiceType.Formal => PaymentText("Formal invoice", "فاکتور رسمی"),
                        SalesInvoiceType.Informal => PaymentText("Informal invoice", "فاکتور غیررسمی"),
                        _ => T("SalesInvoice")
                    })</h1>
                    <p class="document-subtitle">@InvoiceTypeLabels.Label(invoice.InvoiceType, LocalizationService.IsPersian)</p>
                </div>
                <div class="text-end invoice-number">
                    <div class="muted-label">@T("InvoiceNumber")</div>
                    <strong>@invoice.InvoiceNumber</strong>
                    <div class="mt-2">
                        <span class="status-label">@T(invoice.Status.ToString())</span>
                    </div>
                </div>
            </header>

            <hr />

            <section class="info-grid">
                <div><h2>@(LocalizationService.IsPersian ? "کارهای مرتبط" : "Related jobs")</h2><p class="info-value">@HamiChap_MES_ERP.Models.Sales.JobReferences.Titles(invoice.Quotation)</p><p class="small text-muted">@HamiChap_MES_ERP.Models.Sales.JobReferences.Display(invoice.Quotation)</p></div>
                <div>
                    <h2>@T("Customer")</h2>
                    <p class="info-value">@(buyerProfile?.Name ?? invoice.Customer?.Name ?? "—")</p>
                </div>
                <div>
                    <h2>@T("InvoiceDate")</h2>
                    <p class="info-value">@FormatDate(invoice.InvoiceDate)</p>
                </div>
                <div>
                    <h2>@T("ApprovedQuotation")</h2>
                    <p class="info-value">@(invoice.Quotation?.QuotationNumber ?? "—")</p>
                </div>
                <div>
                    <h2>@T("SalesOrder")</h2>
                    <p class="info-value">@(invoice.SalesOrder?.OrderNumber ?? "—")</p>
                </div>
                <div>
                    <h2>@T("SalesDelivery")</h2>
                    <p class="info-value">@(invoice.SalesDelivery?.DeliveryNumber ?? "—")</p>
                </div>
            </section>

            @if (invoice.InvoiceType == SalesInvoiceType.Formal && buyerProfile is { } buyer)
            {
                <section class="mt-4">
                    <h2 class="section-heading">@PaymentText("Registered buyer details", "مشخصات ثبتی خریدار")</h2>
                    <div class="info-grid">
                        <div><h2>@PaymentText(buyer.IdentityLabel == "individual" ? "National ID" : "Company national ID", buyer.IdentityLabel == "individual" ? "کد ملی" : "شناسه ملی")</h2><p class="info-value">@ValueOrDash(buyer.IdentityNumber)</p></div>
                        @if (buyer.IdentityLabel == "company")
                        {
                            <div><h2>@PaymentText("Economic code", "کد اقتصادی")</h2><p class="info-value">@ValueOrDash(buyer.EconomicCode)</p></div>
                            <div><h2>@PaymentText("Registration number", "شماره ثبت")</h2><p class="info-value">@ValueOrDash(buyer.RegistrationNumber)</p></div>
                        }
                        <div><h2>@PaymentText("Address", "نشانی")</h2><p class="info-value">@ValueOrDash(buyer.Address)</p></div>
                        <div><h2>@PaymentText("Postal code", "کد پستی")</h2><p class="info-value">@ValueOrDash(buyer.PostalCode)</p></div>
                        <div><h2>@PaymentText("Phone", "تلفن")</h2><p class="info-value">@ValueOrDash(buyer.Phone)</p></div>
                    </div>
                </section>
            }

            <section class="mt-4">
                <h2 class="section-heading">@T("SalesInvoiceItems")</h2>
                <div class="table-responsive">
                    <table class="table invoice-table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>@T("Item")</th>
                                <th>@T("Description")</th>
                                <th class="text-end">@T("Quantity")</th>
                                <th class="text-end">@T("UnitPrice")</th>
                                <th class="text-end">@T("TotalAmount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (invoice.Lines.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center py-4">@T("NoSalesInvoiceLines")</td></tr>
                            }
                            else
                            {
                                var rowNumber = 0;
                                foreach (var line in invoice.Lines)
                                {
                                    rowNumber++;
                                    <tr>
                                        <td class="text-center">@rowNumber</td>
                                        <td>@(line.Item?.Name ?? $"#{line.ItemId}")</td>
                                        <td>@line.Notes</td>
                                        <td class="text-end">@line.Quantity.ToString("N2")</td>
                                        <td class="text-end">@FormatAmount(line.UnitPrice)</td>
                                        <td class="text-end">@FormatAmount(line.LineTotal)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="totals-section">
                <div class="total-row">
                    <span>@T("Subtotal")</span>
                    <span>@FormatAmount(invoice.Subtotal)</span>
                </div>
                <div class="total-row grand-total">
                    <span>@T("TotalAmount")</span>
                    <span>@FormatAmount(invoice.TotalAmount)</span>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(invoice.Notes))
            {
                <section class="notes-section">
                    <h2 class="section-heading">@T("Notes")</h2>
                    <p class="notes-text">@invoice.Notes</p>
                </section>
            }

            <footer class="document-footer"><p>@T("SalesInvoiceFooterMessage")</p></footer>
        </article>
    }
</div>



@code {
    [Parameter] public long Id { get; set; }

    private SalesInvoice? invoice;
    private InvoiceBuyerProfile? buyerProfile;
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private bool isLoading = true;
    private bool canConfirm, paymentBusy;
    private string paymentReference = "";
    private string? paymentError;
    private string PaymentText(string en, string fa) => LocalizationService.IsPersian ? fa : en;
    private async Task ConfirmPaymentAsync()
    {
        if (!canConfirm || paymentBusy || invoice == null) return;
        paymentBusy = true;
        paymentError = null;
        try { await ShipmentPayment.ConfirmPaymentAsync(invoice.Id, paymentReference, (await Auth.GetAuthenticationStateAsync()).User); await OnParametersSetAsync(); }
        catch (Exception ex) { paymentError = ex.Message; }
        finally { paymentBusy = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        canConfirm = await Permissions.HasPermissionAsync(user, "Sales.Invoices.ConfirmPayment");
        if (!canConfirm && !await Permissions.HasPermissionAsync(user, "Sales.Invoices.View")) { invoice = null; isLoading = false; return; }
        invoice = await Db.SalesInvoices.AsNoTracking()
            .Include(x => x.Customer)
            .Include(x => x.Quotation).ThenInclude(x => x.SalesRequest)
                .Include(x => x.Quotation).ThenInclude(x => x.Lines).ThenInclude(x => x.SourceRequest)
            .Include(x => x.SalesOrder)
            .Include(x => x.SalesDelivery)
            .Include(x => x.Lines).ThenInclude(x => x.Item)
            .FirstOrDefaultAsync(x => x.Id == Id);
        buyerProfile = InvoiceBuyerProfile.Read(invoice?.BuyerProfileJson);
        isLoading = false;
    }

    private string T(string key) => LocalizationService[key];
    private static string FormatDate(DateTime date) => date.ToString("yyyy-MM-dd");
    private static string FormatAmount(decimal amount) => amount.ToString("N2");
    private void BackToInvoices() => Navigation.NavigateTo("/sales/invoices");
    private async Task PrintInvoice() => await JS.InvokeVoidAsync("window.print");
}
