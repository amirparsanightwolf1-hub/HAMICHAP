@page "/sales/orders"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

<PageTitle>
    @LocalizationService["SalesOrders"]
</PageTitle>

<div class="page-container">

    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">
                @LocalizationService["SalesOrders"]
            </div>

            <div class="erp-page-subtitle">
                @LocalizationService["SalesOrdersManagement"]
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @LocalizationService["Loading"]
                </span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-responsive-cards">
                        <thead class="table-light">
                            <tr>
                                <th>@LocalizationService["OrderNumber"]</th>
                                <th>@LocalizationService["Customer"]</th>
                                <th>@LocalizationService["OrderDate"]</th>
                                <th>@LocalizationService["DeliveryDate"]</th>
                                <th class="text-end">@LocalizationService["TotalAmount"]</th>
                                <th>@LocalizationService["Status"]</th>
                                <th class="erp-width-100" ></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (orders.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        @LocalizationService["NoSalesOrdersFound"]
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in orders)
                                {
                                    <tr @key="order.Id">
                                        <td class="fw-semibold">
                                            @order.OrderNumber
                                        </td>

                                        <td>
                                            @order.Customer?.Name
                                        </td>

                                        <td>
                                            @order.OrderDate.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>
                                            @(order.DeliveryDate?.ToString("yyyy-MM-dd") ?? "-")
                                        </td>

                                        <td class="text-end">
                                            @order.TotalAmount.ToString("N2")
                                        </td>

                                        <td>
                                            <span class="badge @GetStatusClass(order.Status)">
                                                @LocalizationService.TranslateEnum(order.Status)
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenOrder(order.Id)">
                                                <i class="bi bi-eye"></i>
                                                @LocalizationService["Open"]
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-3 px-3 gap-2">

                        <div class="text-muted small">
                            @((currentPage - 1) * pageSize + 1)
                            -
                            @(Math.Min(currentPage * pageSize, totalCount))
                            /
                            @totalCount
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="PreviousPage"
                                    disabled="@(currentPage <= 1 || isLoading)">
                                @LocalizationService["Previous"]
                            </button>

                            <span class="small">
                                @currentPage / @totalPages
                            </span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="NextPage"
                                    disabled="@(currentPage >= totalPages || isLoading)">
                                @LocalizationService["Next"]
                            </button>
                        </div>

                    </div>
                }

            </div>
        </div>
    }
</div>

@code {
    private const int pageSize = 20;

    private List<SalesOrder> orders = new();

    private bool isLoading = true;
    private string? errorMessage;

    private int currentPage = 1;
    private int totalCount;

    private int totalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(totalCount / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var query = Db.SalesOrders
                .AsNoTracking();

            totalCount = await query.CountAsync();

            if (totalPages > 0 && currentPage > totalPages)
            {
                currentPage = totalPages;
            }

            if (totalPages == 0)
            {
                currentPage = 1;
            }

            orders = await query
                .Include(x => x.Customer)
                .OrderByDescending(x => x.OrderDate)
                .ThenByDescending(x => x.Id)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            orders = new();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1 || isLoading)
            return;

        currentPage--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages || isLoading)
            return;

        currentPage++;
        await LoadAsync();
    }

    private void OpenOrder(long orderId)
    {
        Navigation.NavigateTo($"/sales/orders/edit/{orderId}");
    }

    private string GetStatusClass(SalesOrderStatus status)
    {
        return status switch
        {
            SalesOrderStatus.Confirmed =>
                "bg-primary",

            SalesOrderStatus.PartiallyReserved =>
                "bg-warning text-dark",

            SalesOrderStatus.Reserved =>
                "bg-success",

            SalesOrderStatus.InProduction =>
                "bg-info text-dark",

            SalesOrderStatus.PartiallyDelivered =>
                "bg-warning text-dark",

            SalesOrderStatus.Completed =>
                "bg-success",

            SalesOrderStatus.Cancelled =>
                "bg-danger",

            _ => "bg-secondary"
        };
    }
}