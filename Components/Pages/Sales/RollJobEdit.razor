@page "/sales/requests/roll/edit/{RequestId:long}"

@using System.Text.Json
@using System.Text.Json.Nodes
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.IO
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Shared.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@inject LocalizationService LocalizationService
@inject QuotationService QuotationService

<PageTitle>@LocalizationService["RollJobSpecification"]</PageTitle>



<HeadContent>
    <link rel="stylesheet" href="css/jobEdit.css" />
</HeadContent>

<div class="page-container job-edit-page job-edit-roll">
    <header class="job-edit-hero">
        <div class="job-edit-hero-intro">
            <div class="job-edit-hero-icon" aria-hidden="true">
                <i class="bi bi-disc"></i>
            </div>
            <div>
                <div class="job-edit-eyebrow">
                    <i class="bi bi-printer" aria-hidden="true"></i>
                    @LocalizationService["JobEditorEyebrow"]
                </div>
                <h1>@LocalizationService["RollJob"]</h1>
                <p>@LocalizationService["RollJobSubtitle"]</p>
            </div>
        </div>
        <button type="button" class="job-edit-back" @onclick="BackToRequest">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @LocalizationService["SalesRequests"]
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (isLoading)
    {
        <div class="job-edit-loading" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@LocalizationService["LoadingJob"]</span>
        </div>
    }
    else if (request is not null)
    {
        <div class="job-edit-context" aria-label="@LocalizationService["JobEditorOverview"]">
            <div class="job-edit-context-field">
                <span>@LocalizationService["RequestNumber"]</span>
                <strong>@request.RequestNumber <span class="job-edit-context-date">· @request.RequestDate.ToString("yyyy-MM-dd")</span></strong>
            </div>
            <div class="job-edit-context-field">
                <span>@LocalizationService["Customer"]</span>
                <strong>@(isCreatingCustomer ? newCustomerName : customers.FirstOrDefault(c => c.Id == selectedCustomerId)?.Name ?? request.Customer?.Name ?? "—")</strong>
            </div>
            <div class="job-edit-context-field">
                <span>@LocalizationService["JobTitle"]</span>
                <strong>@(string.IsNullOrWhiteSpace(spec.JobTitle) ? "—" : spec.JobTitle)</strong>
            </div>
            <div class="job-edit-context-status">
                <span>@LocalizationService["Status"]</span>
                <strong>@LocalizationService.TranslateEnum(request.Status)</strong>
            </div>
        </div>

        <nav class="job-edit-jump-nav" aria-label="@LocalizationService["JobEditorSections"]">
            <a href="@GetSectionHref("job-edit-information")"><i class="bi bi-person-vcard" aria-hidden="true"></i> @LocalizationService["OrderInformation"]</a>
            <a href="@GetSectionHref("job-edit-specifications")"><i class="bi bi-sliders" aria-hidden="true"></i> @LocalizationService["LabelSpecifications"]</a>
            <a href="@GetSectionHref("job-edit-services")"><i class="bi bi-list-check" aria-hidden="true"></i> @LocalizationService["AdditionalServices"]</a>
            <a href="@GetSectionHref("job-edit-artwork")"><i class="bi bi-images" aria-hidden="true"></i> @LocalizationService["ArtworkFiles"]</a>
            <a href="@GetSectionHref("job-edit-items")"><i class="bi bi-layers" aria-hidden="true"></i> @LocalizationService["ItemsInThisOrder"]</a>
            <a href="@GetSectionHref("job-edit-production")"><i class="bi bi-diagram-3" aria-hidden="true"></i> @LocalizationService["RollWorkflowInfo"]</a>
            <button type="button" class="job-edit-nav-save" disabled="@isSaving"
                    @onclick="SaveAndOpenProofAsync">
                <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                @((canEditSpecifications || canEditArtwork)
                    ? LocalizationService["JobEditorQuickSave"]
                    : LocalizationService["CustomerApprovalProof"])
            </button>
        </nav>

        <fieldset class="border-0 p-0 m-0 w-100" disabled="@(!canEditSpecifications)">
        <div class="card job-section mb-4" id="job-edit-information">
            <div class="card-header">
                <span class="job-edit-section-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
                <strong>@LocalizationService["OrderInformation"]</strong>
            </div>
            <div class="card-body">
                <div class="order-info-grid">
                    <label class="form-label">@LocalizationService["Customer"]</label>
                    <div>
                        @if (!isCreatingCustomer)
                        {
                            <select class="form-select" @bind="selectedCustomerId" disabled="@(TargetQuotationId.HasValue || request.Status != SalesRequestStatus.Draft)">
                                <option value="0">@LocalizationService["SelectExistingCustomerPrompt"]</option>
                                @foreach (var customer in customers)
                                {
                                    <option value="@customer.Id">@customer.Code - @customer.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-link px-0" disabled="@(TargetQuotationId.HasValue || request.Status != SalesRequestStatus.Draft)" @onclick="StartNewCustomer">
                                @LocalizationService["CreateNewCustomer"]
                            </button>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="form-control bg-light">@LocalizationService["NewCustomer"]</span>
                                <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="SelectExistingCustomer">
                                    @LocalizationService["SelectExisting"]
                                </button>
                            </div>
                        }
                    </div>

                    @if (isCreatingCustomer)
                    {
                        <label class="form-label">@LocalizationService["CustomerCodeRequired"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerCode" />

                        <label class="form-label">@LocalizationService["CustomerNameRequired"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerName" />

                        <label class="form-label">@LocalizationService["Phone"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerPhone" />

                        <label class="form-label">@LocalizationService["Email"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerEmail" />

                        <label class="form-label">@LocalizationService["Address"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerAddress" />
                    }

                    <label class="form-label">@LocalizationService["JobTitle"]</label>
                    <InputText class="form-control" @bind-Value="spec.JobTitle" />
                    <div style="grid-column: 1 / -1;">
                        <ExistingJobTitlePrompt CurrentRequestId="@RequestId"
                                                CustomerId="@(isCreatingCustomer ? 0 : selectedCustomerId)"
                                                JobType="SalesJobType.Roll"
                                                JobTitle="@spec.JobTitle"
                                                TargetQuotationId="@TargetQuotationId" />
                    </div>

                </div>
            </div>
        </div>

        </fieldset>

        <fieldset class="border-0 p-0 m-0 w-100" disabled="@(!canEditSpecifications)">

        <div class="card job-section mb-4" id="job-edit-specifications">
            <div class="card-header">
                <span class="job-edit-section-icon"><i class="bi bi-sliders" aria-hidden="true"></i></span>
                <strong>@LocalizationService["LabelSpecifications"]</strong>
            </div>
            <div class="card-body">
                <div class="label-specifications-grid">
                    <div class="label-specification-field">
                        <label>@LocalizationService["LabelPull"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.LabelPull" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["LabelWidth"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.LabelWidth" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["GapBetweenLabels"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.GapBetweenLabels" />
                    </div>
                    <div class="label-specification-field job-edit-quantity-field">
                        <label>@LocalizationService["LabelQuantity"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.LabelQuantity" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["PaperTypeMaterial"]</label>
                        <div>
                            <input class="form-control" list="roll-paper-types" @bind="spec.PaperType" placeholder="@LocalizationService["SelectOrEnterMaterial"]" />
                            <datalist id="roll-paper-types">
                                <option value="گلاسه"></option>
                                <option value="نیمه گلاسه"></option>
                                <option value="متالایز"></option>
                                <option value="PVC"></option>
                                <option value="حرارتی"></option>
                                <option value="کاغذی"></option>
                                <option value="شفاف"></option>
                                <option value="صدفی"></option>
                            </datalist>
                            <small class="text-muted">@LocalizationService["SelectStandardOrEnterMaterial"]</small>
                        </div>
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["ColorCount"]</label>
                        <InputSelect class="form-select" @bind-Value="spec.ColorCount">
                            <option value="">@LocalizationService["SelectColorCount"]</option>
                            @for (var color = 1; color <= 10; color++)
                            {
                                <option value="@color">@color</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["PrintingNotes"]</label>
                        <InputText class="form-control" @bind-Value="spec.PrintingNotes" placeholder="@LocalizationService["RollPrintingNotesHint"]" />
                    </div>
                    <div class="col-12">
                        <div class="roll-colors-layout">
                            <section class="cmyk-panel">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <strong>@LocalizationService["RollCmykColors"]</strong>
                                    <span class="text-muted small">@LocalizationService["RollCmykHint"]</span>
                                </div>
                                <div class="cmyk-options">
                                    @foreach (var color in CmykColors)
                                    {
                                        <button type="button" class="cmyk-option @(frontCmykColors.Contains(color.Key) ? "selected" : "")"
                                                aria-pressed="@frontCmykColors.Contains(color.Key)"
                                                @onclick="() => ToggleCmykColor(frontCmykColors, color.Key)">
                                            <span class="cmyk-letter @color.Css">@color.Key</span>
                                            <span>@LocalizationService[color.LocalizationKey]</span>
                                        </button>
                                    }
                                </div>
                                <div class="small text-muted mt-2">@LocalizationService["Selected"]:
                                    @(frontCmykColors.Count == 0 ? LocalizationService["None"] : string.Join(" · ", CmykColors.Where(c => frontCmykColors.Contains(c.Key)).Select(c => c.Key)))
                                </div>
                            </section>

                            <section class="roll-pantone-panel" aria-label="@LocalizationService["RollPantoneColors"]">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                    <strong>@LocalizationService["RollPantoneColors"]</strong>
                                    <span class="text-muted small">@LocalizationService["RollPantoneMultipleHint"]</span>
                                </div>
                                <div class="roll-pantone-inputs">
                                    <div>
                                        <label class="form-label" for="roll-pantone-code">@LocalizationService["RollPantoneReference"]</label>
                                        <input id="roll-pantone-code" type="text" class="form-control" maxlength="64"
                                               @bind="pantoneCode" @bind:event="oninput"
                                               @onkeydown="HandlePantoneKeyDown"
                                               placeholder="@LocalizationService["RollPantoneCodeExample"]" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="roll-pantone-color">@LocalizationService["RollPantonePreviewColor"]</label>
                                        <input id="roll-pantone-color" type="color" class="form-control form-control-color roll-pantone-picker"
                                               @bind="pantoneHex" />
                                    </div>
                                    <button type="button" class="btn btn-outline-primary roll-pantone-add"
                                            @onclick="AddPantoneColor">
                                        <i class="bi bi-plus-circle" aria-hidden="true"></i> @LocalizationService["RollPantoneAdd"]
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(pantoneError))
                                {
                                    <div class="text-danger small mt-2" role="alert">@pantoneError</div>
                                }
                                <div class="small text-muted mt-2">@LocalizationService["RollPantonePreviewDisclaimer"]</div>
                                @if (spec.PantoneColors is { Count: > 0 })
                                {
                                    <ul class="roll-pantone-list">
                                        @foreach (var color in spec.PantoneColors)
                                        {
                                            <li class="roll-pantone-entry" @key="color">
                                                <span class="roll-pantone-swatch" style="@($"background-color:{color.SafeHex}")" aria-hidden="true"></span>
                                                <span class="roll-pantone-name">@color.Code</span>
                                                <span class="roll-pantone-hex">@color.SafeHex</span>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        aria-label="@($"{LocalizationService["RollPantoneRemove"]}: {color.Code}")"
                                                        @onclick="() => RemovePantoneColor(color)">
                                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        </div>
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["RollDiameter"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.RollDiameter" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">@LocalizationService["RollOrientationUnwindDirection"]</label>
                        <div class="text-muted small mb-2">@LocalizationService["ChooseRollOrientation"]</div>
                        <div class="orientation-grid orientation-grid-four" role="group"
                             aria-label="@LocalizationService["RollOrientationUnwindDirection"]">
                            @foreach (var choice in RollOrientationChoices.All)
                            {
                                var option = choice.Value;
                                <button type="button"
                                        @key="option"
                                        class="orientation-option @(spec.RollOrientation == option ? "selected" : "")"
                                        aria-label="@LocalizationService[choice.LocalizationKey]"
                                        aria-pressed="@(spec.RollOrientation == option)"
                                        @onclick="() => spec.RollOrientation = option">
                                    <img src="@choice.ImagePath"
                                         alt="@LocalizationService[choice.LocalizationKey]"
                                         class="orientation-picture" loading="lazy" />
                                    <span class="orientation-caption">@LocalizationService[choice.LocalizationKey]</span>
                                    @if (spec.RollOrientation == option)
                                    {
                                        <span class="orientation-check"><i class="bi bi-check-circle-fill"></i> @LocalizationService["Selected"]</span>
                                    }
                                </button>
                            }
                        </div>
                        @if (RollOrientationChoices.IsLegacy(spec.RollOrientation))
                        {
                            <div class="alert alert-warning small mt-3 mb-0" role="status">
                                @LocalizationService["RollOrientationLegacyNotice"]
                                (@LocalizationService["RollOrientationOption"] @spec.RollOrientation)
                            </div>
                        }
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <label class="form-check job-edit-toggle-chip">
                            <InputCheckbox class="form-check-input" @bind-Value="spec.HandGluing" />
                            <span class="form-check-label">@LocalizationService["HandGluing"]</span>
                        </label>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <label class="form-check job-edit-toggle-chip">
                            <InputCheckbox class="form-check-input" @bind-Value="spec.MachineGluing" />
                            <span class="form-check-label">@LocalizationService["MachineGluing"]</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card job-section mb-4" id="job-edit-services">
            <div class="card-header">
                <span class="job-edit-section-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                <strong>@LocalizationService["AdditionalServices"]</strong>
                <span class="text-muted ms-2">(@LocalizationService["MultipleOptionsCanBeSelected"])</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var group in RollFinishingServices.Groups)
                    {
                        <div class="col-12 col-xl-6" @key="group.TitleKey">
                            <section class="border rounded p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                    <h6 class="mb-0 fw-semibold">@LocalizationService[group.TitleKey]</h6>
                                    <span class="badge bg-light text-dark border">
                                        @group.Services.Count(x => spec.SelectedServices.Contains(x.Value)) / @group.Services.Count
                                    </span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var service in group.Services)
                                    {
                                        var serviceId = "roll-service-" + service.LabelKey;
                                        <div class="col-sm-6" @key="service.Value">
                                            <div class="form-check">
                                                <input id="@serviceId" class="form-check-input" type="checkbox"
                                                       checked="@spec.SelectedServices.Contains(service.Value)"
                                                       @onchange="args => ToggleService(service.Value, args)" />
                                                <label class="form-check-label" for="@serviceId">
                                                    @LocalizationService[service.LabelKey]
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card job-section mb-4" id="job-edit-production">
            <div class="card-header">
                <span class="job-edit-section-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                <strong>@LocalizationService["RollWorkflowInfo"]</strong>
            </div>
            <div class="card-body">
                <div class="workflow-fields-grid">
                    @foreach (var field in WorkflowFieldLabels)
                    {
                        <div class="workflow-field" @key="field.Key">
                            @if (field.IsCheckbox)
                            {
                                <div class="form-check">
                                    <input id="workflow-@field.Key"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked="@IsWorkflowChecked(field.Key)"
                                           @onchange="args => SetWorkflowCheckbox(field.Key, args)" />
                                    <label class="form-check-label" for="workflow-@field.Key">@field.Label</label>
                                </div>
                            }
                            else
                            {
                                <label for="workflow-@field.Key">@field.Label</label>
                                <input id="workflow-@field.Key"
                                       class="form-control"
                                       type="@(field.IsNumber ? "number" : "text")"
                                       min="@(field.IsNumber ? "0" : null)"
                                       @bind="workflowFields[field.Key]" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        </fieldset>

        <div class="card job-section mb-4" id="job-edit-artwork">
            <div class="card-header">
                <span class="job-edit-section-icon"><i class="bi bi-images" aria-hidden="true"></i></span>
                <strong>@LocalizationService["ArtworkFiles"]</strong>
                <span class="job-edit-section-hint">@LocalizationService["JobEditorArtworkHint"]</span>
            </div>
            <div class="card-body">
                <JobArtworkEditor @ref="artworkEditor"
                                  SavedFiles="@spec.ArtworkFiles"
                                  LegacyPath="@spec.ArtworkRelativePath"
                                  LegacyName="@spec.ArtworkOriginalFileName"
                                  CanEdit="@canEditArtwork" />
            </div>
        </div>

        <div id="job-edit-items" class="job-edit-anchor">
            <SalesJobOrderPanel RequestId="@RequestId" TargetQuotationId="@TargetQuotationId"
                                SaveCurrentAsync="@SaveCurrentForOrderAsync" />
        </div>

        <SalesRequestWorkflowPanel Request="request" />


        <div class="job-edit-save-bar" id="job-edit-save">
            <div class="job-edit-save-message">
                <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                <div>
                    <strong>@((canEditSpecifications || canEditArtwork)
                        ? LocalizationService["JobEditorSaveHeading"]
                        : LocalizationService["CustomerApprovalProof"])</strong>
                    <span>@((canEditSpecifications || canEditArtwork)
                        ? LocalizationService["JobEditorSaveHint"]
                        : LocalizationService["JobEditorReadOnlyHint"])</span>
                </div>
            </div>
            <button type="button" class="job-edit-save-button" @onclick="SaveAndOpenProofAsync" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                }
                @(canEditSpecifications
                    ? LocalizationService["SavePreviewAndContinueSalesWorkflow"]
                    : (canEditArtwork
                        ? LocalizationService["SaveAndPreviewApprovalProof"]
                        : LocalizationService["CustomerApprovalProof"]))
                <i class="bi bi-arrow-right-short job-edit-save-arrow" aria-hidden="true"></i>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public long RequestId { get; set; }

    [SupplyParameterFromQuery(Name = "quotationId")]
    public long? TargetQuotationId { get; set; }

    private HamiChap_MES_ERP.Models.Sales.SalesRequest? request;
    private List<Customer> customers = new();
    private int selectedCustomerId;
    private bool isCreatingCustomer;
    private string newCustomerCode = "";
    private string newCustomerName = "";
    private string newCustomerPhone = "";
    private string newCustomerEmail = "";
    private string newCustomerAddress = "";
    private RollJobSpecification spec = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    // Workflow values are stored inside JobSpecificationJson, so no database migration is required.
    private Dictionary<string, string> workflowFields = CreateWorkflowFields();

    private static readonly (string Key, string Label, bool IsCheckbox, bool IsNumber)[] WorkflowFieldLabels =
    {
        ("DesignAndImposition", "طراحی و فرم‌بندی", true, false),
        ("PlateSupply", "تامین زینک", false, false),
        ("PlateCount", "تعداد زینک", false, true),
        ("Paper", "کاغذ", false, false),
        ("PrintingPlate", "کلیشه", true, false),
        ("Die", "قالب", true, false),
        ("FoilStamping", "طلاکوب", true, false),
        ("Lamination", "سلفون", true, false),
        ("DieCutSlitting", "دایکات اسلیت", true, false),
        ("SettlementMethod", "نحوه تسویه", false, false)
    };

    private static Dictionary<string, string> CreateWorkflowFields() =>
        WorkflowFieldLabels.ToDictionary(x => x.Key, x => x.IsCheckbox ? "false" : string.Empty);

    private bool IsWorkflowChecked(string key) =>
        workflowFields.TryGetValue(key, out var value) && bool.TryParse(value, out var isChecked) && isChecked;

    private void SetWorkflowCheckbox(string key, ChangeEventArgs args)
    {
        workflowFields[key] = args.Value is bool value && value ? "true" : "false";
    }

    private JobArtworkEditor? artworkEditor;
    private bool canEditArtwork;
    private bool canEditSpecifications;
    private HashSet<string> frontCmykColors = new(StringComparer.OrdinalIgnoreCase);
    private string pantoneCode = "";
    private string pantoneHex = "#DB2635";
    private string? pantoneError;
    private static readonly (string Key, string LocalizationKey, string Css)[] CmykColors =
    {
        ("C", "CmykCyan", "cmyk-c"), ("M", "CmykMagenta", "cmyk-m"),
        ("Y", "CmykYellow", "cmyk-y"), ("K", "CmykBlack", "cmyk-k")
    };

    private static void ToggleCmykColor(HashSet<string> selection, string color)
    {
        if (!selection.Add(color)) selection.Remove(color);
    }

    // Typing a Pantone reference and pressing Enter adds it without another click.
    private void HandlePantoneKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            AddPantoneColor();
    }

    private void AddPantoneColor()
    {
        pantoneError = null;
        var reference = pantoneCode.Trim();
        if (reference.Length < 2 || reference.Length > 64)
        {
            pantoneError = LocalizationService["RollPantoneInvalidReference"];
            return;
        }
        if (!RollPantoneColor.IsValidHex(pantoneHex))
        {
            pantoneError = LocalizationService["RollPantoneInvalidSwatch"];
            return;
        }
        spec.PantoneColors ??= new();
        var existing = spec.PantoneColors.FirstOrDefault(x =>
            string.Equals(x.Code, reference, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Hex = pantoneHex.ToUpperInvariant();
        }
        else
        {
            if (spec.PantoneColors.Count >= 24)
            {
                pantoneError = LocalizationService["RollPantoneLimit"];
                return;
            }
            spec.PantoneColors.Add(new RollPantoneColor
            {
                Code = reference,
                Hex = pantoneHex.ToUpperInvariant()
            });
        }
        pantoneCode = "";
    }

    private void RemovePantoneColor(RollPantoneColor color)
    {
        spec.PantoneColors.Remove(color);
        pantoneError = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;


        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        request = await Db.SalesRequests
            .Include(x => x.Customer)
            .Include(x => x.CreatedByUser)
            .Include(x => x.AssignedToUser)
            .Include(x => x.Lines).ThenInclude(x => x.Item)
            .Include(x => x.Lines).ThenInclude(x => x.Unit)
            .FirstOrDefaultAsync(x => x.Id == RequestId);

        if (request is not null)
        {
            selectedCustomerId = request.CustomerId;
            var linkedQuoteStatus = await Db.Quotations.AsNoTracking()
                .Where(q => q.SalesRequestId == RequestId ||
                            q.Lines.Any(line => line.SourceRequestId == RequestId))
                .Select(q => (QuotationStatus?)q.Status)
                .FirstOrDefaultAsync();
            var quoteIsEditable = linkedQuoteStatus is
                QuotationStatus.Draft or QuotationStatus.RevisionRequired;
            canEditSpecifications = request.Status == SalesRequestStatus.Draft ||
                (request.Status == SalesRequestStatus.QuotationCreated && quoteIsEditable);
            canEditArtwork = request.Status != SalesRequestStatus.Cancelled &&
                (!linkedQuoteStatus.HasValue || quoteIsEditable);
        }

        if (request is null)
        {
            errorMessage = LocalizationService["SalesRequestNotFound"];
        }
        else if (request.JobType != SalesJobType.Roll)
        {
            errorMessage = LocalizationService["NotRollJob"];
        }
        else if (!string.IsNullOrWhiteSpace(request.JobSpecificationJson))
        {
            try
            {
                spec = JsonSerializer.Deserialize<RollJobSpecification>(
                    request.JobSpecificationJson) ?? new();
                var savedJson = JsonNode.Parse(request.JobSpecificationJson) as JsonObject;
                workflowFields = CreateWorkflowFields();
                if (savedJson?["WorkflowFields"] is JsonObject savedWorkflow)
                {
                    foreach (var field in WorkflowFieldLabels)
                    {
                        workflowFields[field.Key] = savedWorkflow[field.Key]?.GetValue<string>() ?? string.Empty;
                    }
                }
                frontCmykColors = ReadColorSelection(savedJson?["FrontCmykColors"]);
                spec.PantoneColors ??= new();
                spec.SelectedServices ??= new();
                pantoneCode = "";
                pantoneError = null;
            }
            catch (JsonException)
            {
                spec = new();
                errorMessage = LocalizationService["SavedSpecificationsUnreadable"];
            }
        }

        isLoading = false;
    }

    private static HashSet<string> ReadColorSelection(JsonNode? node)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (node is JsonArray array)
            foreach (var item in array)
            {
                var value = item?.GetValue<string>();
                if (value is "C" or "M" or "Y" or "K") result.Add(value);
            }
        return result;
    }

    private void StartNewCustomer()
    {

        isCreatingCustomer = true;
        newCustomerCode = "";
        newCustomerName = "";
        newCustomerPhone = "";
        newCustomerEmail = "";
        newCustomerAddress = "";
        errorMessage = null;
    }

    private void SelectExistingCustomer()
    {
        isCreatingCustomer = false;
        errorMessage = null;
    }

    private void ToggleService(string service, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        if (selected && !spec.SelectedServices.Contains(service))
            spec.SelectedServices.Add(service);
        else if (!selected)
            spec.SelectedServices.Remove(service);
    }

    private async Task SaveArtworkFileAsync()
    {
        if (request is null || artworkEditor is null) return;

        spec.ArtworkFiles = await artworkEditor.StageForSaveAsync(
            request.Id, HostEnvironment.WebRootPath);
        var first = spec.ArtworkFiles.FirstOrDefault();
        spec.ArtworkRelativePath = first?.RelativePath ?? string.Empty;
        spec.ArtworkOriginalFileName = first?.OriginalFileName ?? string.Empty;
    }

    private async Task SaveArtworkOnlyAsync()
    {
        if (request is null || artworkEditor is null ||
            !artworkEditor.HasPendingChanges || !canEditArtwork)
            return;

        var originalFiles = spec.ArtworkFiles?.ToList() ?? new();
        var originalPath = spec.ArtworkRelativePath;
        var originalName = spec.ArtworkOriginalFileName;
        var originalJson = request.JobSpecificationJson;

        try
        {
            isSaving = true;
            errorMessage = null;

            // Recheck approval state immediately before writing: a quotation
            // could have become approved since the job editor was opened.
            var locked = await Db.Quotations.AsNoTracking().AnyAsync(q =>
                (q.SalesRequestId == RequestId ||
                 q.Lines.Any(line => line.SourceRequestId == RequestId)) &&
                q.Status != QuotationStatus.Draft &&
                q.Status != QuotationStatus.RevisionRequired);
            if (locked)
                throw new InvalidOperationException(LocalizationService["ArtworkLockedAfterApproval"]);

            await using var transaction = await Db.Database.BeginTransactionAsync();
            await SaveArtworkFileAsync();
            var json = JsonNode.Parse(originalJson) as JsonObject ?? new();
            json["ArtworkFiles"] = JsonSerializer.SerializeToNode(spec.ArtworkFiles);
            json["ArtworkRelativePath"] = spec.ArtworkRelativePath;
            json["ArtworkOriginalFileName"] = spec.ArtworkOriginalFileName;
            request.JobSpecificationJson = json.ToJsonString();
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            artworkEditor.CompleteSave();
        }
        catch (Exception ex)
        {
            artworkEditor.RollbackNewFiles();
            spec.ArtworkFiles = originalFiles;
            spec.ArtworkRelativePath = originalPath;
            spec.ArtworkOriginalFileName = originalName;
            request.JobSpecificationJson = originalJson;
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<bool> SaveCurrentForOrderAsync()
    {
        if (request is null)
            return false;

        if (canEditSpecifications)
            await SaveAsync();
        else if (canEditArtwork && artworkEditor?.HasPendingChanges == true)
            await SaveArtworkOnlyAsync();

        return string.IsNullOrWhiteSpace(errorMessage);
    }

    private async Task SaveAndOpenProofAsync()
    {
        if (request is null)
            return;

        if (canEditSpecifications)
        {
            await SaveAsync();
            if (!string.IsNullOrWhiteSpace(errorMessage))
                return;

            // The job joins its draft quotation on save; each item still
            // receives a separate approval proof.
            if (TargetQuotationId.HasValue)
            {
                try
                {
                    await QuotationService.AddRequestToQuotationAsync(
                        TargetQuotationId.Value, RequestId);
                }
                catch (Exception ex)
                {
                    errorMessage = ex.Message;
                    return;
                }
            }
        }
        else
            await SaveArtworkOnlyAsync();

        if (!string.IsNullOrWhiteSpace(errorMessage))
            return;
        // Submission/quotation actions remain on the job editor.
        Navigation.NavigateTo(TargetQuotationId.HasValue
            ? $"/sales/requests/proof/{RequestId}?quotationId={TargetQuotationId.Value}"
            : $"/sales/requests/proof/{RequestId}");
    }

    private async Task SaveAsync()
    {
        if (request is null || !canEditSpecifications) return;

        if (request.Status == SalesRequestStatus.QuotationCreated &&
            (isCreatingCustomer || selectedCustomerId != request.CustomerId))
        {
            errorMessage = LocalizationService["QuotationCustomerMustMatch"];
            return;
        }

        if (TargetQuotationId.HasValue)
        {
            var target = await Db.Quotations.AsNoTracking()
                .Where(q => q.Id == TargetQuotationId.Value)
                .Select(q => new { q.CustomerId, q.Status })
                .FirstOrDefaultAsync();
            if (target is null ||
                target.Status is not (QuotationStatus.Draft or QuotationStatus.RevisionRequired))
            {
                errorMessage = LocalizationService["QuotationNotEditable"];
                return;
            }
            if (isCreatingCustomer || selectedCustomerId != target.CustomerId)
            {
                errorMessage = LocalizationService["QuotationCustomerMustMatch"];
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(spec.JobTitle))
        {
            errorMessage = LocalizationService["JobTitleRequired"];
            return;
        }
        var orderedQuantity = spec.LabelQuantity;
        if (orderedQuantity.GetValueOrDefault() <= 0)
        {
            errorMessage = LocalizationService["QuantityMustBeGreaterThanZero"];
            return;
        }
        // Correcting an artwork mistake may temporarily leave the job without artwork.
        // Repeated titles are legitimate repeat orders; the title matcher
        // reuses specifications, not historical order quantities.

        Customer? customerCreatedThisAttempt = null;
        var originalCustomerId = request.CustomerId;
        var originalCustomer = request.Customer;
        var originalFiles = spec.ArtworkFiles?.ToList() ?? new();
        var originalArtworkPath = spec.ArtworkRelativePath;
        var originalArtworkName = spec.ArtworkOriginalFileName;

        try
        {
            isSaving = true;
            errorMessage = null;

            // Keep customer creation/selection, item creation/reuse, and specifications in one transaction.
            await using var transaction = await Db.Database.BeginTransactionAsync();

            if (isCreatingCustomer)
            {
                if (string.IsNullOrWhiteSpace(newCustomerCode))
                    throw new InvalidOperationException(LocalizationService["CustomerCodeIsRequired"]);

                if (string.IsNullOrWhiteSpace(newCustomerName))
                    throw new InvalidOperationException(LocalizationService["CustomerNameIsRequired"]);

                var code = newCustomerCode.Trim();
                if (await Db.Customers.AnyAsync(x => x.Code == code))
                    throw new InvalidOperationException(string.Format(LocalizationService["CustomerCodeAlreadyExists"], code));

                var newCustomer = new Customer
                {
                    Code = code,
                    Name = newCustomerName.Trim(),
                    Phone = newCustomerPhone.Trim(),
                    Email = newCustomerEmail.Trim(),
                    Address = newCustomerAddress.Trim(),
                    IsActive = true
                };

                Db.Customers.Add(newCustomer);
                await Db.SaveChangesAsync();

                customerCreatedThisAttempt = newCustomer;
                request.CustomerId = newCustomer.Id;
                request.Customer = newCustomer;
            }
            else
            {
                var selectedCustomer = customers.FirstOrDefault(x => x.Id == selectedCustomerId);
                if (selectedCustomer is null)
                    throw new InvalidOperationException(LocalizationService["SelectOrCreateCustomer"]);

                request.CustomerId = selectedCustomer.Id;
                request.Customer = selectedCustomer;
            }

            await SaveArtworkFileAsync();

            var item = await JobProductItemHelper.GetOrCreateAsync(
                Db, request, spec.JobTitle, "products-roll");

            var previousFinishedProductItemId = spec.FinishedProductItemId;
            spec.FinishedProductItemId = item.Id;
            SalesRequestFinishedLineSync.Apply(
                Db, request, item, orderedQuantity, previousFinishedProductItemId);

            // Update only this job's quotation line, preserving per-item proofs.
            await SalesJobQuotationLineSync.SyncAsync(
                Db, request, item, orderedQuantity.Value);
            var savedSpec = JsonNode.Parse(JsonSerializer.Serialize(spec)) as JsonObject ?? new JsonObject();
            savedSpec["FrontCmykColors"] = new JsonArray(frontCmykColors.OrderBy(c => c).Select(c => (JsonNode?)JsonValue.Create(c)).ToArray());
            var workflowJson = new JsonObject();
            foreach (var field in WorkflowFieldLabels)
                workflowJson[field.Key] = workflowFields[field.Key] ?? string.Empty;
            savedSpec["WorkflowFields"] = workflowJson;
            request.JobSpecificationJson = savedSpec.ToJsonString();
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            artworkEditor?.CompleteSave();

            if (customerCreatedThisAttempt is not null)
            {
                customers.Add(customerCreatedThisAttempt);
                selectedCustomerId = customerCreatedThisAttempt.Id;
                isCreatingCustomer = false;
            }

            successMessage = string.Format(LocalizationService["SpecificationsSavedFinishedProduct"], item.Code, item.Name);
        }
        catch (Exception ex)
        {
            artworkEditor?.RollbackNewFiles();
            spec.ArtworkFiles = originalFiles;
            spec.ArtworkRelativePath = originalArtworkPath;
            spec.ArtworkOriginalFileName = originalArtworkName;
            if (customerCreatedThisAttempt is not null)
            {
                Db.Entry(customerCreatedThisAttempt).State = Microsoft.EntityFrameworkCore.EntityState.Detached;
                request.CustomerId = originalCustomerId;
                request.Customer = originalCustomer;
                selectedCustomerId = originalCustomerId;
            }

            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    // Fragment-only hrefs resolve against the app's <base href="/"> and
    // accidentally navigate to /#job-edit-*. Use the complete current URL
    // so same-page anchors preserve the request ID and optional quotationId.
    private string GetSectionHref(string sectionId) =>
        $"{Navigation.Uri.Split('#')[0]}#{sectionId}";

    private void BackToRequest() =>
        Navigation.NavigateTo("/sales/requests");
