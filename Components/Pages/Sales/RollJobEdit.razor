@page "/sales/requests/roll/edit/{RequestId:long}"

@using System.Text.Json
@using System.Text.Json.Nodes
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.IO
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@inject LocalizationService LocalizationService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@LocalizationService["RollJobSpecification"]</PageTitle>



<div class="page-container">
    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">@LocalizationService["RollJob"]</div>
            <div class="erp-page-subtitle">@LocalizationService["RollJobSubtitle"]</div>
        </div>
        <button class="btn btn-outline-secondary" @onclick="BackToRequest">
            <i class="bi bi-arrow-left"></i> @LocalizationService["SalesRequests"]
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (isLoading)
    {
        <div class="text-muted">@LocalizationService["LoadingJob"]</div>
    }
    else if (request is not null)
    {
        <fieldset class="border-0 p-0 m-0 w-100" disabled="@(request.Status != SalesRequestStatus.Draft)">
        <div class="card job-section mb-4">
            <div class="card-header"><strong>@LocalizationService["OrderInformation"]</strong></div>
            <div class="card-body">
                <div class="order-info-grid">
                    <label class="form-label">@LocalizationService["Date"]</label>
                    <input class="form-control" value="@request.RequestDate.ToString("yyyy-MM-dd")" readonly />

                    <label class="form-label">@LocalizationService["RequestNumber"]</label>
                    <input class="form-control" value="@request.RequestNumber" readonly />

                    <label class="form-label">@LocalizationService["Customer"]</label>
                    <div>
                        @if (!isCreatingCustomer)
                        {
                            <select class="form-select" @bind="selectedCustomerId" @bind:after="LookupExistingJobAsync" disabled="@TargetQuotationId.HasValue">
                                <option value="0">@LocalizationService["SelectExistingCustomerPrompt"]</option>
                                @foreach (var customer in customers)
                                {
                                    <option value="@customer.Id">@customer.Code - @customer.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-link px-0" disabled="@TargetQuotationId.HasValue" @onclick="StartNewCustomer">
                                @LocalizationService["CreateNewCustomer"]
                            </button>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="form-control bg-light">@LocalizationService["NewCustomer"]</span>
                                <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="SelectExistingCustomer">
                                    @LocalizationService["SelectExisting"]
                                </button>
                            </div>
                        }
                    </div>

                    @if (isCreatingCustomer)
                    {
                        <label class="form-label">@LocalizationService["CustomerCodeRequired"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerCode" />

                        <label class="form-label">@LocalizationService["CustomerNameRequired"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerName" />

                        <label class="form-label">@LocalizationService["Phone"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerPhone" />

                        <label class="form-label">@LocalizationService["Email"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerEmail" />

                        <label class="form-label">@LocalizationService["Address"]</label>
                        <InputText class="form-control" @bind-Value="newCustomerAddress" />
                    }

                    <label class="form-label">@LocalizationService["JobTitle"]</label>
                    <InputText class="form-control" @bind-Value="spec.JobTitle" @bind-Value:after="LookupExistingJobAsync" />
                    <div style="grid-column: 1 / -1;">
                        <ExistingJobTitlePrompt Matches="@existingJobMatches"
                                                JobType="SalesJobType.Roll"
                                                TargetQuotationId="@TargetQuotationId" />
                    </div>

                </div>
            </div>
        </div>

        </fieldset>

        <div class="card job-section mb-4">
            <div class="card-header"><strong>@LocalizationService["ArtworkFiles"]</strong></div>
            <div class="card-body">
                <JobArtworkEditor @ref="artworkEditor"
                                  SavedFiles="@spec.ArtworkFiles"
                                  LegacyPath="@spec.ArtworkRelativePath"
                                  LegacyName="@spec.ArtworkOriginalFileName"
                                  CanEdit="@canEditArtwork" />
            </div>
        </div>

        <fieldset class="border-0 p-0 m-0 w-100" disabled="@(request.Status != SalesRequestStatus.Draft)">

        <div class="card job-section mb-4">
            <div class="card-header"><strong>@LocalizationService["LabelSpecifications"]</strong></div>
            <div class="card-body">
                <div class="label-specifications-grid">
                    <div class="label-specification-field">
                        <label>@LocalizationService["LabelPull"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.LabelPull" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["LabelWidth"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.LabelWidth" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["GapBetweenLabels"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.GapBetweenLabels" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["LabelQuantity"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.LabelQuantity" />
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["PaperTypeMaterial"]</label>
                        <div>
                            <input class="form-control" list="roll-paper-types" @bind="spec.PaperType" placeholder="@LocalizationService["SelectOrEnterMaterial"]" />
                            <datalist id="roll-paper-types">
                                <option value="گلاسه"></option>
                                <option value="نیمه گلاسه"></option>
                                <option value="متالایز"></option>
                                <option value="PVC"></option>
                                <option value="حرارتی"></option>
                                <option value="کاغذی"></option>
                                <option value="شفاف"></option>
                                <option value="صدفی"></option>
                            </datalist>
                            <small class="text-muted">@LocalizationService["SelectStandardOrEnterMaterial"]</small>
                        </div>
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["ColorCount"]</label>
                        <InputSelect class="form-select" @bind-Value="spec.ColorCount">
                            <option value="">@LocalizationService["SelectColorCount"]</option>
                            @for (var color = 1; color <= 10; color++)
                            {
                                <option value="@color">@color</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["PrintingNotes"]</label>
                        <InputText class="form-control" @bind-Value="spec.PrintingNotes" placeholder="@LocalizationService["CustomDetailsPantone"]" />
                    </div>
                    <div class="col-12">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="cmyk-panel">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <strong>@LocalizationService["FrontPrintingColors"]</strong><span class="text-muted small">@LocalizationService["SelectAllColorsOnFront"]</span>
                                    </div>
                                    <div class="cmyk-options">
                                        @foreach (var color in CmykColors)
                                        {
                                            <button type="button" class="cmyk-option @(frontCmykColors.Contains(color.Key) ? "selected" : "")" aria-pressed="@frontCmykColors.Contains(color.Key)" @onclick="() => ToggleCmykColor(frontCmykColors, color.Key)">
                                                <span class="cmyk-letter @color.Css">@color.Key</span><span>@color.Name</span>
                                            </button>
                                        }
                                    </div>
                                    <div class="small text-muted mt-2">Selected: @(frontCmykColors.Count == 0 ? LocalizationService["None"] : string.Join(" · ", CmykColors.Where(c => frontCmykColors.Contains(c.Key)).Select(c => c.Key)))</div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="cmyk-panel">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <strong>@LocalizationService["BackPrintingColors"]</strong><span class="text-muted small">@LocalizationService["SelectAllColorsOnBack"]</span>
                                    </div>
                                    <div class="cmyk-options">
                                        @foreach (var color in CmykColors)
                                        {
                                            <button type="button" class="cmyk-option @(backCmykColors.Contains(color.Key) ? "selected" : "")" aria-pressed="@backCmykColors.Contains(color.Key)" @onclick="() => ToggleCmykColor(backCmykColors, color.Key)">
                                                <span class="cmyk-letter @color.Css">@color.Key</span><span>@color.Name</span>
                                            </button>
                                        }
                                    </div>
                                    <div class="small text-muted mt-2">Selected: @(backCmykColors.Count == 0 ? LocalizationService["None"] : string.Join(" · ", CmykColors.Where(c => backCmykColors.Contains(c.Key)).Select(c => c.Key)))</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="label-specification-field">
                        <label>@LocalizationService["RollDiameter"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.RollDiameter" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">@LocalizationService["RollOrientationUnwindDirection"]</label>
                        <div class="text-muted small mb-2">@LocalizationService["ChooseRollOrientation"]</div>
                        <div class="orientation-grid">
                            @for (var orientation = 1; orientation <= 8; orientation++)
                            {
                                var option = orientation.ToString();
                                var angle = (orientation - 1) * 45;
                                <button type="button"
                                        class="orientation-option @(spec.RollOrientation == option ? "selected" : "")"
                                        aria-pressed="@(spec.RollOrientation == option)"
                                        @onclick="() => spec.RollOrientation = option">
                                    <img src="@($"/images/roll-orientations/orientation-{orientation}.jpg")"
                                         alt="Roll orientation @orientation"
                                         class="orientation-picture" />
                                    <span class="orientation-caption">@LocalizationService["Option"] @orientation</span>
                                    @if (spec.RollOrientation == option)
                                    {
                                        <span class="orientation-check"><i class="bi bi-check-circle-fill"></i> @LocalizationService["Selected"]</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="spec.HandGluing" />
                            <label class="form-check-label">@LocalizationService["HandGluing"]</label>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="spec.MachineGluing" />
                            <label class="form-check-label">@LocalizationService["MachineGluing"]</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card job-section mb-4">
            <div class="card-header">
                <strong>@LocalizationService["AdditionalServices"]</strong>
                <span class="text-muted ms-2">(@LocalizationService["MultipleOptionsCanBeSelected"])</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var group in ServiceGroups)
                    {
                        <div class="col-12 col-xl-6" @key="group.Key">
                            <section class="border rounded p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                    <h6 class="mb-0 fw-semibold">@group.Key</h6>
                                    <span class="badge bg-light text-dark border">@group.Value.Count(x => spec.SelectedServices.Contains(x)) از @group.Value.Length</span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var service in group.Value)
                                    {
                                        <div class="col-sm-6" @key="service">
                                            <div class="form-check">
                                                <input id="roll-service-@service.GetHashCode()"
                                                       class="form-check-input"
                                                       type="checkbox"
                                                       checked="@spec.SelectedServices.Contains(service)"
                                                       @onchange="args => ToggleService(service, args)" />
                                                <label class="form-check-label" for="roll-service-@service.GetHashCode()">@service</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card job-section mb-4">
            <div class="card-header">
                <strong>@LocalizationService["RollWorkflowInfo"]</strong>
            </div>
            <div class="card-body">
                <div class="workflow-fields-grid">
                    @foreach (var field in WorkflowFieldLabels)
                    {
                        <div class="workflow-field" @key="field.Key">
                            @if (field.IsCheckbox)
                            {
                                <div class="form-check">
                                    <input id="workflow-@field.Key"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked="@IsWorkflowChecked(field.Key)"
                                           @onchange="args => SetWorkflowCheckbox(field.Key, args)" />
                                    <label class="form-check-label" for="workflow-@field.Key">@field.Label</label>
                                </div>
                            }
                            else
                            {
                                <label for="workflow-@field.Key">@field.Label</label>
                                <input id="workflow-@field.Key"
                                       class="form-control"
                                       type="@(field.IsNumber ? "number" : "text")"
                                       min="@(field.IsNumber ? "0" : null)"
                                       @bind="workflowFields[field.Key]" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        </fieldset>

        <SalesRequestWorkflowPanel Request="request" />

        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-outline-dark" @onclick="SaveAndOpenProofAsync" disabled="@isSaving">
                <i class="bi bi-file-earmark-pdf"></i> @(request.Status == SalesRequestStatus.Draft
                    ? LocalizationService["SavePreviewAndContinueSalesWorkflow"]
                    : (canEditArtwork
                        ? LocalizationService["SaveAndPreviewApprovalProof"]
                        : LocalizationService["CustomerApprovalProof"]))
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public long RequestId { get; set; }

    [SupplyParameterFromQuery(Name = "quotationId")]
    public long? TargetQuotationId { get; set; }

    private HamiChap_MES_ERP.Models.Sales.SalesRequest? request;
    private List<Customer> customers = new();
    private int selectedCustomerId;
    private bool isCreatingCustomer;
    private string newCustomerCode = "";
    private string newCustomerName = "";
    private string newCustomerPhone = "";
    private string newCustomerEmail = "";
    private string newCustomerAddress = "";
    private RollJobSpecification spec = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    // Workflow values are stored inside JobSpecificationJson, so no database migration is required.
    private Dictionary<string, string> workflowFields = CreateWorkflowFields();

    private static readonly (string Key, string Label, bool IsCheckbox, bool IsNumber)[] WorkflowFieldLabels =
    {
        ("DesignAndImposition", "طراحی و فرم‌بندی", true, false),
        ("PlateSupply", "تامین زینک", false, false),
        ("PlateCount", "تعداد زینک", false, true),
        ("Paper", "کاغذ", false, false),
        ("PrintingPlate", "کلیشه", true, false),
        ("Die", "قالب", true, false),
        ("FoilStamping", "طلاکوب", true, false),
        ("Lamination", "سلفون", true, false),
        ("DieCutSlitting", "دایکات اسلیت", true, false),
        ("SettlementMethod", "نحوه تسویه", false, false)
    };

    private static Dictionary<string, string> CreateWorkflowFields() =>
        WorkflowFieldLabels.ToDictionary(x => x.Key, x => x.IsCheckbox ? "false" : string.Empty);

    private bool IsWorkflowChecked(string key) =>
        workflowFields.TryGetValue(key, out var value) && bool.TryParse(value, out var isChecked) && isChecked;

    private void SetWorkflowCheckbox(string key, ChangeEventArgs args)
    {
        workflowFields[key] = args.Value is bool value && value ? "true" : "false";
    }

    private JobArtworkEditor? artworkEditor;
    private bool canEditArtwork;
    private List<ExistingSalesJobLookup.Match> existingJobMatches = new();
    private HashSet<string> frontCmykColors = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> backCmykColors = new(StringComparer.OrdinalIgnoreCase);
    private static readonly (string Key, string Name, string Css)[] CmykColors =
    {
        ("C", "Cyan", "cmyk-c"), ("M", "Magenta", "cmyk-m"),
        ("Y", "Yellow", "cmyk-y"), ("K", "Black", "cmyk-k")
    };

    private static void ToggleCmykColor(HashSet<string> selection, string color)
    {
        if (!selection.Add(color)) selection.Remove(color);
    }

    private static readonly Dictionary<string, string[]> ServiceGroups = new()
    {
        ["سلفون و لمینیت"] = new[] { "سلفون مات", "سلفون براق" },
        ["طلاکوب و فویل"] = new[] { "طلاکوب روتاری", "طلاکوب تخت", "رنگ فویل" },
        ["قالب و عملیات تکمیلی"] = new[] { "قالب روتاری", "قالب تخت", "دیلن میلن" }
    };

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        existingJobMatches.Clear();

        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        request = await Db.SalesRequests
            .Include(x => x.Customer)
            .Include(x => x.CreatedByUser)
            .Include(x => x.AssignedToUser)
            .Include(x => x.Lines).ThenInclude(x => x.Item)
            .Include(x => x.Lines).ThenInclude(x => x.Unit)
            .FirstOrDefaultAsync(x => x.Id == RequestId);

        if (request is not null)
        {
            selectedCustomerId = request.CustomerId;
            canEditArtwork = request.Status != SalesRequestStatus.Cancelled &&
                !await Db.Quotations.AsNoTracking().AnyAsync(q =>
                    (q.SalesRequestId == RequestId ||
                     q.Lines.Any(line => line.SourceRequestId == RequestId)) &&
                    q.Status != QuotationStatus.Draft &&
                    q.Status != QuotationStatus.RevisionRequired);
        }

        if (request is null)
        {
            errorMessage = LocalizationService["SalesRequestNotFound"];
        }
        else if (request.JobType != SalesJobType.Roll)
        {
            errorMessage = LocalizationService["NotRollJob"];
        }
        else if (!string.IsNullOrWhiteSpace(request.JobSpecificationJson))
        {
            try
            {
                spec = JsonSerializer.Deserialize<RollJobSpecification>(
                    request.JobSpecificationJson) ?? new();
                var savedJson = JsonNode.Parse(request.JobSpecificationJson) as JsonObject;
                workflowFields = CreateWorkflowFields();
                if (savedJson?["WorkflowFields"] is JsonObject savedWorkflow)
                {
                    foreach (var field in WorkflowFieldLabels)
                    {
                        workflowFields[field.Key] = savedWorkflow[field.Key]?.GetValue<string>() ?? string.Empty;
                    }
                }
                frontCmykColors = ReadColorSelection(savedJson?["FrontCmykColors"]);
                backCmykColors = ReadColorSelection(savedJson?["BackCmykColors"]);
            }
            catch (JsonException)
            {
                spec = new();
                errorMessage = LocalizationService["SavedSpecificationsUnreadable"];
            }
        }

        isLoading = false;
    }

    private static HashSet<string> ReadColorSelection(JsonNode? node)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (node is JsonArray array)
            foreach (var item in array)
            {
                var value = item?.GetValue<string>();
                if (value is "C" or "M" or "Y" or "K") result.Add(value);
            }
        return result;
    }

    private async Task LookupExistingJobAsync()
    {
        existingJobMatches.Clear();
        if (request?.Status != SalesRequestStatus.Draft || isCreatingCustomer)
            return;

        try
        {
            errorMessage = null;

            // Query in an independent DI scope: a scoped DbContext cannot be
            // used by simultaneous Blazor events or child render callbacks.
            // The result is passed to a presentation-only child component.
            using var scope = ScopeFactory.CreateScope();
            var lookupDb = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            existingJobMatches = await ExistingSalesJobLookup.FindAsync(
                lookupDb, selectedCustomerId, SalesJobType.Roll,
                spec.JobTitle, RequestId);
        }
        catch (Exception)
        {
            // Do not tear down the Blazor Server circuit for lookup failures.
            existingJobMatches.Clear();
            errorMessage = LocalizationService["ExistingJobLookupFailed"];
        }
    }

    private void StartNewCustomer()
    {
        existingJobMatches.Clear();
        isCreatingCustomer = true;
        newCustomerCode = "";
        newCustomerName = "";
        newCustomerPhone = "";
        newCustomerEmail = "";
        newCustomerAddress = "";
        errorMessage = null;
    }

    private void SelectExistingCustomer()
    {
        isCreatingCustomer = false;
        errorMessage = null;
    }

    private void ToggleService(string service, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        if (selected && !spec.SelectedServices.Contains(service))
            spec.SelectedServices.Add(service);
        else if (!selected)
            spec.SelectedServices.Remove(service);
    }

    private async Task SaveArtworkFileAsync()
    {
        if (request is null || artworkEditor is null) return;

        spec.ArtworkFiles = await artworkEditor.StageForSaveAsync(
            request.Id, HostEnvironment.WebRootPath);
        var first = spec.ArtworkFiles.FirstOrDefault();
        spec.ArtworkRelativePath = first?.RelativePath ?? string.Empty;
        spec.ArtworkOriginalFileName = first?.OriginalFileName ?? string.Empty;
    }

    private async Task SaveArtworkOnlyAsync()
    {
        if (request is null || artworkEditor is null ||
            !artworkEditor.HasPendingChanges || !canEditArtwork)
            return;

        var originalFiles = spec.ArtworkFiles?.ToList() ?? new();
        var originalPath = spec.ArtworkRelativePath;
        var originalName = spec.ArtworkOriginalFileName;
        var originalJson = request.JobSpecificationJson;

        try
        {
            isSaving = true;
            errorMessage = null;

            // Recheck approval state immediately before writing: a quotation
            // could have become approved since the job editor was opened.
            var locked = await Db.Quotations.AsNoTracking().AnyAsync(q =>
                (q.SalesRequestId == RequestId ||
                 q.Lines.Any(line => line.SourceRequestId == RequestId)) &&
                q.Status != QuotationStatus.Draft &&
                q.Status != QuotationStatus.RevisionRequired);
            if (locked)
                throw new InvalidOperationException(LocalizationService["ArtworkLockedAfterApproval"]);

            await using var transaction = await Db.Database.BeginTransactionAsync();
            await SaveArtworkFileAsync();
            var json = JsonNode.Parse(originalJson) as JsonObject ?? new();
            json["ArtworkFiles"] = JsonSerializer.SerializeToNode(spec.ArtworkFiles);
            json["ArtworkRelativePath"] = spec.ArtworkRelativePath;
            json["ArtworkOriginalFileName"] = spec.ArtworkOriginalFileName;
            request.JobSpecificationJson = json.ToJsonString();
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            artworkEditor.CompleteSave();
        }
        catch (Exception ex)
        {
            artworkEditor.RollbackNewFiles();
            spec.ArtworkFiles = originalFiles;
            spec.ArtworkRelativePath = originalPath;
            spec.ArtworkOriginalFileName = originalName;
            request.JobSpecificationJson = originalJson;
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAndOpenProofAsync()
    {
        if (request is null)
            return;

        if (request.Status == SalesRequestStatus.Draft)
            await SaveAsync();
        else
            await SaveArtworkOnlyAsync();

        if (!string.IsNullOrWhiteSpace(errorMessage))
            return;

        // The single button saves the job and opens its approval proof.
        // Submission/quotation actions remain on the job editor.
        Navigation.NavigateTo(TargetQuotationId.HasValue
            ? $"/sales/requests/proof/{RequestId}?quotationId={TargetQuotationId.Value}"
            : $"/sales/requests/proof/{RequestId}");
    }

    private async Task SaveAsync()
    {
        if (request is null || request.Status != SalesRequestStatus.Draft) return;

        if (TargetQuotationId.HasValue)
        {
            var target = await Db.Quotations.AsNoTracking()
                .Where(q => q.Id == TargetQuotationId.Value)
                .Select(q => new { q.CustomerId, q.Status })
                .FirstOrDefaultAsync();
            if (target is null ||
                target.Status is not (QuotationStatus.Draft or QuotationStatus.RevisionRequired))
            {
                errorMessage = LocalizationService["QuotationNotEditable"];
                return;
            }
            if (isCreatingCustomer || selectedCustomerId != target.CustomerId)
            {
                errorMessage = LocalizationService["QuotationCustomerMustMatch"];
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(spec.JobTitle))
        {
            errorMessage = LocalizationService["JobTitleRequired"];
            return;
        }
        var orderedQuantity = spec.LabelQuantity;
        if (orderedQuantity.GetValueOrDefault() <= 0)
        {
            errorMessage = LocalizationService["QuantityMustBeGreaterThanZero"];
            return;
        }
        // Correcting an artwork mistake may temporarily leave the job without artwork.
        if (!isCreatingCustomer)
        {
            var duplicates = await ExistingSalesJobLookup.FindAsync(
                Db, selectedCustomerId, SalesJobType.Roll, spec.JobTitle, RequestId);
            if (duplicates.Count > 0)
            {
                errorMessage = LocalizationService["MatchingExistingJobSaveBlocked"];
                return;
            }
        }

        Customer? customerCreatedThisAttempt = null;
        var originalCustomerId = request.CustomerId;
        var originalCustomer = request.Customer;
        var originalFiles = spec.ArtworkFiles?.ToList() ?? new();
        var originalArtworkPath = spec.ArtworkRelativePath;
        var originalArtworkName = spec.ArtworkOriginalFileName;

        try
        {
            isSaving = true;
            errorMessage = null;

            // Keep customer creation/selection, item creation/reuse, and specifications in one transaction.
            await using var transaction = await Db.Database.BeginTransactionAsync();

            if (isCreatingCustomer)
            {
                if (string.IsNullOrWhiteSpace(newCustomerCode))
                    throw new InvalidOperationException(LocalizationService["CustomerCodeIsRequired"]);

                if (string.IsNullOrWhiteSpace(newCustomerName))
                    throw new InvalidOperationException(LocalizationService["CustomerNameIsRequired"]);

                var code = newCustomerCode.Trim();
                if (await Db.Customers.AnyAsync(x => x.Code == code))
                    throw new InvalidOperationException(string.Format(LocalizationService["CustomerCodeAlreadyExists"], code));

                var newCustomer = new Customer
                {
                    Code = code,
                    Name = newCustomerName.Trim(),
                    Phone = newCustomerPhone.Trim(),
                    Email = newCustomerEmail.Trim(),
                    Address = newCustomerAddress.Trim(),
                    IsActive = true
                };

                Db.Customers.Add(newCustomer);
                await Db.SaveChangesAsync();

                customerCreatedThisAttempt = newCustomer;
                request.CustomerId = newCustomer.Id;
                request.Customer = newCustomer;
            }
            else
            {
                var selectedCustomer = customers.FirstOrDefault(x => x.Id == selectedCustomerId);
                if (selectedCustomer is null)
                    throw new InvalidOperationException(LocalizationService["SelectOrCreateCustomer"]);

                request.CustomerId = selectedCustomer.Id;
                request.Customer = selectedCustomer;
            }

            await SaveArtworkFileAsync();

            var item = await JobProductItemHelper.GetOrCreateAsync(
                Db, request, spec.JobTitle, "products-roll");

            var previousFinishedProductItemId = spec.FinishedProductItemId;
            spec.FinishedProductItemId = item.Id;
            SalesRequestFinishedLineSync.Apply(
                Db, request, item, orderedQuantity, previousFinishedProductItemId);
            var savedSpec = JsonNode.Parse(JsonSerializer.Serialize(spec)) as JsonObject ?? new JsonObject();
            savedSpec["FrontCmykColors"] = new JsonArray(frontCmykColors.OrderBy(c => c).Select(c => (JsonNode?)JsonValue.Create(c)).ToArray());
            savedSpec["BackCmykColors"] = new JsonArray(backCmykColors.OrderBy(c => c).Select(c => (JsonNode?)JsonValue.Create(c)).ToArray());
            var workflowJson = new JsonObject();
            foreach (var field in WorkflowFieldLabels)
                workflowJson[field.Key] = workflowFields[field.Key] ?? string.Empty;
            savedSpec["WorkflowFields"] = workflowJson;
            request.JobSpecificationJson = savedSpec.ToJsonString();
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            artworkEditor?.CompleteSave();

            if (customerCreatedThisAttempt is not null)
            {
                customers.Add(customerCreatedThisAttempt);
                selectedCustomerId = customerCreatedThisAttempt.Id;
                isCreatingCustomer = false;
            }

            successMessage = string.Format(LocalizationService["SpecificationsSavedFinishedProduct"], item.Code, item.Name);
        }
        catch (Exception ex)
        {
            artworkEditor?.RollbackNewFiles();
            spec.ArtworkFiles = originalFiles;
            spec.ArtworkRelativePath = originalArtworkPath;
            spec.ArtworkOriginalFileName = originalArtworkName;
            if (customerCreatedThisAttempt is not null)
            {
                Db.Entry(customerCreatedThisAttempt).State = Microsoft.EntityFrameworkCore.EntityState.Detached;
                request.CustomerId = originalCustomerId;
                request.Customer = originalCustomer;
                selectedCustomerId = originalCustomerId;
            }

            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BackToRequest() =>
        Navigation.NavigateTo("/sales/requests");
}
