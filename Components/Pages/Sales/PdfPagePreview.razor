@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="proof-pdf-pages" @ref="_container">
    <div class="text-muted small text-center py-3">Loading PDF pages...</div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Url { get; set; } = "";

    private ElementReference _container;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(Url))
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                Navigation.ToAbsoluteUri("js/pdfPreview.js").ToString());

            await _module.InvokeVoidAsync("renderPdf", _container, Url);
        }
        catch
        {
            await JS.InvokeVoidAsync("console.error", "Could not render PDF preview.");
        }
    }

    public async ValueTask DisposeAsync()
    {
                try
        {
            await _module.InvokeVoidAsync("disposePdf", _container);
        }
        catch { }

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch { }
        }
    }
}