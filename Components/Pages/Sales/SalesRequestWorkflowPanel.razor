@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services

@inject LocalizationService LocalizationService

@* The finished-product request line is generated from RollJobEdit/SheetJobEdit.
   It must not be entered independently: quotations still read that saved line. *@
<div class="card shadow-sm mb-4" id="sales-workflow">
    <div class="card-header">
        <span class="job-edit-section-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
        <strong>@LocalizationService["OrderInformation"]</strong>
    </div>
    <div class="card-body">
        <dl class="job-workflow-summary">
            <div class="job-workflow-fact">
                <span class="job-workflow-fact-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
                <div>
                    <dt>@LocalizationService["Status"]</dt>
                    <dd>@LocalizationService.TranslateEnum(Request.Status)</dd>
                </div>
            </div>
            <div class="job-workflow-fact">
                <span class="job-workflow-fact-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
                <div>
                    <dt>@LocalizationService["CreatedBy"]</dt>
                    <dd>@UserDisplayName(Request.CreatedByUser)</dd>
                </div>
            </div>
            <div class="job-workflow-fact">
                <span class="job-workflow-fact-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
                <div>
                    <dt>@LocalizationService["AssignedEvaluator"]</dt>
                    <dd>@UserDisplayName(Request.AssignedToUser)</dd>
                </div>
            </div>
        </dl>

        <div class="job-workflow-fields">
            <div class="job-workflow-field">
                <label class="form-label" for="job-workflow-delivery"><i class="bi bi-calendar-event app-field-icon" aria-hidden="true"></i> @LocalizationService["RequestedDeliveryDate"]</label>
                @if (IsDraft)
                {
                    <InputDate id="job-workflow-delivery" class="form-control" @bind-Value="Request.RequestedDeliveryDate" />
                }
                else
                {
                    <input id="job-workflow-delivery" class="form-control" value="@(Request.RequestedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")" readonly />
                }
            </div>
            <div class="job-workflow-field">
                <label class="form-label" for="job-workflow-notes"><i class="bi bi-chat-left-text app-field-icon" aria-hidden="true"></i> @LocalizationService["Notes"]</label>
                @if (IsDraft)
                {
                    <textarea id="job-workflow-notes" class="form-control" rows="3" @bind="Request.Notes"></textarea>
                }
                else
                {
                    <textarea id="job-workflow-notes" class="form-control" rows="3" readonly>@Request.Notes</textarea>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public SalesRequest Request { get; set; } = default!;

    private bool IsDraft => Request.Status == SalesRequestStatus.Draft;

    private static string UserDisplayName(ApplicationUser? user)
    {
        if (user is null) return "-";
        var fullName = $"{user.FirstName} {user.LastName}".Trim();
        return fullName.Length > 0 ? fullName : user.UserName ?? "-";
    }
}
