@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using Microsoft.JSInterop
@implements IDisposable

@inject LocalizationService LocalizationService

<div class="job-artwork-editor">
    @if (CanEdit)
    {
        <label class="form-label fw-semibold">@LocalizationService["ArtworkFiles"]</label>
        <div class="artwork-upload-box w-100">
            <i class="bi bi-cloud-arrow-up fs-3"></i>
            <strong>@(replacingPath is null ? LocalizationService["UploadArtworkFiles"] : LocalizationService["SelectReplacementArtwork"])</strong>
            <div class="small text-muted">@LocalizationService["ArtworkFileLimits"]</div>
            @if (replacingPath is not null)
            {
                <div class="small text-primary">@LocalizationService["ReplacingArtwork"]: @GetName(replacingPath)</div>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        disabled="@Busy" @onclick="() => replacingPath = null">@LocalizationService["Cancel"]</button>
            }
            <InputFile @key="inputVersion" OnChange="ArtworkSelectedAsync" multiple="@(replacingPath is null)"
                       accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.webp"
                       disabled="@Busy" class="form-control mt-2" />
            @if (IsReceiving)
            {
                <div class="mt-2 small text-primary" role="status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    @Text("Uploading artwork — please wait before selecting more files or saving.", "در حال بارگذاری فایل طرح؛ پیش از انتخاب فایل دیگر یا ذخیره منتظر بمانید.")
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(localError))
    {
        <div class="alert alert-danger py-2 my-2">@localError</div>
    }

    @if (ExistingFiles.Count > 0)
    {
        <div class="mt-3">
            <div class="fw-semibold mb-2">@LocalizationService["PreviouslyUploadedArtwork"]</div>
            @foreach (var file in ExistingFiles)
            {
                var removed = removedPaths.Contains(file.RelativePath);
                var replacement = pendingArtworks.FirstOrDefault(x => x.ReplacesPath == file.RelativePath);
                <div class="artwork-file-row mb-2" @key="file.RelativePath">
                    <div class="text-truncate">
                        <i class="bi bi-paperclip me-2"></i>
                        <a href="@file.RelativePath" target="_blank" rel="noopener"
                           class="@(removed ? "text-decoration-line-through text-muted" : "")">
                            @file.OriginalFileName
                        </a>
                        @if (removed)
                        {
                            <div class="small text-warning">@LocalizationService["ArtworkMarkedForRemoval"]</div>
                        }
                        else if (replacement is not null)
                        {
                            <div class="small text-primary">@LocalizationService["ReplacingArtwork"]: @replacement.Name</div>
                        }
                    </div>
                    @if (CanEdit)
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @if (removed)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        disabled="@Busy" @onclick="() => UndoRemove(file.RelativePath)">
                                    @LocalizationService["Undo"]
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        disabled="@Busy" @onclick="() => BeginReplace(file.RelativePath)">
                                    @LocalizationService["ReplaceArtwork"]
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        disabled="@Busy" @onclick="() => MarkRemove(file.RelativePath)">
                                    @LocalizationService["Remove"]
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (pendingArtworks.Count > 0)
    {
        <div class="mt-3">
            <div class="fw-semibold mb-2">@LocalizationService["SelectedForUpload"]</div>
            @foreach (var pending in pendingArtworks)
            {
                <div class="artwork-file-row mb-2" @key="pending">
                    <div class="text-truncate">
                        <i class="bi bi-file-earmark me-2"></i>
                        @pending.Name
                        <small class="text-muted">(@(Math.Ceiling(pending.Size / 1024d).ToString("N0")) KB)</small>
                        @if (pending.ReplacesPath is not null)
                        {
                            <span class="small text-primary">— @LocalizationService["ReplacementArtwork"]</span>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            disabled="@Busy" @onclick="() => RemovePending(pending)">@LocalizationService["Remove"]</button>
                </div>
            }
        </div>
    }

    @if (CanEdit && !HasArtworkAfterChanges)
    {
        <div class="alert alert-warning py-2 mt-2">@LocalizationService["ArtworkMissingWarning"]</div>
    }

    @if (CanEdit && HasPendingChanges)
    {
        <p class="form-text mt-2">@LocalizationService["ArtworkChangesSavedOnSave"]</p>
    }
</div>

@code {
    [Parameter] public List<JobArtworkFile>? SavedFiles { get; set; }
    [Parameter] public string? LegacyPath { get; set; }
    [Parameter] public string? LegacyName { get; set; }
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public bool ParentSaving { get; set; }
    [Parameter] public EventCallback ReceivingChanged { get; set; }

    private const long MaxBytes = 25L * 1024 * 1024;
    private const int MaxPendingFiles = 20;
    private static readonly HashSet<string> AllowedExtensions = new(StringComparer.OrdinalIgnoreCase)
        { ".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".webp" };
    private sealed record PendingArtwork(string Name, long Size, string TempPath, string? ReplacesPath);

    // Temporary content is outside the web root. Never retain browser file IDs
    // across selections or after the InputFile component is replaced.
    private readonly string tempDirectory = Path.Combine(Path.GetTempPath(), "HamiChap-artwork", Guid.NewGuid().ToString("N"));
    private readonly CancellationTokenSource lifetime = new();
    private bool disposed;
    private int inputVersion;
    public bool IsReceiving { get; private set; }
    private bool Busy => IsReceiving || ParentSaving;
    private string Text(string en, string fa) => LocalizationService.IsPersian ? fa : en;

    private readonly List<PendingArtwork> pendingArtworks = new();
    private readonly HashSet<string> removedPaths = new(StringComparer.Ordinal);
    private readonly List<string> freshlyWrittenPaths = new();
    private string? replacingPath;
    private string? localError;

    private List<JobArtworkFile> ExistingFiles
    {
        get
        {
            var files = (SavedFiles ?? new()).Where(x => !string.IsNullOrWhiteSpace(x.RelativePath))
                .GroupBy(x => x.RelativePath, StringComparer.Ordinal)
                .Select(x => x.First())
                .ToList();

            if (!string.IsNullOrWhiteSpace(LegacyPath) &&
                files.All(x => x.RelativePath != LegacyPath))
            {
                files.Insert(0, new JobArtworkFile
                {
                    RelativePath = LegacyPath,
                    OriginalFileName = string.IsNullOrWhiteSpace(LegacyName)
                        ? Path.GetFileName(LegacyPath) : LegacyName
                });
            }
            return files;
        }
    }

    public bool HasPendingChanges => pendingArtworks.Count > 0 || removedPaths.Count > 0;

    public bool HasArtworkAfterChanges =>
        ExistingFiles.Count(x => !removedPaths.Contains(x.RelativePath) &&
            pendingArtworks.All(p => p.ReplacesPath != x.RelativePath)) +
        pendingArtworks.Count > 0;

    private string GetName(string path) =>
        ExistingFiles.FirstOrDefault(x => x.RelativePath == path)?.OriginalFileName ?? path;

    private void BeginReplace(string path)
    {
        replacingPath = path;
        localError = null;
    }

    private void MarkRemove(string path)
    {
        removedPaths.Add(path);
        foreach (var pending in pendingArtworks.Where(x => x.ReplacesPath == path).ToList())
            RemovePending(pending);
        if (replacingPath == path)
            replacingPath = null;
        localError = null;
    }

    private void UndoRemove(string path) => removedPaths.Remove(path);

    private void RemovePending(PendingArtwork pending)
    {
        if (pendingArtworks.Remove(pending)) DeleteTempFile(pending.TempPath);
    }

    private async Task ArtworkSelectedAsync(InputFileChangeEventArgs args)
    {
        if (!CanEdit || Busy || disposed) return;
        localError = null;
        IsReceiving = true;
        var replacementPath = replacingPath;
        var batch = new List<PendingArtwork>();
        try
        {
            // Disable the picker and parent save controls while its current
            // browser file IDs are being consumed.
            await ReceivingChanged.InvokeAsync();
            StateHasChanged();
            var files = args.GetMultipleFiles(MaxPendingFiles);
            if (replacementPath is not null && files.Count != 1)
                throw new InvalidOperationException(LocalizationService["SelectOneReplacementArtwork"]);
            var retainedCount = pendingArtworks.Count(x => replacementPath is null || x.ReplacesPath != replacementPath);
            if (retainedCount + files.Count > MaxPendingFiles)
                throw new InvalidOperationException(Text("Select no more than 20 pending artwork files per save.", "حداکثر ۲۰ فایل طرح را در هر ذخیره انتخاب کنید."));
            foreach (var file in files)
            {
                if (file.Size <= 0 || file.Size > MaxBytes)
                    throw new InvalidOperationException(string.Format(LocalizationService["ArtworkMaxSize"], file.Name));
                if (!AllowedExtensions.Contains(Path.GetExtension(file.Name)))
                    throw new InvalidOperationException(string.Format(LocalizationService["UnsupportedArtworkFormat"], file.Name));
            }
            Directory.CreateDirectory(tempDirectory);
            foreach (var file in files)
            {
                var path = Path.Combine(tempDirectory, Guid.NewGuid().ToString("N") + ".tmp");
                var pending = new PendingArtwork(Path.GetFileName(file.Name), file.Size, path, replacementPath);
                batch.Add(pending);
                await using var source = file.OpenReadStream(MaxBytes, lifetime.Token);
                await using var target = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None, 65536, useAsync: true);
                await source.CopyToAsync(target, lifetime.Token);
                if (target.Length != file.Size)
                    throw new IOException("Incomplete artwork upload.");
            }
            if (disposed) return;
            // Commit the batch only after every file has arrived. A failed
            // replacement must not discard the previous pending replacement.
            if (replacementPath is not null)
            {
                foreach (var previous in pendingArtworks.Where(x => x.ReplacesPath == replacementPath).ToList())
                    RemovePending(previous);
                removedPaths.Remove(replacementPath);
                replacingPath = null;
            }
            pendingArtworks.AddRange(batch);
            batch.Clear();
        }
        catch (InvalidOperationException ex) { localError = ex.Message; }
        catch (JSException) { localError = Text("Artwork selection changed during upload. Select the affected files again.", "انتخاب فایل هنگام بارگذاری تغییر کرد. فایل‌های مورد نظر را دوباره انتخاب کنید."); }
        catch (IOException) { localError = Text("Artwork upload could not be completed. Try again or contact your administrator to check server storage.", "بارگذاری فایل طرح کامل نشد. دوباره تلاش کنید یا برای بررسی فضای سرور با مدیر تماس بگیرید."); }
        catch (UnauthorizedAccessException) { localError = Text("The server cannot write temporary artwork files. Contact your administrator.", "سرور امکان نوشتن فایل‌های موقت طرح را ندارد. با مدیر تماس بگیرید."); }
        catch (OperationCanceledException) when (disposed) { }
        finally
        {
            foreach (var pending in batch) DeleteTempFile(pending.TempPath);
            IsReceiving = false;
            if (disposed) DeleteTempDirectory();
            else
            {
                // A fresh InputFile permits selecting the same filename again.
                inputVersion++;
                await ReceivingChanged.InvokeAsync();
            }
        }
    }

    private static void DeleteTempFile(string path)
    {
        try { File.Delete(path); }
        catch (IOException) { }
        catch (UnauthorizedAccessException) { }
    }

    private void DeleteTempDirectory()
    {
        try { if (Directory.Exists(tempDirectory)) Directory.Delete(tempDirectory, recursive: true); }
        catch (IOException) { }
        catch (UnauthorizedAccessException) { }
    }

    public void Dispose()
    {
        disposed = true;
        lifetime.Cancel();
        foreach (var pending in pendingArtworks) DeleteTempFile(pending.TempPath);
        if (!IsReceiving) DeleteTempDirectory();
        lifetime.Dispose();
    }

    /// <summary>
    /// Stage uploads using unique filenames; only the calling editor persists the
    /// returned references. Old files are DETACHED, not deleted, to preserve
    /// previously issued approval proofs and historical document links.
    /// </summary>
    public async Task<List<JobArtworkFile>> StageForSaveAsync(long requestId, string webRoot)
    {
        if (!CanEdit)
            throw new InvalidOperationException("Artwork is locked for this job.");

        if (IsReceiving)
            throw new InvalidOperationException(Text("Wait until artwork uploads finish before saving.", "پیش از ذخیره منتظر پایان بارگذاری فایل طرح بمانید."));

        var updated = ExistingFiles
            .Where(x => !removedPaths.Contains(x.RelativePath) &&
                pendingArtworks.All(p => p.ReplacesPath != x.RelativePath))
            .ToList();

        var folder = Path.Combine(webRoot, "uploads", "job-artwork");
        if (pendingArtworks.Count > 0)
            Directory.CreateDirectory(folder);

        try
        {
            foreach (var pending in pendingArtworks)
            {
                var extension = Path.GetExtension(pending.Name).ToLowerInvariant();
                var safeName = $"request-{requestId}-{Guid.NewGuid():N}{extension}";
                var fullPath = Path.Combine(folder, safeName);
                freshlyWrittenPaths.Add(fullPath);

                await using (var source = new FileStream(pending.TempPath, FileMode.Open, FileAccess.Read, FileShare.Read, 65536, useAsync: true))
                await using (var target = new FileStream(fullPath, FileMode.CreateNew, FileAccess.Write, FileShare.None, 65536, useAsync: true))
                    await source.CopyToAsync(target);

                updated.Add(new JobArtworkFile
                {
                    RelativePath = $"/uploads/job-artwork/{safeName}",
                    OriginalFileName = Path.GetFileName(pending.Name)
                });
            }
            return updated;
        }
        catch
        {
            RollbackNewFiles();
            throw;
        }
    }

    public void CompleteSave()
    {
        freshlyWrittenPaths.Clear();
        foreach (var pending in pendingArtworks) DeleteTempFile(pending.TempPath);
        pendingArtworks.Clear();
        DeleteTempDirectory();
        removedPaths.Clear();
        replacingPath = null;
        localError = null;
    }

    public void RollbackNewFiles()
    {
        foreach (var file in freshlyWrittenPaths)
        {
            try { if (File.Exists(file)) File.Delete(file); }
            catch (IOException) { /* Best effort cleanup */ }
            catch (UnauthorizedAccessException) { /* Best effort cleanup */ }
        }
        freshlyWrittenPaths.Clear();
    }
}
