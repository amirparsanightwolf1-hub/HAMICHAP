@page "/sales/deliveries/edit/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Inventory
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Shared
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@using SalesDeliveryModel = HamiChap_MES_ERP.Models.Sales.SalesDelivery
@using SalesDeliveryLineModel = HamiChap_MES_ERP.Models.Sales.SalesDeliveryLine

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ShipmentPaymentService ShipmentPayment
@inject PermissionService Permissions
@inject LocalizationService L

<PageTitle>
    @L["SalesDelivery"]
</PageTitle>

<div class="page-container">

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @L["Loading"]
                </span>
            </div>
        </div>
    }
    else if (delivery == null)
    {
        <div class="alert alert-danger">
            @L["SalesDeliveryNotFound"]
        </div>
    }
    else
    {
        <div class="erp-page-header mb-4">

            <div>
                <div class="erp-page-title">
                    @L["SalesDelivery"]
                </div>

                <div class="erp-page-subtitle">
                    @HamiChap_MES_ERP.Models.Sales.JobReferences.Titles(delivery.SalesOrder?.Quotation, delivery.DeliveryNumber)
                    <small class="text-muted d-block">@delivery.DeliveryNumber</small>
                </div>
            </div>

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="GoBack">

                    <i class="bi bi-arrow-left"></i>
                    @L["Back"]

                </button>

                @if (delivery.Status == SalesDeliveryStatus.Draft && linkedInvoice == null && canEdit)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveAsync"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-save"></i>
                        @L["Save"]

                    </button>

                }
                @if (delivery.Status == SalesDeliveryStatus.Draft && linkedInvoice == null && canPrepare)
                {
                    <button type="button" class="btn btn-primary" disabled="@(isSaving || isPosting || !SelectedInvoiceType.HasValue)" @onclick="PrepareInvoiceAsync"><i class="bi bi-receipt"></i> @Text("Create invoice", "صدور فاکتور")</button>
                }
                @if (linkedInvoice != null)
                {
                    <a class="btn btn-outline-primary" href="@($"/sales/invoices/edit/{linkedInvoice.Id}")">@Text("View invoice", "مشاهده فاکتور")</a>
                }
                @if (delivery.Status == SalesDeliveryStatus.Draft && linkedInvoice?.PaidAtUtc != null && canPost)
                {
                    <button type="button" class="btn btn-success" disabled="@(isPosting || isSaving)" @onclick="PostAsync"><i class="bi bi-truck"></i> @Text("Dispatch paid goods", "ارسال کالای پرداخت شده")</button>
                }

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-4">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success mb-4">
                @successMessage
            </div>
        }

        @if (delivery.Status == SalesDeliveryStatus.Draft)
        {
            <div class="alert @(linkedInvoice?.PaidAtUtc != null ? "alert-success" : "alert-info")">
                @(linkedInvoice == null ? Text("Prepare an invoice for QC-accepted finished goods.", "برای محصول نهایی تأییدشده فاکتور صادر کنید.") :
                    linkedInvoice.PaidAtUtc == null ? Text("Awaiting full payment — shipment locked.", "در انتظار پرداخت کامل — ارسال مسدود است.") :
                    Text("Payment confirmed — ready for shipment, subject to current stock.", "پرداخت تأیید شد — آماده ارسال با بررسی موجودی."))
            </div>
        }
        @if (delivery.Status == SalesDeliveryStatus.Draft && linkedInvoice == null && canPrepare)
        {
            <section class="card mb-3">
                <div class="card-body">
                    <label for="invoice-type" class="form-label fw-semibold">@Text("Invoice type", "نوع فاکتور")</label>
                    <select id="invoice-type" class="form-select" style="max-width:360px" @bind="invoiceTypeChoice" disabled="@(isPosting || isSaving || QuotationDocument.InvoiceType(delivery.SalesOrder?.Quotation?.QuotationType) != null)">
                        <option value="">@Text("Select invoice type", "انتخاب نوع فاکتور")</option>
                        <option value="Formal">@Text("Formal", "رسمی")</option>
                        <option value="Informal">@Text("Informal", "غیررسمی")</option>
                    </select>
                    <p class="small text-muted mt-2 mb-0">@Text("Formal includes registered customer details; informal uses a simpler layout. Both use accepted quotation prices and require full payment before shipment. Formal requires a completed customer identity profile.", "فاکتور رسمی شامل مشخصات ثبتی مشتری و غیررسمی دارای قالب ساده‌تر است. هر دو بر اساس قیمت توافق‌شده و با پرداخت کامل پیش از ارسال هستند. برای فاکتور رسمی مشخصات هویتی مشتری را تکمیل کنید.")</p>
                </div>
            </section>
        }
        else if (linkedInvoice != null)
        {
            <div class="mb-3 small"><strong>@Text("Invoice type", "نوع فاکتور"):</strong> @InvoiceTypeLabels.Label(linkedInvoice.InvoiceType, L.IsPersian)</div>
        }
        <!-- Delivery Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>
                    @L["SalesDeliveryInformation"]
                </strong>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <!-- Delivery Number -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["DeliveryNumber"]
                        </label>

                        <input class="form-control"
                               value="@delivery.DeliveryNumber"
                               readonly />

                    </div>

                    <!-- Sales Order -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["SalesOrder"]
                        </label>

                        <input class="form-control"
                               value="@GetSalesOrderNumber()"
                               readonly />

                    </div>

                    <!-- Customer -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["Customer"]
                        </label>

                        <input class="form-control"
                               value="@GetCustomerName()"
                               readonly />

                    </div>

                    <!-- Status -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["Status"]
                        </label>

                        <input class="form-control"
                               value="@L.TranslateEnum(delivery.Status)"
                               readonly />

                    </div>

                    <!-- Delivery Date -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["DeliveryDate"]
                        </label>

                        @if (CanEditDraft)
                        {
                            <InputDate @bind-Value="delivery.DeliveryDate"
                                       class="form-control" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@delivery.DeliveryDate.ToString("yyyy-MM-dd")"
                                   readonly />
                        }

                    </div>

                    <!-- From Location -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["FromLocation"]
                        </label>

                        @if (CanEditDraft)
                        {
                            <select class="form-select"
                                    @bind="delivery.FromLocationId">

                                @foreach (var location in finishedGoodsLocations)
                                {
                                    <option value="@location.Id">
                                        @GetLocationDisplayName(location)
                                    </option>
                                }

                            </select>
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@GetLocationDisplayName(delivery.FromLocation)"
                                   readonly />
                        }

                    </div>

                    <!-- To Location -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["ToLocation"]
                        </label>

                        @if (CanEditDraft)
                        {
                            <select class="form-select"
                                    @bind="delivery.ToLocationId">

                                @foreach (var location in customerLocations)
                                {
                                    <option value="@location.Id">
                                        @GetLocationDisplayName(location)
                                    </option>
                                }

                            </select>
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@GetLocationDisplayName(delivery.ToLocation)"
                                   readonly />
                        }

                    </div>

                    <!-- Created By -->

                    <div class="col-md-3">

                        <label class="form-label">
                            @L["CreatedBy"]
                        </label>

                        <input class="form-control"
                               value="@GetUserName()"
                               readonly />

                    </div>

                    <!-- Notes -->

                    <div class="col-12">

                        <label class="form-label">
                            @L["Notes"]
                        </label>

                        @if (CanEditDraft)
                        {
                            <textarea class="form-control"
                                      rows="3"
                                      @bind="delivery.Notes">
                            </textarea>
                        }
                        else
                        {
                            <textarea class="form-control"
                                      rows="3"
                                      readonly>@delivery.Notes</textarea>
                        }

                    </div>

                </div>

            </div>
        </div>

        <!-- Delivery Lines -->

        <div class="card shadow-sm">

            <div class="card-header">
                <strong>
                    @L["DeliveryLines"]
                </strong>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    @L["Item"]
                                </th>

                                <th class="text-end">
                                    @L["OrderedQuantity"]
                                </th>

                                <th class="text-end">
                                    @L["DeliveredQuantity"]
                                </th>

                                <th class="text-end">
                                    @L["RemainingQuantity"]
                                </th>

                                <th class="text-end">
                                    @L["DeliveryQuantity"]
                                </th>

                                <th>
                                    @L["Unit"]
                                </th>

                                <th>
                                    @L["Notes"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var line in delivery.Lines)
                            {
                                var salesLine =
                                    line.SalesOrderLine;

                                var remaining =
                                    salesLine.Quantity -
                                    salesLine.DeliveredQuantity;

                                <tr>

                                    <!-- Item -->

                                    <td>

                                        <div class="fw-semibold">
                                            @GetItemDisplayName(line)
                                        </div>

                                        <small class="text-muted">
                                            @line.ItemId
                                        </small>

                                    </td>

                                    <!-- Ordered -->

                                    <td class="text-end">
                                        @salesLine.Quantity.ToString("N2")
                                    </td>

                                    <!-- Delivered -->

                                    <td class="text-end">
                                        @salesLine.DeliveredQuantity.ToString("N2")
                                    </td>

                                    <!-- Remaining -->

                                    <td class="text-end">
                                        @remaining.ToString("N2")
                                    </td>

                                    <!-- Delivery Quantity -->

                                    <td class="text-end erp-min-width-150"
                                        >

                                        @if (CanEditDraft)
                                        {
                                            <input type="number"
                                                   class="form-control text-end"
                                                   step="0.0001"
                                                   min="0"
                                                   max="@remaining"
                                                   @bind="line.Quantity" />
                                        }
                                        else
                                        {
                                            @line.Quantity.ToString("N2")
                                        }

                                    </td>

                                    <!-- Unit -->

                                    <td>
                                        @GetUnitDisplayName(line)
                                    </td>

                                    <!-- Notes -->

                                    <td class="erp-min-width-220" >

                                        @if (CanEditDraft)
                                        {
                                            <input type="text"
                                                   class="form-control"
                                                   @bind="line.Notes" />
                                        }
                                        else
                                        {
                                            @line.Notes
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        @if (delivery.Status == SalesDeliveryStatus.Posted)
        {
            <div class="alert alert-success mt-4">

                <i class="bi bi-check-circle me-1"></i>

                @L["SalesDeliveryPostedSuccessfully"]

            </div>
        }

        @if (delivery.Status == SalesDeliveryStatus.Cancelled)
        {
            <div class="alert alert-secondary mt-4">

                <i class="bi bi-x-circle me-1"></i>

                @L["SalesDeliveryCancelled"]

            </div>
        }
    }

</div>

@code {

    [Parameter]
    public long Id { get; set; }

    private SalesDeliveryModel? delivery;
    private HamiChap_MES_ERP.Models.Sales.SalesInvoice? linkedInvoice;
    private bool canEdit, canPrepare, canPost;
    private string invoiceTypeChoice = "";
    private SalesInvoiceType? SelectedInvoiceType => Enum.TryParse<SalesInvoiceType>(invoiceTypeChoice, out var type) && Enum.IsDefined(type) ? type : null;
    private bool CanEditDraft => canEdit && linkedInvoice == null && delivery?.Status == SalesDeliveryStatus.Draft;
    private string Text(string en, string fa) => L.IsPersian ? fa : en;

    private List<InventoryLocation> locations = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool isPosting;

    private string? errorMessage;
    private string? successMessage;

    private List<InventoryLocation> finishedGoodsLocations = new();
    private List<InventoryLocation> customerLocations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Deliveries.View")) return;
            canEdit = await Permissions.HasPermissionAsync(principal, "Sales.Deliveries.Edit");
            canPrepare = await Permissions.HasPermissionAsync(principal, "Sales.Deliveries.Create");
            canPost = await Permissions.HasPermissionAsync(principal, "Sales.Deliveries.Post");
            delivery =
                await Db.SalesDeliveries

                    .Include(x => x.SalesOrder)
                        .ThenInclude(x => x.Lines)
                    .Include(x => x.SalesOrder).ThenInclude(x => x.Quotation).ThenInclude(x => x.SalesRequest)
                .Include(x => x.SalesOrder).ThenInclude(x => x.Quotation).ThenInclude(x => x.Lines).ThenInclude(x => x.SourceRequest)

                    .Include(x => x.Customer)

                    .Include(x => x.User)

                    .Include(x => x.FromLocation)

                    .Include(x => x.ToLocation)

                    .Include(x => x.Lines)
                        .ThenInclude(x => x.Item)

                    .Include(x => x.Lines)
                        .ThenInclude(x => x.Unit)

                    .Include(x => x.Lines)
                        .ThenInclude(x => x.SalesOrderLine)

                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);

            if (delivery == null)
            {
                errorMessage =
                    L["SalesDeliveryNotFound"];

                return;
            }

            linkedInvoice = await Db.SalesInvoices.AsNoTracking().FirstOrDefaultAsync(x => x.SalesDeliveryId == Id);
            if (QuotationDocument.InvoiceType(delivery.SalesOrder?.Quotation?.QuotationType) is { } quoteType)
                invoiceTypeChoice = quoteType.ToString();
            finishedGoodsLocations =
                await Db.InventoryLocations
                .Where(x =>
                    x.IsActive &&
                    x.Type == InventoryLocationType.FinishedGoods)
                .OrderBy(x => x.Name)
                .ToListAsync();

            customerLocations =
                await Db.InventoryLocations
                    .Where(x =>
                        x.IsActive &&
                        x.Type == InventoryLocationType.Customer)
                    .OrderBy(x => x.Name)
                    .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (delivery == null || !CanEditDraft || isSaving || isPosting) return;
        isSaving = true;
        errorMessage = successMessage = null;
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Deliveries.Edit")) throw new UnauthorizedAccessException();
            ValidateDraft();
            await using var tx = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            if (await Db.SalesInvoices.AnyAsync(x => x.SalesDeliveryId == delivery.Id))
                throw new InvalidOperationException("Invoiced shipments cannot be edited.");
            await Db.SaveChangesAsync();
            await tx.CommitAsync();
            successMessage = L["SalesDeliverySavedSuccessfully"];
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task PrepareInvoiceAsync()
    {
        if (delivery == null || !canPrepare || linkedInvoice != null || isPosting || isSaving || SelectedInvoiceType is not { } invoiceType) return;
        // Do not silently invoice unsaved edits.
        if (Db.ChangeTracker.HasChanges()) { errorMessage = Text("Save changes before invoicing.", "پیش از صدور فاکتور تغییرات را ذخیره کنید."); return; }
        isPosting = true;
        try
        {
            var id = await ShipmentPayment.PrepareInvoiceAsync(delivery.Id, (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, invoiceType);
            Navigation.NavigateTo($"/sales/deliveries/edit/{delivery.Id}", forceLoad: true);
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isPosting = false; }
    }

    private async Task PostAsync()
    {
        if (delivery == null || !canPost || linkedInvoice?.PaidAtUtc == null || isPosting || isSaving) return;
        isPosting = true;
        try
        {
            await ShipmentPayment.DispatchAsync(delivery.Id, (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
            Navigation.NavigateTo($"/sales/deliveries/edit/{delivery.Id}", forceLoad: true);
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isPosting = false; }
    }

    private void ValidateDraft()
    {
        if (delivery == null)
            return;

        if (delivery.FromLocationId <= 0)
        {
            throw new InvalidOperationException(
                L["FromLocationRequired"]);
        }

        if (delivery.ToLocationId <= 0)
        {
            throw new InvalidOperationException(
                L["ToLocationRequired"]);
        }

        if (delivery.FromLocationId ==
            delivery.ToLocationId)
        {
            throw new InvalidOperationException(
                L["LocationsMustBeDifferent"]);
        }

        if (delivery.Lines == null ||
            delivery.Lines.Count == 0)
        {
            throw new InvalidOperationException(
                L["AtLeastOneDeliveryLineRequired"]);
        }

        foreach (var line in delivery.Lines)
        {
            if (line.Quantity <= 0)
            {
                throw new InvalidOperationException(
                    $"{L["DeliveryQuantityMustBeGreaterThanZero"]} " +
                    $"({GetItemDisplayName(line)})");
            }

            if (line.SalesOrderLine == null)
            {
                throw new InvalidOperationException(
                    L["SalesOrderLineNotFound"]);
            }

            var salesLine =
                line.SalesOrderLine;

            var remaining =
                salesLine.Quantity -
                salesLine.DeliveredQuantity;

            if (line.Quantity > remaining)
            {
                throw new InvalidOperationException(
                    $"{L["DeliveryQuantityExceedsRemaining"]} " +
                    $"({GetItemDisplayName(line)})");
            }

        }
    }

    private string GetSalesOrderNumber()
    {
        return delivery?.SalesOrder?.OrderNumber
            ?? "-";
    }

    private string GetCustomerName()
    {
        return delivery?.Customer?.Name
            ?? "-";
    }

    private string GetUserName()
    {
        return delivery?.User?.UserName
            ?? "-";
    }

    private string GetItemDisplayName(
        SalesDeliveryLineModel line)
    {
        return line.Item?.Name
            ?? line.ItemId.ToString();
    }

    private string GetUnitDisplayName(
        SalesDeliveryLineModel line)
    {
        if (line.Unit == null)
            return line.UnitId.ToString();

        if (!string.IsNullOrWhiteSpace(
            line.Unit.Symbol))
        {
            return line.Unit.Symbol;
        }

        return line.Unit.Name;
    }

    private string GetLocationDisplayName(
        InventoryLocation? location)
    {
        if (location == null)
            return "-";

        if (!string.IsNullOrWhiteSpace(
            location.Name))
        {
            return location.Name;
        }

        return location.Code;
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/sales/deliveries");
    }
}