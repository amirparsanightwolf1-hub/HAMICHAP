@page "/sales/requests/create"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext Db
@inject SalesRequestService SalesRequestService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SalesRequest"]</PageTitle>

<div class="page-container">
    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">@LocalizationService["SalesRequest"]</div>
            <div class="erp-page-subtitle">Choose a customer and job type</div>
        </div>

        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
            @LocalizationService["Back"]
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mb-4">@errorMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-header"><strong>Sales request information</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@LocalizationService["Customer"]</label>
                    @if (!isCreatingCustomer)
                    {
                        <select class="form-select" @bind="customerId">
                            <option value="0">@LocalizationService["SelectCustomer"]</option>
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id">@customer.Code - @customer.Name</option>
                            }
                        </select>
                        <button type="button"
                                class="btn btn-link px-0"
                                @onclick="StartNewCustomer">
                            + Create a new customer
                        </button>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="form-control bg-light">New customer</span>
                            <button type="button"
                                    class="btn btn-outline-secondary text-nowrap"
                                    @onclick="SelectExistingCustomer">
                                Select existing
                            </button>
                        </div>
                    }
                </div>

                @if (isCreatingCustomer)
                {
                    <div class="col-md-4">
                        <label class="form-label">Customer code *</label>
                        <InputText class="form-control" @bind-Value="newCustomerCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Customer name *</label>
                        <InputText class="form-control" @bind-Value="newCustomerName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone</label>
                        <InputText class="form-control" @bind-Value="newCustomerPhone" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="newCustomerEmail" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <InputText class="form-control" @bind-Value="newCustomerAddress" />
                    </div>
                }

                <div class="col-md-6">
                    <label class="form-label">Job type</label>
                    <select class="form-select" @bind="selectedJobType">
                        <option value="@SalesJobType.Roll">Roll Job — رول</option>
                        <option value="@SalesJobType.Sheet">Sheet Job — شیت</option>
                    </select>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="CreateAsync"
                            disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-plus-circle"></i>
                        Create job
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Customer> customers = new();
    private int customerId;
    private SalesJobType selectedJobType = SalesJobType.Roll;
    private bool isSaving;
    private bool isCreatingCustomer;
    private string newCustomerCode = "";
    private string newCustomerName = "";
    private string newCustomerPhone = "";
    private string newCustomerEmail = "";
    private string newCustomerAddress = "";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private void StartNewCustomer()
    {
        isCreatingCustomer = true;
        newCustomerCode = "";
        newCustomerName = "";
        newCustomerPhone = "";
        newCustomerEmail = "";
        newCustomerAddress = "";
        errorMessage = null;
    }

    private void SelectExistingCustomer()
    {
        isCreatingCustomer = false;
        errorMessage = null;
    }

    private async Task CreateAsync()
    {
        errorMessage = null;

        if (!isCreatingCustomer && customerId <= 0)
        {
            errorMessage = "Select an existing customer or create a new one.";
            return;
        }

        if (isCreatingCustomer &&
            (string.IsNullOrWhiteSpace(newCustomerCode) ||
             string.IsNullOrWhiteSpace(newCustomerName)))
        {
            errorMessage = "Customer code and customer name are required.";
            return;
        }

        try
        {
            isSaving = true;

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(authenticationState.User);

            if (user == null)
            {
                throw new InvalidOperationException(
                    LocalizationService["UserNotAuthenticated"]);
            }

            if (isCreatingCustomer)
            {
                var code = newCustomerCode.Trim();

                if (await Db.Customers.AnyAsync(x => x.Code == code))
                    throw new InvalidOperationException($"Customer code '{code}' already exists.");

                var newCustomer = new Customer
                {
                    Code = code,
                    Name = newCustomerName.Trim(),
                    Phone = newCustomerPhone.Trim(),
                    Email = newCustomerEmail.Trim(),
                    Address = newCustomerAddress.Trim(),
                    IsActive = true
                };

                Db.Customers.Add(newCustomer);
                await Db.SaveChangesAsync();

                customerId = newCustomer.Id;
                customers.Add(newCustomer);
                isCreatingCustomer = false;
            }

            var request = await SalesRequestService.CreateRequestAsync(
                customerId,
                user.Id,
                selectedJobType);

            var route = selectedJobType == SalesJobType.Roll
                ? $"/sales/requests/roll/edit/{request.Id}"
                : $"/sales/requests/sheet/edit/{request.Id}";

            Navigation.NavigateTo(route);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/sales/requests");
}
