
@page "/sales/requests/create"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext Db
@inject SalesRequestService SalesRequestService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SalesRequest"]</PageTitle>

<div class="page-container">

    <!-- Page Header -->
    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">
                @LocalizationService["SalesRequest"]
            </div>

            <div class="erp-page-subtitle">
                @LocalizationService["ChooseCustomerAndJobType"]
            </div>
        </div>

        <button type="button"
                class="btn sales-action-btn sales-back-btn"
                @onclick="GoBack">

            <i class="bi bi-arrow-left"></i>
            @LocalizationService["Back"]

        </button>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mb-4">
            @errorMessage
        </div>
    }

    <!-- Sales Request Form -->
    <div class="card shadow-sm">

        <div class="card-header">
            <strong>
                @LocalizationService["SalesRequestInformation"]
            </strong>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- Customer Selection -->
                <div class="col-md-6">

                    <label class="form-label">
                        @LocalizationService["Customer"]
                    </label>

                    @if (!isCreatingCustomer)
                    {
                        <select class="form-select" @bind="customerId" disabled="@TargetQuotationId.HasValue">

                            <option value="0">
                                @LocalizationService["SelectCustomer"]
                            </option>

                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id">
                                    @customer.Code - @customer.Name
                                </option>
                            }

                        </select>

                        @if (!TargetQuotationId.HasValue)
                        {
                        <div class="customer-action-wrapper">

                            <button type="button"
                                    class="btn sales-action-btn"
                                    @onclick="StartNewCustomer">

                                <i class="bi bi-person-plus"></i>
                                @LocalizationService["CreateNewCustomer"]

                            </button>

                        </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">

                            <span class="form-control bg-light">
                                @LocalizationService["NewCustomer"]
                            </span>

                            <button type="button"
                                    class="btn sales-action-btn sales-select-btn"
                                    @onclick="SelectExistingCustomer">

                                <i class="bi bi-people"></i>
                                @LocalizationService["SelectExisting"]

                            </button>

                        </div>
                    }

                </div>

                <!-- New Customer Fields -->
                @if (isCreatingCustomer)
                {
                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["CustomerCode"] *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="newCustomerCode" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["CustomerName"] *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="newCustomerName" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["Phone"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="newCustomerPhone" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            @LocalizationService["Email"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="newCustomerEmail" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            @LocalizationService["Address"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="newCustomerAddress" />

                    </div>
                }

                <!-- Job Type -->
                <div class="col-md-6">

                    <label class="form-label">
                        @LocalizationService["JobType"]
                    </label>

                    <select class="form-select" @bind="selectedJobType">

                        <option value="@SalesJobType.Roll">
                            @LocalizationService["RollJob"]
                        </option>

                        <option value="@SalesJobType.Sheet">
                            @LocalizationService["SheetJob"]
                        </option>

                    </select>

                </div>

                <!-- Create Job Button -->
                <div class="col-12 sales-action-wrapper mt-4">

                    <button type="button"
                            class="btn sales-action-btn sales-create-btn"
                            @onclick="CreateAsync"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-plus-circle"></i>

                        @LocalizationService["CreateJob"]

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    [SupplyParameterFromQuery(Name = "quotationId")]
    public long? TargetQuotationId { get; set; }

    private List<Customer> customers = new();

    private int customerId;

    private SalesJobType selectedJobType = SalesJobType.Roll;

    private bool isSaving;
    private bool isCreatingCustomer;

    private string newCustomerCode = "";
    private string newCustomerName = "";
    private string newCustomerPhone = "";
    private string newCustomerEmail = "";
    private string newCustomerAddress = "";

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        if (TargetQuotationId.HasValue)
        {
            // Reuse the quotation's customer for every newly attached job.
            var quote = await Db.Quotations.AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == TargetQuotationId.Value);
            if (quote is null ||
                quote.Status is not (QuotationStatus.Draft or QuotationStatus.RevisionRequired))
            {
                errorMessage = LocalizationService["QuotationNotEditable"];
                return;
            }

            customerId = quote.CustomerId;
        }
    }


    private void StartNewCustomer()
    {
        isCreatingCustomer = true;

        newCustomerCode = "";
        newCustomerName = "";
        newCustomerPhone = "";
        newCustomerEmail = "";
        newCustomerAddress = "";

        errorMessage = null;
    }


    private void SelectExistingCustomer()
    {
        isCreatingCustomer = false;
        errorMessage = null;
    }


    private async Task CreateAsync()
    {
        errorMessage = null;

        if (!isCreatingCustomer && customerId <= 0)
        {
            errorMessage =
                LocalizationService["SelectExistingOrCreateCustomer"];

            return;
        }

        if (TargetQuotationId.HasValue && isCreatingCustomer)
        {
            errorMessage = LocalizationService["QuotationCustomerMustMatch"];
            return;
        }

        if (isCreatingCustomer &&
            (string.IsNullOrWhiteSpace(newCustomerCode) ||
             string.IsNullOrWhiteSpace(newCustomerName)))
        {
            errorMessage =
                LocalizationService["CustomerCodeAndNameRequired"];

            return;
        }

        try
        {
            isSaving = true;

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(authenticationState.User);

            if (user == null)
            {
                throw new InvalidOperationException(
                    LocalizationService["UserNotAuthenticated"]);
            }

            if (isCreatingCustomer)
            {
                var code = newCustomerCode.Trim();

                if (await Db.Customers.AnyAsync(x => x.Code == code))
                {
                    throw new InvalidOperationException(
                        $"{LocalizationService["CustomerCodeAlreadyExists"]} {code}");
                }

                var newCustomer = new Customer
                {
                    Code = code,
                    Name = newCustomerName.Trim(),
                    Phone = newCustomerPhone.Trim(),
                    Email = newCustomerEmail.Trim(),
                    Address = newCustomerAddress.Trim(),
                    IsActive = true
                };

                Db.Customers.Add(newCustomer);

                await Db.SaveChangesAsync();

                customerId = newCustomer.Id;

                customers.Add(newCustomer);

                isCreatingCustomer = false;
            }

            var request = await SalesRequestService.CreateRequestAsync(
                customerId,
                user.Id,
                selectedJobType);

            var route = selectedJobType == SalesJobType.Roll
                ? $"/sales/requests/roll/edit/{request.Id}"
                : $"/sales/requests/sheet/edit/{request.Id}";

            Navigation.NavigateTo(TargetQuotationId.HasValue
                ? $"{route}?quotationId={TargetQuotationId.Value}"
                : route);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/sales/requests");
    }

}
