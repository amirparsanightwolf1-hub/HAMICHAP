
@page "/sales/requests/create"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Sales.Requests.Create")]
@inject PermissionService Permissions

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Components.Pages.Customers
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext Db
@inject SalesRequestService SalesRequestService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["CreateJob"]</PageTitle>

<div class="page-container job-create-page">
    <header class="job-create-intro">
        <div class="job-create-heading">
            <div class="job-create-eyebrow">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                <span>@LocalizationService["StartNewJobQuotation"]</span>
            </div>
            <h1>@LocalizationService["CreateJob"]</h1>
            <p>@LocalizationService["ChooseCustomerAndJobType"]</p>
        </div>

        <button type="button" class="job-create-back" @onclick="GoBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @LocalizationService["Back"]
        </button>
    </header>

    <div class="job-create-steps" aria-label="@LocalizationService["JobSetupProgress"]">
        <div class="job-create-step is-current">
            <span class="job-create-step-number">01</span>
            <span>@LocalizationService["Customer"]</span>
        </div>
        <span class="job-create-step-divider" aria-hidden="true"></span>
        <div class="job-create-step is-current">
            <span class="job-create-step-number">02</span>
            <span>@LocalizationService["JobType"]</span>
        </div>
        <span class="job-create-step-divider" aria-hidden="true"></span>
        <div class="job-create-step">
            <span class="job-create-step-number">03</span>
            <span>@LocalizationService["JobDetailsNext"]</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger job-create-alert" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>@errorMessage</span>
        </div>
    }

    <div class="job-create-layout @(overviewBelowJobType ? "overview-below" : "")">
        <div class="job-create-main">
            <section class="job-create-panel" aria-labelledby="job-create-customer-heading">
                <div class="job-create-section-heading">
                    <span class="job-create-section-icon">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                    </span>
                    <div>
                        <div class="job-create-section-kicker">@LocalizationService["JobSetupStepOne"]</div>
                        <h2 id="job-create-customer-heading">@LocalizationService["Customer"]</h2>
                        <p>@LocalizationService["SelectExistingOrCreateCustomer"]</p>
                    </div>
                </div>

                @if (!TargetQuotationId.HasValue)
                {
                    <div class="job-create-customer-choices" role="group" aria-label="@LocalizationService["Customer"]">
                        <button type="button"
                                class="job-create-customer-choice @(!isCreatingCustomer ? "is-selected" : "")"
                                aria-pressed="@(!isCreatingCustomer)"
                                @onclick="SelectExistingCustomer">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            @LocalizationService["SelectExisting"]
                        </button>
                        <button type="button"
                                class="job-create-customer-choice @(isCreatingCustomer ? "is-selected" : "")"
                                aria-pressed="@isCreatingCustomer"
                                @onclick="StartNewCustomer">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                            @LocalizationService["CreateNewCustomer"]
                        </button>
                    </div>
                }

                @if (!isCreatingCustomer)
                {
                    <div class="job-create-field">
                        <label for="job-create-customer">@LocalizationService["Customer"] <span class="job-create-required">*</span></label>
                        <select id="job-create-customer"
                                class="form-select"
                                @bind="customerId"
                                disabled="@TargetQuotationId.HasValue">
                            <option value="0">@LocalizationService["SelectCustomer"]</option>
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id">@customer.Code - @customer.Name</option>
                            }
                        </select>
                        @if (TargetQuotationId.HasValue)
                        {
                            <div class="job-create-context">
                                <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                @LocalizationService["QuotationCustomerLocked"]
                            </div>
                        }
                    </div>
                }
                else
                {
                    <CustomerProfileFields Profile="newCustomerProfile" IdPrefix="sales-new-customer" Changed="StateHasChanged" />
                }
            </section>

            <section class="job-create-panel" aria-labelledby="job-create-type-heading">
                <div class="job-create-section-heading">
                    <span class="job-create-section-icon">
                        <i class="bi bi-printer" aria-hidden="true"></i>
                    </span>
                    <div>
                        <div class="job-create-section-kicker">@LocalizationService["JobSetupStepTwo"]</div>
                        <h2 id="job-create-type-heading">@LocalizationService["JobType"]</h2>
                        <p>@LocalizationService["JobTypeSelectionHelp"]</p>
                    </div>
                </div>

                <div class="job-create-types" role="group" aria-label="@LocalizationService["JobType"]">
                    <button type="button"
                            class="job-create-type @(selectedJobType == SalesJobType.Sheet ? "is-selected" : "")"
                            aria-pressed="@(selectedJobType == SalesJobType.Sheet)"
                            @onclick="() => selectedJobType = SalesJobType.Sheet">
                        <span class="job-create-type-image job-create-type-sheet">
                            <i class="bi bi-file-earmark-richtext" aria-hidden="true"></i>
                        </span>
                        <span class="job-create-type-details">
                            <strong>@LocalizationService["SheetJob"]</strong>
                            <span>@LocalizationService["SheetJobSubtitle"]</span>
                        </span>
                        <i class="bi @(selectedJobType == SalesJobType.Sheet ? "bi-check-circle-fill" : "bi-circle") job-create-type-check"
                           aria-hidden="true"></i>
                    </button>

                    <button type="button"
                            class="job-create-type @(selectedJobType == SalesJobType.Roll ? "is-selected" : "")"
                            aria-pressed="@(selectedJobType == SalesJobType.Roll)"
                            @onclick="() => selectedJobType = SalesJobType.Roll">
                        <span class="job-create-type-image job-create-type-roll">
                            <i class="bi bi-disc" aria-hidden="true"></i>
                        </span>
                        <span class="job-create-type-details">
                            <strong>@LocalizationService["RollJob"]</strong>
                            <span>@LocalizationService["RollJobSubtitle"]</span>
                        </span>
                        <i class="bi @(selectedJobType == SalesJobType.Roll ? "bi-check-circle-fill" : "bi-circle") job-create-type-check"
                           aria-hidden="true"></i>
                    </button>
                </div>
            </section>
        </div>

        <aside class="job-create-sidebar" aria-label="@LocalizationService["JobSetupSummary"]">
            <div class="job-create-summary">
                <div class="job-create-summary-top">
                    <span class="job-create-summary-icon">
                        <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                    </span>
                    <div class="job-create-summary-heading">
                        <h2>@LocalizationService["JobSetupSummary"]</h2>
                        <p>@LocalizationService["JobSetupSummaryHelp"]</p>
                    </div>
                    <button type="button"
                            class="job-create-overview-position"
                            title="@OverviewPositionLabel"
                            aria-label="@OverviewPositionLabel"
                            @onclick="ToggleOverviewPosition">
                        <i class="bi @(overviewBelowJobType ? "bi-layout-sidebar-inset-reverse" : "bi-layout-text-window-reverse")" aria-hidden="true"></i>
                        <span>@OverviewPositionLabel</span>
                    </button>
                </div>

                <dl class="job-create-summary-rows" aria-live="polite">
                    <div class="job-create-summary-row">
                        <dt>@LocalizationService["Customer"]</dt>
                        <dd>@GetCustomerSummary()</dd>
                    </div>
                    <div class="job-create-summary-row">
                        <dt>@LocalizationService["JobType"]</dt>
                        <dd>
                            <i class="bi @(selectedJobType == SalesJobType.Roll ? "bi-disc" : "bi-file-earmark-richtext")"
                               aria-hidden="true"></i>
                            @(selectedJobType == SalesJobType.Roll
                                ? LocalizationService["RollJob"]
                                : LocalizationService["SheetJob"])
                        </dd>
                    </div>
                </dl>

                <div class="job-create-next">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    <span>@LocalizationService["JobSetupNextStepHelp"]</span>
                </div>

                <button type="button"
                        class="job-create-submit"
                        @onclick="CreateAsync"
                        disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    }
                    @LocalizationService["ContinueToJobDetails"]
                </button>

                <p class="job-create-submit-help">@LocalizationService["JobSetupSubmitHelp"]</p>
            </div>
        </aside>
    </div>
</div>

@code {

    [SupplyParameterFromQuery(Name = "quotationId")]
    public long? TargetQuotationId { get; set; }

    private List<Customer> customers = new();

    private int customerId;

    private SalesJobType selectedJobType = SalesJobType.Roll;

    private bool overviewBelowJobType;

    private string OverviewPositionLabel => overviewBelowJobType
        ? (LocalizationService.IsPersian ? "انتقال به کنار" : "Move to side")
        : (LocalizationService.IsPersian ? "انتقال به پایین" : "Move below");

    private void ToggleOverviewPosition() => overviewBelowJobType = !overviewBelowJobType;

    private bool isSaving;
    private bool isCreatingCustomer;

    private Customer newCustomerProfile = new() { CustomerType = CustomerType.Natural };

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        if (TargetQuotationId.HasValue)
        {
            // Reuse the quotation's customer for every newly attached job.
            var quote = await Db.Quotations.AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == TargetQuotationId.Value);
            if (quote is null ||
                quote.Status is not (QuotationStatus.Draft or QuotationStatus.RevisionRequired))
            {
                errorMessage = LocalizationService["QuotationNotEditable"];
                return;
            }

            customerId = quote.CustomerId;
        }
    }


    private void StartNewCustomer()
    {
        isCreatingCustomer = true;

        newCustomerProfile = new Customer { CustomerType = CustomerType.Natural };

        errorMessage = null;
    }


    private void SelectExistingCustomer()
    {
        isCreatingCustomer = false;
        errorMessage = null;
    }


    private async Task CreateAsync()
    {
        errorMessage = null;

        if (!isCreatingCustomer && customerId <= 0)
        {
            errorMessage =
                LocalizationService["SelectExistingOrCreateCustomer"];

            return;
        }

        if (TargetQuotationId.HasValue && isCreatingCustomer)
        {
            errorMessage = LocalizationService["QuotationCustomerMustMatch"];
            return;
        }

        if (isCreatingCustomer && newCustomerProfile.CustomerType is not (CustomerType.Natural or CustomerType.Legal))
        {
            errorMessage = LocalizationService.IsPersian ? "نوع مشتری را انتخاب کنید." : "Select customer type.";
            return;
        }

        if (isCreatingCustomer && string.IsNullOrWhiteSpace(newCustomerProfile.Name))
        {
            errorMessage =
                LocalizationService["CustomerNameIsRequired"];

            return;
        }

        try
        {
            isSaving = true;

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(authenticationState.User);

            if (user is not { IsActive: true } ||
                !await Permissions.HasPermissionAsync(authenticationState.User, "Sales.Requests.Create"))
            {
                throw new InvalidOperationException(
                    LocalizationService["UserNotAuthenticated"]);
            }

            if (TargetQuotationId.HasValue &&
                !await Permissions.HasPermissionAsync(authenticationState.User, "Sales.Requests.CreateQuotation"))
                throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);

            if (isCreatingCustomer)
            {
                if (!await Permissions.HasPermissionAsync(authenticationState.User, "Customers.Create"))
                    throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);
                var code = await CustomerCodeGenerator.GenerateAsync(Db);

                var newCustomer = new Customer { Code = code, IsActive = true };
                newCustomerProfile.CopyProfileTo(newCustomer);

                Db.Customers.Add(newCustomer);

                await Db.SaveChangesAsync();

                customerId = newCustomer.Id;

                customers.Add(newCustomer);

                isCreatingCustomer = false;
            }

            var request = await SalesRequestService.CreateRequestAsync(
                customerId,
                user.Id,
                selectedJobType);

            var route = selectedJobType == SalesJobType.Roll
                ? $"/sales/requests/roll/edit/{request.Id}"
                : $"/sales/requests/sheet/edit/{request.Id}";

            Navigation.NavigateTo(TargetQuotationId.HasValue
                ? $"{route}?quotationId={TargetQuotationId.Value}"
                : route);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private string GetCustomerSummary()
    {
        if (isCreatingCustomer)
            return string.IsNullOrWhiteSpace(newCustomerProfile.Name)
                ? LocalizationService["NewCustomer"]
                : newCustomerProfile.Name.Trim();

        return customers.FirstOrDefault(x => x.Id == customerId)?.Name
            ?? LocalizationService["SelectCustomer"];
    }

    private void GoBack()
    {
        Navigation.NavigateTo(TargetQuotationId.HasValue
            ? $"/sales/quotations/edit/{TargetQuotationId.Value}"
            : "/sales/quotations");
    }

}
