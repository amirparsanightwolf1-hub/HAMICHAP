@page "/sales/quotations/edit/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Sales.Requests.View")]

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Models.Shared.Services
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json

@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject QuotationService QuotationService
@inject LocalizationService LocalizationService
@inject SalesOrderService SalesOrderService
@inject PermissionService Permissions
@inject IConfiguration Configuration

<HeadContent>
    <link rel="stylesheet" href="css/quotationEdit.css" />
</HeadContent>

<PageTitle>
    @LocalizationService["Quotation"]
</PageTitle>

<div class="page-container quotation-edit-page quotation-workspace">

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @LocalizationService["Loading"]
                </span>
            </div>
        </div>
    }
    else if (quotation == null)
    {
        <div class="alert alert-danger">
            @LocalizationService["QuotationNotFound"]
        </div>
    }
    else
    {
        <header class="erp-page-header quotation-page-header quotation-workspace-hero">
            <div class="quotation-workspace-hero-info">
                <div class="quotation-workspace-hero-emblem" aria-hidden="true">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div class="quotation-workspace-hero-copy">
                    <div class="quotation-workspace-eyebrow">@LocalizationService["QuotationEditorTitle"]</div>
                    <h1>@LocalizationService["Quotation"]</h1>
                    <div class="quotation-workspace-hero-meta">
                        <span class="quotation-workspace-number">@HamiChap_MES_ERP.Models.Sales.JobReferences.Titles(quotation, quotation.QuotationNumber)</span><small class="text-muted">@quotation.QuotationNumber</small>
                        <span class="quotation-workspace-meta-separator" aria-hidden="true"></span>
                        <span>@GetCustomerName()</span>
                    </div>
                    <div class="quotation-workspace-hero-status">
                        <span class="quotation-status-badge @GetQuotationStatusCssClass(quotation.Status)">
                            <span class="quotation-status-dot"></span>
                            @LocalizationService.TranslateEnum(quotation.Status)
                        </span>
                    </div>
                </div>
            </div>
            <div class="quotation-actions">

                @if (quotation.Status == QuotationStatus.Approved ||
                     quotation.Status == QuotationStatus.ReadyToSend ||
                     quotation.Status == QuotationStatus.SentToCustomer ||
                     quotation.Status == QuotationStatus.CustomerNegotiation ||
                     quotation.Status == QuotationStatus.Accepted ||
                     quotation.Status == QuotationStatus.Rejected)
                {
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenPreview">
                        @LocalizationService["QuotationPreview"]
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="GoBack">

                    <i class="bi bi-arrow-left"></i>
                    @LocalizationService["Back"]

                </button>

                @if (CanEditPricing)
                {
                    <button type="button" class="btn btn-outline-primary" disabled="@IsWriting" @onclick="SaveAndPreviewAsync">
                        <i class="bi bi-file-earmark-pdf"></i> @VatText("Generate quotation", "ایجاد پیش‌فاکتور")
                    </button>
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveAsync"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-save"></i>
                        @LocalizationService["Save"]

                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="SubmitForApprovalAsync"
                            disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-send"></i>
                        @(LocalizationService.IsPersian ? "ثبت ارسال پیش‌فاکتور" : "Mark quotation as sent")

                    </button>
                }

                @if (canManageQuotation && quotation.Status is (QuotationStatus.PendingApproval or QuotationStatus.Approved or QuotationStatus.ReadyToSend))
                {
                    <button type="button" class="btn btn-primary" disabled="@isSubmitting" @onclick="SubmitForApprovalAsync">
                        @(LocalizationService.IsPersian ? "ثبت ارسال پیش‌فاکتور" : "Mark quotation as sent")
                    </button>
                }

                @if (canManageQuotation && quotation.Status is (QuotationStatus.SentToCustomer or QuotationStatus.CustomerNegotiation))
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="() => CustomerDecisionAsync(true)"
                            disabled="@isDeciding">

                        <i class="bi bi-check-circle"></i>
                        @LocalizationService["CustomerAccepted"]

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="() => CustomerDecisionAsync(false)"
                            disabled="@isDeciding">

                        <i class="bi bi-x-circle"></i>
                        @LocalizationService["CustomerRejected"]

                    </button>
                }
                @if (canManageQuotation && quotation.Status is not (QuotationStatus.Accepted or QuotationStatus.Cancelled or QuotationStatus.Rejected or QuotationStatus.Expired))
                {
                    <button type="button" class="btn btn-outline-danger" disabled="@isDeciding" @onclick="CancelQuotationAsync">
                        @(LocalizationService.IsPersian ? "لغو پیش‌فاکتور و سفارش" : "Cancel quotation and jobs")
                    </button>
                }

            </div>
        </header>

        <div class="quotation-workspace-overview" aria-label="@LocalizationService["QuotationInformation"]">
            <div class="quotation-workspace-overview-item">
                <span>@LocalizationService["Customer"]</span>
                <strong>@GetCustomerName()</strong>
            </div>
            <div class="quotation-workspace-overview-item">
                <span>@LocalizationService["JobsOnQuotation"]</span>
                <strong>@linkedRequests.Count</strong>
            </div>
            <div class="quotation-workspace-overview-item">
                <span>@LocalizationService["QuotationLines"]</span>
                <strong>@quotation.Lines.Count</strong>
            </div>
            <div class="quotation-workspace-overview-item is-total">
                <span>@LocalizationService["FinalAmount"]</span>
                <strong>@FormatVatTotal(InvoiceVat.Gross(quotation))</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-4">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success mb-4">
                @successMessage
            </div>
        }

        <div class="quotation-workspace-layout">
            <div class="quotation-workspace-main">
        <!-- Quotation Information -->

        <section class="card quotation-card quotation-workspace-section mb-4" aria-label="@LocalizationService["QuotationInformation"]">

            <div class="card-header quotation-card-header">
                <span class="quotation-workspace-section-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
                <strong>
                    @LocalizationService["QuotationInformation"]
                </strong>
            </div>

            <div class="card-body quotation-card-body">

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="quotation-type">@VatText("Quotation type", "نوع پیش‌فاکتور")</label>
                        @if (CanEditPricing)
                        {
                            <InputSelect TValue="QuotationType?" id="quotation-type" class="form-select" style="max-width: 360px" @bind-Value="quotation.QuotationType">
                                <option value="">@VatText("Select quotation type", "انتخاب نوع پیش‌فاکتور")</option>
                                <option value="Formal">@QuotationDocument.Label(QuotationType.Formal, LocalizationService.IsPersian)</option>
                                <option value="Informal">@QuotationDocument.Label(QuotationType.Informal, LocalizationService.IsPersian)</option>
                            </InputSelect>
                            <div class="form-text">@VatText("Formal shows registered buyer and seller details and item tax identifiers. Informal uses a simpler commercial layout. Both retain the same VAT and agreed totals.", "رسمی شامل اطلاعات ثبتی خریدار و فروشنده و شناسه مالیاتی اقلام است. غیررسمی قالب تجاری ساده‌تری دارد. مالیات و مبالغ توافق‌شده در هر دو یکسان است.")</div>
                        }
                        else
                        {
                            <strong class="d-block">@QuotationDocument.Label(quotation.QuotationType, LocalizationService.IsPersian)</strong>
                        }
                    </div>

                    @if (quotation.QuotationType == QuotationType.Formal)
                    {
                        <div class="col-12">
                            <section class="border rounded p-3" aria-label="@VatText("Seller company", "شرکت فروشنده")">
                                <h2 class="h6 mb-2">@VatText("Seller company", "شرکت فروشنده")</h2>
                                @if (CanEditPricing)
                                {
                                    <label class="form-label" for="seller-company-search">@VatText("Company name", "نام شرکت")</label>
                                    <input id="seller-company-search" class="form-control mb-2" @bind="sellerSearch" @bind:event="oninput" disabled="@IsWriting" placeholder="@VatText("Search or enter company name", "جستجو یا ورود نام شرکت")" />
                                    <div class="d-flex gap-2 flex-wrap">
                                        <InputSelect TValue="int?" class="form-select flex-grow-1" style="max-width:560px" @bind-Value="quotation.SellerCompanyId" disabled="@IsWriting">
                                            <option value="">@VatText("Select a saved company", "انتخاب شرکت ذخیره‌شده")</option>
                                            @foreach (var company in FilteredSellers)
                                            {
                                                <option value="@company.Id">@company.LegalName — @company.NationalId</option>
                                            }
                                        </InputSelect>
                                        <button class="btn btn-outline-primary" type="button" disabled="@IsWriting" @onclick="StartSeller"><i class="bi bi-plus-circle"></i> @VatText("Add company", "افزودن شرکت")</button>
                                        @if (SelectedSeller is not null)
                                        {
                                            <button class="btn btn-outline-secondary" type="button" disabled="@IsWriting" @onclick="EditSeller">@VatText("Edit company", "ویرایش شرکت")</button>
                                        }
                                    </div>
                                    @if (sellerDraft is not null)
                                    {
                                        <div class="row g-2 mt-2">
                                            <div class="col-md-6"><label class="form-label">@VatText("Registered company name", "نام ثبتی شرکت") *</label><input class="form-control" maxlength="200" @bind="sellerDraft.LegalName" disabled="@IsWriting" /></div>
                                            <div class="col-md-6"><label class="form-label">@VatText("National ID", "شناسه ملی") *</label><input class="form-control" maxlength="64" @bind="sellerDraft.NationalId" disabled="@(IsWriting || sellerDraft.Id != 0)" /></div>
                                            <div class="col-md-4"><label class="form-label">@VatText("Economic code", "کد اقتصادی") *</label><input class="form-control" maxlength="64" @bind="sellerDraft.EconomicCode" disabled="@IsWriting" /></div>
                                            <div class="col-md-4"><label class="form-label">@VatText("Registration number", "شماره ثبت")</label><input class="form-control" maxlength="64" @bind="sellerDraft.RegistrationNumber" disabled="@IsWriting" /></div>
                                            <div class="col-md-4"><label class="form-label">@VatText("Postal code", "کد پستی") *</label><input class="form-control" maxlength="32" @bind="sellerDraft.PostalCode" disabled="@IsWriting" /></div>
                                            <div class="col-12"><label class="form-label">@VatText("Registered address", "نشانی ثبتی") *</label><textarea class="form-control" rows="2" maxlength="600" @bind="sellerDraft.Address" disabled="@IsWriting"></textarea></div>
                                            <div class="col-md-6"><label class="form-label">@VatText("Phone", "تلفن")</label><input class="form-control" maxlength="64" @bind="sellerDraft.Phone" disabled="@IsWriting" /></div>
                                            <div class="col-md-6"><label class="form-label">@VatText("Email", "ایمیل")</label><input class="form-control" type="email" maxlength="254" @bind="sellerDraft.Email" disabled="@IsWriting" /></div>
                                            <div class="col-md-4"><label class="form-label">@VatText("Tax jurisdiction (e.g. IR)", "کشور مالیاتی (مانند IR)") *</label><input class="form-control" maxlength="2" @bind="sellerDraft.Jurisdiction" disabled="@(IsWriting || sellerDraft.Id != 0)" /></div>
                                            <div class="col-md-4"><label class="form-label">@VatText("Currency (e.g. IRR)", "واحد پول (مانند IRR)") *</label><input class="form-control" maxlength="3" @bind="sellerDraft.CurrencyCode" disabled="@IsWriting" /></div>
                                            <div class="col-md-4"><label class="form-label">@VatText("Tax memory ID (for invoicing)", "شناسه یکتای حافظه مالیاتی (برای فاکتور)")</label><input class="form-control" maxlength="100" @bind="sellerDraft.TaxMemoryId" disabled="@IsWriting" /></div>
                                            <div class="col-12 d-flex gap-2">
                                                <button type="button" class="btn btn-primary" disabled="@IsWriting" @onclick="SaveSellerAsync">@VatText("Save company for reuse", "ذخیره شرکت برای استفاده مجدد")</button>
                                                <button type="button" class="btn btn-outline-secondary" disabled="@IsWriting" @onclick="() => sellerDraft = null">@VatText("Cancel", "انصراف")</button>
                                            </div>
                                            <div class="form-text">@VatText("Changes affect future documents and drafts only, not already sent quotations. Enter verified company details; no automatic registry lookup is performed.", "تغییرات فقط بر اسناد آتی و پیش‌نویس‌ها اثر دارد، نه پیش‌فاکتورهای ارسال‌شده. اطلاعات تأییدشده را وارد کنید؛ استعلام خودکار انجام نمی‌شود.")</div>
                                        </div>
                                    }
                                    @if (SelectedSeller is { } selected)
                                    {
                                        <div class="small mt-3"><strong>@selected.LegalName</strong> · @selected.NationalId · @selected.CurrencyCode<div>@selected.Address</div></div>
                                        @if (!string.IsNullOrWhiteSpace(quotation.CurrencyCode) && quotation.CurrencyCode != selected.CurrencyCode)
                                        {
                                            <div class="text-danger small">@VatText("Quotation currency must match the seller's currency.", "واحد پول پیش‌فاکتور باید با واحد پول فروشنده یکسان باشد.")</div>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sellerError)) { <div class="alert alert-danger mt-2 mb-0" role="alert">@sellerError</div> }
                                }
                                else
                                {
                                    var savedSeller = QuotationDocument.Read(quotation.DocumentPartiesJson)?.Seller;
                                    <strong>@(savedSeller?.Name ?? "—")</strong>
                                    @if (savedSeller is not null) { <div class="small">@savedSeller.IdentityNumber · @savedSeller.Address</div> }
                                }
                            </section>
                        </div>
                    }

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["QuotationNumber"]
                        </label>

                        <input class="form-control"
                               value="@quotation.QuotationNumber"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Customer"]
                        </label>

                        <input class="form-control"
                               value="@GetCustomerName()"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["JobTitle"]
                        </label>

                        <input class="form-control"
                               value="@GetJobTitle()"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["QuotationDate"]
                        </label>

                        <input class="form-control"
                               value="@FormatJalaliDate(quotation.QuotationDate)"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Status"]
                        </label>

                        <div class="quotation-status-value">
                            <span class="quotation-status-badge @GetQuotationStatusCssClass(quotation.Status)">
                                <span class="quotation-status-dot"></span>
                                @LocalizationService.TranslateEnum(quotation.Status)
                            </span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label" for="quotation-validity-days">
                            @(CanEditPricing
                                ? LocalizationService["ValidityDays"]
                                : LocalizationService["ValidUntil"])
                        </label>

                        @if (CanEditPricing)
                        {
                            <InputNumber TValue="int?" id="quotation-validity-days"
                                         class="form-control"
                                         min="0" max="3650" step="1"
                                         @bind-Value="ValidityDays" />
                            <div class="quotation-validity-preview" aria-live="polite">
                                <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                <span>@LocalizationService["ValidUntil"]:</span>
                                <strong>@FormatJalaliDate(quotation.ValidUntil)</strong>
                            </div>
                            <div class="form-text">@LocalizationService["ValidityDaysHelp"]</div>
                        }
                        else
                        {
                            <input id="quotation-validity-days" class="form-control"
                                   value="@FormatJalaliDate(quotation.ValidUntil)"
                                   readonly />
                        }

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["EstimatedDeliveryDays"]
                        </label>

                        @if (CanEditPricing)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="quotation.EstimatedDeliveryDays" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@quotation.EstimatedDeliveryDays"
                                   readonly />
                        }

                    </div>

                </div>

            </div>
        </section>

        <!-- All jobs on this quotation, each retaining its own approval proof. -->
        <section class="card quotation-card quotation-workspace-section mb-4" aria-label="@LocalizationService["JobsOnQuotation"]">
            <div class="card-header quotation-card-header">
                <span class="quotation-workspace-section-icon"><i class="bi bi-collection" aria-hidden="true"></i></span>
                <strong>@LocalizationService["JobsOnQuotation"]</strong>
                <span class="quotation-workspace-count">@linkedRequests.Count</span>
            </div>
            <div class="card-body quotation-card-body">
                @foreach (var job in linkedRequests)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 quotation-workspace-job" @key="job.Id">
                        <div class="quotation-workspace-job-overview">
                            <span class="quotation-workspace-job-icon" aria-hidden="true">
                                <i class="bi @(job.JobType == SalesJobType.Roll ? "bi-disc" : "bi-file-earmark-richtext")"></i>
                            </span>
                            <div>
                                <strong>@GetRequestTitle(job)</strong>
                                <div class="text-muted small">
                                    @HamiChap_MES_ERP.Models.Sales.JobReferences.Title(job) · @job.RequestNumber · @LocalizationService.TranslateEnum(job.JobType)
                                </div>
                            </div>
                        </div>
                        <div class="quotation-workspace-job-actions">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="@($"/sales/requests/{(job.JobType == SalesJobType.Roll ? "roll" : "sheet")}/edit/{job.Id}?quotationId={quotation.Id}")">
                                @LocalizationService["OpenJob"]
                            </a>
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/sales/requests/proof/{job.Id}?quotationId={quotation.Id}")">
                                @LocalizationService["OpenApprovalProof"]
                            </a>
                        </div>
                    </div>
                }

                @if (CanEditPricing && linkedRequests.Count > 0)
                {
                    <div class="mt-3">
                        <a class="btn btn-outline-primary"
                           href="@($"/sales/requests/{(linkedRequests[0].JobType == SalesJobType.Roll ? "roll" : "sheet")}/edit/{linkedRequests[0].Id}?quotationId={quotation.Id}")">
                            @LocalizationService["ManageOrderItemsInJobEditor"]
                        </a>
                    </div>
                }
            </div>
        </section>

        <!-- Quotation Lines -->

        <section class="card quotation-card quotation-workspace-section mb-4" aria-label="@LocalizationService["QuotationLines"]">
            <div class="card-header quotation-card-header">
                <span class="quotation-workspace-section-icon"><i class="bi bi-calculator" aria-hidden="true"></i></span>
                <strong>
                    @LocalizationService["QuotationLines"]
                </strong>
                <span class="quotation-workspace-header-note">@LocalizationService["QuotationPricingHelp"]</span>
            </div>

            <div class="card-body p-0 quotation-table-body">

                <div class="p-3 border-bottom">
                    <label class="form-label">@VatText("Currency (ISO code)", "واحد پول (کد ISO)")</label>
                    @if (CanEditPricing) { <input class="form-control" style="max-width:180px" maxlength="3" @bind="quotation.CurrencyCode" placeholder="IRR" /> }
                    else { <strong>@(quotation.CurrencyCode ?? "—")</strong> }
                    <p class="small text-muted mb-0 mt-1">@VatText("Unit prices exclude VAT. Enter the actual billing currency and verified rates and official goods/service identifiers. IRR means rials, not tomans.", "قیمت واحد بدون ارزش افزوده است. واحد پول واقعی، نرخ تأییدشده و شناسه رسمی کالا/خدمت را ثبت کنید. IRR ریال است، نه تومان.")</p>
                </div>
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0 quotation-lines-table">

                        <thead>
                            <tr>

                                <th>
                                    @LocalizationService["Item"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["Quantity"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["UnitPrice"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["TotalPrice"]
                                </th>

                                <th>@VatText("VAT / tax identifier", "ارزش افزوده / شناسه مالیاتی")</th>
                                <th>
                                    @LocalizationService["Notes"]
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var line in quotation.Lines)
                            {
                                <tr class="quotation-workspace-price-row">
                                    <td>
                                        <div class="fw-semibold">
                                            @line.Item?.Name
                                        </div>

                                        <small class="text-muted">
                                            @line.Item?.Code
                                        </small>
                                        @if (line.SourceRequestId is long sourceId)
                                        {
                                            <div class="small mt-1">
                                                @GetLinkedRequestNumber(sourceId) ·
                                                <a href="@($"/sales/requests/proof/{sourceId}?quotationId={quotation.Id}")">
                                                    @LocalizationService["OpenApprovalProof"]
                                                </a>
                                            </div>
                                        }
                                    </td>

                                    <td class="text-end">
                                        @line.Quantity.ToString("N2")
                                    </td>

                                    <td class="text-end">

                                        @if (CanEditPricing)
                                        {
                                            <input type="number" min="0" step="1" inputmode="numeric"
                                                   class="form-control text-end quotation-workspace-price-input @(invalidPriceLineIds.Contains(line.Id) ? "is-invalid" : "")"
                                                   aria-invalid="@invalidPriceLineIds.Contains(line.Id)"
                                                   value="@FormatWholePriceInput(line.UnitPrice)"
                                                   @onchange="args => UpdateWholeUnitPrice(line, args)" />
                                        }
                                        else
                                        {
                                            @FormatWholeAmount(line.UnitPrice)
                                        }

                                    </td>

                                    <td class="text-end fw-semibold">
                                        @FormatVatTotal(quotation.CurrencyCode == null ? line.TotalPrice : InvoiceVat.Net(line, quotation.CurrencyCode))
                                    </td>

                                    <td style="min-width:210px">
                                        @if (CanEditPricing)
                                        {
                                            <label class="small">@VatText("VAT %", "درصد ارزش افزوده")</label>
                                            <input type="number" class="form-control form-control-sm mb-1" min="0" max="100" step="0.01" @bind="line.VatRate" />
                                            <input class="form-control form-control-sm mb-1" maxlength="64" placeholder="@VatText("Official goods/service ID", "شناسه کالا / خدمت")" @bind="line.TaxItemCode" />
                                            @if (line.VatRate == 0)
                                            {
                                                <input class="form-control form-control-sm" maxlength="250" placeholder="@VatText("Zero VAT justification", "دلیل نرخ صفر / معافیت")" @bind="line.TaxTreatmentReason" />
                                            }
                                        }
                                        else
                                        {
                                            <div>@(line.VatRate.HasValue ? line.VatRate.Value.ToString("0.##") + "%" : "—") · @line.TaxItemCode</div>
                                            <div class="small text-muted">@line.TaxTreatmentReason</div>
                                        }
                                        <div class="small text-muted">@VatText("VAT", "ارزش افزوده"): @FormatVatTotal(InvoiceVat.Tax(line, quotation.CurrencyCode))</div>
                                    </td>
                                    <td>

                                        @if (CanEditPricing)
                                        {
                                            <InputText class="form-control"
                                                       @bind-Value="line.Notes" />
                                        }
                                        else
                                        {
                                            @line.Notes
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
                <div class="quotation-workspace-table-total" aria-live="polite">
                    <span>@LocalizationService["FinalAmount"]</span>
                    <strong>@FormatVatTotal(InvoiceVat.Gross(quotation))</strong>
                </div>
            </div>
        </section>

        <!-- Quotation Notes -->

        <section class="card quotation-card quotation-workspace-section mb-4" aria-label="@LocalizationService["Notes"]">
            <div class="card-header quotation-card-header">
                <span class="quotation-workspace-section-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
                <strong>@LocalizationService["Notes"]</strong>
            </div>
            <div class="card-body quotation-card-body">
                @if (CanEditPricing)
                {
                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="quotation.Notes" />
                }
                else
                {
                    <textarea class="form-control" rows="4" readonly>@quotation.Notes</textarea>
                }
            </div>
        </section>
            </div>

            <aside class="quotation-workspace-sidebar" aria-label="@LocalizationService["QuotationPricingSummary"]">
                <section class="quotation-workspace-total-card">
                    <div class="quotation-workspace-total-heading">
                        <span class="quotation-workspace-total-icon" aria-hidden="true"><i class="bi bi-receipt"></i></span>
                        <div>
                            <h2>@LocalizationService["QuotationPricingSummary"]</h2>
                            <p>@quotation.QuotationNumber</p>
                        </div>
                    </div>

                    <div class="small px-3 pt-2">@VatText("Net", "خالص"): @FormatVatTotal(InvoiceVat.Subtotal(quotation)) · @VatText("VAT", "ارزش افزوده"): @FormatVatTotal(InvoiceVat.TotalTax(quotation))</div>
                    <div class="quotation-workspace-total-amount" aria-live="polite">
                        <span>@LocalizationService["FinalAmount"]</span>
                        <strong>@FormatVatTotal(InvoiceVat.Gross(quotation))</strong>
                    </div>

                    <dl class="quotation-workspace-total-details">
                        <div><dt>@LocalizationService["QuotationLines"]</dt><dd>@quotation.Lines.Count</dd></div>
                        <div><dt>@LocalizationService["JobsOnQuotation"]</dt><dd>@linkedRequests.Count</dd></div>
                        <div><dt>@LocalizationService["Customer"]</dt><dd>@GetCustomerName()</dd></div>
                    </dl>

                    <p class="quotation-workspace-total-help">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        @LocalizationService["QuotationPricingSummaryHint"]
                    </p>
                    @if (quotation.Status is QuotationStatus.Approved or QuotationStatus.ReadyToSend
                        or QuotationStatus.SentToCustomer or QuotationStatus.CustomerNegotiation
                        or QuotationStatus.Accepted or QuotationStatus.Rejected)
                    {
                        <a class="quotation-workspace-preview-link" href="@($"/sales/quotations/preview/{quotation.Id}")">
                            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                            @LocalizationService["QuotationPreview"]
                        </a>
                    }
                </section>

                <section class="quotation-workspace-guidance">
                    <div class="quotation-workspace-guidance-title">
                        <i class="bi bi-lightbulb" aria-hidden="true"></i>
                        <strong>@LocalizationService["QuotationNextStep"]</strong>
                    </div>
                    <p>@GetQuotationWorkflowHint()</p>
                </section>
            </aside>
        </div>
    }
</div>

@code {

    [Parameter]
    public long Id { get; set; }

    private ApplicationDbContext? editContext;
    private ApplicationDbContext Db => editContext!;
    private Quotation? quotation;
    private List<SalesRequest> linkedRequests = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool isSubmitting;
    private bool isApproving;
    private bool isRejecting;
    private bool isDeciding;
    private bool IsWriting => isSaving || isSubmitting || isDeciding || isSavingSeller;
    private bool canManageQuotation;
    private bool CanEditPricing => canManageQuotation && IsEditable;

    private string? errorMessage;
    private string? successMessage;
    private List<SellerCompany> sellerCompanies = new();
    private SellerCompany? sellerDraft;
    private string sellerSearch = "";
    private string? sellerError;
    private bool isSavingSeller;
    private SellerCompany? SelectedSeller => sellerCompanies.FirstOrDefault(x => x.Id == quotation?.SellerCompanyId);
    private IEnumerable<SellerCompany> FilteredSellers => sellerCompanies.Where(x =>
        x.Id == quotation?.SellerCompanyId || string.IsNullOrWhiteSpace(sellerSearch) ||
        x.LegalName.Contains(sellerSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
        x.NationalId.Contains(sellerSearch.Trim(), StringComparison.OrdinalIgnoreCase));
    private readonly HashSet<long> invalidPriceLineIds = new();

    private bool IsEditable =>
        quotation != null &&
        (quotation.Status == QuotationStatus.Draft ||
         quotation.Status == QuotationStatus.RevisionRequired);

    private string GetQuotationWorkflowHint() => quotation?.Status switch
    {
        QuotationStatus.Draft or QuotationStatus.RevisionRequired =>
            LocalizationService.IsPersian ? "قیمت‌ها را تکمیل و پس از تأیید طرح‌های مشتری، پیش‌فاکتور را ارسال کنید." : "Complete pricing and send after all customer proofs are accepted.",
        QuotationStatus.PendingApproval =>
            LocalizationService.IsPersian ? "پس از تأیید طرح‌ها، ارسال پیش‌فاکتور را ثبت کنید." : "Record sending after customer proofs are accepted.",
        QuotationStatus.Approved or QuotationStatus.ReadyToSend or
        QuotationStatus.SentToCustomer or QuotationStatus.CustomerNegotiation =>
            LocalizationService.IsPersian ? "پاسخ مشتری را ثبت کنید؛ در صورت درخواست تغییر، قیمت‌ها قابل ویرایش می‌شوند." : "Record the customer's response; a requested change returns the quotation to negotiation.",
        _ => LocalizationService["QuotationEditClosedHint"]
    };

    private static string GetQuotationStatusCssClass(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => "quotation-status-draft",
        QuotationStatus.PendingApproval => "quotation-status-pending",
        QuotationStatus.RevisionRequired => "quotation-status-revision",
        QuotationStatus.Approved => "quotation-status-approved",
        QuotationStatus.Accepted => "quotation-status-accepted",
        QuotationStatus.Rejected => "quotation-status-rejected",
        QuotationStatus.Cancelled => "quotation-status-cancelled",
        QuotationStatus.ReadyToSend or QuotationStatus.SentToCustomer or QuotationStatus.CustomerNegotiation => "quotation-status-customer",
        QuotationStatus.Expired => "quotation-status-expired",
        _ => "quotation-status-unknown"
    };

    private void OpenPreview()
    {
        Navigation.NavigateTo($"/sales/quotations/preview/{Id}");
    }


    protected override async Task OnInitializedAsync() => editContext = await DbFactory.CreateDbContextAsync();

    public async ValueTask DisposeAsync()
    {
        if (editContext is not null)
            await editContext.DisposeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        canManageQuotation = await Permissions.HasPermissionAsync(principal, "Sales.Requests.CreateQuotation");
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Db.ChangeTracker.Clear();
            sellerDraft = null; sellerError = null; sellerSearch = "";
            sellerCompanies = canManageQuotation
                ? await Db.SellerCompanies.AsNoTracking().OrderBy(x => x.LegalName).ToListAsync()
                : new List<SellerCompany>();
            quotation = await Db.Quotations

                .Include(x => x.Customer)

                .Include(x => x.SalesRequest)
                .Include(x => x.Lines).ThenInclude(x => x.SourceRequest)

                .Include(x => x.Lines)
                    .ThenInclude(x => x.Item)

                .FirstOrDefaultAsync(x =>
                    x.Id == Id);

            if (quotation == null)
            {
                errorMessage =
                    LocalizationService["QuotationNotFound"];
            }
            else
            {
                // Editable legacy quotations may contain fractional prices.
                // Normalize tracked values so visible unit prices and totals
                // agree immediately; changes persist only when saved.
                if (CanEditPricing)
                    NormalizeUnitPrices();

                // The primary request remains linked for legacy quotations.
                var requestIds = quotation.Lines
                    .Where(line => line.SourceRequestId.HasValue)
                    .Select(line => line.SourceRequestId!.Value)
                    .Append(quotation.SalesRequestId)
                    .Distinct()
                    .ToArray();

                invalidPriceLineIds.Clear();

                linkedRequests = await Db.SalesRequests.AsNoTracking()
                    .Where(job => requestIds.Contains(job.Id))
                    .OrderBy(job => job.RequestDate)
                    .ToListAsync();

            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private string GetLinkedRequestNumber(long requestId) =>
        linkedRequests.FirstOrDefault(x => x.Id == requestId)?.RequestNumber ?? $"#{requestId}";

    private static string GetRequestTitle(SalesRequest request)
    {
        try
        {
            using var json = JsonDocument.Parse(
                string.IsNullOrWhiteSpace(request.JobSpecificationJson)
                    ? "{}" : request.JobSpecificationJson);
            if (json.RootElement.TryGetProperty("JobTitle", out var value) &&
                value.ValueKind == JsonValueKind.String &&
                !string.IsNullOrWhiteSpace(value.GetString()))
                return value.GetString()!;
        }
        catch (JsonException) { }

        return request.RequestNumber;
    }

    private void StartSeller()
    {
        sellerError = null;
        sellerDraft = new SellerCompany
        {
            LegalName = sellerSearch.Trim(),
            Jurisdiction = Configuration["TaxReporting:Jurisdiction"] ?? "",
            CurrencyCode = quotation?.CurrencyCode ?? Configuration["TaxReporting:CurrencyCode"] ?? ""
        };
    }

    private void EditSeller()
    {
        if (SelectedSeller is not { } source) return;
        sellerError = null;
        sellerDraft = new SellerCompany
        {
            Id = source.Id, RowVersion = source.RowVersion.ToArray(),
            LegalName = source.LegalName,
            NationalId = source.NationalId,
            EconomicCode = source.EconomicCode,
            RegistrationNumber = source.RegistrationNumber,
            Address = source.Address,
            PostalCode = source.PostalCode,
            Phone = source.Phone,
            Email = source.Email,
            Jurisdiction = source.Jurisdiction,
            CurrencyCode = source.CurrencyCode,
            TaxMemoryId = source.TaxMemoryId,
        };
    }

    private async Task SaveSellerAsync()
    {
        if (sellerDraft is null || quotation is null || !CanEditPricing || IsWriting ||
            quotation.QuotationType != QuotationType.Formal) return;
        isSavingSeller = true; sellerError = null;
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Requests.CreateQuotation"))
                throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);
            QuotationDocument.NormalizeSeller(sellerDraft);
            QuotationDocument.ValidateSeller(sellerDraft);
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.SellerCompanies.AnyAsync(x => x.Jurisdiction == sellerDraft.Jurisdiction &&
                x.NationalId == sellerDraft.NationalId && x.Id != sellerDraft.Id))
                throw new InvalidOperationException(VatText("This company is already saved. Select it from the directory.", "این شرکت قبلاً ذخیره شده است؛ آن را از فهرست انتخاب کنید."));
            SellerCompany saved;
            if (sellerDraft.Id == 0)
            {
                saved = sellerDraft;
                db.SellerCompanies.Add(saved);
            }
            else
            {
                saved = await db.SellerCompanies.SingleAsync(x => x.Id == sellerDraft.Id);
                if (saved.Jurisdiction != sellerDraft.Jurisdiction || saved.NationalId != sellerDraft.NationalId)
                    throw new InvalidOperationException("Registered company identity cannot be changed; add a different company instead.");
                db.Entry(saved).Property(x => x.RowVersion).OriginalValue = sellerDraft.RowVersion;
                saved.LegalName = sellerDraft.LegalName;
                saved.EconomicCode = sellerDraft.EconomicCode;
                saved.RegistrationNumber = sellerDraft.RegistrationNumber;
                saved.Address = sellerDraft.Address;
                saved.PostalCode = sellerDraft.PostalCode;
                saved.Phone = sellerDraft.Phone;
                saved.Email = sellerDraft.Email;
                saved.CurrencyCode = sellerDraft.CurrencyCode;
                saved.TaxMemoryId = sellerDraft.TaxMemoryId;
            }
            await db.SaveChangesAsync();
            sellerCompanies = await db.SellerCompanies.AsNoTracking().OrderBy(x => x.LegalName).ToListAsync();
            quotation.SellerCompanyId = saved.Id;
            if (string.IsNullOrWhiteSpace(quotation.CurrencyCode)) quotation.CurrencyCode = saved.CurrencyCode;
            sellerSearch = ""; sellerDraft = null;
        }
        catch (DbUpdateConcurrencyException) { sellerError = VatText("Company was updated by someone else. Reload the quotation and try again.", "شرکت توسط کاربر دیگری تغییر کرده است؛ پیش‌فاکتور را بارگذاری مجدد کنید."); }
        catch (DbUpdateException) { sellerError = VatText("Company could not be saved. Check for an existing company with this national ID.", "ذخیره شرکت ممکن نیست؛ شناسه ملی تکراری را بررسی کنید."); }
        catch (Exception ex) { sellerError = ex.Message; }
        finally { isSavingSeller = false; }
    }

    private async Task ValidateDocumentAsync()
    {
        if (quotation is null) return;
        if (sellerDraft is not null && quotation.QuotationType == QuotationType.Formal)
            throw new InvalidOperationException(VatText("Save or cancel the company details first.", "ابتدا مشخصات شرکت را ذخیره یا لغو کنید."));
        await using var db = await DbFactory.CreateDbContextAsync();
        var seller = quotation.SellerCompanyId is int id
            ? await db.SellerCompanies.AsNoTracking().SingleOrDefaultAsync(x => x.Id == id) : null;
        QuotationDocument.Capture(quotation, quotation.Customer, Configuration, seller);
    }

    private async Task SaveAndPreviewAsync()
    {
        if (quotation == null || !CanEditPricing || IsWriting) return;
        try
        {
            ValidateQuotation();
            NormalizeUnitPrices();
            CalculateFinalAmount();
            await ValidateDocumentAsync();
        }
        catch (Exception ex) { errorMessage = ex.Message; return; }
        await SaveAsync();
        if (errorMessage == null && successMessage != null)
            OpenPreview();
    }

    private async Task SaveAsync()
    {
        if (quotation == null || !IsEditable || IsWriting)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isSaving = true;
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Requests.CreateQuotation"))
                throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);

            ValidateQuotation();
            if (quotation.QuotationType != QuotationType.Formal) quotation.SellerCompanyId = null;

            NormalizeUnitPrices();
            CalculateFinalAmount();

            var pricingUser = await GetCurrentUserAsync();
            await Db.SaveChangesAsync();
            await QuotationService.AssignPricingUserAsEvaluatorAsync(
                quotation.Id,
                pricingUser.Id);

            successMessage =
                LocalizationService[
                    "QuotationSavedSuccessfully"];
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private async Task SubmitForApprovalAsync()
    {
        if (quotation == null || IsWriting)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isSubmitting = true;
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Requests.CreateQuotation"))
                throw new UnauthorizedAccessException("Quotation permission required.");
            if (IsEditable)
            {
                ValidateQuotation();
                if (quotation.QuotationType != QuotationType.Formal) quotation.SellerCompanyId = null;
                NormalizeUnitPrices();
                CalculateFinalAmount();
                await ValidateDocumentAsync();
                var pricingUser = await GetCurrentUserAsync();
                await Db.SaveChangesAsync();
                await QuotationService.AssignPricingUserAsEvaluatorAsync(quotation.Id, pricingUser.Id);
            }
            await QuotationService.SendToCustomerAsync(quotation.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private async Task ApproveAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isApproving = true;

            var user =
                await GetCurrentUserAsync();

            await QuotationService.ApproveAsync(
                quotation.Id,
                user.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isApproving = false;
        }
    }


    private async Task RejectAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isRejecting = true;

            var user =
                await GetCurrentUserAsync();

            await QuotationService.RejectAsync(
                quotation.Id,
                user.Id,
                "");

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRejecting = false;
        }
    }


    private async Task CustomerDecisionAsync(bool accepted)
    {
        if (quotation == null || IsWriting)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isDeciding = true;
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Requests.CreateQuotation"))
                throw new UnauthorizedAccessException("Quotation permission required.");

            if (accepted)
            {
                // One action: record customer acceptance and create the order
                // in a single transaction. Repeated requests reuse the order.
                var salesOrder = await SalesOrderService
                    .AcceptQuotationAndCreateOrderAsync(quotation.Id);

                Navigation.NavigateTo($"/sales/orders/edit/{salesOrder.Id}");
                return;
            }

            // Rejection only returns the quotation for price revision.
            await QuotationService.CustomerDecisionAsync(quotation.Id, false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            // Refresh the actual persisted state after a rolled-back acceptance.
            await LoadAsync();
            errorMessage = ex.Message;
        }
        finally
        {
            isDeciding = false;
        }
    }


    private async Task CancelQuotationAsync()
    {
        if (quotation == null || IsWriting) return;
        isDeciding = true;
        errorMessage = null;
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Sales.Requests.CreateQuotation"))
                throw new UnauthorizedAccessException("Quotation permission required.");
            await QuotationService.CancelAsync(quotation.Id);
            await LoadAsync();
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isDeciding = false; }
    }

    private async Task<ApplicationUser>
        GetCurrentUserAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(
                authenticationState.User);

        if (user == null)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "UserNotAuthenticated"]);
        }

        return user;
    }


    private void ValidateQuotation()
    {
        if (quotation == null)
            return;

        if (invalidPriceLineIds.Count > 0)
            throw new InvalidOperationException(
                LocalizationService["WholeNumberPriceRequired"]);

        if (!quotation.Lines.Any())
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "AtLeastOneQuotationLineRequired"]);
        }

        foreach (var line in quotation.Lines)
        {
            if (line.Quantity <= 0)
            {
                throw new InvalidOperationException(
                    LocalizationService[
                        "QuantityMustBeGreaterThanZero"]);
            }

            if (line.UnitPrice < 0)
            {
                throw new InvalidOperationException(
                    LocalizationService[
                        "UnitPriceCannotBeNegative"]);
            }
        }

        if (quotation.MaterialCost < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "MaterialCostCannotBeNegative"]);
        }

        if (quotation.ProductionCost < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "ProductionCostCannotBeNegative"]);
        }

        if (quotation.EstimatedDeliveryDays < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "EstimatedDeliveryDaysCannotBeNegative"]);
        }
    }


    private void CalculateFinalAmount()
    {
        if (quotation == null)
            return;

        quotation.CurrencyCode = quotation.CurrencyCode?.Trim().ToUpperInvariant();
        quotation.FinalAmount = InvoiceVat.Gross(quotation);
    }


    private string GetCustomerName()
    {
        return quotation?.Customer?.Name
            ?? "-";
    }


    private string GetJobTitle()
    {
        if (linkedRequests.Count > 1)
            return $"{linkedRequests.Count} {LocalizationService["JobsOnQuotation"]}";
        var json = quotation?.SalesRequest?.JobSpecificationJson;
        if (string.IsNullOrWhiteSpace(json))
            return "-";

        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
                return "-";

            foreach (var property in document.RootElement.EnumerateObject())
            {
                if (string.Equals(property.Name, "JobTitle", StringComparison.OrdinalIgnoreCase) &&
                    property.Value.ValueKind == JsonValueKind.String)
                {
                    var title = property.Value.GetString()?.Trim();
                    return string.IsNullOrWhiteSpace(title) ? "-" : title;
                }
            }
        }
        catch (JsonException)
        {
            // Older or malformed job specification data should not break the quotation page.
        }

        return "-";
    }

    // A blank validity period means no expiry is specified. Derive dates
    // from the quotation date, not from the day the editor is opened.
    private int? ValidityDays
    {
        get => quotation?.ValidUntil is DateTime expiry
            ? (expiry.Date - quotation.QuotationDate.Date).Days
            : null;
        set
        {
            if (quotation == null)
                return;

            if (value is < 0 or > 3650)
            {
                errorMessage = LocalizationService["ValidityDaysRange"];
                return;
            }

            quotation.ValidUntil = value.HasValue
                ? quotation.QuotationDate.Date.AddDays(value.Value)
                : null;
            errorMessage = null;
        }
    }

    private string VatText(string en, string fa) => LocalizationService.IsPersian ? fa : en;
    private string FormatVatTotal(decimal amount) => amount.ToString(quotation?.CurrencyCode == "IRR" ? "N0" : "N2", CultureInfo.CurrentCulture);
    private static decimal WholePrice(decimal amount) =>
        decimal.Round(amount, 0, MidpointRounding.AwayFromZero);

    private static string FormatWholeAmount(decimal amount) =>
        WholePrice(amount).ToString("N0", CultureInfo.CurrentCulture);

    // HTML number controls require invariant, ungrouped values.
    private static string FormatWholePriceInput(decimal amount) =>
        WholePrice(amount).ToString("0", CultureInfo.InvariantCulture);

    private void UpdateWholeUnitPrice(QuotationLine line, ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var price) ||
            price < 0 || decimal.Truncate(price) != price)
        {
            invalidPriceLineIds.Add(line.Id);
            errorMessage = LocalizationService["WholeNumberPriceRequired"];
            return;
        }

        invalidPriceLineIds.Remove(line.Id);
        line.UnitPrice = price;
        errorMessage = null;
    }

    private void NormalizeUnitPrices()
    {
        if (quotation is null)
            return;

        foreach (var line in quotation.Lines)
            line.UnitPrice = WholePrice(line.UnitPrice);
    }

    private static string FormatJalaliDate(DateTime? date)
    {
        if (!date.HasValue)
            return "-";

        var calendar = new PersianCalendar();
        return $"{calendar.GetYear(date.Value):0000}/{calendar.GetMonth(date.Value):00}/{calendar.GetDayOfMonth(date.Value):00}";
    }

    private void GoBack()
    {
        if (quotation == null)
        {
            Navigation.NavigateTo(
                "/sales/requests");

            return;
        }

        Navigation.NavigateTo("/sales/quotations");
    }
}
