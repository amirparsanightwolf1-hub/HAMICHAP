@page "/sales/quotations/edit/{Id:long}"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Models.Shared.Services
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject QuotationService QuotationService
@inject LocalizationService LocalizationService
@inject SalesOrderService SalesOrderService

<PageTitle>
    @LocalizationService["Quotation"]
</PageTitle>

<div class="page-container">

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @LocalizationService["Loading"]
                </span>
            </div>
        </div>
    }
    else if (quotation == null)
    {
        <div class="alert alert-danger">
            @LocalizationService["QuotationNotFound"]
        </div>
    }
    else
    {
        <div class="erp-page-header mb-4">

            <div>
                <div class="erp-page-title">
                    @LocalizationService["Quotation"]
                </div>

                <div class="erp-page-subtitle">
                    @quotation.QuotationNumber
                </div>
            </div>

            <div class="d-flex gap-2">

                @if (quotation.Status == QuotationStatus.Approved ||
                     quotation.Status == QuotationStatus.SentToCustomer ||
                     quotation.Status == QuotationStatus.CustomerNegotiation ||
                     quotation.Status == QuotationStatus.Accepted ||
                     quotation.Status == QuotationStatus.Rejected)
                {
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenPreview">
                        @LocalizationService["QuotationPreview"]
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="GoBack">

                    <i class="bi bi-arrow-left"></i>
                    @LocalizationService["Back"]

                </button>

                @if (quotation.Status == QuotationStatus.Draft ||
                     quotation.Status == QuotationStatus.RevisionRequired)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveAsync"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-save"></i>
                        @LocalizationService["Save"]

                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="SubmitForApprovalAsync"
                            disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-send"></i>
                        @LocalizationService["SubmitForApproval"]

                    </button>
                }

                @if (quotation.Status == QuotationStatus.PendingApproval)
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="ApproveAsync"
                            disabled="@isApproving">

                        @if (isApproving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-check-circle"></i>
                        @LocalizationService["Approve"]

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="RejectAsync"
                            disabled="@isRejecting">

                        @if (isRejecting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-x-circle"></i>
                        @LocalizationService["Reject"]

                    </button>
                }

                @if (quotation.Status == QuotationStatus.Approved ||
                     quotation.Status == QuotationStatus.ReadyToSend)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SendToCustomerAsync"
                            disabled="@isSending">

                        @if (isSending)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-send"></i>
                        @LocalizationService["SendToCustomer"]

                    </button>
                }

                @if (quotation.Status == QuotationStatus.SentToCustomer ||
                     quotation.Status == QuotationStatus.CustomerNegotiation)
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="() => CustomerDecisionAsync(true)"
                            disabled="@isDeciding">

                        <i class="bi bi-check-circle"></i>
                        @LocalizationService["CustomerAccepted"]

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="() => CustomerDecisionAsync(false)"
                            disabled="@isDeciding">

                        <i class="bi bi-x-circle"></i>
                        @LocalizationService["CustomerRejected"]

                    </button>
                }

                @if (quotation.Status == QuotationStatus.Accepted)
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="CreateSalesOrderAsync"
                            disabled="@isCreatingSalesOrder">

                        @if (isCreatingSalesOrder)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-cart-check"></i>
                        @LocalizationService["CreateSalesOrder"]

                    </button>
                }

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-4">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success mb-4">
                @successMessage
            </div>
        }

        <!-- Quotation Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>
                    @LocalizationService["QuotationInformation"]
                </strong>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["QuotationNumber"]
                        </label>

                        <input class="form-control"
                               value="@quotation.QuotationNumber"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Customer"]
                        </label>

                        <input class="form-control"
                               value="@GetCustomerName()"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["QuotationDate"]
                        </label>

                        <input class="form-control"
                               value="@quotation.QuotationDate.ToString("yyyy-MM-dd")"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Status"]
                        </label>

                        <input class="form-control"
                               value="@LocalizationService.TranslateEnum(quotation.Status)"
                               readonly />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["ValidUntil"]
                        </label>

                        @if (IsEditable)
                        {
                            <InputDate @bind-Value="quotation.ValidUntil"
                                       class="form-control" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@FormatDate(quotation.ValidUntil)"
                                   readonly />
                        }

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["EstimatedDeliveryDays"]
                        </label>

                        @if (IsEditable)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="quotation.EstimatedDeliveryDays" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@quotation.EstimatedDeliveryDays"
                                   readonly />
                        }

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["ProfitMargin"]
                        </label>

                        @if (IsEditable)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="quotation.ProfitMargin" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@quotation.ProfitMargin.ToString("N2")"
                                   readonly />
                        }

                    </div>

                </div>

            </div>
        </div>

        <!-- Quotation Lines -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>
                    @LocalizationService["QuotationLines"]
                </strong>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>

                                <th>
                                    @LocalizationService["Item"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["Quantity"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["UnitPrice"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["TotalPrice"]
                                </th>

                                <th>
                                    @LocalizationService["Notes"]
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var line in quotation.Lines)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @line.Item?.Name
                                        </div>

                                        <small class="text-muted">
                                            @line.Item?.Code
                                        </small>
                                    </td>

                                    <td class="text-end">
                                        @line.Quantity.ToString("N2")
                                    </td>

                                    <td class="text-end">

                                        @if (IsEditable)
                                        {
                                            <InputNumber class="form-control text-end"
                                                         @bind-Value="line.UnitPrice" />
                                        }
                                        else
                                        {
                                            @line.UnitPrice.ToString("N2")
                                        }

                                    </td>

                                    <td class="text-end fw-semibold">
                                        @line.TotalPrice.ToString("N2")
                                    </td>

                                    <td>

                                        @if (IsEditable)
                                        {
                                            <InputText class="form-control"
                                                       @bind-Value="line.Notes" />
                                        }
                                        else
                                        {
                                            @line.Notes
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        <!-- Financial Summary -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>
                    @LocalizationService["FinancialSummary"]
                </strong>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["MaterialCost"]
                        </label>

                        @if (IsEditable)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="quotation.MaterialCost" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@quotation.MaterialCost.ToString("N2")"
                                   readonly />
                        }

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["ProductionCost"]
                        </label>

                        @if (IsEditable)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="quotation.ProductionCost" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@quotation.ProductionCost.ToString("N2")"
                                   readonly />
                        }

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["ProfitMargin"]
                        </label>

                        <input class="form-control"
                               value="@quotation.ProfitMargin.ToString("N2")"
                               readonly="@(!IsEditable)" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["FinalAmount"]
                        </label>

                        <input class="form-control fw-bold"
                               value="@quotation.FinalAmount.ToString("N2")"
                               readonly />

                    </div>

                </div>

                <div class="mt-3">

                    <label class="form-label">
                        @LocalizationService["Notes"]
                    </label>

                    @if (IsEditable)
                    {
                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="quotation.Notes" />
                    }
                    else
                    {
                        <textarea class="form-control"
                                  rows="4"
                                  readonly>@quotation.Notes</textarea>
                    }

                </div>

            </div>
        </div>
    }
</div>

@code {

    [Parameter]
    public long Id { get; set; }

    private Quotation? quotation;

    private bool isLoading = true;
    private bool isSaving;
    private bool isSubmitting;
    private bool isApproving;
    private bool isRejecting;
    private bool isSending;
    private bool isDeciding;
    private bool isCreatingSalesOrder;

    private string? errorMessage;
    private string? successMessage;

    private bool IsEditable =>
        quotation != null &&
        (quotation.Status == QuotationStatus.Draft ||
         quotation.Status == QuotationStatus.RevisionRequired);

    private void OpenPreview()
    {
        Navigation.NavigateTo($"/sales/quotations/preview/{Id}");
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            quotation = await Db.Quotations

                .Include(x => x.Customer)

                .Include(x => x.SalesRequest)

                .Include(x => x.Lines)
                    .ThenInclude(x => x.Item)

                .FirstOrDefaultAsync(x =>
                    x.Id == Id);

            if (quotation == null)
            {
                errorMessage =
                    LocalizationService["QuotationNotFound"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SaveAsync()
    {
        if (quotation == null || !IsEditable)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            ValidateQuotation();

            CalculateFinalAmount();

            isSaving = true;

            await Db.SaveChangesAsync();

            successMessage =
                LocalizationService[
                    "QuotationSavedSuccessfully"];
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private async Task SubmitForApprovalAsync()
    {
        if (quotation == null || !IsEditable)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            ValidateQuotation();

            CalculateFinalAmount();

            isSubmitting = true;

            await Db.SaveChangesAsync();

            await QuotationService
                .SubmitForApprovalAsync(
                    quotation.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private async Task ApproveAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isApproving = true;

            var user =
                await GetCurrentUserAsync();

            await QuotationService.ApproveAsync(
                quotation.Id,
                user.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isApproving = false;
        }
    }


    private async Task RejectAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isRejecting = true;

            var user =
                await GetCurrentUserAsync();

            await QuotationService.RejectAsync(
                quotation.Id,
                user.Id,
                "");

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRejecting = false;
        }
    }


    private async Task SendToCustomerAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isSending = true;

            await QuotationService
                .SendToCustomerAsync(
                    quotation.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }


    private async Task CustomerDecisionAsync(
        bool accepted)
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isDeciding = true;

            await QuotationService
                .CustomerDecisionAsync(
                    quotation.Id,
                    accepted);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isDeciding = false;
        }
    }


    private async Task CreateSalesOrderAsync()
    {
        if (quotation == null)
            return;

        if (quotation.Status != QuotationStatus.Accepted)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isCreatingSalesOrder = true;

            var salesOrder =
                await SalesOrderService
                    .CreateFromQuotationAsync(
                        quotation.Id);

            Navigation.NavigateTo(
                $"/sales/orders/edit/{salesOrder.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCreatingSalesOrder = false;
        }
    }


    private async Task<ApplicationUser>
        GetCurrentUserAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(
                authenticationState.User);

        if (user == null)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "UserNotAuthenticated"]);
        }

        return user;
    }


    private void ValidateQuotation()
    {
        if (quotation == null)
            return;

        if (!quotation.Lines.Any())
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "AtLeastOneQuotationLineRequired"]);
        }

        foreach (var line in quotation.Lines)
        {
            if (line.Quantity <= 0)
            {
                throw new InvalidOperationException(
                    LocalizationService[
                        "QuantityMustBeGreaterThanZero"]);
            }

            if (line.UnitPrice < 0)
            {
                throw new InvalidOperationException(
                    LocalizationService[
                        "UnitPriceCannotBeNegative"]);
            }
        }

        if (quotation.MaterialCost < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "MaterialCostCannotBeNegative"]);
        }

        if (quotation.ProductionCost < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "ProductionCostCannotBeNegative"]);
        }

        if (quotation.EstimatedDeliveryDays < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "EstimatedDeliveryDaysCannotBeNegative"]);
        }
    }


    private void CalculateFinalAmount()
    {
        if (quotation == null)
            return;

        var subtotal =
            quotation.Lines.Sum(x =>
                x.TotalPrice);

        quotation.FinalAmount =
            subtotal;
    }


    private string GetCustomerName()
    {
        return quotation?.Customer?.Name
            ?? "-";
    }


    private string FormatDate(DateTime? date)
    {
        return date?.ToString("yyyy-MM-dd")
            ?? "-";
    }


    private void GoBack()
    {
        if (quotation == null)
        {
            Navigation.NavigateTo(
                "/sales/requests");

            return;
        }

        Navigation.NavigateTo(
            $"/sales/requests/edit/{quotation.SalesRequestId}");
    }
}