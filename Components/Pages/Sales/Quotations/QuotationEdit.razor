@page "/sales/quotations/edit/{Id:long}"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Models.Shared.Services
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject QuotationService QuotationService
@inject LocalizationService LocalizationService
@inject SalesOrderService SalesOrderService

<PageTitle>
    @LocalizationService["Quotation"]
</PageTitle>

<div class="page-container quotation-edit-page">

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @LocalizationService["Loading"]
                </span>
            </div>
        </div>
    }
    else if (quotation == null)
    {
        <div class="alert alert-danger">
            @LocalizationService["QuotationNotFound"]
        </div>
    }
    else
    {
        <div class="erp-page-header quotation-page-header mb-4">

            <div>
                <div class="erp-page-title">
                    @LocalizationService["Quotation"]
                </div>

                <div class="erp-page-subtitle">
                    @quotation.QuotationNumber
                </div>
            </div>

            <div class="quotation-actions">

                @if (quotation.Status == QuotationStatus.Approved ||
                     quotation.Status == QuotationStatus.ReadyToSend ||
                     quotation.Status == QuotationStatus.SentToCustomer ||
                     quotation.Status == QuotationStatus.CustomerNegotiation ||
                     quotation.Status == QuotationStatus.Accepted ||
                     quotation.Status == QuotationStatus.Rejected)
                {
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenPreview">
                        @LocalizationService["QuotationPreview"]
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="GoBack">

                    <i class="bi bi-arrow-left"></i>
                    @LocalizationService["Back"]

                </button>

                @if (quotation.Status == QuotationStatus.Draft ||
                     quotation.Status == QuotationStatus.RevisionRequired)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveAsync"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-save"></i>
                        @LocalizationService["Save"]

                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="SubmitForApprovalAsync"
                            disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-send"></i>
                        @LocalizationService["SubmitForApproval"]

                    </button>
                }

                @if (quotation.Status == QuotationStatus.PendingApproval)
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="ApproveAsync"
                            disabled="@isApproving">

                        @if (isApproving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-check-circle"></i>
                        @LocalizationService["Approve"]

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="RejectAsync"
                            disabled="@isRejecting">

                        @if (isRejecting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-x-circle"></i>
                        @LocalizationService["Reject"]

                    </button>
                }


                @if (quotation.Status == QuotationStatus.Approved ||
                     quotation.Status == QuotationStatus.ReadyToSend ||
                     quotation.Status == QuotationStatus.SentToCustomer ||
                     quotation.Status == QuotationStatus.CustomerNegotiation)
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="() => CustomerDecisionAsync(true)"
                            disabled="@isDeciding">

                        <i class="bi bi-check-circle"></i>
                        @LocalizationService["CustomerAccepted"]

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="() => CustomerDecisionAsync(false)"
                            disabled="@isDeciding">

                        <i class="bi bi-x-circle"></i>
                        @LocalizationService["CustomerRejected"]

                    </button>
                }

                @if (quotation.Status == QuotationStatus.Accepted)
                {
                    <button type="button"
                            class="btn btn-success"
                            @onclick="CreateSalesOrderAsync"
                            disabled="@isCreatingSalesOrder">

                        @if (isCreatingSalesOrder)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <i class="bi bi-cart-check"></i>
                        @LocalizationService["CreateSalesOrder"]

                    </button>
                }

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-4">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success mb-4">
                @successMessage
            </div>
        }

        <!-- Quotation Information -->

        <div class="card quotation-card mb-4">

            <div class="card-header quotation-card-header">
                <strong>
                    @LocalizationService["QuotationInformation"]
                </strong>
            </div>

            <div class="card-body quotation-card-body">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["QuotationNumber"]
                        </label>

                        <input class="form-control"
                               value="@quotation.QuotationNumber"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Customer"]
                        </label>

                        <input class="form-control"
                               value="@GetCustomerName()"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["JobTitle"]
                        </label>

                        <input class="form-control"
                               value="@GetJobTitle()"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["QuotationDate"]
                        </label>

                        <input class="form-control"
                               value="@FormatJalaliDate(quotation.QuotationDate)"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Status"]
                        </label>

                        <div class="quotation-status-value">
                            <span class="quotation-status-badge @GetQuotationStatusCssClass(quotation.Status)">
                                <span class="quotation-status-dot"></span>
                                @LocalizationService.TranslateEnum(quotation.Status)
                            </span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["ValidUntil"]
                        </label>

                        @if (IsEditable)
                        {
                            <input class="form-control"
                                   value="@FormatJalaliDate(quotation.ValidUntil)"
                                   @onchange="UpdateValidUntilFromJalali"
                                   inputmode="numeric"
                                   placeholder="1405/01/01" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@FormatJalaliDate(quotation.ValidUntil)"
                                   readonly />
                        }

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            @LocalizationService["EstimatedDeliveryDays"]
                        </label>

                        @if (IsEditable)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="quotation.EstimatedDeliveryDays" />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="@quotation.EstimatedDeliveryDays"
                                   readonly />
                        }

                    </div>

                </div>

            </div>
        </div>

        <!-- Quotation Lines -->

        <div class="card quotation-card mb-4">

            <div class="card-header quotation-card-header">
                <strong>
                    @LocalizationService["QuotationLines"]
                </strong>
            </div>

            <div class="card-body p-0 quotation-table-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0 quotation-lines-table">

                        <thead>
                            <tr>

                                <th>
                                    @LocalizationService["Item"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["Quantity"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["UnitPrice"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["TotalPrice"]
                                </th>

                                <th>
                                    @LocalizationService["Notes"]
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var line in quotation.Lines)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @line.Item?.Name
                                        </div>

                                        <small class="text-muted">
                                            @line.Item?.Code
                                        </small>
                                    </td>

                                    <td class="text-end">
                                        @line.Quantity.ToString("N2")
                                    </td>

                                    <td class="text-end">

                                        @if (IsEditable)
                                        {
                                            <InputNumber class="form-control text-end"
                                                         @bind-Value="line.UnitPrice" />
                                        }
                                        else
                                        {
                                            @line.UnitPrice.ToString("N2")
                                        }

                                    </td>

                                    <td class="text-end fw-semibold">
                                        @line.TotalPrice.ToString("N2")
                                    </td>

                                    <td>

                                        @if (IsEditable)
                                        {
                                            <InputText class="form-control"
                                                       @bind-Value="line.Notes" />
                                        }
                                        else
                                        {
                                            @line.Notes
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        <!-- Quotation Notes -->

        <div class="card quotation-card mb-4">
            <div class="card-header quotation-card-header">
                <strong>@LocalizationService["Notes"]</strong>
            </div>
            <div class="card-body quotation-card-body">
                @if (IsEditable)
                {
                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="quotation.Notes" />
                }
                else
                {
                    <textarea class="form-control" rows="4" readonly>@quotation.Notes</textarea>
                }
            </div>
        </div>
    }
</div>

@code {

    [Parameter]
    public long Id { get; set; }

    private Quotation? quotation;

    private bool isLoading = true;
    private bool isSaving;
    private bool isSubmitting;
    private bool isApproving;
    private bool isRejecting;
    private bool isDeciding;
    private bool isCreatingSalesOrder;

    private string? errorMessage;
    private string? successMessage;

    private bool IsEditable =>
        quotation != null &&
        (quotation.Status == QuotationStatus.Draft ||
         quotation.Status == QuotationStatus.RevisionRequired);

    private static string GetQuotationStatusCssClass(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => "quotation-status-draft",
        QuotationStatus.PendingApproval => "quotation-status-pending",
        QuotationStatus.RevisionRequired => "quotation-status-revision",
        QuotationStatus.Approved => "quotation-status-approved",
        QuotationStatus.Accepted => "quotation-status-accepted",
        QuotationStatus.Rejected => "quotation-status-rejected",
        QuotationStatus.Cancelled => "quotation-status-cancelled",
        QuotationStatus.ReadyToSend or QuotationStatus.SentToCustomer or QuotationStatus.CustomerNegotiation => "quotation-status-customer",
        QuotationStatus.Expired => "quotation-status-expired",
        _ => "quotation-status-unknown"
    };

    private void OpenPreview()
    {
        Navigation.NavigateTo($"/sales/quotations/preview/{Id}");
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            quotation = await Db.Quotations

                .Include(x => x.Customer)

                .Include(x => x.SalesRequest)

                .Include(x => x.Lines)
                    .ThenInclude(x => x.Item)

                .FirstOrDefaultAsync(x =>
                    x.Id == Id);

            if (quotation == null)
            {
                errorMessage =
                    LocalizationService["QuotationNotFound"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SaveAsync()
    {
        if (quotation == null || !IsEditable)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            ValidateQuotation();

            CalculateFinalAmount();

            isSaving = true;

            var pricingUser = await GetCurrentUserAsync();
            await Db.SaveChangesAsync();
            await QuotationService.AssignPricingUserAsEvaluatorAsync(
                quotation.Id,
                pricingUser.Id);

            successMessage =
                LocalizationService[
                    "QuotationSavedSuccessfully"];
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private async Task SubmitForApprovalAsync()
    {
        if (quotation == null || !IsEditable)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            ValidateQuotation();

            CalculateFinalAmount();

            isSubmitting = true;

            var pricingUser = await GetCurrentUserAsync();
            await Db.SaveChangesAsync();
            await QuotationService.AssignPricingUserAsEvaluatorAsync(
                quotation.Id,
                pricingUser.Id);

            await QuotationService
                .SubmitForApprovalAsync(
                    quotation.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private async Task ApproveAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isApproving = true;

            var user =
                await GetCurrentUserAsync();

            await QuotationService.ApproveAsync(
                quotation.Id,
                user.Id);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isApproving = false;
        }
    }


    private async Task RejectAsync()
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isRejecting = true;

            var user =
                await GetCurrentUserAsync();

            await QuotationService.RejectAsync(
                quotation.Id,
                user.Id,
                "");

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isRejecting = false;
        }
    }


    private async Task CustomerDecisionAsync(
        bool accepted)
    {
        if (quotation == null)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isDeciding = true;

            await QuotationService
                .CustomerDecisionAsync(
                    quotation.Id,
                    accepted);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isDeciding = false;
        }
    }


    private async Task CreateSalesOrderAsync()
    {
        if (quotation == null)
            return;

        if (quotation.Status != QuotationStatus.Accepted)
            return;

        errorMessage = null;
        successMessage = null;

        try
        {
            isCreatingSalesOrder = true;

            var salesOrder =
                await SalesOrderService
                    .CreateFromQuotationAsync(
                        quotation.Id);

            Navigation.NavigateTo(
                $"/sales/orders/edit/{salesOrder.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCreatingSalesOrder = false;
        }
    }


    private async Task<ApplicationUser>
        GetCurrentUserAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(
                authenticationState.User);

        if (user == null)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "UserNotAuthenticated"]);
        }

        return user;
    }


    private void ValidateQuotation()
    {
        if (quotation == null)
            return;

        if (!quotation.Lines.Any())
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "AtLeastOneQuotationLineRequired"]);
        }

        foreach (var line in quotation.Lines)
        {
            if (line.Quantity <= 0)
            {
                throw new InvalidOperationException(
                    LocalizationService[
                        "QuantityMustBeGreaterThanZero"]);
            }

            if (line.UnitPrice < 0)
            {
                throw new InvalidOperationException(
                    LocalizationService[
                        "UnitPriceCannotBeNegative"]);
            }
        }

        if (quotation.MaterialCost < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "MaterialCostCannotBeNegative"]);
        }

        if (quotation.ProductionCost < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "ProductionCostCannotBeNegative"]);
        }

        if (quotation.EstimatedDeliveryDays < 0)
        {
            throw new InvalidOperationException(
                LocalizationService[
                    "EstimatedDeliveryDaysCannotBeNegative"]);
        }
    }


    private void CalculateFinalAmount()
    {
        if (quotation == null)
            return;

        var subtotal =
            quotation.Lines.Sum(x =>
                x.TotalPrice);

        quotation.FinalAmount =
            subtotal;
    }


    private string GetCustomerName()
    {
        return quotation?.Customer?.Name
            ?? "-";
    }


    private string GetJobTitle()
    {
        var json = quotation?.SalesRequest?.JobSpecificationJson;
        if (string.IsNullOrWhiteSpace(json))
            return "-";

        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
                return "-";

            foreach (var property in document.RootElement.EnumerateObject())
            {
                if (string.Equals(property.Name, "JobTitle", StringComparison.OrdinalIgnoreCase) &&
                    property.Value.ValueKind == JsonValueKind.String)
                {
                    var title = property.Value.GetString()?.Trim();
                    return string.IsNullOrWhiteSpace(title) ? "-" : title;
                }
            }
        }
        catch (JsonException)
        {
            // Older or malformed job specification data should not break the quotation page.
        }

        return "-";
    }

    private static string FormatJalaliDate(DateTime? date)
    {
        if (!date.HasValue)
            return "-";

        var calendar = new PersianCalendar();
        return $"{calendar.GetYear(date.Value):0000}/{calendar.GetMonth(date.Value):00}/{calendar.GetDayOfMonth(date.Value):00}";
    }

    private void UpdateValidUntilFromJalali(ChangeEventArgs args)
    {
        if (quotation == null)
            return;

        var value = (args.Value?.ToString() ?? string.Empty).Trim()
            .Replace('-', '/').Replace('.', '/')
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2')
            .Replace('۳', '3').Replace('۴', '4').Replace('۵', '5')
            .Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9')
            .Replace('٠', '0').Replace('١', '1').Replace('٢', '2')
            .Replace('٣', '3').Replace('٤', '4').Replace('٥', '5')
            .Replace('٦', '6').Replace('٧', '7').Replace('٨', '8').Replace('٩', '9');

        if (string.IsNullOrWhiteSpace(value))
        {
            quotation.ValidUntil = null;
            return;
        }

        var parts = value.Split('/');
        if (parts.Length != 3 ||
            !int.TryParse(parts[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out var year) ||
            !int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out var month) ||
            !int.TryParse(parts[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out var day))
        {
            errorMessage = LocalizationService["InvalidJalaliFromDate"];
            return;
        }

        try
        {
            quotation.ValidUntil = new PersianCalendar().ToDateTime(year, month, day, 0, 0, 0, 0);
            errorMessage = null;
        }
        catch (ArgumentOutOfRangeException)
        {
            errorMessage = LocalizationService["InvalidJalaliFromDate"];
        }
    }


    private void GoBack()
    {
        if (quotation == null)
        {
            Navigation.NavigateTo(
                "/sales/requests");

            return;
        }

        var job = quotation.SalesRequest?.JobType == SalesJobType.Roll ? "roll" : "sheet";
        Navigation.NavigateTo($"/sales/requests/{job}/edit/{quotation.SalesRequestId}");
    }
}