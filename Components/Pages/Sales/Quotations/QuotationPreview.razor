@page "/sales/quotations/preview/{Id:long}"

@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Sales.Enums

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService
@inject IJSRuntime JS

<HeadContent>
    <link rel="stylesheet" href="css/quotationPrint.css" />
</HeadContent>

<PageTitle>@T("Quotation") - @quotation?.QuotationNumber</PageTitle>

<div class="hc-quote-page">
    <div class="hc-quote-toolbar no-print">
        <button type="button" class="btn btn-outline-secondary" @onclick="BackToEditor">
            <i class="bi bi-arrow-left"></i> @T("BackToQuotation")
        </button>
        <button type="button" class="btn btn-primary" @onclick="PrintQuotation" disabled="@(quotation is null)">
            <i class="bi bi-printer"></i> @T("PrintSavePdf")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 no-print">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">@T("Loading")</p>
        </div>
    }
    else if (quotation is null)
    {
        <div class="alert alert-warning no-print">@T("QuotationNotFound")</div>
    }
    else
    {
        <article class="hc-quote-document" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
            <header class="hc-quote-header">
                <div class="hc-quote-brand">
                    <img class="hc-quote-logo"
                         src="images/Logo%20Wings%20navy%20blue.png"
                         alt="HamiChap" />
                    <div>
                        <div class="hc-quote-brand-name">@T("AppTitle")</div>
                        <div class="hc-quote-brand-caption">@T("Quotation")</div>
                    </div>
                </div>

                <div class="hc-quote-heading">
                    <h1>@T("Quotation")</h1>
                    <div class="hc-quote-meta-label">@T("QuotationNumber")</div>
                    <div class="hc-quote-serial">@quotation.QuotationNumber</div>
                    <div class="hc-quote-issued">
                        <span class="hc-quote-meta-label">@T("QuotationDate")</span>
                        <strong>@FormatDate(quotation.QuotationDate)</strong>
                    </div>
                </div>
            </header>

            <section class="hc-quote-parties" aria-label="@T("QuotationInformation")">
                <div class="hc-quote-bill-to">
                    <h2 class="hc-quote-block-title">@T("Customer")</h2>
                    <strong class="hc-quote-customer-name">@GetCustomerName()</strong>
                    @if (!string.IsNullOrWhiteSpace(quotation.Customer?.Address))
                    {
                        <p class="hc-quote-contact-line">@T("Address"): @quotation.Customer.Address</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(quotation.Customer?.Phone))
                    {
                        <p class="hc-quote-contact-line">@T("Phone"): @quotation.Customer.Phone</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(quotation.Customer?.Email))
                    {
                        <p class="hc-quote-contact-line">@T("Email"): @quotation.Customer.Email</p>
                    }
                </div>

                <div class="hc-quote-details">
                    <h2 class="hc-quote-block-title">@T("QuotationInformation")</h2>
                    <div class="hc-quote-fact">
                        <span class="hc-quote-meta-label">@T("QuotationDate")</span>
                        <strong>@FormatDate(quotation.QuotationDate)</strong>
                    </div>
                    <div class="hc-quote-fact">
                        <span class="hc-quote-meta-label">@T("ValidUntil")</span>
                        <strong>@(quotation.ValidUntil.HasValue ? FormatDate(quotation.ValidUntil.Value) : "—")</strong>
                    </div>
                    <div class="hc-quote-fact">
                        <span class="hc-quote-meta-label">@T("EstimatedDeliveryDays")</span>
                        <strong>@(quotation.EstimatedDeliveryDays > 0 ? quotation.EstimatedDeliveryDays.ToString("N0") : "—")</strong>
                    </div>
                </div>
            </section>

            <section>
                <h2 class="hc-quote-section-title">@T("QuotationItems")</h2>
                <div class="hc-quote-table-scroll">
                    <table class="hc-quote-items">
                        <colgroup>
                            <col style="width:5%" />
                            <col style="width:28%" />
                            <col style="width:21%" />
                            <col style="width:11%" />
                            <col style="width:9%" />
                            <col style="width:13%" />
                            <col style="width:13%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="hc-quote-center">#</th>
                                <th>@T("Item")</th>
                                <th>@T("Description")</th>
                                <th class="hc-quote-num">@T("Quantity")</th>
                                <th>@T("Unit")</th>
                                <th class="hc-quote-num">@T("UnitPrice")</th>
                                <th class="hc-quote-num">@T("TotalAmount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (quotation.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">@T("NoQuotationLines")</td>
                                </tr>
                            }
                            else
                            {
                                var rowNumber = 0;
                                @foreach (var line in quotation.Lines.OrderBy(l => l.Id))
                                {
                                    rowNumber++;
                                    <tr @key="line.Id">
                                        <td class="hc-quote-center">@rowNumber</td>
                                        <td>
                                            <span class="hc-quote-item-title">@(line.Item?.Name ?? $"#{line.ItemId}")</span>
                                            @if (!string.IsNullOrWhiteSpace(line.Item?.Code))
                                            {
                                                <span class="hc-quote-item-code">@line.Item.Code</span>
                                            }
                                            @if (line.SourceRequestId is long sourceId)
                                            {
                                                <span class="hc-quote-item-code">@GetRequestNumber(sourceId)</span>
                                            }
                                        </td>
                                        <td class="hc-quote-description">@(string.IsNullOrWhiteSpace(line.Notes) ? "—" : line.Notes)</td>
                                        <td class="hc-quote-num">@FormatAmount(line.Quantity)</td>
                                        <td class="hc-quote-unit">@(line.Item?.Unit?.Name ?? "عدد")</td>
                                        <td class="hc-quote-num">@FormatAmount(line.UnitPrice)</td>
                                        <td class="hc-quote-num"><strong>@FormatAmount(line.TotalPrice)</strong></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="hc-quote-total-area">
                <div class="hc-quote-total">
                    <span class="hc-quote-total-label">@T("TotalAmount")</span>
                    <strong class="hc-quote-total-amount">@FormatAmount(quotation.FinalAmount)</strong>
                </div>
            </section>

            @if (linkedRequests.Count > 0)
            {
                <section class="hc-quote-jobs">
                    <h2 class="hc-quote-jobs-title">@T("JobsOnQuotation")</h2>
                    @foreach (var job in linkedRequests)
                    {
                        <div class="hc-quote-job" @key="job.Id">
                            <div>
                                <span class="hc-quote-job-title">@GetJobTitle(job)</span>
                                <span class="hc-quote-job-meta">@job.RequestNumber · @LocalizationService.TranslateEnum(job.JobType)</span>
                            </div>
                            <a href="@($"/sales/requests/proof/{job.Id}")" target="_blank" rel="noopener">
                                @T("OpenApprovalProof")
                            </a>
                        </div>
                    }
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(quotation.Notes))
            {
                <section class="hc-quote-note-card">
                    <h2 class="hc-quote-block-title">@T("Notes")</h2>
                    <p class="hc-quote-note-text">@quotation.Notes</p>
                </section>
            }

            <footer class="hc-quote-footer">
                <p>@T("QuotationFooterMessage")</p>
                <span class="hc-quote-footer-ref">@T("QuotationNumber"): @quotation.QuotationNumber</span>
            </footer>
        </article>
    }
</div>

@code {
    [Parameter]
    public long Id { get; set; }

    private Quotation? quotation;
    private List<SalesRequest> linkedRequests = new();
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        quotation = null;
        linkedRequests.Clear();

        try
        {
            var result = await Db.Quotations
                .AsNoTracking()
                .Include(x => x.Customer)
                .Include(x => x.Lines)
                    .ThenInclude(x => x.Item)
                        .ThenInclude(x => x.Unit)
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (result is null)
            {
                Navigation.NavigateTo("/sales/quotations");
                return;
            }

            // Preserve the existing quotation approval/visibility workflow.
            var previewAllowed =
                result.Status == QuotationStatus.Approved ||
                result.Status == QuotationStatus.ReadyToSend ||
                result.Status == QuotationStatus.SentToCustomer ||
                result.Status == QuotationStatus.CustomerNegotiation ||
                result.Status == QuotationStatus.Accepted ||
                result.Status == QuotationStatus.Rejected;

            if (!previewAllowed)
            {
                Navigation.NavigateTo($"/sales/quotations/edit/{Id}");
                return;
            }

            quotation = result;
            var requestIds = quotation.Lines
                .Where(line => line.SourceRequestId.HasValue)
                .Select(line => line.SourceRequestId!.Value)
                .Append(quotation.SalesRequestId)
                .Distinct()
                .ToArray();

            linkedRequests = await Db.SalesRequests
                .AsNoTracking()
                .Where(job => requestIds.Contains(job.Id))
                .OrderBy(job => job.RequestDate)
                .ToListAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetRequestNumber(long id) =>
        linkedRequests.FirstOrDefault(x => x.Id == id)?.RequestNumber ?? $"#{id}";

    private static string GetJobTitle(SalesRequest job)
    {
        if (string.IsNullOrWhiteSpace(job.JobSpecificationJson))
            return job.RequestNumber;

        try
        {
            using var document = JsonDocument.Parse(job.JobSpecificationJson);
            if (document.RootElement.ValueKind == JsonValueKind.Object &&
                document.RootElement.TryGetProperty("JobTitle", out var title) &&
                title.ValueKind == JsonValueKind.String &&
                !string.IsNullOrWhiteSpace(title.GetString()))
                return title.GetString()!;
        }
        catch (JsonException)
        {
            // Older or malformed specification JSON must not break the quotation.
        }

        return job.RequestNumber;
    }

    private string T(string key) => LocalizationService[key];

    private string GetCustomerName() => quotation?.Customer?.Name ?? "—";

    private string FormatDate(DateTime value)
    {
        if (LocalizationService.IsPersian)
        {
            var calendar = new PersianCalendar();
            return $"{calendar.GetYear(value):0000}/{calendar.GetMonth(value):00}/{calendar.GetDayOfMonth(value):00}";
        }

        return value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private static string FormatAmount(decimal value) => value.ToString("N2", CultureInfo.CurrentCulture);

    private void BackToEditor() =>
        Navigation.NavigateTo($"/sales/quotations/edit/{Id}");

    private async Task PrintQuotation() =>
        await JS.InvokeVoidAsync("window.print");
}
