@page "/sales/quotations/preview/{Id:long}"

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Sales.Enums


@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

@inject IJSRuntime JS

<PageTitle>@T("QuotationPreview") - @quotation?.QuotationNumber</PageTitle>

<div class="container-fluid py-3 quotation-page">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <button class="btn btn-outline-secondary"
                @onclick="BackToEditor">
            &larr; @T("BackToQuotation")
        </button>

        <button class="btn btn-primary"
                @onclick="PrintQuotation">
            @T("PrintSavePdf")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 no-print">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">@T("Loading")</p>
        </div>
    }
    else if (quotation is null)
    {
        <div class="alert alert-warning no-print">
            @T("QuotationNotFound")
        </div>
    }
    else
    {
        <article class="quotation-document">
            <header class="document-header">
                <div>
                    <h1>@T("Quotation")</h1>
                    <p class="document-subtitle">
                        @T("QuotationPreview")
                    </p>
                </div>

                <div class="text-end quotation-number">
                    <div class="muted-label">@T("QuotationNumber")</div>
                    <strong>@quotation.QuotationNumber</strong>

                    <div class="mt-2">
                        <span class="status-label">
                            @T(quotation.Status.ToString())
                        </span>
                    </div>
                </div>
            </header>

            <hr />

            <section class="info-grid">
                <div>
                    <h2>@T("Customer")</h2>
                    <p class="info-value">
                        @quotation.Customer?.Name
                    </p>
                </div>

                <div>
                    <h2>@T("QuotationDate")</h2>
                    <p class="info-value">
                        @FormatDate(quotation.QuotationDate)
                    </p>
                </div>

                <div>
                    <h2>@T("ValidUntil")</h2>
                    <p class="info-value">
                        @(quotation.ValidUntil.HasValue
                            ? FormatDate(quotation.ValidUntil.Value)
                            : "—")
                    </p>
                </div>

                <div>
                    <h2>@T("EstimatedDeliveryDays")</h2>
                    <p class="info-value">
                        @(quotation.EstimatedDeliveryDays > 0
                            ? quotation.EstimatedDeliveryDays.ToString()
                            : "—")
                    </p>
                </div>
            </section>

            <section class="mt-4">
                <h2 class="section-heading">@T("QuotationItems")</h2>

                <div class="table-responsive">
                    <table class="table quotation-table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>@T("Item")</th>
                                <th>@T("Description")</th>
                                <th class="text-end">@T("Quantity")</th>
                                <th class="text-end">@T("UnitPrice")</th>
                                <th class="text-end">@T("TotalAmount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (quotation.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        @T("NoQuotationLines")
                                    </td>
                                </tr>
                            }

                            else
                            {
                                var rowNumber = 0;

                                foreach (var line in quotation.Lines)
                                {
                                    rowNumber++;

                                    <tr>
                                        <td class="text-center">@rowNumber</td>
                                        <td>
                                            @(line.Item?.Name ?? $"#{line.ItemId}")
                                        </td>
                                        <td>@line.Notes</td>
                                        <td class="text-end">
                                            @line.Quantity.ToString("N2")
                                        </td>
                                        <td class="text-end">
                                            @FormatAmount(line.UnitPrice)
                                        </td>
                                        <td class="text-end">
                                            @FormatAmount(line.TotalPrice)
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </section>

            <section class="totals-section">
                <div class="total-row">
                    <span>@T("MaterialCost")</span>
                    <span>@FormatAmount(quotation.MaterialCost)</span>
                </div>

                <div class="total-row">
                    <span>@T("ProductionCost")</span>
                    <span>@FormatAmount(quotation.ProductionCost)</span>
                </div>

                <div class="total-row grand-total">
                    <span>@T("TotalAmount")</span>
                    <span>@FormatAmount(quotation.FinalAmount)</span>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(quotation.Notes))
            {
                <section class="notes-section">
                    <h2 class="section-heading">@T("Notes")</h2>
                    <p class="notes-text">@quotation.Notes</p>
                </section>
            }

            <footer class="document-footer">
                <p>@T("QuotationFooterMessage")</p>
            </footer>
        </article>
    }
</div>

<style>
    .quotation-document {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px;
        background: white;
        color: #222;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .document-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
    }

        .document-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
        }

    .document-subtitle,
    .muted-label {
        color: #6b7280;
    }

    .quotation-number strong {
        font-size: 1.15rem;
    }

    .status-label {
        display: inline-block;
        padding: 4px 10px;
        border: 1px solid #d1d5db;
        border-radius: 20px;
        font-size: .85rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

        .info-grid h2,
        .section-heading {
            margin-bottom: 8px;
            font-size: 1rem;
            font-weight: 700;
        }

    .info-value {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .quotation-table {
        width: 100%;
        margin-top: 12px;
        border-collapse: collapse;
    }

        .quotation-table th,
        .quotation-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }

        .quotation-table thead th {
            background: #f3f4f6;
            font-weight: 700;
        }

    .totals-section {
        width: min(100%, 420px);
        margin: 24px 0 0 auto;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 8px 0;
    }

    .grand-total {
        margin-top: 6px;
        padding-top: 14px;
        border-top: 2px solid #222;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .notes-section {
        margin-top: 32px;
        overflow-wrap: anywhere;
    }

    .notes-text {
        white-space: pre-wrap;
    }

    .document-footer {
        margin-top: 60px;
        padding-top: 16px;
        border-top: 1px solid #e5e7eb;
        color: #6b7280;
        text-align: center;
        font-size: .9rem;
    }

    @@media print {
        @@page {
            size: A4;
            margin: 15mm;
        }

        body {
            background: white !important;
        }

        .no-print {
            display: none !important;
        }

        .quotation-page {
            padding: 0 !important;
            margin: 0 !important;
        }

        .quotation-document {
            max-width: none;
            margin: 0;
            padding: 0;
            border: 0;
            border-radius: 0;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .quotation-table thead {
            display: table-header-group;
        }

        .quotation-table tr {
            break-inside: avoid;
        }

        .notes-section,
        .totals-section {
            break-inside: avoid;
        }

        .quotation-table th {
            background: #f3f4f6 !important;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }
    }

    @@media (max-width: 640px) {
        .quotation-document {
            padding: 20px;
        }

        .document-header {
            flex-direction: column;
        }

        .quotation-number {
            text-align: start !important;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter]
    public long Id { get; set; }

    private Quotation? quotation;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        quotation = null;

        try
        {
            var result = await Db.Quotations
                .AsNoTracking()
                .Include(x => x.Customer)
                .Include(x => x.Lines)
                    .ThenInclude(x => x.Item)
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (result == null)
            {
                Navigation.NavigateTo("/sales/quotations");
                return;
            }

            var previewAllowed =
                result.Status == QuotationStatus.Approved ||
                result.Status == QuotationStatus.ReadyToSend ||
                result.Status == QuotationStatus.SentToCustomer ||
                result.Status == QuotationStatus.CustomerNegotiation ||
                result.Status == QuotationStatus.Accepted ||
                result.Status == QuotationStatus.Rejected;

            if (!previewAllowed)
            {
                Navigation.NavigateTo($"/sales/quotations/edit/{Id}");
                return;
            }

            quotation = result;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string T(string key)
        => LocalizationService[key];

    private string GetCustomerName()
    {
        if (quotation?.Customer is null)
            return "—";

        return quotation.Customer.ToString() ?? $"#{quotation.CustomerId}";
    }

    private static string FormatDate(DateTime date)
        => date.ToString("yyyy-MM-dd");

    private static string FormatAmount(decimal amount)
        => amount.ToString("N2");

    private void BackToEditor()
        => Navigation.NavigateTo($"/sales/quotations/edit/{Id}");

    private void PrintQuotation()
        => JS.InvokeVoidAsync("window.print");
}
