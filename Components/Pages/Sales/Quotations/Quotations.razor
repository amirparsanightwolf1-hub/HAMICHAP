@page "/sales/quotations"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SalesQuotations"]</PageTitle>

<div class="page-container">

    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">
                @LocalizationService["SalesQuotations"]
            </div>

            <div class="erp-page-subtitle">
                @LocalizationService["SalesQuotationsManagement"]
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @LocalizationService["Loading"]
                </span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <strong>
                    @LocalizationService["SalesQuotations"]
                </strong>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-responsive-cards">
                        <thead class="table-light">
                            <tr>
                                <th>@LocalizationService["QuotationNumber"]</th>
                                <th>@LocalizationService["Customer"]</th>
                                <th>@LocalizationService["QuotationDate"]</th>
                                <th>@LocalizationService["ValidUntil"]</th>
                                <th class="text-end">@LocalizationService["FinalAmount"]</th>
                                <th>@LocalizationService["Status"]</th>
                                <th style="width: 180px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (quotations.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        @LocalizationService["NoQuotationsFound"]
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var quotation in quotations)
                                {
                                    <tr @key="quotation.Id">
                                        <td class="fw-semibold">
                                            @quotation.QuotationNumber
                                        </td>

                                        <td>
                                            @(quotation.Customer?.Name ?? "-")
                                        </td>

                                        <td>
                                            @quotation.QuotationDate.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>
                                            @(quotation.ValidUntil.HasValue
                                                ? quotation.ValidUntil.Value.ToString("yyyy-MM-dd")
                                                : "-")
                                        </td>

                                        <td class="text-end fw-semibold">
                                            @quotation.FinalAmount.ToString("N2")
                                        </td>

                                        <td>
                                            <span class="badge @GetStatusClass(quotation.Status)">
                                                @LocalizationService.TranslateEnum(quotation.Status)
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => OpenQuotation(quotation.Id)">
                                                    <i class="bi bi-eye"></i>
                                                    @LocalizationService["Open"]
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => PreviewQuotation(quotation.Id)">
                                                    @LocalizationService["QuotationPreview"]
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-3 px-3 gap-2">

                        <div class="text-muted small">
                            @((currentPage - 1) * pageSize + 1)
                            -
                            @(Math.Min(currentPage * pageSize, totalCount))
                            /
                            @totalCount
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="PreviousPage"
                                    disabled="@(currentPage <= 1 || isLoading)">
                                @LocalizationService["Previous"]
                            </button>

                            <span class="small">
                                @currentPage / @totalPages
                            </span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="NextPage"
                                    disabled="@(currentPage >= totalPages || isLoading)">
                                @LocalizationService["Next"]
                            </button>
                        </div>

                    </div>
                }

            </div>
        </div>
    }
</div>

@code {
    private const int pageSize = 20;

    private List<Quotation> quotations = new();

    private bool isLoading = true;
    private string? errorMessage;

    private int currentPage = 1;
    private int totalCount;

    private int totalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(totalCount / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var query = Db.Quotations
                .AsNoTracking();

            totalCount = await query.CountAsync();

            if (totalPages > 0 && currentPage > totalPages)
            {
                currentPage = totalPages;
            }

            if (totalPages == 0)
            {
                currentPage = 1;
            }

            quotations = await query
                .Include(x => x.Customer)
                .OrderByDescending(x => x.QuotationDate)
                .ThenByDescending(x => x.Id)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            quotations = new();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1 || isLoading)
            return;

        currentPage--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages || isLoading)
            return;

        currentPage++;
        await LoadAsync();
    }

    private void OpenQuotation(long id)
    {
        Navigation.NavigateTo($"/sales/quotations/edit/{id}");
    }

    private void PreviewQuotation(long id)
    {
        Navigation.NavigateTo($"/sales/quotations/preview/{id}");
    }

    private static string GetStatusClass(QuotationStatus status)
    {
        return status switch
        {
            QuotationStatus.Draft =>
                "bg-secondary",

            QuotationStatus.PendingApproval =>
                "bg-warning text-dark",

            QuotationStatus.RevisionRequired =>
                "bg-danger",

            QuotationStatus.Approved =>
                "bg-primary",

            QuotationStatus.ReadyToSend =>
                "bg-info text-dark",

            QuotationStatus.SentToCustomer =>
                "bg-info text-dark",

            QuotationStatus.CustomerNegotiation =>
                "bg-warning text-dark",

            QuotationStatus.Accepted =>
                "bg-success",

            QuotationStatus.Rejected =>
                "bg-danger",

            QuotationStatus.Expired =>
                "bg-dark",

            QuotationStatus.Cancelled =>
                "bg-secondary",

            _ => "bg-secondary"
        };
    }
}