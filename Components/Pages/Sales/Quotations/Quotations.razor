@page "/sales/quotations"

@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SalesQuotations"]</PageTitle>

<div class="page-container">
    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">@LocalizationService["SalesQuotations"]</div>
            <div class="erp-page-subtitle">@LocalizationService["SalesQuotationsManagement"]</div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">@LocalizationService["Loading"]</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>@LocalizationService["SalesQuotations"]</strong>
            </div>

            <div class="card-body p-0">
                <div class="quotation-filters">
                    <div class="quotation-filter-field quotation-search-field">
                        <label for="quotationSearch">@LocalizationService["Search"]</label>
                        <input id="quotationSearch"
                               class="form-control"
                               type="search"
                               placeholder="@LocalizationService["QuotationSearchPlaceholder"]"
                               @bind="searchText"
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown" />
                    </div>

                    <div class="quotation-filter-field">
                        <label for="quotationJobType">@LocalizationService["JobType"]</label>
                        <select id="quotationJobType" class="form-select" @bind="selectedJobType">
                            <option value="">@LocalizationService["AllJobTypes"]</option>
                            @foreach (var jobType in Enum.GetValues<SalesJobType>())
                            {
                                <option value="@jobType">@LocalizationService.TranslateEnum(jobType)</option>
                            }
                        </select>
                    </div>

                    <div class="quotation-filter-field">
                        <label for="quotationFromDate">@LocalizationService["FromDateJalali"]</label>
                        <input id="quotationFromDate"
                               class="form-control"
                               type="text"
                               inputmode="numeric"
                               placeholder="@LocalizationService["JalaliDatePlaceholder"]"
                               @bind="fromJalaliDate" />
                    </div>

                    <div class="quotation-filter-field">
                        <label for="quotationToDate">@LocalizationService["ToDateJalali"]</label>
                        <input id="quotationToDate"
                               class="form-control"
                               type="text"
                               inputmode="numeric"
                               placeholder="@LocalizationService["JalaliDatePlaceholder"]"
                               @bind="toJalaliDate" />
                    </div>

                    <div class="quotation-filter-actions">
                        <button type="button" class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@isLoading">
                            <i class="bi bi-search"></i> @LocalizationService["Apply"]
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" disabled="@isLoading">
                            @LocalizationService["Clear"]
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(filterError))
                {
                    <div class="alert alert-warning mx-3 mt-2 mb-0">@filterError</div>
                }

                <div class="quotation-status-legend" aria-label="@LocalizationService["Status"]">
                    <span class="quotation-status-legend-title">@LocalizationService["Status"]:</span>
                    @foreach (var status in Enum.GetValues<QuotationStatus>())
                    {
                        <button type="button"
                                class="quotation-status-legend-item quotation-status-filter @(IsStatusSelected(status) ? "is-selected" : "")"
                                aria-pressed="@IsStatusSelected(status)"
                                title="@GetStatusFilterTitle(status)"
                                @onclick="() => ToggleStatusFilterAsync(status)">
                            <span class="quotation-status-dot @GetStatusCssClass(status)"></span>
                            @LocalizationService.TranslateEnum(status)
                            @if (IsStatusSelected(status))
                            {
                                <i class="bi bi-check-circle-fill quotation-status-filter-check"></i>
                            }
                        </button>
                    }
                </div>

                @if (quotations.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        @LocalizationService["NoQuotationsFound"]
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 table-responsive-cards sales-quotations-table">
                            <thead class="table-light">
                                <tr>
                                    <th>@LocalizationService["QuotationNumber"]</th>
                                    <th>@LocalizationService["Customer"]</th>
                                    <th>@LocalizationService["JobType"]</th>
                                    <th>@LocalizationService["JobTitle"]</th>
                                    <th>@LocalizationService["QuotationDate"]</th>
                                    <th>@LocalizationService["ValidUntil"]</th>
                                    <th class="text-end">@LocalizationService["FinalAmount"]</th>
                                    <th>@LocalizationService["Status"]</th>
                                    <th class="erp-width-190" ></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var quotation in quotations)
                                {
                                    <tr @key="quotation.Id"
                                        class="quotation-row @GetStatusCssClass(quotation.Status) @(expandedQuotationId == quotation.Id ? "is-expanded" : "")"
                                        role="button"
                                        tabindex="0"
                                        aria-expanded="@(expandedQuotationId == quotation.Id)"
                                        @onclick="() => ToggleDetails(quotation.Id)"
                                        @onkeydown="args => HandleRowKeyDown(args, quotation.Id)">
                                        <td class="fw-semibold">@quotation.QuotationNumber</td>
                                        <td>@(quotation.Customer?.Name ?? "-")</td>
                                        <td>
                                            @if (quotation.SalesRequest != null)
                                            {
                                                <span class="quotation-job-type-badge">@LocalizationService.TranslateEnum(quotation.SalesRequest.JobType)</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td><span class="quotation-job-title-cell">@GetJobTitle(quotation)</span></td>
                                        <td>@quotation.QuotationDate.ToString("yyyy-MM-dd")</td>
                                        <td>@(quotation.ValidUntil?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td class="text-end fw-semibold">@quotation.FinalAmount.ToString("N2")</td>
                                        <td>
                                            <span class="quotation-status-badge @GetStatusCssClass(quotation.Status)">
                                                <span class="quotation-status-dot"></span>
                                                @LocalizationService.TranslateEnum(quotation.Status)
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => OpenQuotation(quotation.Id)"
                                                        @onclick:stopPropagation="true">
                                                    <i class="bi bi-eye"></i>
                                                    @LocalizationService["Open"]
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => PreviewQuotation(quotation.Id)"
                                                        @onclick:stopPropagation="true">
                                                    @LocalizationService["QuotationPreview"]
                                                </button>
                                            </div>
                                        </td>
                                    </tr>

                                    @if (expandedQuotationId == quotation.Id)
                                    {
                                        <tr class="quotation-summary-row" @key="@($"quotation-summary-{quotation.Id}")">
                                            <td colspan="9">
                                                <div class="quotation-summary">
                                                    <div class="quotation-summary-section">
                                                        <div class="quotation-summary-heading">@LocalizationService["QuotationInformation"]</div>
                                                        <div class="quotation-summary-grid">
                                                            @SummaryItem(LocalizationService["QuotationNumber"], quotation.QuotationNumber)
                                                            @SummaryItem(LocalizationService["Customer"], quotation.Customer?.Name)
                                                            @SummaryItem(LocalizationService["QuotationDate"], quotation.QuotationDate.ToString("yyyy-MM-dd"))
                                                            @SummaryItem(LocalizationService["ValidUntil"], quotation.ValidUntil?.ToString("yyyy-MM-dd"))
                                                            @SummaryItem(LocalizationService["EstimatedDeliveryDays"], quotation.EstimatedDeliveryDays.ToString())
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(quotation.Notes))
                                                        {
                                                            <div class="quotation-summary-notes">
                                                                <span>@LocalizationService["Notes"]</span>
                                                                <strong>@quotation.Notes</strong>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="quotation-summary-section">
                                                        <div class="quotation-summary-heading">@LocalizationService["QuotationLines"]</div>
                                                        @if (quotation.Lines == null || quotation.Lines.Count == 0)
                                                        {
                                                            <div class="quotation-summary-empty">-</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-bordered align-middle mb-0 quotation-lines-summary">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@LocalizationService["Item"]</th>
                                                                            <th class="text-end">@LocalizationService["Quantity"]</th>
                                                                            <th class="text-end">@LocalizationService["UnitPrice"]</th>
                                                                            <th class="text-end">@LocalizationService["TotalPrice"]</th>
                                                                            <th>@LocalizationService["Notes"]</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var line in quotation.Lines)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <strong>@(line.Item?.Name ?? "-")</strong>
                                                                                    @if (!string.IsNullOrWhiteSpace(line.Item?.Code))
                                                                                    {
                                                                                        <small class="d-block text-muted">@line.Item.Code</small>
                                                                                    }
                                                                                </td>
                                                                                <td class="text-end">@line.Quantity.ToString("N2")</td>
                                                                                <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                                                                                <td class="text-end fw-semibold">@line.TotalPrice.ToString("N2")</td>
                                                                                <td>@(string.IsNullOrWhiteSpace(line.Notes) ? "-" : line.Notes)</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                    </div>

                                                    @if (quotation.SalesRequest != null)
                                                    {
                                                        <div class="quotation-summary-section">
                                                            <div class="quotation-summary-heading">
                                                                @LocalizationService["LinkedSalesRequest"] — @quotation.SalesRequest.RequestNumber
                                                            </div>
                                                            <div class="quotation-source-meta">
                                                                <span>@LocalizationService["JobType"]: <strong>@LocalizationService.TranslateEnum(quotation.SalesRequest.JobType)</strong></span>
                                                                <span>@LocalizationService["Status"]: <strong>@LocalizationService.TranslateEnum(quotation.SalesRequest.Status)</strong></span>
                                                                <span>@LocalizationService["RequestDate"]: <strong>@quotation.SalesRequest.RequestDate.ToString("yyyy-MM-dd")</strong></span>
                                                                <span>@LocalizationService["RequestedDeliveryDate"]: <strong>@(quotation.SalesRequest.RequestedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</strong></span>
                                                                <span>@LocalizationService["JobTitle"]: <strong>@GetJobTitle(quotation)</strong></span>
                                                            </div>
                                                            <div class="quotation-specification-grid">
                                                                @foreach (var detail in GetSpecificationSummary(quotation.SalesRequest.JobSpecificationJson))
                                                                {
                                                                    <div class="quotation-specification-item">
                                                                        <span class="quotation-specification-label">@detail.Label</span>
                                                                        <strong class="quotation-specification-value">@detail.Value</strong>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (totalPages > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-3 px-3 gap-2">
                        <div class="text-muted small">
                            @((currentPage - 1) * pageSize + 1) - @(Math.Min(currentPage * pageSize, totalCount)) / @totalCount
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="PreviousPage" disabled="@(currentPage <= 1 || isLoading)">
                                @LocalizationService["Previous"]
                            </button>
                            <span class="small">@currentPage / @totalPages</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="NextPage" disabled="@(currentPage >= totalPages || isLoading)">
                                @LocalizationService["Next"]
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private const int pageSize = 20;
    private List<Quotation> quotations = new();
    private List<Quotation> allFilteredQuotations = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? filterError;
    private int currentPage = 1;
    private int totalCount;
    private long? expandedQuotationId;

    private string searchText = "";
    private string? selectedJobType = "";
    private string fromJalaliDate = "";
    private string toJalaliDate = "";
    private HashSet<QuotationStatus> selectedStatuses = new();

    private int totalPages => totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)pageSize);
    private sealed record SpecificationSummaryItem(string Label, string Value);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        filterError = null;

        try
        {
            DateTime? fromDate = ParseJalaliDate(fromJalaliDate);
            DateTime? toDate = ParseJalaliDate(toJalaliDate);

            if (!string.IsNullOrWhiteSpace(fromJalaliDate) && fromDate == null)
                throw new InvalidOperationException(LocalizationService["InvalidJalaliFromDate"]);
            if (!string.IsNullOrWhiteSpace(toJalaliDate) && toDate == null)
                throw new InvalidOperationException(LocalizationService["InvalidJalaliToDate"]);
            if (fromDate.HasValue && toDate.HasValue && fromDate.Value.Date > toDate.Value.Date)
                throw new InvalidOperationException(LocalizationService["JalaliFromDateAfterToDate"]);

            var query = Db.Quotations.AsNoTracking();

            if (Enum.TryParse<SalesJobType>(selectedJobType, out var jobType))
                query = query.Where(x => x.SalesRequest.JobType == jobType);

            if (selectedStatuses.Count > 0)
                query = query.Where(x => selectedStatuses.Contains(x.Status));

            if (fromDate.HasValue)
                query = query.Where(x => x.QuotationDate >= fromDate.Value);

            if (toDate.HasValue)
            {
                var dayAfter = toDate.Value.Date.AddDays(1);
                query = query.Where(x => x.QuotationDate < dayAfter);
            }

            var filtered = await query
                .Include(x => x.Customer)
                .Include(x => x.SalesRequest)
                .Include(x => x.Lines).ThenInclude(x => x.Item)
                .OrderByDescending(x => x.QuotationDate)
                .ThenByDescending(x => x.Id)
                .ToListAsync();

            var term = searchText.Trim();
            if (!string.IsNullOrWhiteSpace(term))
            {
                filtered = filtered.Where(x =>
                    (x.QuotationNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Customer?.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.SalesRequest?.RequestNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    GetJobTitle(x).Contains(term, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            allFilteredQuotations = filtered;
            totalCount = allFilteredQuotations.Count;

            if (totalPages > 0 && currentPage > totalPages)
                currentPage = totalPages;
            if (totalPages == 0)
                currentPage = 1;

            quotations = allFilteredQuotations
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            quotations = new();
            allFilteredQuotations = new();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static DateTime? ParseJalaliDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var normalized = value.Trim()
            .Replace('-', '/')
            .Replace('.', '/')
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2')
            .Replace('۳', '3').Replace('۴', '4').Replace('۵', '5')
            .Replace('۶', '6').Replace('۷', '7').Replace('۸', '8')
            .Replace('۹', '9')
            .Replace('٠', '0').Replace('١', '1').Replace('٢', '2')
            .Replace('٣', '3').Replace('٤', '4').Replace('٥', '5')
            .Replace('٦', '6').Replace('٧', '7').Replace('٨', '8')
            .Replace('٩', '9');

        var parts = normalized.Split('/');
        if (parts.Length != 3 ||
            !int.TryParse(parts[0], out var year) ||
            !int.TryParse(parts[1], out var month) ||
            !int.TryParse(parts[2], out var day))
            return null;

        try
        {
            return new PersianCalendar().ToDateTime(year, month, day, 0, 0, 0, 0);
        }
        catch (ArgumentOutOfRangeException)
        {
            return null;
        }
    }

    private bool IsStatusSelected(QuotationStatus status) =>
        selectedStatuses.Count == 0 || selectedStatuses.Contains(status);

    private string GetStatusFilterTitle(QuotationStatus status) =>
        selectedStatuses.Count == 0
            ? $"{LocalizationService["FilterByStatus"]}: {LocalizationService.TranslateEnum(status)}"
            : selectedStatuses.Contains(status)
                ? $"{LocalizationService["ShowingStatusClickToRemove"]}: {LocalizationService.TranslateEnum(status)}"
                : $"{LocalizationService["AddStatusToFilter"]}: {LocalizationService.TranslateEnum(status)}";

    private async Task ToggleStatusFilterAsync(QuotationStatus status)
    {
        if (selectedStatuses.Count == 0)
            selectedStatuses.Add(status);
        else if (!selectedStatuses.Add(status))
            selectedStatuses.Remove(status);

        currentPage = 1;
        expandedQuotationId = null;
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage = 1;
        expandedQuotationId = null;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        searchText = "";
        selectedJobType = "";
        fromJalaliDate = "";
        toJalaliDate = "";
        selectedStatuses.Clear();
        currentPage = 1;
        expandedQuotationId = null;
        await LoadAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ApplyFiltersAsync();
    }

    private void ToggleDetails(long id) =>
        expandedQuotationId = expandedQuotationId == id ? null : id;

    private void HandleRowKeyDown(KeyboardEventArgs args, long id)
    {
        if (args.Key is "Enter" or " ")
            ToggleDetails(id);
    }

    private RenderFragment SummaryItem(string label, string? value) => builder =>
    {
        if (string.IsNullOrWhiteSpace(value)) value = "-";
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "quotation-summary-item");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", "quotation-summary-label");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "strong");
        builder.AddAttribute(6, "class", "quotation-summary-value");
        builder.AddContent(7, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string GetJobTitle(Quotation quotation)
    {
        var json = quotation.SalesRequest?.JobSpecificationJson;
        try
        {
            using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(json) ? "{}" : json);
            return doc.RootElement.TryGetProperty("JobTitle", out var title) &&
                   title.ValueKind == JsonValueKind.String &&
                   !string.IsNullOrWhiteSpace(title.GetString())
                ? title.GetString()! : "-";
        }
        catch { return "-"; }
    }

    private static List<SpecificationSummaryItem> GetSpecificationSummary(string? json)
    {
        var result = new List<SpecificationSummaryItem>();
        try
        {
            using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(json) ? "{}" : json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object) return result;

            foreach (var property in doc.RootElement.EnumerateObject())
            {
                if (property.Name is "JobTitle" or "FinishedProductItemId" or
                    "ArtworkRelativePath" or "ArtworkOriginalFileName" or "ArtworkFiles" or "Referrer")
                    continue;

                AddSummary(result, property.Name, FormatJsonValue(property.Value));
            }

            if (doc.RootElement.TryGetProperty("WorkflowFields", out var workflow) &&
                workflow.ValueKind == JsonValueKind.Object)
            {
                foreach (var property in workflow.EnumerateObject())
                    AddSummary(result, property.Name, FormatJsonValue(property.Value));
            }
        }
        catch
        {
            // Keep quotation list usable if an older linked request contains malformed JSON.
        }
        return result;
    }

    private static void AddSummary(List<SpecificationSummaryItem> result, string name, string value)
    {
        if (string.IsNullOrWhiteSpace(value) || value is "—" or "No" or "false" or "False")
            return;
        result.Add(new SpecificationSummaryItem(Humanize(name), value));
    }

    private static string FormatJsonValue(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString()?.Trim() ?? "",
        JsonValueKind.Number => value.ToString(),
        JsonValueKind.True => "Yes",
        JsonValueKind.False => "No",
        JsonValueKind.Array => string.Join(", ", value.EnumerateArray()
            .Select(FormatJsonValue).Where(x => !string.IsNullOrWhiteSpace(x) && x != "No")),
        JsonValueKind.Object => string.Join(", ", value.EnumerateObject()
            .Select(x => $"{Humanize(x.Name)}: {FormatJsonValue(x.Value)}")
            .Where(x => !x.EndsWith(": "))),
        _ => ""
    };

    private static string Humanize(string name)
    {
        var spaced = Regex.Replace(name, "([a-z0-9])([A-Z])", "$1 $2");
        return spaced switch
        {
            "Cut Length Cm" => "Cut length (cm)",
            "Cut Width Cm" => "Cut width (cm)",
            "Before Cut Length Cm" => "Before-cut length (cm)",
            "Before Cut Width Cm" => "Before-cut width (cm)",
            "Label Pull" => "Label pull",
            "Label Width" => "Label width",
            "Gap Between Labels" => "Gap between labels",
            "Print Run Sheets" => "Print run (sheets)",
            "Sheet Count" => "Sheet count",
            "Color Count" => "Color count",
            "Roll Diameter" => "Roll diameter",
            _ => spaced
        };
    }

    private static string GetStatusCssClass(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => "status-draft",
        QuotationStatus.PendingApproval => "status-pending",
        QuotationStatus.RevisionRequired => "status-revision",
        QuotationStatus.Approved => "status-approved",
        QuotationStatus.ReadyToSend => "status-ready",
        QuotationStatus.SentToCustomer => "status-sent",
        QuotationStatus.CustomerNegotiation => "status-negotiation",
        QuotationStatus.Accepted => "status-accepted",
        QuotationStatus.Rejected => "status-rejected",
        QuotationStatus.Expired => "status-expired",
        QuotationStatus.Cancelled => "status-cancelled",
        _ => "status-unknown"
    };

    private async Task PreviousPage()
    {
        if (currentPage <= 1 || isLoading) return;
        currentPage--;
        expandedQuotationId = null;
        quotations = allFilteredQuotations.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages || isLoading) return;
        currentPage++;
        expandedQuotationId = null;
        quotations = allFilteredQuotations.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void OpenQuotation(long id) =>
        Navigation.NavigateTo($"/sales/quotations/edit/{id}");

    private void PreviewQuotation(long id) =>
        Navigation.NavigateTo($"/sales/quotations/preview/{id}");
}
