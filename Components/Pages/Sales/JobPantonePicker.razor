@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Services
@inject LocalizationService LocalizationService

<section class="roll-pantone-panel" aria-label="@LocalizationService["RollPantoneColors"]">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <strong>@LocalizationService["RollPantoneColors"]</strong>
        <span class="text-muted small">@LocalizationService["RollPantoneMultipleHint"]</span>
    </div>
    <div class="roll-pantone-inputs">
        <div>
            <label class="form-label" for="@(IdPrefix + "-code")">@LocalizationService["RollPantoneReference"]</label>
            <input id="@(IdPrefix + "-code")" type="text" class="form-control" maxlength="64"
                   @bind="code" @bind:event="oninput" @onkeydown="HandleKey"
                   placeholder="@T("Optional Pantone reference", "کد پنتون اختیاری")" />
        </div>
        <div>
            <label class="form-label" for="@(IdPrefix + "-color")">CMYK</label>
            <input id="@(IdPrefix + "-color")" type="color" class="form-control form-control-color roll-pantone-picker"
                   @bind="hex" />
        </div>
        <button type="button" class="btn btn-outline-primary roll-pantone-add" @onclick="AddAsync">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> @LocalizationService["RollPantoneAdd"]
        </button>
    </div>
    @if (error is not null)
    {
        <div class="text-danger small mt-2" role="alert">@error</div>
    }
    <div class="small text-muted mt-2">@T("Screen colour is converted to approximate CMYK automatically.", "رنگ صفحه به صورت خودکار به CMYK تقریبی تبدیل می‌شود.")</div>
    @if (Colors.Count > 0)
    {
        <ul class="roll-pantone-list">
            @foreach (var color in Colors)
            {
                <li class="roll-pantone-entry" @key="color">
                    <span class="roll-pantone-swatch" style="@($"background-color:{color.SafeHex}")" aria-hidden="true"></span>
                    <span class="roll-pantone-name">@color.Code</span>
                    <span class="roll-pantone-hex" dir="ltr">@InkLabel(color)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(color)" aria-label="@LocalizationService["Edit"]">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAsync(color)" aria-label="@LocalizationService["RollPantoneRemove"]">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public List<RollPantoneColor> Colors { get; set; } = new();
    [Parameter, EditorRequired] public string IdPrefix { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }

    private string code = "";
    private string hex = "#DB2635";
    private string? error;
    private RollPantoneColor? editing;
    private string T(string en, string fa) => LocalizationService.IsPersian ? fa : en;
    private static string InkLabel(RollPantoneColor c) => $"C{c.Cyan} M{c.Magenta} Y{c.Yellow} K{c.Black}";
    private static string AutomaticName(RollPantoneColor c) => "CMYK " + InkLabel(c);

    private void Edit(RollPantoneColor color)
    {
        editing = color;
        code = color.Code == AutomaticName(color) ? "" : color.Code;
        hex = color.SafeHex;
        error = null;
    }

    private async Task HandleKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await AddAsync();
    }

    private async Task AddAsync()
    {
        error = null;
        if (!RollPantoneColor.IsValidHex(hex)) return;
        var sampled = new RollPantoneColor { Hex = hex };
        if (editing is not null && string.Equals(hex, editing.SafeHex, StringComparison.OrdinalIgnoreCase))
        {
            sampled.Cyan = editing.Cyan; sampled.Magenta = editing.Magenta;
            sampled.Yellow = editing.Yellow; sampled.Black = editing.Black;
        }
        sampled.EnsureCmyk();
        var reference = string.IsNullOrWhiteSpace(code) ? AutomaticName(sampled) : code.Trim();
        if (reference.Length < 2 || reference.Length > 64)
        {
            error = LocalizationService["RollPantoneInvalidReference"];
            return;
        }
        var existing = Colors.FirstOrDefault(x => string.Equals(x.Code, reference, StringComparison.OrdinalIgnoreCase));
        if (editing is not null && existing is not null && existing != editing)
        {
            error = T("This colour is already selected.", "این رنگ قبلاً انتخاب شده است.");
            return;
        }
        var color = editing ?? existing;
        if (color is null)
        {
            if (Colors.Count >= 24) { error = LocalizationService["RollPantoneLimit"]; return; }
            color = new RollPantoneColor();
            Colors.Add(color);
        }
        color.Code = reference;
        color.Cyan = sampled.Cyan; color.Magenta = sampled.Magenta;
        color.Yellow = sampled.Yellow; color.Black = sampled.Black;
        color.Hex = color.SafeHex;
        editing = null;
        code = "";
        await Changed.InvokeAsync();
    }

    private async Task RemoveAsync(RollPantoneColor color)
    {
        Colors.Remove(color);
        if (editing == color) { editing = null; code = ""; }
        error = null;
        await Changed.InvokeAsync();
    }
}
