@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Services

@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

@* Parent editors run the lookup. This component only renders its results:
   querying the shared scoped DbContext in OnParametersSetAsync can overlap
   with the parent's @bind-Value:after callback and break the Blazor circuit. *@
@if (Matches.Count > 0)
{
    <div class="alert alert-info mb-2">
        <div class="fw-semibold mb-2">
            @LocalizationService["MatchingExistingJobFound"]
        </div>
        <div class="small mb-2">@LocalizationService["OpenExistingJobInsteadOfDuplicate"]</div>
        @foreach (var match in Matches)
        {
            <div class="d-flex align-items-center justify-content-between gap-2 border-top py-2" @key="match.Id">
                <div class="text-break">
                    <strong>@match.RequestNumber</strong>
                    <small class="text-muted ms-2">@LocalizationService.TranslateEnum(match.Status)</small>
                </div>
                <button type="button" class="btn btn-sm btn-primary"
                        @onclick="() => OpenExisting(match.Id)">
                    @LocalizationService["LoadExistingJob"]
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ExistingSalesJobLookup.Match> Matches { get; set; } =
        Array.Empty<ExistingSalesJobLookup.Match>();

    [Parameter] public SalesJobType JobType { get; set; }
    [Parameter] public long? TargetQuotationId { get; set; }

    private void OpenExisting(long id)
    {
        // Do not navigate if an old button/event no longer matches the results.
        if (!Matches.Any(match => match.Id == id))
            return;

        var kind = JobType == SalesJobType.Roll ? "roll" : "sheet";
        var url = $"/sales/requests/{kind}/edit/{id}";
        if (TargetQuotationId.HasValue)
            url += $"?quotationId={TargetQuotationId.Value}";

        Navigation.NavigateTo(url);
    }
}
