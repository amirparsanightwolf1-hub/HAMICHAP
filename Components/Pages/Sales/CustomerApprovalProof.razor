                    </div>

                    @if (request.JobType == SalesJobType.Roll)
                    {
                        <div class="proof-panel">
                            <div class="proof-panel-title">@LocalizationService["SelectedServices"]</div>
                            <div class="proof-panel-body">
                                <div class="proof-service-groups">
