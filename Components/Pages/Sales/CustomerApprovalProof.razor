@page "/sales/requests/proof/{RequestId:long}"
@using System.Text.Json
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService
@inject IJSRuntime JS


<HeadContent>
    <link rel="stylesheet" href="css/customerProofPrint.css" />
</HeadContent>

<div class="page-container proof-page">
    <div class="erp-page-header mb-3 no-print">
        <div>
            <div class="erp-page-title">@LocalizationService["CustomerApprovalProof"]</div>
            <div class="erp-page-subtitle">@LocalizationService["ReviewProofPrintSavePdf"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" @onclick="BackToJob">
                @LocalizationService["BackToJob"]
            </button>
            <button class="btn btn-outline-primary" @onclick="ContinueSalesWorkflow">
                @LocalizationService["ContinueSalesWorkflow"]
            </button>
            <button class="btn btn-primary" @onclick="PrintProof">
                <i class="bi bi-printer"></i> @LocalizationService["PrintSaveAsPdf"]
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5"><span class="spinner-border"></span></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (request is not null)
    {
        <article class="proof-sheet @(request.JobType == SalesJobType.Sheet ? "sheet-proof" : "")" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
            <header class="proof-card-header">
                <div class="d-flex align-items-center gap-3">
                    <img class="proof-logo" src="/images/Logo%20Wings%20navy%20blue.png" alt="HamiChap logo" />
                    <div>
                        <div class="proof-brand">HAMI CHAP</div>
                        <div class="proof-brand-subtitle">@LocalizationService["PrintingPackagingCustomerApproval"]</div>
                    </div>
                </div>
                <div class="proof-header-meta">
                    <div><strong>@LocalizationService[request.JobType == SalesJobType.Roll ? "RollJobUpper" : "SheetJobUpper"]</strong></div>
                    <div>@LocalizationService["Date"]: <strong>@request.RequestDate.ToString("yyyy/MM/dd")</strong></div>
                    <div>@LocalizationService["ProofNumber"]: <strong>@request.RequestNumber</strong></div>
                </div>
            </header>

            <div class="proof-columns">
                @* LEFT: ARTWORK AND ROLL ORIENTATION *@
                <section class="proof-left-column" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
                    <div class="proof-panel proof-artwork-panel">
                        <div class="proof-panel-title">@LocalizationService["ArtworkPreview"]</div>
                        <div class="proof-panel-body">
                            @if (artworkFiles.Count > 0)
                            {
                                <div class="proof-artwork-frame">
                                    <div class="proof-artwork-grid count-@(Math.Min(artworkFiles.Count, 4))">
                                        @foreach (var art in artworkFiles)
                                        {
                                            <div class="proof-artwork-card @(IsPdf(art.RelativePath) ? "proof-pdf-card" : "")">
                                                @if (IsImage(art.RelativePath))
                                                {
                                                    <img src="@art.RelativePath" alt="Artwork preview" />
                                                }
                                                else if (IsPdf(art.RelativePath))
                                                {
                                                    <PdfPagePreview Url="@art.RelativePath" />
                                                }
                                                else
                                                {
                                                    <div class="text-center py-3">
                                                        <i class="bi bi-file-earmark erp-proof-heading-icon" ></i>
                                                        <div><a href="@art.RelativePath" target="_blank" rel="noopener">@LocalizationService["OpenFile"]</a></div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="proof-artwork-frame">
                                    <div class="proof-artwork-empty">
                                        <i class="bi bi-image erp-icon-2rem" ></i>
                                        <strong>@LocalizationService["ArtworkNotUploaded"]</strong>
                                    </div>
                                </div>
                            }

                            @if (request.JobType == SalesJobType.Roll)
                            {
                                <div class="proof-dimensions">@DimensionsSummary</div>
                            }
                            else
                            {
                                <div class="proof-dimensions">@DimensionsBeforeCutSummary</div>
                                <div class="proof-dimensions">@DimensionsAfterCutSummary</div>
                            }
                        </div>
                    </div>

                    @if (request.JobType == SalesJobType.Roll)
                    {
                        <div class="proof-panel">
                            <div class="proof-panel-title">@LocalizationService["SelectedRollOrientation"]</div>
                            <div class="proof-roll-orientation">
                                @if (int.TryParse(rollOrientation, out var orientationNumber) && orientationNumber >= 1 && orientationNumber <= 8)
                                {
                                    <img src="@($"/images/roll-orientations/orientation-{orientationNumber}.jpg")"
                                         alt="@RollOrientationLabel" />
                                }
                                else
                                {
                                    <span class="proof-muted">@LocalizationService["NoRollOrientationSelected"]</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(rollOrientation))
                            {
                                <div class="proof-panel-body text-center proof-muted">@RollOrientationLabel</div>
                            }
                        </div>
                    }

                    <div class="proof-panel">
                        <div class="proof-panel-title">@LocalizationService["ProductionNotes"]</div>
                        <div class="proof-panel-body proof-notes">
                            @(string.IsNullOrWhiteSpace(PrintingNotes) ? "—" : PrintingNotes)
                        </div>
                    </div>
                </section>

                @* RIGHT: PRESS-CARD DETAILS *@
                <section class="proof-right-column" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
                    <div class="proof-panel">
                        <div class="proof-panel-title">@LocalizationService["CustomerJobDetails"]</div>
                        <div class="proof-panel-body">
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["Customer"]</span>
                                <strong class="proof-kv-value">@(request.Customer?.Name ?? "—")</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["JobTitle"]</span>
                                <strong class="proof-kv-value">@Empty(JobTitle)</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["JobType"]</span>
                                <strong class="proof-kv-value">@LocalizationService[request.JobType == SalesJobType.Roll ? "RollLabel" : "SheetProduct"]</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["RequestNumber"]</span>
                                <strong class="proof-kv-value">@request.RequestNumber</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["Date"]</span>
                                <strong class="proof-kv-value">@request.RequestDate.ToString("yyyy/MM/dd")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="proof-panel">
                        <div class="proof-panel-title">@LocalizationService["TechnicalSpecifications"]</div>
                        <div class="proof-panel-body">
                            @if (request.JobType == SalesJobType.Roll)
                            {
                                @foreach (var item in technicalDetails)
                                {
                                    <div class="proof-kv">
                                        <span class="proof-kv-label">@item.Key</span>
                                        <strong class="proof-kv-value">@item.Value</strong>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="proof-technical-grid">
                                    @foreach (var item in technicalDetails)
                                    {
                                        <div class="proof-kv">
                                            <span class="proof-kv-label">@item.Key</span>
                                            <strong class="proof-kv-value">@item.Value</strong>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="proof-panel">
                        <div class="proof-panel-title">@LocalizationService["PrintingColorsFrontBack"]</div>
                        <div class="proof-panel-body">
                            <div class="proof-two-col">
                                <div>
                                    <div class="proof-muted mb-1">@LocalizationService["FrontSide"]</div>
                                    <div class="proof-cmyk-grid">
                                        @foreach (var color in CmykColors)
                                        {
                                            <div class="proof-cmyk-chip @(IsCmykSelected("front", color.Key) ? "active" : "")">
                                                <div class="proof-cmyk-swatch" style="@($"background:{color.Value};color:{CmykTextColor(color.Key)}")">@color.Key</div>
                                                <div class="proof-cmyk-name">@LocalizationService[color.ValueName]</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <div class="proof-muted mb-1">@LocalizationService["BackSide"]</div>
                                    <div class="proof-cmyk-grid">
                                        @foreach (var color in CmykColors)
                                        {
                                            <div class="proof-cmyk-chip @(IsCmykSelected("back", color.Key) ? "active" : "")">
                                                <div class="proof-cmyk-swatch" style="@($"background:{color.Value};color:{CmykTextColor(color.Key)}")">@color.Key</div>
                                                <div class="proof-cmyk-name">@LocalizationService[color.ValueName]</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="proof-muted mt-2">@LocalizationService["HighlightedTilesExplain"]</div>
                        </div>
                    </div>

                    @if (request.JobType == SalesJobType.Roll)
                    {
                        <div class="proof-panel">
                            <div class="proof-panel-title">@LocalizationService["SelectedServices"]</div>
                            <div class="proof-panel-body">
                                <div class="proof-service-groups">
                                    @foreach (var group in RollServiceGroups)
                                    {
                                        <section>
                                            <div class="proof-service-group-title">@LocalizationService[group.TitleKey]</div>
                                            <div class="proof-service-list">
                                                @foreach (var service in group.Services)
                                                {
                                                    var selected = IsServiceSelected(service.Value);
                                                    <div class="proof-service @(selected ? "is-selected" : "is-not-selected")">
                                                        <span class="proof-service-indicator">@(selected ? "✓" : "")</span>
                                                        <span>@LocalizationService[service.LabelKey]</span>
                                                    </div>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="proof-panel">
                            <div class="proof-panel-title">@LocalizationService["SelectedServices"]</div>
                            <div class="proof-panel-body">
                                <div class="proof-service-groups">
                                    @foreach (var group in SheetServiceGroups)
                                    {
                                        <section>
                                            <div class="proof-service-group-title">@LocalizationService[group.TitleKey]</div>
                                            <div class="proof-service-list">
                                                @foreach (var service in group.Services)
                                                {
                                                    var selected = IsServiceSelected(service.Value);
                                                    <div class="proof-service @(selected ? "is-selected" : "is-not-selected")">
                                                        <span class="proof-service-indicator">@(selected ? "✓" : "")</span>
                                                        <span>@service.LabelKey</span>
                                                    </div>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                </section>
            </div>

            <div class="proof-panel proof-approval">
                <div class="proof-panel-title">@LocalizationService["CustomerApproval"]</div>
                <div class="proof-panel-body">
                    <div class="proof-approval-fields">
                        <div class="proof-approval-line">@LocalizationService["ApprovedBy"]: ____________________</div>
                        <div class="proof-approval-line">@LocalizationService["Date"]: ____________________</div>
                        <div class="proof-approval-line">@LocalizationService["Signature"]: ____________________</div>
                    </div>
                </div>
            </div>

            <footer class="proof-footer">
                <span>@LocalizationService["CustomerApprovalCopy"]</span>
                <span>@LocalizationService["ReviewDimensionsArtworkFinishing"]</span>
            </footer>
        </article>
    }
</div>


@code {
    [Parameter] public long RequestId { get; set; }
    private HamiChap_MES_ERP.Models.Sales.SalesRequest? request;
    private bool isLoading = true;
    private string? errorMessage;
    private string artworkPath = "";
    private string artworkFileName = "";
    private string rollOrientation = "";
    private HashSet<string> frontCmyk = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> backCmyk = new(StringComparer.OrdinalIgnoreCase);
    private string frontPantoneColors = "";
    private string backPantoneColors = "";
    private string mixedFrontColors = "";
    private string mixedBackColors = "";
    private string finishType = "";
    private string plateProvider = "";
    private List<JobArtworkFile> artworkFiles = new();
    private static readonly (string Key, string Value, string ValueName)[] CmykColors =
    {
        ("C", "#00A9E8", "CmykCyan"),
        ("M", "#E6007E", "CmykMagenta"),
        ("Y", "#F2CC00", "CmykYellow"),
        ("K", "#202124", "CmykBlack")
    };
    private string JobTitle = "";
    private string PrintingNotes = "";
    private string DimensionsSummary = "";
    private string DimensionsBeforeCutSummary = "";
    private string DimensionsAfterCutSummary = "";
    private List<KeyValuePair<string, string>> technicalDetails = new();
    private List<string> selectedServices = new();


    private sealed record ProofServiceGroup(
        string TitleKey,
        (string Value, string LabelKey)[] Services);

    private static readonly ProofServiceGroup[] RollServiceGroups =
    {
        new("ServiceGroupUvCoating", new[]
        {
            ("یووی روتاری", "ServiceUvRotary"),
            ("یووی برجسته", "ServiceUvEmbossed"),
            ("یووی تخت", "ServiceUvFlat"),
            ("یووی موضعی", "ServiceUvSpot")
        }),
        new("ServiceGroupLamination", new[]
        {
            ("سلفون مات", "ServiceMatteLamination"),
            ("سلفون براق", "ServiceGlossLamination")
        }),
        new("ServiceGroupFoilStamping", new[]
        {
            ("طلاکوب روتاری", "ServiceRotaryFoil"),
            ("طلاکوب تخت", "ServiceFlatFoil"),
            ("رنگ فویل", "ServiceFoilColor")
        }),
        new("ServiceGroupEmbossingDie", new[]
        {
            ("قالب روتاری", "ServiceRotaryDie"),
            ("قالب تخت", "ServiceFlatDie"),
            ("دیلن میلن", "ServiceDylanMilan")
        })
    };

    private static readonly ProofServiceGroup[] SheetServiceGroups =
    {
        new("ServiceGroupLamination", new[]
        {
            ("سلفون واتربیس مات", "سلفون واتربیس مات"),
            ("سلفون واتربیس براق", "سلفون واتربیس براق"),
            ("سلفون حرارتی مات", "سلفون حرارتی مات"),
            ("سلفون حرارتی براق", "سلفون حرارتی براق"),
            ("سلفون حرارتی متالایز", "سلفون حرارتی متالایز")
        }),
        new("ServiceGroupUvCoating", new[]
        {
            ("یووی موضعی", "یووی موضعی")
        }),
        new("ServiceGroupFoilStamping", new[]
        {
            ("طلاکوب", "طلاکوب"),
            ("نقره‌کوب", "نقره‌کوب"),
            ("رنگ فویل", "رنگ فویل")
        }),
        new("ServiceGroupEmbossingDie", new[]
        {
            ("برجسته", "برجسته"),
            ("قالب", "قالب")
        }),
        new("ServiceGroupGluingCuttingPackaging", new[]
        {
            ("جعبه‌چسبانی", "جعبه‌چسبانی"),
            ("برش و بسته‌بندی", "برش و بسته‌بندی")
        })
    };

    private bool IsServiceSelected(string storedValue) =>
        selectedServices.Contains(storedValue, StringComparer.OrdinalIgnoreCase);

    private string RollOrientationLabel =>
        int.TryParse(rollOrientation, out var n) && n is >= 1 and <= 8
            ? $"{LocalizationService["RollOrientationOption"]} {n}"
            : LocalizationService["NoRollOrientationSelected"];

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; errorMessage = null;
        DimensionsSummary = LocalizationService["DimensionsNotSpecified"];
        request = await Db.SalesRequests.Include(x => x.Customer).FirstOrDefaultAsync(x => x.Id == RequestId);
        if (request is null) { errorMessage = LocalizationService["SalesRequestNotFound"]; isLoading = false; return; }
        try
        {
            if (request.JobType == SalesJobType.Roll)
            {
                var spec = JsonSerializer.Deserialize<RollJobSpecification>(request.JobSpecificationJson ?? "{}") ?? new();
                JobTitle = spec.JobTitle; PrintingNotes = spec.PrintingNotes;
                artworkPath = spec.ArtworkRelativePath; artworkFileName = spec.ArtworkOriginalFileName;
                artworkFiles = spec.ArtworkFiles ?? new();
                if (artworkFiles.Count == 0 && !string.IsNullOrWhiteSpace(artworkPath))
                    artworkFiles.Add(new JobArtworkFile { RelativePath = artworkPath, OriginalFileName = artworkFileName });
                rollOrientation = spec.RollOrientation ?? "";
                LoadCmykSelections(request.JobSpecificationJson);
                DimensionsSummary = $"{LocalizationService["LabelPull"]}: {Fmt(spec.LabelPull)} mm · {LocalizationService["LabelWidth"]}: {Fmt(spec.LabelWidth)} mm · {LocalizationService["Gap"]}: {Fmt(spec.GapBetweenLabels)} mm";
                technicalDetails = new() {
                    new(LocalizationService["Material"], Empty(spec.PaperType)), new(LocalizationService["Colors"], spec.ColorCount?.ToString() ?? "—"),
                    new(LocalizationService["RollDiameter"], spec.RollDiameter.HasValue ? Fmt(spec.RollDiameter) + " mm" : "—"),
                    new(LocalizationService["LabelQuantity"], spec.LabelQuantity?.ToString("N0") ?? "—"),
                    new(LocalizationService["HandGluing"], spec.HandGluing ? LocalizationService["Yes"] : LocalizationService["No"]), new(LocalizationService["MachineGluing"], spec.MachineGluing ? LocalizationService["Yes"] : LocalizationService["No"])
                };
                selectedServices = spec.SelectedServices ?? new();
            }
            else
            {
                var spec = JsonSerializer.Deserialize<SheetJobSpecification>(request.JobSpecificationJson ?? "{}") ?? new();
                JobTitle = spec.JobTitle; PrintingNotes = spec.PrintingNotes;
                artworkPath = spec.ArtworkRelativePath; artworkFileName = spec.ArtworkOriginalFileName;
                artworkFiles = spec.ArtworkFiles ?? new();
                if (artworkFiles.Count == 0 && !string.IsNullOrWhiteSpace(artworkPath))
                    artworkFiles.Add(new JobArtworkFile { RelativePath = artworkPath, OriginalFileName = artworkFileName });
                DimensionsBeforeCutSummary = $"{LocalizationService["BeforeCutDimensions"]}: {LocalizationService["DimensionWidth"]} {Fmt(spec.BeforeCutWidthCm)} × {LocalizationService["DimensionLength"]} {Fmt(spec.BeforeCutLengthCm)} cm";
                DimensionsAfterCutSummary = $"{LocalizationService["AfterCutDimensions"]}: {LocalizationService["DimensionWidth"]} {Fmt(spec.CutWidthCm)} × {LocalizationService["DimensionLength"]} {Fmt(spec.CutLengthCm)} cm";
                LoadCmykSelections(request.JobSpecificationJson);
                frontPantoneColors = ReadJsonStringProperty(request.JobSpecificationJson, "FrontPantoneColors");
                backPantoneColors = ReadJsonStringProperty(request.JobSpecificationJson, "BackPantoneColors");
                mixedFrontColors = ReadJsonStringProperty(request.JobSpecificationJson, "MixedFrontColors");
                mixedBackColors = ReadJsonStringProperty(request.JobSpecificationJson, "MixedBackColors");
                finishType = ReadJsonStringProperty(request.JobSpecificationJson, "FinishType");
                plateProvider = ReadJsonStringProperty(request.JobSpecificationJson, "PlateProvider");
                technicalDetails = new() {
                    new(LocalizationService["Paper"], Empty(spec.PaperType)),
                    new(LocalizationService["Grammage"], spec.Grammage.HasValue ? spec.Grammage + " gsm" : "—"),
                    new(LocalizationService["PrintRun"], spec.PrintRunSheets?.ToString("N0") ?? "—"),
                    new(LocalizationService["SheetCount"], spec.SheetCount?.ToString("N0") ?? "—"),
                    new(LocalizationService["ZincPlate"], Empty(spec.Zinc)),
                    new(LocalizationService["Die"], Empty(spec.Die)),
                    new(LocalizationService["Cliche"], Empty(spec.Cliche)),
                    new(LocalizationService["OrderNumber"], Empty(spec.OrderNumber)),
                    new(LocalizationService["FrontPantoneColors"], Empty(frontPantoneColors)),
                    new(LocalizationService["BackPantoneColors"], Empty(backPantoneColors)),
                    new(LocalizationService["MixedFrontColors"], Empty(mixedFrontColors)),
                    new(LocalizationService["MixedBackColors"], Empty(mixedBackColors)),
                    new(LocalizationService["FinishType"], LocalizeFinishType(finishType)),
                    new(LocalizationService["PlateProvider"], LocalizePlateProvider(plateProvider))
                };
                selectedServices = spec.SelectedServices ?? new();
            }
        }
        catch (JsonException) { errorMessage = LocalizationService["SavedJobSpecificationsUnreadable"]; }
        isLoading = false;
    }
    private void LoadCmykSelections(string? json)
    {
        frontCmyk.Clear();
        backCmyk.Clear();
        if (string.IsNullOrWhiteSpace(json)) return;

        try
        {
            using var document = JsonDocument.Parse(json);
            var root = document.RootElement;
            foreach (var property in root.EnumerateObject())
            {
                var name = property.Name.Replace("_", "").Replace("-", "").ToLowerInvariant();
                var target = name.Contains("front") ? frontCmyk
                    : name.Contains("back") ? backCmyk
                    : null;
                if (target is null) continue;

                var isCmykField = name.Contains("cmyk") || name.Contains("printcolor") ||
                                  name.Contains("printingcolor") || name.Contains("color");
                if (!isCmykField) continue;

                if (property.Value.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in property.Value.EnumerateArray())
                        AddCmykValue(target, item.ToString());
                }
                else if (property.Value.ValueKind == JsonValueKind.Object)
                {
                    foreach (var item in property.Value.EnumerateObject())
                    {
                        if (item.Value.ValueKind == JsonValueKind.True)
                            AddCmykValue(target, item.Name);
                        else if (item.Value.ValueKind == JsonValueKind.String)
                            AddCmykValue(target, item.Value.GetString());
                    }
                }
                else if (property.Value.ValueKind == JsonValueKind.String)
                {
                    foreach (var value in (property.Value.GetString() ?? "").Split(',', ';', ' ', '|'))
                        AddCmykValue(target, value);
                }
            }
        }
        catch (JsonException) { }
    }

    private static void AddCmykValue(HashSet<string> target, string? value)
    {
        var normalized = value?.Trim().ToUpperInvariant();
        if (normalized is "C" or "M" or "Y" or "K")
            target.Add(normalized);
        else if (normalized is not null)
        {
            foreach (var letter in normalized.Where(ch => ch is 'C' or 'M' or 'Y' or 'K'))
                target.Add(letter.ToString());
        }
    }

    private bool IsCmykSelected(string side, string key) =>
        (side == "front" ? frontCmyk : backCmyk).Contains(key);

    private static string CmykTextColor(string key) => key == "Y" ? "#242424" : "#FFFFFF";

    private static string ReadJsonStringProperty(string? json, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            using var document = JsonDocument.Parse(json);
            return document.RootElement.TryGetProperty(propertyName, out var value) &&
                   value.ValueKind == JsonValueKind.String
                ? value.GetString() ?? ""
                : "";
        }
        catch (JsonException)
        {
            return "";
        }
    }

    private string LocalizeFinishType(string? value) => value switch
    {
        "Hybrid" => LocalizationService["FinishHybrid"],
        "Opaque varnish" => LocalizationService["FinishOpaqueVarnish"],
        "Clear varnish" => LocalizationService["FinishClearVarnish"],
        _ => Empty(value)
    };

    private string LocalizePlateProvider(string? value) => value switch
    {
        "Press" => LocalizationService["PlateProviderPress"],
        "Customer" => LocalizationService["PlateProviderCustomer"],
        _ => Empty(value)
    };

    private static string Empty(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    private static string Fmt(decimal? d) => d.HasValue ? d.Value.ToString("0.##") : "—";
    private static bool IsImage(string path) => new[] { ".png", ".jpg", ".jpeg", ".webp" }.Any(x => path.EndsWith(x, StringComparison.OrdinalIgnoreCase));
    private void BackToJob() => Navigation.NavigateTo(request?.JobType == SalesJobType.Roll ? $"/sales/requests/roll/edit/{RequestId}" : $"/sales/requests/sheet/edit/{RequestId}");
    private void ContinueSalesWorkflow()
    {
        var job = request?.JobType == SalesJobType.Roll ? "roll" : "sheet";
        Navigation.NavigateTo($"/sales/requests/{job}/edit/{RequestId}#sales-workflow");
    }
    private IJSObjectReference? _proofPrintModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _proofPrintModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", Navigation.ToAbsoluteUri("js/customerProofPrint.js").ToString());
            await _proofPrintModule.InvokeVoidAsync("registerProofPrint");
        }
        catch (JSException)
        {
            // The Print button retains the normal browser print fallback.
        }
    }

    private async Task PrintProof()
    {
        if (_proofPrintModule is not null)
            await _proofPrintModule.InvokeVoidAsync("printProof");
        else
            await JS.InvokeVoidAsync("window.print");
    }

    public async ValueTask DisposeAsync()
    {
        if (_proofPrintModule is null)
            return;

        try
        {
            await _proofPrintModule.InvokeVoidAsync("unregisterProofPrint");
            await _proofPrintModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The interactive circuit may already have closed.
        }
    }
    private static bool IsPdf(string path) =>
    path.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
}
