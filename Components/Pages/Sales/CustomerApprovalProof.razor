@page "/sales/requests/proof/{RequestId:long}"
@using System.Text.Json
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<PageTitle>Customer Approval Proof</PageTitle>

<style>
    .proof-page { max-width: 1200px; margin: 0 auto; color: #202633; }
    .proof-sheet { background: white; border: 1px solid #d9dde5; padding: 10px; border-radius: 0; }
    .proof-brand { color: #0e1641; font-weight: 800; letter-spacing: .04em; }
    .proof-subtle { color: #657085; }
    .proof-panel { border: 1px solid #d7dbe3; border-radius: 10px; overflow: hidden; }
    .proof-panel-title { background: #f4f6fa; color: #0e1641; font-weight: 700; padding: 5px 8px; border-bottom: 1px solid #d7dbe3; }
    .proof-panel-body { padding: 6px 8px; }
    .proof-kv { display: grid; grid-template-columns: 1fr 1.2fr; gap: 8px; padding: 3px 0; border-bottom: 1px dashed #d7dbe3; }
    .proof-kv:last-child { border-bottom: 0; }
    .proof-artwork { min-height: 110px; border: 1px solid #d7dbe3; border-radius: 10px; display: flex; align-items: center; justify-content: center; padding: 20px; background: #fff; }
    .proof-artwork img { max-width: 100%; max-height: 145px; object-fit: contain; }
    .proof-dimension { color: #376d91; font-size: .9rem; font-weight: 700; text-align: center; padding: 8px; }
    .proof-foot { border-top: 1px solid #d7dbe3; margin-top: 18px; padding-top: 12px; color: #657085; font-size: .8rem; }
    .proof-pill { display: inline-block; background: #f1f3f8; border: 1px solid #dfe3eb; border-radius: 999px; padding: 4px 9px; margin: 3px; font-size: .85rem; }
    .roll-diagram { border: 1px solid #d7dbe3; border-radius: 8px; min-height: 110px; padding: 12px; display: flex; align-items: center; justify-content: center; gap: 12px; }
    .roll-core { width: 54px; height: 54px; border: 5px solid #667085; border-radius: 50%; }
    @@media print {
      body { background: white !important; }
      .no-print, .page-container > .erp-page-header { display: none !important; }
      .proof-page { max-width: none; margin: 0; }
      .proof-sheet { border: 0; border-radius: 0; padding: 0; }
      .proof-panel, .proof-artwork { break-inside: avoid; }
      .proof-sheet { font-size: 9pt; }
      .proof-sheet .mb-4 { margin-bottom: .4rem !important; }
      .proof-sheet .mb-3 { margin-bottom: .35rem !important; }
      .proof-sheet .row { --bs-gutter-x: .45rem; --bs-gutter-y: .35rem; }
      .proof-artwork-grid { display:grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap:4px; }
      .proof-artwork-card { border:1px solid #d7dbe3; padding:3px; min-width:0; }
      .proof-artwork-card img { width:100%; height:110px; object-fit:contain; }
      .proof-artwork-card .filename { font-size:7pt; overflow-wrap:anywhere; }
      .roll-diagram { min-height:48px; padding:4px; }
      .roll-core { width:28px; height:28px; border-width:3px; }
      .proof-foot { margin-top:5px; padding-top:5px; }
      @@page { size: A4 landscape; margin: 6mm; }
    }
</style>

<div class="page-container proof-page">
    <div class="erp-page-header mb-3 no-print">
        <div><div class="erp-page-title">Customer approval proof</div><div class="erp-page-subtitle">Review the proof, then print and choose Save as PDF.</div></div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" @onclick="BackToJob">Back to job</button>
            <button class="btn btn-primary" @onclick="PrintProof"><i class="bi bi-printer"></i> Print / Save as PDF</button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5"><span class="spinner-border"></span></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (request is not null)
    {
        <article class="proof-sheet">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                <div>
                    <div class="proof-brand fs-3">HAMI CHAP</div>
                    <div class="proof-subtle">Printing & Packaging · Customer Approval Proof</div>
                </div>
                <div class="text-end">
                    <div class="fs-5 fw-bold">@(request.JobType == SalesJobType.Roll ? "ROLL JOB" : "SHEET JOB")</div>
                    <div class="proof-subtle">Proof # @request.RequestNumber</div>
                    <div class="proof-subtle">Date: @request.RequestDate.ToString("yyyy-MM-dd")</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="proof-panel mb-3">
                        <div class="proof-panel-title">Artwork preview</div>
                        <div class="proof-panel-body">
                            @if (artworkFiles.Count > 0)
                            {
                                <div class="proof-artwork-grid">
                                    @foreach (var art in artworkFiles)
                                    {
                                        <div class="proof-artwork-card">
                                            @if (IsImage(art.RelativePath))
                                            {
                                                <img src="@art.RelativePath" alt="@art.OriginalFileName" />
                                            }
                                            else
                                            {
                                                <div class="text-center py-3"><i class="bi bi-file-earmark-pdf" style="font-size:2rem;color:#0e1641"></i><div><a href="@art.RelativePath" target="_blank" rel="noopener">Open file</a></div></div>
                                            }
                                            <div class="filename">@art.OriginalFileName</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="proof-artwork flex-column"><i class="bi bi-image text-secondary" style="font-size:2rem"></i><strong>Artwork not uploaded</strong></div>
                            }
                            <div class="proof-dimension">@DimensionsSummary</div>
                        </div>
                    </div>
                    <div class="proof-panel">
                        <div class="proof-panel-title">Production notes</div>
                        <div class="proof-panel-body" style="min-height:80px; white-space:pre-wrap">@PrintingNotes</div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="proof-panel mb-3">
                        <div class="proof-panel-title">Customer & job details</div>
                        <div class="proof-panel-body">
                            <div class="proof-kv"><span class="proof-subtle">Customer</span><strong>@(request.Customer?.Name ?? "—")</strong></div>
                            <div class="proof-kv"><span class="proof-subtle">Job title</span><strong>@JobTitle</strong></div>
                            <div class="proof-kv"><span class="proof-subtle">Job type</span><strong>@(request.JobType == SalesJobType.Roll ? "Roll label" : "Sheet product")</strong></div>
                            <div class="proof-kv"><span class="proof-subtle">Request no.</span><strong>@request.RequestNumber</strong></div>
                            <div class="proof-kv"><span class="proof-subtle">Artwork file</span><span>@(string.IsNullOrWhiteSpace(artworkFileName) ? "—" : artworkFileName)</span></div>
                        </div>
                    </div>
                    <div class="proof-panel mb-3">
                        <div class="proof-panel-title">Technical specifications</div>
                        <div class="proof-panel-body">
                            @foreach (var item in technicalDetails)
                            {
                                <div class="proof-kv"><span class="proof-subtle">@item.Key</span><strong>@item.Value</strong></div>
                            }
                        </div>
                    </div>
                    <div class="proof-panel">
                        <div class="proof-panel-title">Selected services</div>
                        <div class="proof-panel-body">
                            @if (selectedServices.Count == 0) { <span class="proof-subtle">No additional services selected.</span> }
                            @foreach (var service in selectedServices) { <span class="proof-pill">@service</span> }
                        </div>
                    </div>
                </div>
            </div>

            @if (request.JobType == SalesJobType.Roll)
            {
                <div class="row g-3 mt-1">
                    <div class="col-md-6"><div class="proof-panel"><div class="proof-panel-title">Roll direction</div><div class="proof-panel-body"><div class="roll-diagram"><div class="roll-core"></div><div class="text-center"><div class="fw-semibold">Roll label</div><div class="proof-subtle small">Confirm unwind direction with customer</div></div></div></div></div></div>
                    <div class="col-md-6"><div class="proof-panel"><div class="proof-panel-title">Customer approval</div><div class="proof-panel-body" style="min-height:110px"><div class="proof-kv"><span>Approved by</span><span>____________________</span></div><div class="proof-kv"><span>Date</span><span>____________________</span></div><div class="proof-kv"><span>Signature</span><span>____________________</span></div></div></div></div>
                </div>
            }
            else
            {
                <div class="proof-panel mt-3"><div class="proof-panel-title">Customer approval</div><div class="proof-panel-body"><div class="row"><div class="col-md-4">Approved by: ____________________</div><div class="col-md-4">Date: ____________________</div><div class="col-md-4">Signature: ____________________</div></div></div></div>
            }
            <div class="proof-foot d-flex justify-content-between gap-3 flex-wrap"><span>HamiChap · Customer approval copy</span><span>Please review all dimensions, artwork and finishing selections before approval.</span></div>
        </article>
    }
</div>

@code {
    [Parameter] public long RequestId { get; set; }
    private HamiChap_MES_ERP.Models.Sales.SalesRequest? request;
    private bool isLoading = true;
    private string? errorMessage;
    private string artworkPath = "";
    private string artworkFileName = "";
    private List<JobArtworkFile> artworkFiles = new();
    private string JobTitle = "";
    private string PrintingNotes = "";
    private string DimensionsSummary = "Dimensions not specified";
    private List<KeyValuePair<string,string>> technicalDetails = new();
    private List<string> selectedServices = new();

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; errorMessage = null;
        request = await Db.SalesRequests.Include(x => x.Customer).FirstOrDefaultAsync(x => x.Id == RequestId);
        if (request is null) { errorMessage = "Sales request not found."; isLoading = false; return; }
        try
        {
            if (request.JobType == SalesJobType.Roll)
            {
                var spec = JsonSerializer.Deserialize<RollJobSpecification>(request.JobSpecificationJson ?? "{}") ?? new();
                JobTitle = spec.JobTitle; PrintingNotes = spec.PrintingNotes;
                artworkPath = spec.ArtworkRelativePath; artworkFileName = spec.ArtworkOriginalFileName;
                artworkFiles = spec.ArtworkFiles ?? new();
                if (artworkFiles.Count == 0 && !string.IsNullOrWhiteSpace(artworkPath))
                    artworkFiles.Add(new JobArtworkFile { RelativePath = artworkPath, OriginalFileName = artworkFileName });
                DimensionsSummary = $"Label pull: {Fmt(spec.LabelPull)} mm · Label width: {Fmt(spec.LabelWidth)} mm · Gap: {Fmt(spec.GapBetweenLabels)} mm";
                technicalDetails = new() {
                    new("Material", Empty(spec.PaperType)), new("Colors", spec.ColorCount?.ToString() ?? "—"),
                    new("Roll diameter", spec.RollDiameter.HasValue ? Fmt(spec.RollDiameter) + " mm" : "—"),
                    new("Label quantity", spec.LabelQuantity?.ToString("N0") ?? "—"), new("Roll orientation", Empty(spec.RollOrientation)),
                    new("Hand gluing", spec.HandGluing ? "Yes" : "No"), new("Machine gluing", spec.MachineGluing ? "Yes" : "No")
                };
                selectedServices = spec.SelectedServices ?? new();
            }
            else
            {
                var spec = JsonSerializer.Deserialize<SheetJobSpecification>(request.JobSpecificationJson ?? "{}") ?? new();
                JobTitle = spec.JobTitle; PrintingNotes = spec.PrintingNotes;
                artworkPath = spec.ArtworkRelativePath; artworkFileName = spec.ArtworkOriginalFileName;
                artworkFiles = spec.ArtworkFiles ?? new();
                if (artworkFiles.Count == 0 && !string.IsNullOrWhiteSpace(artworkPath))
                    artworkFiles.Add(new JobArtworkFile { RelativePath = artworkPath, OriginalFileName = artworkFileName });
                DimensionsSummary = $"Cut size: {Fmt(spec.CutWidthCm)} × {Fmt(spec.CutLengthCm)} cm";
                technicalDetails = new() {
                    new("Sheet orientation", Empty(spec.SheetOrientation)), new("Paper", Empty(spec.PaperType)), new("Grammage", spec.Grammage.HasValue ? spec.Grammage + " gsm" : "—"),
                    new("Print run", spec.PrintRunSheets?.ToString("N0") ?? "—"), new("Sheet count", spec.SheetCount?.ToString("N0") ?? "—"),
                    new("Zinc / plate", Empty(spec.Zinc)), new("Die", Empty(spec.Die)), new("Cliché", Empty(spec.Cliche)),
                    new("Production location", Empty(spec.ProductionLocation)), new("Payment method", Empty(spec.PaymentMethod)), new("Order number", Empty(spec.OrderNumber))
                };
                selectedServices = spec.SelectedServices ?? new();
            }
        }
        catch (JsonException) { errorMessage = "Saved job specifications could not be read. Open and save the job form again."; }
        isLoading = false;
    }
    private static string Empty(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    private static string Fmt(decimal? d) => d.HasValue ? d.Value.ToString("0.##") : "—";
    private static bool IsImage(string path) => new[] { ".png", ".jpg", ".jpeg", ".webp" }.Any(x => path.EndsWith(x, StringComparison.OrdinalIgnoreCase));
    private void BackToJob() => Navigation.NavigateTo(request?.JobType == SalesJobType.Roll ? $"/sales/requests/roll/edit/{RequestId}" : $"/sales/requests/sheet/edit/{RequestId}");
    private async Task PrintProof() { await Task.Yield(); await JSPrintFallback(); }
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    private async Task JSPrintFallback() => await JS.InvokeVoidAsync("window.print");
}
