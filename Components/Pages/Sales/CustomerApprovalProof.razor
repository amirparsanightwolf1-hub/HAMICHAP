@page "/sales/requests/proof/{RequestId:long}"
@using System.Text.Json
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

<style>
    .proof-page {
        max-width: 1320px;
        margin: 0 auto;
        color: #20283a;
    }

    .proof-sheet {
        background: #fff;
        border: 1px solid #d7dce5;
        border-radius: 12px;
        padding: 16px;
        box-shadow: 0 10px 28px rgba(20,32,60,.07);
        direction: inherit;
    }

    .proof-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        border-bottom: 2px solid #17234a;
        padding: 0 0 10px;
        margin-bottom: 12px;
    }

    .proof-logo {
        display: block;
        width: 58px;
        height: 48px;
        flex: 0 0 auto;
        object-fit: contain;
        object-position: center;
    }

    .proof-brand {
        color: #0e1641;
        font-weight: 900;
        letter-spacing: .04em;
        font-size: 1.3rem;
        line-height: 1.2;
    }

    .proof-brand-subtitle,
    .proof-muted {
        color: #68748a;
        font-size: .76rem;
    }

    .proof-header-meta {
        text-align: end;
        font-size: .78rem;
        line-height: 1.7;
    }

    .proof-columns {
        direction: ltr !important;
        display: grid;
        grid-template-columns: minmax(0, 1.75fr) minmax(280px, .85fr);
        grid-template-areas: "left right";
        gap: 12px;
        align-items: start;
    }

    .proof-left-column {
        grid-area: left;
        grid-column: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .proof-right-column {
        grid-area: right;
        grid-column: 2;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .proof-panel {
        border: 1px solid #cfd5df;
        border-radius: 9px;
        overflow: hidden;
        background: #fff;
        min-width: 0;
    }

    /* The large Artwork Preview panel has a fixed overall height.
           Its body allocates the remaining space to the preview frame. */





    .proof-panel-title {
        background: #f3f5f8;
        color: #17234a;
        font-weight: 800;
        padding: 6px 9px;
        border-bottom: 1px solid #dce1e9;
        font-size: .82rem;
    }

    .proof-panel-body {
        padding: 8px;
        min-width: 0;
    }


    /* Fixed-size frame: this height never changes */
    .proof-artwork-frame {
        position: relative;
        width: 100%;
        height: 550px;
        overflow: hidden;
    }

    .proof-artwork-grid {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: repeat(2, minmax(0, 1fr));
        gap: 7px;
    }

        .proof-artwork-grid.count-1 {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: minmax(0, 1fr);
        }

        .proof-artwork-grid.count-2 {
            grid-template-rows: minmax(0, 1fr);
        }

    .proof-artwork-card {
        position: relative;
        min-width: 0;
        min-height: 0;
        box-sizing: border-box;
        border: 1px solid #dce1e9;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
    }

        /* The image fills the card's box and shrinks to fit, never cropped */
        .proof-artwork-card img {
            position: absolute;
            inset: 4px;
            width: calc(100% - 8px);
            height: calc(100% - 8px);
            max-width: none;
            max-height: none;
            object-fit: contain;
            object-position: center;
        }








    .proof-pdf-pages {
        position: absolute;
        inset: 4px;
        overflow: auto;
        display: flex;
        flex-direction: column;
        gap: 7px;
        width: auto;
        min-width: 0;
        max-width: none;
        box-sizing: border-box;
    }

    .proof-pdf-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 0;
        box-sizing: border-box;
        overflow: hidden;
        border: 1px solid #e1e5ec;
        border-radius: 5px;
        padding: 3px;
    }

        .proof-pdf-page canvas {
            display: block;
            max-width: 100%;
            max-height: calc(100% - 14px);
            margin: 0 auto;
        }

    .proof-pdf-page-number {
        flex: 0 0 auto;
        padding-top: 3px;
        text-align: center;
        font-size: 10px;
        color: #69758a;
    }

    .proof-artwork-empty {
        height: 100%;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 6px;
        color: #68748a;
        background: #f8fafc;
        border: 1px dashed #cfd5df;
        border-radius: 7px;
    }

    .proof-dimensions {
        margin-top: 7px;
        padding: 7px 8px;
        border: 1px solid #dce1e9;
        border-radius: 6px;
        color: #17234a;
        font-weight: 750;
        text-align: center;
        font-size: .82rem;
        background: #fafbfd;
    }

    .proof-kv {
        display: grid;
        grid-template-columns: minmax(90px, .8fr) minmax(0, 1.2fr);
        gap: 8px;
        padding: 5px 7px;
        border-bottom: 1px solid #edf0f4;
        font-size: .79rem;
        align-items: baseline;
    }

    /* Sheet technical specifications: two specification items side by side. */
    .proof-technical-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 10px;
        align-items: start;
    }

        .proof-technical-grid .proof-kv {
            min-width: 0;
        }

    .proof-kv:last-child {
        border-bottom: 0;
    }

    .proof-kv-label {
        color: #68748a;
    }

    .proof-kv-value {
        color: #20283a;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .proof-notes {
        min-height: 105px;
        white-space: pre-wrap;
        font-size: .78rem;
        line-height: 1.65;
    }

    .proof-service-groups {
        display: grid;
        grid-template-columns: 1fr;
        gap: 7px;
    }

    .proof-service-group-title {
        color: #17234a;
        font-weight: 800;
        font-size: .75rem;
        padding-bottom: 4px;
        margin-bottom: 4px;
        border-bottom: 1px solid #e7eaf0;
    }

    .proof-service-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4px 7px;
    }

    .proof-service {
        display: flex;
        align-items: center;
        gap: 5px;
        min-width: 0;
        font-size: .7rem;
        line-height: 1.35;
    }

    .proof-service-indicator {
        width: 13px;
        height: 13px;
        border: 1px solid #737d8d;
        border-radius: 2px;
        flex: 0 0 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 900;
    }

    .proof-service.is-selected .proof-service-indicator {
        color: #fff;
        background: #198754;
        border-color: #198754;
    }

    .proof-service.is-not-selected {
        color: #737d8d;
    }

    .proof-roll-orientation {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 135px;
        padding: 8px;
        background: #fff;
    }

        .proof-roll-orientation img {
            display: block;
            width: auto;
            height: 125px;
            max-width: 100%;
            object-fit: contain;
        }

    .proof-two-col {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .proof-cmyk-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 5px;
    }

    .proof-cmyk-chip {
        min-width: 0;
        border: 1px solid #dce2eb;
        border-radius: 6px;
        padding: 5px 2px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        background: #fff;
    }

        .proof-cmyk-chip.active {
            border-color: #536a9a;
            background: #f1f4fa;
            box-shadow: inset 0 0 0 1px #536a9a;
        }

    .proof-cmyk-swatch {
        width: 21px;
        height: 21px;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .68rem;
        font-weight: 850;
        border: 1px solid rgba(0,0,0,.1);
    }

    /* Preserve the actual CMYK swatch colors in browser print/PDF output. */
    .proof-cmyk-swatch,
    .proof-cmyk-chip.active {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    .proof-cmyk-name {
        color: #4b566d;
        font-size: .62rem;
        font-weight: 700;
    }

    .proof-approval {
        margin-top: 10px;
    }

    .proof-approval-fields {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        font-size: .78rem;
    }

    .proof-approval-line {
        border-bottom: 1px dotted #7d8797;
        min-height: 24px;
        padding-bottom: 4px;
    }

    .proof-footer {
        border-top: 1px solid #dce1e9;
        margin-top: 9px;
        padding-top: 6px;
        color: #68748a;
        font-size: .68rem;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    @@media (max-width: 850px) {
        .proof-columns {
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "left"
                "right";
        }

        .proof-left-column,
        .proof-right-column {
            grid-column: 1;
        }
    }

    @@media (max-width: 560px) {
        .proof-artwork-grid {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: none;
            grid-auto-rows: minmax(0, 1fr);
        }

        .proof-service-list,
        .proof-approval-fields {
            grid-template-columns: 1fr;
        }
    }

    @@page {
        size: A4 landscape;
        margin: 5mm;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        .proof-page,
        .proof-page * {
            visibility: visible !important;
        }

        .proof-page {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 287mm !important;
            max-width: 287mm !important;
            margin: 0 !important;
            padding: 0 !important;
            box-sizing: border-box !important;
        }

        .no-print {
            display: none !important;
        }

        html, body {
            width: 287mm !important;
            height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
        }

        .proof-sheet {
            width: 287mm !important;
            max-width: 287mm !important;
            min-height: 0 !important;
            height: auto !important;
            margin: 0 !important;
            padding: 2mm !important;
            box-sizing: border-box !important;
            border: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            font-size: 7pt !important;
            line-height: 1.15 !important;
            break-inside: avoid !important;
        }

        .proof-card-header {
            margin-bottom: 2mm !important;
            padding-bottom: 2mm !important;
        }

        .proof-logo {
            width: 13mm !important;
            height: 10mm !important;
        }

        .proof-columns {
            direction: ltr !important;
            grid-template-columns: minmax(0, 1.75fr) minmax(0, .85fr) !important;
            grid-template-areas: "left right" !important;
            gap: 2mm !important;
        }

        .proof-left-column {
            grid-area: left !important;
            grid-column: 1 !important;
        }

        .proof-right-column {
            grid-area: right !important;
            grid-column: 2 !important;
        }

        .proof-left-column,
        .proof-right-column {
            gap: 1.5mm !important;
        }

        .proof-panel-title {
            padding: 1mm 1.5mm !important;
            font-size: 6.8pt !important;
        }

        .proof-panel-body {
            padding: 1.2mm !important;
        }

        .proof-artwork-frame {
            height: 70mm !important;
        }

        .proof-artwork-grid {
            gap: 1mm !important;
        }

        .proof-artwork-card img {
            inset: 1mm !important;
            width: calc(100% - 2mm) !important;
            height: calc(100% - 2mm) !important;
        }








        .proof-pdf-pages {
            position: absolute !important;
            inset: 1mm !important;
            max-height: none !important;
            overflow: hidden !important;
            gap: 1mm !important;
        }

        .proof-pdf-page {
            padding: .5mm !important;
        }

        .proof-pdf-page-number {
            font-size: 5pt !important;
            padding-top: .4mm !important;
        }

        .proof-kv {
            padding: .9mm 1mm !important;
            font-size: 6.3pt !important;
            gap: 1mm !important;
        }

        .proof-notes {
            min-height: 22mm !important;
            font-size: 6.2pt !important;
        }

        .proof-service-groups {
            gap: 1.2mm !important;
        }

        .proof-service-group-title {
            font-size: 6pt !important;
            padding-bottom: .5mm !important;
            margin-bottom: .5mm !important;
        }

        .proof-service-list {
            gap: .6mm 1mm !important;
        }

        .proof-service {
            font-size: 5.7pt !important;
            gap: .7mm !important;
        }

        .proof-service-indicator {
            width: 3mm !important;
            height: 3mm !important;
            flex-basis: 3mm !important;
            font-size: 5pt !important;
        }

        .proof-roll-orientation {
            min-height: 25mm !important;
            padding: 1mm !important;
        }

            .proof-roll-orientation img {
                height: 24mm !important;
            }

        .proof-two-col {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .proof-cmyk-grid {
            gap: .8mm !important;
        }

        .proof-cmyk-chip {
            padding: .8mm .3mm !important;
            gap: .4mm !important;
        }

        .proof-cmyk-swatch {
            width: 4mm !important;
            height: 4mm !important;
            font-size: 5pt !important;
        }

        .proof-cmyk-name {
            font-size: 5pt !important;
        }

        .proof-approval {
            margin-top: 2mm !important;
        }

        .proof-approval-fields {
            font-size: 6pt !important;
            gap: 3mm !important;
        }

        .proof-approval-line {
            min-height: 5mm !important;
        }

        .proof-footer {
            margin-top: 1.5mm !important;
            padding-top: 1mm !important;
            font-size: 5.5pt !important;
        }
        /* Slightly compact Sheet proofs to improve A4 landscape fit. */
        .proof-sheet.sheet-proof {
            width: 280mm !important;
            max-width: 280mm !important;
            margin: 0 auto !important;
            padding: 1.5mm !important;
            font-size: 6.7pt !important;
            line-height: 1.1 !important;
        }

        .sheet-proof .proof-card-header {
            margin-bottom: 1.5mm !important;
            padding-bottom: 1.5mm !important;
        }

        .sheet-proof .proof-artwork-frame {
            height: 65mm !important;
        }

        .sheet-proof .proof-left-column,
        .sheet-proof .proof-right-column {
            gap: 1.2mm !important;
        }

        .sheet-proof .proof-panel-title {
            padding: .8mm 1.2mm !important;
            font-size: 6.5pt !important;
        }

        .sheet-proof .proof-panel-body {
            padding: 1mm !important;
        }

        .sheet-proof .proof-kv {
            padding: .7mm .8mm !important;
            font-size: 6pt !important;
        }

        .sheet-proof .proof-notes {
            min-height: 18mm !important;
            font-size: 5.9pt !important;
        }

        .sheet-proof .proof-approval {
            margin-top: 1.5mm !important;
        }

        .sheet-proof .proof-footer {
            margin-top: 1mm !important;
            padding-top: .8mm !important;
        }

        .sheet-proof .proof-cmyk-swatch {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
</style>

<div class="page-container proof-page">
    <div class="erp-page-header mb-3 no-print">
        <div>
            <div class="erp-page-title">@LocalizationService["CustomerApprovalProof"]</div>
            <div class="erp-page-subtitle">@LocalizationService["ReviewProofPrintSavePdf"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" @onclick="BackToJob">
                @LocalizationService["BackToJob"]
            </button>
            <button class="btn btn-primary" @onclick="PrintProof">
                <i class="bi bi-printer"></i> @LocalizationService["PrintSaveAsPdf"]
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5"><span class="spinner-border"></span></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (request is not null)
    {
        <article class="proof-sheet @(request.JobType == SalesJobType.Sheet ? "sheet-proof" : "")" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
            <header class="proof-card-header">
                <div class="d-flex align-items-center gap-3">
                    <img class="proof-logo" src="/images/Logo%20Wings%20navy%20blue.png" alt="HamiChap logo" />
                    <div>
                        <div class="proof-brand">HAMI CHAP</div>
                        <div class="proof-brand-subtitle">@LocalizationService["PrintingPackagingCustomerApproval"]</div>
                    </div>
                </div>
                <div class="proof-header-meta">
                    <div><strong>@LocalizationService[request.JobType == SalesJobType.Roll ? "RollJobUpper" : "SheetJobUpper"]</strong></div>
                    <div>@LocalizationService["Date"]: <strong>@request.RequestDate.ToString("yyyy/MM/dd")</strong></div>
                    <div>@LocalizationService["ProofNumber"]: <strong>@request.RequestNumber</strong></div>
                </div>
            </header>

            <div class="proof-columns">
                @* LEFT: ARTWORK AND ROLL ORIENTATION *@
                <section class="proof-left-column" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
                    <div class="proof-panel proof-artwork-panel">
                        <div class="proof-panel-title">@LocalizationService["ArtworkPreview"]</div>
                        <div class="proof-panel-body">
                            @if (artworkFiles.Count > 0)
                            {
                                <div class="proof-artwork-frame">
                                    <div class="proof-artwork-grid count-@(Math.Min(artworkFiles.Count, 4))">
                                        @foreach (var art in artworkFiles)
                                        {
                                            <div class="proof-artwork-card @(IsPdf(art.RelativePath) ? "proof-pdf-card" : "")">
                                                @if (IsImage(art.RelativePath))
                                                {
                                                    <img src="@art.RelativePath" alt="Artwork preview" />
                                                }
                                                else if (IsPdf(art.RelativePath))
                                                {
                                                    <PdfPagePreview Url="@art.RelativePath" />
                                                }
                                                else
                                                {
                                                    <div class="text-center py-3">
                                                        <i class="bi bi-file-earmark" style="font-size:2rem;color:#0e1641"></i>
                                                        <div><a href="@art.RelativePath" target="_blank" rel="noopener">@LocalizationService["OpenFile"]</a></div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="proof-artwork-frame">
                                    <div class="proof-artwork-empty">
                                        <i class="bi bi-image" style="font-size:2rem"></i>
                                        <strong>@LocalizationService["ArtworkNotUploaded"]</strong>
                                    </div>
                                </div>
                            }

                            @if (request.JobType == SalesJobType.Roll)
                            {
                                <div class="proof-dimensions">@DimensionsSummary</div>
                            }
                            else
                            {
                                <div class="proof-dimensions">@DimensionsBeforeCutSummary</div>
                                <div class="proof-dimensions">@DimensionsAfterCutSummary</div>
                            }
                        </div>
                    </div>

                    @if (request.JobType == SalesJobType.Roll)
                    {
                        <div class="proof-panel">
                            <div class="proof-panel-title">@LocalizationService["SelectedRollOrientation"]</div>
                            <div class="proof-roll-orientation">
                                @if (int.TryParse(rollOrientation, out var orientationNumber) && orientationNumber >= 1 && orientationNumber <= 8)
                                {
                                    <img src="@($"/images/roll-orientations/orientation-{orientationNumber}.jpg")"
                                         alt="@RollOrientationLabel" />
                                }
                                else
                                {
                                    <span class="proof-muted">@LocalizationService["NoRollOrientationSelected"]</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(rollOrientation))
                            {
                                <div class="proof-panel-body text-center proof-muted">@RollOrientationLabel</div>
                            }
                        </div>
                    }

                    <div class="proof-panel">
                        <div class="proof-panel-title">@LocalizationService["ProductionNotes"]</div>
                        <div class="proof-panel-body proof-notes">
                            @(string.IsNullOrWhiteSpace(PrintingNotes) ? "—" : PrintingNotes)
                        </div>
                    </div>
                </section>

                @* RIGHT: PRESS-CARD DETAILS *@
                <section class="proof-right-column" dir="@(LocalizationService.IsPersian ? "rtl" : "ltr")">
                    <div class="proof-panel">
                        <div class="proof-panel-title">@LocalizationService["CustomerJobDetails"]</div>
                        <div class="proof-panel-body">
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["Customer"]</span>
                                <strong class="proof-kv-value">@(request.Customer?.Name ?? "—")</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["JobTitle"]</span>
                                <strong class="proof-kv-value">@Empty(JobTitle)</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["JobType"]</span>
                                <strong class="proof-kv-value">@LocalizationService[request.JobType == SalesJobType.Roll ? "RollLabel" : "SheetProduct"]</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["RequestNumber"]</span>
                                <strong class="proof-kv-value">@request.RequestNumber</strong>
                            </div>
                            <div class="proof-kv">
                                <span class="proof-kv-label">@LocalizationService["Date"]</span>
                                <strong class="proof-kv-value">@request.RequestDate.ToString("yyyy/MM/dd")</strong>
                            </div>
                        </div>
