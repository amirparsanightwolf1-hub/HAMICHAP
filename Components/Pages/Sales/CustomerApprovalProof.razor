    private SalesProofService.State? proofState;
    private string displayedFingerprint = "";
    private bool canRecordProof;
    private bool canCancelProofJob;
    private bool proofBusy;
    private string proofNotes = "";
    private string T(string en, string fa) => LocalizationService.IsPersian ? fa : en;
    private string RevisionStatus(ProofRevisionStatus status) => status switch
    {
        ProofRevisionStatus.Accepted => T("Accepted", "تأیید شده"),
        ProofRevisionStatus.ChangesRequested => T("Changes requested", "درخواست اصلاح"),
        ProofRevisionStatus.Superseded => T("Superseded", "نسخه جایگزین شده"),
        _ => T("Awaiting response", "در انتظار پاسخ")
    };
    private string ProofStatusLabel => request?.Status == SalesRequestStatus.Cancelled ? T("Cancelled", "لغو شده")
        : proofState?.Latest is not { } latest ? T("Not sent", "ارسال نشده")
        : latest.Fingerprint != displayedFingerprint ? T("New revision required", "نیاز به نسخه جدید")
        : RevisionStatus(latest.Status);

    private async Task MarkProofSent() => await RunProofActionAsync(async principal =>
        await ProofService.MarkSentAsync(RequestId, displayedFingerprint, principal));

    private async Task DecideProof(bool accepted) => await RunProofActionAsync(async principal =>
        await ProofService.RecordDecisionAsync(RequestId, displayedFingerprint, accepted, proofNotes, principal));

    private async Task CancelProofJob() => await RunProofActionAsync(async principal =>
        await ProofService.CancelUnquotedJobAsync(RequestId, principal));

    private async Task RunProofActionAsync(Func<System.Security.Claims.ClaimsPrincipal, Task> action)
    {
        if (proofBusy || !canRecordProof) return;
        proofBusy = true;
        quotationError = null;
        try
        {
            await action((await Auth.GetAuthenticationStateAsync()).User);
            proofNotes = "";
            await OnParametersSetAsync();
        }
        catch (Exception ex) { quotationError = ex.Message; }
        finally { proofBusy = false; }
    }

    private bool isOpeningQuotation;
    private string? quotationError;

    private async Task ContinueSalesWorkflow()
    {
        if (!await SecurityPermissions.HasPermissionAsync((await SecurityAuth.GetAuthenticationStateAsync()).User, "Sales.Requests.CreateQuotation"))
        {
            quotationError = "Access denied / دسترسی غیرمجاز";
            return;
        }
        if (request is null || proofState?.Accepted != true) return;

        quotationError = null;
        try
        {
            isOpeningQuotation = true;
            // Reuses an existing quote when the job has already been attached.
            // Draft requests go straight to quoting (no duplicate Submit step).
            if (TargetQuotationId.HasValue)
            {
                await QuotationService.AddRequestToQuotationAsync(
                    TargetQuotationId.Value, RequestId);
                Navigation.NavigateTo($"/sales/quotations/edit/{TargetQuotationId.Value}");
            }
            else
            {
                var quotation = await QuotationService.CreateFromRequestAsync(RequestId);
                Navigation.NavigateTo($"/sales/quotations/edit/{quotation.Id}");
            }
        }
        catch (Exception ex)
        {
            quotationError = ex.Message;
        }
        finally
        {
            isOpeningQuotation = false;
        }
    }
    private bool isPreparingPrint;
    private string? printError;
    private IJSObjectReference? _proofPrintModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _proofPrintModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", Navigation.ToAbsoluteUri("js/customerProofPrint.js").ToString());
            await _proofPrintModule.InvokeVoidAsync("registerProofPrint");
        }
        catch (JSException)
        {
            // The Print button retains the normal browser print fallback.
        }
    }

    private async Task PrintProof()
    {
        if (isPreparingPrint) return;
        isPreparingPrint = true;
        printError = null;
        try
        {
            // The Print button must not silently fall back to low-resolution art.
            if (_proofPrintModule is null)
            {
                printError = LocalizationService["ProofPrintQualityFailed"];
                return;
            }
            await _proofPrintModule.InvokeVoidAsync("printProof");
        }
        catch (JSException)
        {
            printError = LocalizationService["ProofPrintQualityFailed"];
        }
        finally
        {
            isPreparingPrint = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_proofPrintModule is null)
            return;

        try
        {
            await _proofPrintModule.InvokeVoidAsync("unregisterProofPrint");
            await _proofPrintModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The interactive circuit may already have closed.
        }
    }
    private static bool IsPdf(string path) =>
    path.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
