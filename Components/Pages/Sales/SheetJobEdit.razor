@page "/sales/requests/sheet/edit/{RequestId:long}"

@using System.Text.Json
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Customers
@using HamiChap_MES_ERP.Models.Sales
@using HamiChap_MES_ERP.Models.Sales.Enums
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.IO
@using HamiChap_MES_ERP.Services

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SheetJobSpecification"]</PageTitle>

<div class="page-container">
    <div class="erp-page-header mb-4">
        <div>
            <div class="erp-page-title">@LocalizationService["SheetJob"]</div>
            <div class="erp-page-subtitle">@LocalizationService["SheetJobSubtitle"]</div>
        </div>
        <button class="btn btn-outline-secondary" @onclick="BackToRequest">
            <i class="bi bi-arrow-left"></i> @LocalizationService["BackToRequest"]
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (isLoading)
    {
        <div class="text-muted">Loading job…</div>
    }
    else if (request is not null)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header"><strong>@LocalizationService["OrderInformation"]</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["Date"]</label>
                        <input class="form-control" value="@request.RequestDate.ToString("yyyy-MM-dd")" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["OrderNumber"]</label>
                        <input class="form-control" value="@request.RequestNumber" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["Customer"]</label>
                        @if (!isCreatingCustomer)
                        {
                            <select class="form-select" @bind="selectedCustomerId">
                                <option value="0">-- @LocalizationService["SelectExistingCustomer"] --</option>
                                @foreach (var customer in customers)
                                {
                                    <option value="@customer.Id">@customer.Code - @customer.Name</option>
                                }
                            </select>
                            <button type="button"
                                    class="btn btn-link px-0"
                                    @onclick="StartNewCustomer">
                                + @LocalizationService["CreateNewCustomer"]
                            </button>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="form-control bg-light">@LocalizationService["NewCustomer"]</span>
                                <button type="button"
                                        class="btn btn-outline-secondary text-nowrap"
                                        @onclick="SelectExistingCustomer">
                                    Select existing
                                </button>
                            </div>
                        }
                    </div>
                    @if (isCreatingCustomer)
                    {
                        <div class="col-md-4">
                            <label class="form-label">@LocalizationService["CustomerCodeRequired"]</label>
                            <InputText class="form-control" @bind-Value="newCustomerCode" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@LocalizationService["CustomerNameRequired"]</label>
                            <InputText class="form-control" @bind-Value="newCustomerName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@LocalizationService["Phone"]</label>
                            <InputText class="form-control" @bind-Value="newCustomerPhone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@LocalizationService["Email"]</label>
                            <InputText class="form-control" @bind-Value="newCustomerEmail" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@LocalizationService["Address"]</label>
                            <InputText class="form-control" @bind-Value="newCustomerAddress" />
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">@LocalizationService["JobTitle"]</label>
                        <InputText class="form-control" @bind-Value="spec.JobTitle" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@LocalizationService["Referrer"]</label>
                        <InputText class="form-control" @bind-Value="spec.Referrer" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@LocalizationService["RequiredItems"]</label>
                        <InputText class="form-control" @bind-Value="spec.RequiredItems" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@LocalizationService["PaperType"]</label>
                        <input class="form-control" list="sheet-paper-types" @bind="spec.PaperType" placeholder="@LocalizationService["SelectOrType"]" />
                        <datalist id="sheet-paper-types">
                            <option value="گلاسه"></option>
                            <option value="تحریر"></option>
                            <option value="ایندربرد"></option>
                            <option value="پشت طوسی"></option>
                            <option value="کرافت"></option>
                            <option value="کارتن"></option>
                            <option value="متالایز"></option>
                            <option value="کاغذ اختصاصی"></option>
                        </datalist>
                        <small class="text-muted">@LocalizationService["PaperTypeHelp"]</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["Zinc"]</label>
                        <InputText class="form-control" @bind-Value="spec.Zinc" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["DieCut"]</label>
                        <InputText class="form-control" @bind-Value="spec.Die" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["Cliche"]</label>
                        <InputText class="form-control" @bind-Value="spec.Cliche" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["PrintRunSheets"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.PrintRunSheets" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["CutLengthCm"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.CutLengthCm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["CutWidthCm"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.CutWidthCm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["SheetOrientation"]</label>
                        <select class="form-select" @bind="spec.SheetOrientation">
                            <option value="">@LocalizationService["SelectOrientation"]</option><option value="Portrait">@LocalizationService["Portrait"]</option><option value="Landscape">@LocalizationService["Landscape"]</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["Grammage"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.Grammage" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["SheetCount"]</label>
                        <InputNumber class="form-control" @bind-Value="spec.SheetCount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["ProductionLocation"]</label>
                        <input class="form-control" list="sheet-production-locations" @bind="spec.ProductionLocation" placeholder="@LocalizationService["SelectOrEnterLocation"]" />
                        <datalist id="sheet-production-locations">
                            <option value="داخل کارخانه"></option>
                            <option value="برون‌سپاری"></option>
                            <option value="تولید مشترک"></option>
                        </datalist>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["PaymentMethod"]</label>
                        <input class="form-control" list="sheet-payment-methods" @bind="spec.PaymentMethod" placeholder="@LocalizationService["SelectOrEnterPaymentMethod"]" />
                        <datalist id="sheet-payment-methods">
                            <option value="نقدی"></option>
                            <option value="اعتباری"></option>
                            <option value="پیش‌پرداخت و تسویه نهایی"></option>
                            <option value="طبق قرارداد"></option>
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@LocalizationService["PrintingAndColorNotes"]</label>
                        <InputText class="form-control" @bind-Value="spec.PrintingNotes" placeholder="@LocalizationService["PrintingNotesPlaceholder"]" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@LocalizationService["CustomerOrderNumber"]</label>
                        <InputText class="form-control" @bind-Value="spec.OrderNumber" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header"><strong>@LocalizationService["AdditionalServicesAndColorSelection"]</strong><span class="text-muted ms-2">(@LocalizationService["ExpandEachGroup"])</span></div>
            <div class="card-body">
                @foreach (var group in ServiceGroups)
                {
                    <details class="border rounded p-3 mb-2" @key="group.Key">
                        <summary class="fw-semibold" style="cursor:pointer">@LocalizationService[group.Key] <span class="text-muted small">(@group.Value.Count(x => spec.SelectedServices.Contains(x)) @LocalizationService["Selected"])</span></summary>
                        <div class="row g-3 pt-3">
                            @foreach (var service in group.Value)
                            {
                                <div class="col-sm-6 col-lg-4" @key="service">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@spec.SelectedServices.Contains(service)"
                                               @onchange="args => ToggleService(service, args)" />
                                        <label class="form-check-label">@service</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                @LocalizationService["SaveSpecifications"]
            </button>
            <button class="btn btn-outline-dark" @onclick="SaveAndOpenProofAsync" disabled="@isSaving">
                <i class="bi bi-file-earmark-pdf"></i> @LocalizationService["SaveAndPreviewApprovalProof"]
            </button>
            <button class="btn btn-outline-primary" @onclick="SaveAndContinueAsync" disabled="@isSaving">
                @LocalizationService["SaveAndContinueSalesWorkflow"]
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public long RequestId { get; set; }

    private HamiChap_MES_ERP.Models.Sales.SalesRequest? request;
    private List<Customer> customers = new();
    private int selectedCustomerId;
    private bool isCreatingCustomer;
    private string newCustomerCode = "";
    private string newCustomerName = "";
    private string newCustomerPhone = "";
    private string newCustomerEmail = "";
    private string newCustomerAddress = "";
    private SheetJobSpecification spec = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;
    private List<IBrowserFile> pendingArtworks = new();

    private static readonly Dictionary<string, string[]> ServiceGroups = new()
    {
        ["ServiceGroupLamination"] = new[] { "سلفون واتربیس مات", "سلفون واتربیس براق", "سلفون حرارتی مات", "سلفون حرارتی براق", "سلفون حرارتی متالایز" },
        ["ServiceGroupUvCoating"] = new[] { "یووی موضعی" },
        ["ServiceGroupFoilStamping"] = new[] { "طلاکوب", "نقره‌کوب", "رنگ فویل" },
        ["ServiceGroupEmbossingDie"] = new[] { "برجسته", "قالب" },
        ["ServiceGroupGluingCuttingPackaging"] = new[] { "جعبه‌چسبانی", "برش و بسته‌بندی" },
        ["ServiceGroupBackColors"] = new[] { "رنگ‌های پنتون پشت", "رنگ‌های ساختگی پشت", "طلایی پشت", "نقره‌ای پشت", "رنگ پشت C", "رنگ پشت M", "رنگ پشت Y", "رنگ پشت K" },
        ["ServiceGroupFrontColors"] = new[] { "رنگ‌های پنتون رو", "رنگ‌های ساختگی رو", "طلایی رو", "نقره‌ای رو", "رنگ رو C", "رنگ رو M", "رنگ رو Y", "رنگ رو K" }
    };

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        request = await Db.SalesRequests
            .Include(x => x.Customer)
            .FirstOrDefaultAsync(x => x.Id == RequestId);

        if (request is not null)
            selectedCustomerId = request.CustomerId;

        if (request is null)
        {
            errorMessage = LocalizationService["SalesRequestNotFound"];
        }
        else if (request.JobType != SalesJobType.Sheet)
        {
            errorMessage = LocalizationService["RequestIsNotSheetJob"];
        }
        else if (!string.IsNullOrWhiteSpace(request.JobSpecificationJson))
        {
            try
            {
                spec = JsonSerializer.Deserialize<SheetJobSpecification>(
                    request.JobSpecificationJson) ?? new();
            }
            catch (JsonException)
            {
                spec = new();
                errorMessage = LocalizationService["SavedSpecificationsUnreadable"];
            }
        }

        isLoading = false;
    }

    private void StartNewCustomer()
    {
        isCreatingCustomer = true;
        newCustomerCode = "";
        newCustomerName = "";
        newCustomerPhone = "";
        newCustomerEmail = "";
        newCustomerAddress = "";
        errorMessage = null;
    }

    private void SelectExistingCustomer()
    {
        isCreatingCustomer = false;
        errorMessage = null;
    }

    private void ToggleService(string service, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        if (selected && !spec.SelectedServices.Contains(service))
            spec.SelectedServices.Add(service);
        else if (!selected)
            spec.SelectedServices.Remove(service);
    }

    private void ArtworkSelected(InputFileChangeEventArgs args)
    {
        pendingArtworks = args.GetMultipleFiles(20).ToList();
        errorMessage = null;
    }

    private static bool IsPreviewableImage(string path) =>
        path.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
        path.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
        path.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
        path.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);

    private async Task SaveArtworkFileAsync()
    {
        if (request is null || pendingArtworks.Count == 0) return;
        const long maxBytes = 25 * 1024 * 1024;
        var allowed = new[] { ".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".webp" };
        var uploadFolder = Path.Combine(HostEnvironment.WebRootPath, "uploads", "job-artwork");
        Directory.CreateDirectory(uploadFolder);
        spec.ArtworkFiles ??= new List<JobArtworkFile>();
        foreach (var file in pendingArtworks)
        {
            if (file.Size > maxBytes) throw new InvalidOperationException(string.Format(LocalizationService["ArtworkMaxSize"], file.Name));
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!allowed.Contains(extension)) throw new InvalidOperationException(string.Format(LocalizationService["UnsupportedArtworkFormat"], file.Name));
            var safeName = $"request-{request.Id}-{Guid.NewGuid():N}{extension}";
            var fullPath = Path.Combine(uploadFolder, safeName);
            await using (var source = file.OpenReadStream(maxBytes))
            await using (var destination = File.Create(fullPath))
                await source.CopyToAsync(destination);
            spec.ArtworkFiles.Add(new JobArtworkFile { RelativePath = $"/uploads/job-artwork/{safeName}", OriginalFileName = Path.GetFileName(file.Name) });
        }
        var first = spec.ArtworkFiles.FirstOrDefault();
        if (first is not null) { spec.ArtworkRelativePath = first.RelativePath; spec.ArtworkOriginalFileName = first.OriginalFileName; }
        pendingArtworks.Clear();
    }

    private async Task SaveAndOpenProofAsync()
    {
        await SaveAsync();
        if (string.IsNullOrWhiteSpace(errorMessage))
            Navigation.NavigateTo($"/sales/requests/proof/{RequestId}");
    }

    private async Task SaveAsync()
    {
        if (request is null) return;

        if (string.IsNullOrWhiteSpace(spec.JobTitle))
        {
            errorMessage = LocalizationService["JobTitleRequired"];
            return;
        }
        if (pendingArtworks.Count == 0 && (spec.ArtworkFiles?.Count ?? 0) == 0 && string.IsNullOrWhiteSpace(spec.ArtworkRelativePath))
        {
            errorMessage = LocalizationService["UploadArtworkBeforeSaving"];
            return;
        }

        Customer? customerCreatedThisAttempt = null;
        var originalCustomerId = request.CustomerId;
        var originalCustomer = request.Customer;

        try
        {
            isSaving = true;
            errorMessage = null;

            // Keep customer creation/selection, item creation/reuse, and specifications in one transaction.
            await using var transaction = await Db.Database.BeginTransactionAsync();

            if (isCreatingCustomer)
            {
                if (string.IsNullOrWhiteSpace(newCustomerCode))
                    throw new InvalidOperationException(LocalizationService["CustomerCodeIsRequired"]);

                if (string.IsNullOrWhiteSpace(newCustomerName))
                    throw new InvalidOperationException(LocalizationService["CustomerNameIsRequired"]);

                var code = newCustomerCode.Trim();
                if (await Db.Customers.AnyAsync(x => x.Code == code))
                    throw new InvalidOperationException(string.Format(LocalizationService["CustomerCodeAlreadyExists"], code));

                var newCustomer = new Customer
                {
                    Code = code,
                    Name = newCustomerName.Trim(),
                    Phone = newCustomerPhone.Trim(),
                    Email = newCustomerEmail.Trim(),
                    Address = newCustomerAddress.Trim(),
                    IsActive = true
                };

                Db.Customers.Add(newCustomer);
                await Db.SaveChangesAsync();

                customerCreatedThisAttempt = newCustomer;
                request.CustomerId = newCustomer.Id;
                request.Customer = newCustomer;
            }
            else
            {
                var selectedCustomer = customers.FirstOrDefault(x => x.Id == selectedCustomerId);
                if (selectedCustomer is null)
                    throw new InvalidOperationException(LocalizationService["SelectOrCreateCustomer"]);

                request.CustomerId = selectedCustomer.Id;
                request.Customer = selectedCustomer;
            }

            await SaveArtworkFileAsync();

            var item = await JobProductItemHelper.GetOrCreateAsync(
                Db, request, spec.JobTitle, "products-sheet");

            spec.FinishedProductItemId = item.Id;
            request.JobSpecificationJson = JsonSerializer.Serialize(spec);
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();

            if (customerCreatedThisAttempt is not null)
            {
                customers.Add(customerCreatedThisAttempt);
                selectedCustomerId = customerCreatedThisAttempt.Id;
                isCreatingCustomer = false;
            }

            successMessage = string.Format(LocalizationService["SpecificationsSavedFinishedProduct"], item.Code, item.Name);
        }
        catch (Exception ex)
        {
            if (customerCreatedThisAttempt is not null)
            {
                Db.Entry(customerCreatedThisAttempt).State = Microsoft.EntityFrameworkCore.EntityState.Detached;
                request.CustomerId = originalCustomerId;
                request.Customer = originalCustomer;
                selectedCustomerId = originalCustomerId;
            }

            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAndContinueAsync()
    {
        await SaveAsync();
        if (string.IsNullOrWhiteSpace(errorMessage))
            BackToRequest();
    }

    private void BackToRequest() =>
        Navigation.NavigateTo($"/sales/requests/edit/{RequestId}");
}
