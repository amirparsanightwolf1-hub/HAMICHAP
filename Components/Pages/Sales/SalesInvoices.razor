@page "/sales/invoices"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using HamiChap_MES_ERP.Models.Sales.Enums
@inject AuthenticationStateProvider Auth
@inject PermissionService Permissions

@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Sales
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject LocalizationService LocalizationService

<PageTitle>@LocalizationService["SalesInvoices.PageTitle"]</PageTitle>

<div class="page-container" dir="@LocalizationService["Common.TextDirection"]">

    <div class="erp-page-header hc-standard-header mb-4">
        <div class="hc-heading-content">
            <span class="hc-heading-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            <div><h3 class="erp-page-title">
                @LocalizationService["SalesInvoices.Title"]
            </h3>

            <p class="erp-page-subtitle">
                @LocalizationService["SalesInvoices.Description"]
            </p></div>
        </div>
    </div>

    @if (canReportTax)
    {
        <div class="mb-3"><a class="btn btn-outline-primary" href="/sales/tax-reporting"><i class="bi bi-file-earmark-check"></i> @Text("Tax reporting", "گزارش مالیاتی")</a></div>
    }
    @if (canView)
    {
        <div class="card mb-3"><div class="card-body d-flex flex-wrap gap-2 align-items-center">
            <label for="invoice-type-filter" class="form-label mb-0">@Text("Invoice type", "نوع فاکتور")</label>
            <select id="invoice-type-filter" class="form-select w-auto" @bind="typeFilter" @bind:after="ChangeFilterAsync" disabled="@isLoading">
                <option value="">@Text("All types", "همه انواع")</option>
                <option value="Formal">@Text("Formal", "رسمی")</option>
                <option value="Informal">@Text("Informal", "غیررسمی")</option>
                <option value="legacy">@Text("Legacy — unclassified", "قدیمی — نوع نامشخص")</option>
            </select>
        </div></div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    @LocalizationService["Common.Loading"]
                </span>
            </div>
        </div>
    }
    else if (!canView)
    {
        <div class="alert alert-warning">@LocalizationService["AccessDenied"]</div>
    }
    else if (totalCount == 0)
    {
        <div class="alert alert-info">
            @LocalizationService["SalesInvoices.Empty"]
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-responsive-cards">
                    <thead class="table-light">
                        <tr>
                            <th>@LocalizationService["SalesInvoices.Invoice"]</th>
                            <th>@Text("Type", "نوع")</th>
                            <th>@LocalizationService["Common.Date"]</th>
                            <th>@LocalizationService["Common.Customer"]</th>
                            <th>@LocalizationService["SalesInvoices.Quotation"]</th>
                            <th>@LocalizationService["SalesInvoices.SalesOrder"]</th>
                            <th>@LocalizationService["SalesInvoices.Delivery"]</th>
                            <th class="text-end">@LocalizationService["Common.Total"]</th>
                            <th>@LocalizationService["Common.Status"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in invoices)
                        {
                            <tr class="erp-clickable" @key="invoice.Id"
                                role="button"
                                
                                @onclick="() => OpenInvoice(invoice.Id)">

                                <td class="fw-semibold">
                                    <div class="job-reference-primary">@HamiChap_MES_ERP.Models.Sales.JobReferences.Titles(invoice.Quotation, invoice.InvoiceNumber)</div>
                                    <small class="text-muted d-block">@invoice.InvoiceNumber · @HamiChap_MES_ERP.Models.Sales.JobReferences.Display(invoice.Quotation)</small>
                                </td>

                                <td>@InvoiceTypeLabels.Label(invoice.InvoiceType, LocalizationService.IsPersian)</td>
                                <td>
                                    @invoice.InvoiceDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @invoice.Customer?.Name
                                </td>

                                <td>
                                    @invoice.Quotation?.QuotationNumber
                                </td>

                                <td>
                                    @invoice.SalesOrder?.OrderNumber
                                </td>

                                <td>
                                    @invoice.SalesDelivery?.DeliveryNumber
                                </td>

                                <td class="text-end">
                                    @invoice.TotalAmount.ToString("N2") @invoice.CurrencyCode
                                </td>

                                <td>
                                    @(invoice.Status == HamiChap_MES_ERP.Models.Sales.Enums.SalesInvoiceStatus.Cancelled ? LocalizationService[$"SalesInvoiceStatus.{invoice.Status}"] : invoice.SalesDelivery?.Status == HamiChap_MES_ERP.Models.Sales.Enums.SalesDeliveryStatus.Posted ? (LocalizationService.IsPersian ? "ارسال شده" : "Shipped") : invoice.PaidAtUtc.HasValue ? (LocalizationService.IsPersian ? "پرداخت شده" : "Paid") : (LocalizationService.IsPersian ? "در انتظار پرداخت" : "Awaiting payment"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 0)
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 gap-2">

                    <div class="text-muted small">
                        @((currentPage - 1) * pageSize + 1)
                        -
                        @(Math.Min(currentPage * pageSize, totalCount))
                        /
                        @totalCount
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="PreviousPage"
                                disabled="@(currentPage <= 1 || isLoading)">
                            @LocalizationService["Previous"]
                        </button>

                        <span class="small">
                            @currentPage / @totalPages
                        </span>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="NextPage"
                                disabled="@(currentPage >= totalPages || isLoading)">
                            @LocalizationService["Next"]
                        </button>
                    </div>

                </div>
            }
        </div>
    }
</div>

@code {
    private const int pageSize = 20;

    private List<SalesInvoice> invoices = new();

    private bool isLoading = true, canView, canReportTax;
    private string typeFilter = "";
    private string Text(string en, string fa) => LocalizationService.IsPersian ? fa : en;
    private async Task ChangeFilterAsync() { currentPage = 1; await LoadAsync(); }
    private string? errorMessage;

    private int currentPage = 1;
    private int totalCount;

    private int totalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(totalCount / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User;
            canReportTax = await Permissions.HasPermissionAsync(user, "Sales.Invoices.TaxReporting");
            canView = canReportTax || await Permissions.HasPermissionAsync(user, "Sales.Invoices.View") || await Permissions.HasPermissionAsync(user, "Sales.Invoices.ConfirmPayment");
            if (!canView) { invoices.Clear(); totalCount = 0; return; }
            var query = Db.SalesInvoices.AsNoTracking();
            if (typeFilter == "legacy") query = query.Where(x => x.InvoiceType == null);
            else if (Enum.TryParse<SalesInvoiceType>(typeFilter, out var selected) && Enum.IsDefined(selected))
                query = query.Where(x => x.InvoiceType == selected);

            totalCount = await query.CountAsync();

            if (totalPages > 0 && currentPage > totalPages)
            {
                currentPage = totalPages;
            }

            if (totalPages == 0)
            {
                currentPage = 1;
            }

            invoices = await query
                .Include(x => x.Customer)
                .Include(x => x.Quotation).ThenInclude(x => x.SalesRequest)
                .Include(x => x.Quotation).ThenInclude(x => x.Lines).ThenInclude(x => x.SourceRequest)
                .Include(x => x.SalesOrder)
                .Include(x => x.SalesDelivery)
                .OrderByDescending(x => x.InvoiceDate)
                .ThenByDescending(x => x.Id)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();
        }
        catch
        {
            errorMessage = LocalizationService["Common.LoadFailed"];
            invoices = new();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1 || isLoading)
            return;

        currentPage--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages || isLoading)
            return;

        currentPage++;
        await LoadAsync();
    }

    private void OpenInvoice(long id)
    {
        Navigation.NavigateTo($"/sales/invoices/edit/{id}");
    }
}