
@page "/"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HamiChap_MES_ERP.Services.PermissionService PermissionService
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService
@inject NavigationManager Navigation

<div class="home-page">

    <div class="home-content">

        <img src="/images/Logo Wings navy blue.png"
             alt="Company Logo"
             class="company-logo" />

        <div class="home-actions">

            <a class="login-button"
               href="/Account/Login">
                🔐 @LocalizationService["Login"]
            </a>

            @if (canViewProductionDeadlines)
            {
                <a class="login-button planning-home-button" href="/production/planning">📅 @LocalizationService["CeoDeadlineCalendar"]</a>
            }
            @if (canViewMachineSchedule)
            {
                <a class="login-button planning-home-button" href="/production/machine-schedule">🏭 @LocalizationService["MachineSchedule"]</a>
            }

            @if (canCreateSalesRequest)
            {
                <button type="button"
                        class="login-button"
                        @onclick="CreateNewOrder">
                    ➕ @LocalizationService["NewOrder"]
                </button>
            }

        </div>

    </div>

</div>

@code {
    private bool canCreateSalesRequest;
    private bool canViewProductionDeadlines;
    private bool canViewMachineSchedule;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            canViewProductionDeadlines = authState.User.IsInRole("CEO") || authState.User.IsInRole("Ceo") || authState.User.IsInRole("Administrator");
            canViewMachineSchedule = authState.User.IsInRole("ProductionManager") || authState.User.IsInRole("Production Manager") || authState.User.IsInRole("FloorManager") || authState.User.IsInRole("Floor Manager") || authState.User.IsInRole("Administrator");
            canCreateSalesRequest =
                await PermissionService.HasPermissionAsync(
                    authState.User,
                    "Sales.Requests.Create");
        }
    }

    private void CreateNewOrder()
    {
        Navigation.NavigateTo("/sales/requests/create");
    }
}
