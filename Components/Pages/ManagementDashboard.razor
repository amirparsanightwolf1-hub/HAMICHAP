@page "/dashboard/{DashboardSection}"
@implements IDisposable
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Production
@using HamiChap_MES_ERP.Models.Sales.Enums
@using HamiChap_MES_ERP.Models.Inventory
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject LocalizationService L

<PageTitle>@DashboardTitle</PageTitle>
<div class="@($"manager-dashboard manager-dashboard-{section}")">
    @if (checkingAccess)
    {
        <div class="d-flex align-items-center gap-2 py-4" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            @L["Loading"]
        </div>
    }
    else if (!authorized)
    {
        <div class="alert alert-warning">@L["AccessDenied"]</div>
    }
    else
    {
        <header class="manager-dashboard-heading">
            <div>
                <span class="manager-overline">@L["ManagerOverview"]</span>
                <h1>@DashboardTitle</h1>
                <p>@L["ManagerDashboardIntro"]</p>
            </div>
            <button class="btn btn-outline-primary" type="button" disabled="@busy" @onclick="LoadAsync">@L["Refresh"]</button>
        </header>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        @if (busy)
        {
            <div class="d-flex align-items-center gap-2 py-3" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                @L["Loading"]
            </div>
        }
        else
        {
        <div class="manager-kpi-grid">
            @foreach (var kpi in kpis)
            {
                <div class="manager-kpi">
                    <span>@L[kpi.Key]</span>
                    <strong>@kpi.Value.ToString("N0")</strong>
                </div>
            }
        </div>

        <div class="manager-dashboard-grid">
            <section class="manager-panel">
                <div class="manager-panel-heading">
                    <h2>@L["ManagerQuickActions"]</h2>
                    <span>@L["ManagerOpenWorkspace"]</span>
                </div>
                <div class="manager-shortcuts">
                    @foreach (var shortcut in shortcuts)
                    {
                        <a class="manager-shortcut" href="@shortcut.Url">
                            <span>@L[shortcut.Key]</span>
                            <span aria-hidden="true">›</span>
                        </a>
                    }
                </div>
            </section>
            <section class="manager-panel">
                <div class="manager-panel-heading">
                    <h2>@L["ManagerNeedsAttention"]</h2>
                    <span>@L["ManagerLiveCounts"]</span>
                </div>
                @foreach (var item in alerts)
                {
                    <a class="manager-alert-row" href="@item.Url">
                        <span>@L[item.Key]</span>
                        <strong>@item.Count.ToString("N0")</strong>
                    </a>
                }
                @if (alerts.Count == 0)
                {
                    <p class="manager-no-alerts">@L["ManagerNoOpenAlerts"]</p>
                }
            </section>
        </div>
        }
    }
</div>

@code {
    [Parameter] public string DashboardSection { get; set; } = "";
    private record Metric(string Key, int Value);
    private record Shortcut(string Key, string Url);
    private record Alert(string Key, int Count, string Url);

    private readonly List<Metric> kpis = new();
    private readonly List<Shortcut> shortcuts = new();
    private readonly List<Alert> alerts = new();
    private bool authorized;
    private bool busy;
    private bool checkingAccess = true;
    private bool disposed;
    private int loadVersion;
    private string error = "";
    private string section = "";

    private string DashboardTitle => section switch
    {
        "sales" => L["ManagerSalesDashboard"],
        "warehouse" => L["ManagerWarehouseDashboard"],
        "ceo" => L["ManagerCeoDashboard"],
        "production" => L["ManagerProductionDashboard"],
        _ => L["Dashboard"]
    };

    // The router reuses this component when only the dashboard section changes.
    // A route parameter makes each section change trigger parameter processing.
    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (disposed) return;
        var version = ++loadVersion;
        var targetSection = DashboardSection.Trim().ToLowerInvariant();
        section = targetSection;
        checkingAccess = true;
        authorized = false;
        busy = true;
        error = "";
        kpis.Clear();
        shortcuts.Clear();
        alerts.Clear();

        // Keep query results local until this request is still the current route.
        // A slow previous dashboard must never overwrite the newly selected one.
        var nextKpis = new List<Metric>();
        var nextShortcuts = new List<Shortcut>();
        var nextAlerts = new List<Alert>();

        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            if (disposed || version != loadVersion) return;
            var knownSection = targetSection is "sales" or "warehouse" or "ceo" or "production";
            authorized = knownSection && user.Identity?.IsAuthenticated == true &&
                (user.IsInRole("Administrator") || (targetSection switch
                {
                    "sales" => user.IsInRole("Sales") || user.IsInRole("SalesManager") || user.IsInRole("Sales Manager"),
                    "warehouse" => user.IsInRole("Warehouse") || user.IsInRole("WarehouseManager") || user.IsInRole("Warehouse Manager"),
                    "ceo" => user.IsInRole("CEO") || user.IsInRole("Ceo") || user.IsInRole("Manager"),
                    "production" => user.IsInRole("ProductionManager") || user.IsInRole("Production Manager") ||
                        user.IsInRole("Manager") || user.IsInRole("FloorManager") ||
                        user.IsInRole("Floor Manager") || user.IsInRole("Production"),
                    _ => false
                }));
            checkingAccess = false;
            if (!authorized) return;
            StateHasChanged();

            await using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.Now;
            if (targetSection == "sales")
            {
                nextKpis.Add(new("ManagerSalesRequests", await db.SalesRequests.CountAsync(x => x.Status != SalesRequestStatus.Cancelled)));
                nextKpis.Add(new("ManagerSalesActiveOrders", await db.SalesOrders.CountAsync(x =>
                    x.Status != SalesOrderStatus.Completed && x.Status != SalesOrderStatus.Cancelled)));
                nextKpis.Add(new("ManagerSalesQuotations", await db.Quotations.CountAsync()));
                nextKpis.Add(new("ManagerSalesInvoices", await db.SalesInvoices.CountAsync()));
                nextAlerts.Add(new("ManagerSalesDraftRequests", await db.SalesRequests.CountAsync(x => x.Status == SalesRequestStatus.Draft), "/sales/requests"));
                nextAlerts.Add(new("ManagerSalesUndelivered", await db.SalesOrders.CountAsync(x =>
                    x.DeliveryDate.HasValue && x.DeliveryDate.Value < now &&
                    x.Status != SalesOrderStatus.Completed && x.Status != SalesOrderStatus.Cancelled), "/sales/orders"));
                nextShortcuts.AddRange(new[] {
                    new Shortcut("SalesRequests", "/sales/requests"),
                    new Shortcut("SalesQuotations", "/sales/quotations"),
                    new Shortcut("SalesOrders", "/sales/orders"),
                    new Shortcut("SalesInvoices", "/sales/invoices")
                });
            }
            else if (targetSection == "warehouse")
            {
                nextKpis.Add(new("ManagerWarehouseItems", await db.Items.CountAsync(x => x.IsActive)));
                nextKpis.Add(new("ManagerWarehouseOpenRequests", await db.ProductionMaterialRequests.CountAsync(x => x.Status == "Requested")));
                nextKpis.Add(new("ManagerWarehouseDraftDocuments", await db.InventoryDocuments.CountAsync(x => x.Status == InventoryDocumentStatus.Draft)));
                nextKpis.Add(new("ManagerWarehousePostedDocuments", await db.InventoryDocuments.CountAsync(x => x.Status == InventoryDocumentStatus.Posted)));
                nextAlerts.Add(new("ManagerWarehouseRequestsToProcess", await db.ProductionMaterialRequests.CountAsync(x => x.Status == "Requested"), "/inventory/documents"));
                nextAlerts.Add(new("ManagerWarehouseDocumentsToPost", await db.InventoryDocuments.CountAsync(x => x.Status == InventoryDocumentStatus.Draft), "/inventory/documents"));
                nextShortcuts.AddRange(new[] {
                    new Shortcut("Documents", "/inventory/documents"),
                    new Shortcut("InventoryStock", "/inventory/stock"),
                    new Shortcut("Items", "/inventory/items"),
                    new Shortcut("Transactions", "/inventory/transactions")
                });
            }
            else if (targetSection == "ceo")
            {
                nextKpis.Add(new("ManagerCeoActiveSales", await db.SalesOrders.CountAsync(x =>
                    x.Status != SalesOrderStatus.Completed && x.Status != SalesOrderStatus.Cancelled)));
                nextKpis.Add(new("ManagerCeoProductionOrders", await db.ProductionOrders.CountAsync(x =>
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled)));
                nextKpis.Add(new("ManagerCeoApprovedWindows", await db.ProductionOrders.CountAsync(x =>
                    x.PlannedStartDate.HasValue && x.PlannedEndDate.HasValue)));
                nextKpis.Add(new("ManagerCeoOpenWarehouse", await db.ProductionMaterialRequests.CountAsync(x => x.Status == "Requested")));
                nextAlerts.Add(new("ManagerCeoUnplannedOrders", await db.ProductionOrders.CountAsync(x =>
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled &&
                    (!x.PlannedStartDate.HasValue || !x.PlannedEndDate.HasValue)), "/production/planning"));
                nextAlerts.Add(new("ManagerCeoOverdueProduction", await db.ProductionOrders.CountAsync(x =>
                    x.PlannedEndDate.HasValue && x.PlannedEndDate.Value < now &&
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled), "/production/planning"));
                nextShortcuts.AddRange(new[] {
                    new Shortcut("CeoDeadlineCalendar", "/production/planning"),
                    new Shortcut("ProductionOrders", "/production/orders"),
                    new Shortcut("SalesOrders", "/sales/orders"),
                    new Shortcut("ProductionWorkflow", "/production/workflow")
                });
            }
            else if (targetSection == "production")
            {
                nextKpis.Add(new("ManagerProductionActiveOrders", await db.ProductionOrders.CountAsync(x =>
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled)));
                nextKpis.Add(new("ManagerProductionUnscheduled", await db.ProductionOrders.CountAsync(x =>
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled &&
                    x.OperationsSequenceConfirmedAt == null)));
                nextKpis.Add(new("ManagerProductionRunning", await db.ProductionOperations.CountAsync(x => x.Status == ProductionOperationStatus.Running)));
                nextKpis.Add(new("ManagerProductionMachineBookings", await db.ProductionSchedules.CountAsync(x => x.Status == ScheduleStatus.Planned)));
                nextAlerts.Add(new("ManagerProductionNeedsSequence", await db.ProductionOrders.CountAsync(x =>
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled &&
                    x.OperationsSequenceConfirmedAt == null), "/production/machine-schedule"));
                nextAlerts.Add(new("ManagerProductionLateOrders", await db.ProductionOrders.CountAsync(x =>
                    x.PlannedEndDate.HasValue && x.PlannedEndDate.Value < now &&
                    x.Status != ProductionOrderStatus.Completed && x.Status != ProductionOrderStatus.Cancelled), "/production/machine-schedule"));
                nextShortcuts.AddRange(new[] {
                    new Shortcut("MachineSchedule", "/production/machine-schedule"),
                    new Shortcut("ProductionWorkflow", "/production/workflow"),
                    new Shortcut("ProductionOrders", "/production/orders"),
                    new Shortcut("QualityInspectionManagement", "/production/quality-inspections")
                });
            }
            if (disposed || version != loadVersion) return;
            kpis.AddRange(nextKpis);
            shortcuts.AddRange(nextShortcuts);
            alerts.AddRange(nextAlerts);
        }
        catch (Exception ex)
        {
            if (!disposed && version == loadVersion)
                error = ex.Message;
        }
        finally
        {
            if (!disposed && version == loadVersion)
            {
                checkingAccess = false;
                busy = false;
            }
        }
    }

    public void Dispose()
    {
        disposed = true;
        loadVersion++;
    }
}
