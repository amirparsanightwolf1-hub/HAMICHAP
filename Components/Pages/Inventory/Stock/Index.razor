@page "/inventory/stock"

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Inventory
@using HamiChap_MES_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AuthenticationStateProvider Auth
@inject PermissionService Permissions
@inject InventoryAlertService InventoryAlerts

@inject ApplicationDbContext Db
@inject LocalizationService LocalizationService

<PageTitle>
    @LocalizationService["InventoryStock"]
</PageTitle>

@if (checkingAccess)
{
    <p role="status">@LocalizationService["Loading"]</p>
}
else if (!canViewStock)
{
    <div class="alert alert-warning">@LocalizationService["AccessDenied"]</div>
}
else
{
<div class="page-container inventory-page inventory-stock">

    <div class="erp-page-header inventory-hero">
        <div class="inventory-hero-icon" aria-hidden="true"><i class="bi bi-boxes"></i></div>

        <div>
            <h3 class="erp-page-title">
                @LocalizationService["InventoryStock"]
            </h3>
            <p class="erp-page-subtitle">@(LocalizationService.IsPersian ? "موجودی انبارهای فعال و محصول نهایی به تفکیک کالا و مالک" : "Stock in active warehouse and finished-goods storage, by item and owner")</p>
        </div>

    </div>

    <div class="warehouse-action-grid mb-3">
        <a href="/inventory/documents/create?movement=receive" class="warehouse-action"><i class="bi bi-box-arrow-in-down"></i><strong>@(LocalizationService.IsPersian ? "دریافت کالا" : "Receive stock")</strong><small>@(LocalizationService.IsPersian ? "ثبت کالای ورودی" : "Receive incoming goods")</small></a>
        <a href="/inventory/material-requests" class="warehouse-action"><i class="bi bi-inbox"></i><strong>@(LocalizationService.IsPersian ? "تحویل مواد" : "Issue materials")</strong><small>@(LocalizationService.IsPersian ? "درخواست‌های اپراتورها" : "Operator requests")</small></a>
        <a href="/inventory/material-settlement" class="warehouse-action"><i class="bi bi-arrow-return-left"></i><strong>@(LocalizationService.IsPersian ? "مصرف و برگشت" : "Usage & returns")</strong><small>@(LocalizationService.IsPersian ? "ثبت مصرف واقعی" : "Settle issued material")</small></a>
        <a href="/inventory/shipments" class="warehouse-action"><i class="bi bi-truck"></i><strong>@(LocalizationService.IsPersian ? "ارسال کالا" : "Ship orders")</strong><small>@(LocalizationService.IsPersian ? "کالاهای پرداخت شده" : "Paid orders ready to dispatch")</small></a>
    </div>
    <details class="mb-3">
        <summary class="small text-muted mb-2">@(LocalizationService.IsPersian ? "عملیات پیشرفته انبار" : "Advanced stock actions")</summary>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="/inventory/material-requests"><i class="bi bi-inbox" aria-hidden="true"></i> @(LocalizationService.IsPersian ? "درخواست‌های مواد" : "Material requests")</a>
        <a class="btn btn-outline-primary" href="/inventory/documents/create"><i class="bi bi-plus-circle" aria-hidden="true"></i> @LocalizationService["CreateInventoryDocument"]</a>
        <a class="btn btn-outline-secondary" href="/inventory/stock/warehouse"><i class="bi bi-building" aria-hidden="true"></i> @LocalizationService["WarehouseStock"]</a>
        <a class="btn btn-outline-secondary" href="/inventory/stock/lots"><i class="bi bi-box-seam" aria-hidden="true"></i> @LocalizationService["StockByLot"]</a>
        <a class="btn btn-outline-secondary" href="/inventory/low-stock"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @LocalizationService["LowStockAlert"]</a>
        <a class="btn btn-outline-secondary" href="/inventory/transactions"><i class="bi bi-clock-history" aria-hidden="true"></i> @LocalizationService["Transactions"]</a>
    </div>
    </details>

    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="@(LocalizationService.IsPersian ? "نوع موجودی" : "Stock area")">
        <button type="button" class="btn @(stockArea == "storage" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ChangeStockArea("storage")'>@(LocalizationService.IsPersian ? "موجودی انبار" : "Stored stock")</button>
        <button type="button" class="btn @(stockArea == "materials" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ChangeStockArea("materials")'>@(LocalizationService.IsPersian ? "مواد اولیه و ملزومات" : "Materials & supplies")</button>
        <button type="button" class="btn @(stockArea == "finished" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ChangeStockArea("finished")'>@(LocalizationService.IsPersian ? "محصول نهایی" : "Finished goods")</button>
        <button type="button" class="btn @(stockArea == "production" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ChangeStockArea("production")'>@(LocalizationService.IsPersian ? "موجودی سالن تولید" : "Production floor")</button>
    </div>

    <!-- =========================================
         Low Stock Alert Summary
         ========================================= -->
    @if (lowStockItems != null && lowStockItems.Count > 0)
    {
        <div class="alert alert-warning mb-4">

            <strong>
                @LocalizationService["LowStockAlert"]
            </strong>

            <span class="ms-2">
                @lowStockItems.Count
                @LocalizationService["ItemsLowStock"]
            </span>
            <a class="btn btn-outline-warning btn-sm ms-2" href="/inventory/low-stock">@(LocalizationService.IsPersian ? "مشاهده همه کسری‌ها" : "View all shortages")</a>

        </div>
    }

    <!-- =========================================
         Inventory Filters
         ========================================= -->

    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- Item Search -->

                <div class="col-md-6">

                    <label class="form-label">
                        @LocalizationService["Item"]
                    </label>

                    <input type="text"
                           class="form-control"
                           @bind="searchText"
                           @bind:event="oninput"
                           @bind:after="SearchChanged"
                           placeholder="@LocalizationService["SearchItem"]" />

                </div>

                <!-- Inventory Owner -->

                <div class="col-md-4">

                    <label class="form-label">
                        @LocalizationService["InventoryOwner"]
                    </label>

                    <select class="form-select"
                            @bind="ownerFilter"
                            @bind:after="FilterChanged">

                        <option value="@InventoryOwnerFilter.All">
                            @LocalizationService["AllInventory"]
                        </option>

                        <option value="@InventoryOwnerFilter.Company">
                            @LocalizationService["CompanyInventory"]
                        </option>

                        <option value="@InventoryOwnerFilter.Customer">
                            @LocalizationService["CustomerInventoryFilter"]
                        </option>

                    </select>

                </div>

                <!-- Clear -->

                <div class="col-md-2">

                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            @onclick="ClearFilters">

                        @LocalizationService["Clear"]

                    </button>

                </div>

            </div>

        </div>

    </div>

    @if (balances == null)
    {
        <p>
            @LocalizationService["Loading"]
        </p>
    }
    else
    {
        <div class="card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <div class="inventory-table-scroll">
<table class="table table-striped table-bordered table-responsive-cards mb-0">

                        <thead>

                            <tr>

                                <th>
                                    @LocalizationService["Code"]
                                </th>

                                <th>
                                    @LocalizationService["Item"]
                                </th>

                                <th>
                                    @LocalizationService["Customer"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["OnHand"]
                                </th>

                                <th class="text-end">
                                    @LocalizationService["Reserved"]
                                </th>

                                <th class="text-end">
                                    @(LocalizationService.IsPersian ? "موجودی قابل استفاده" : "Usable available")
                                </th>

                                <th>
                                    @LocalizationService["StockAlert"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (balances.Count == 0)
                            {
                                <tr>

                                    <td colspan="7"
                                        class="text-center">

                                        @LocalizationService["NoInventoryFound"]

                                    </td>

                                </tr>
                            }
                            else
                            {
                                @foreach (var stock in balances)
                                {
                                    var isLowStock =
                                        stockArea != "production" && stock.CustomerId == null && IsLowStock(stock.ItemId);

                                    <tr class="@(isLowStock ? "table-warning" : "")">

                                        <td>
                                            @stock.ItemCode
                                        </td>

                                        <td>
                                            @stock.ItemName
                                        </td>

                                        <td>
                                            @(stock.CustomerName
                                                ?? LocalizationService["CompanyInventory"])
                                        </td>

                                        <td class="text-end">
                                            @stock.OnHandQuantity
                                        </td>

                                        <td class="text-end">
                                            @stock.ReservedQuantity
                                        </td>

                                        <td class="text-end fw-bold">
                                            @stock.AvailableQuantity
                                        </td>

                                        <td>

                                            @if (isLowStock)
                                            {
                                                <span class="badge bg-danger">
                                                    @LocalizationService["LowStock"]
                                                </span>

                                                <div class="small mt-1">
                                                    @LocalizationService["Threshold"]:
                                                    @GetThreshold(stock.ItemId)
                                                </div>
                                            }
                                            else if (stockArea != "production" && stock.CustomerId == null && stock.AlertEnabled)
                                            {
                                                <span class="badge bg-success">
                                                    @LocalizationService["StockOK"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    @LocalizationService["Disabled"]
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>
</div>

                </div>

                <!-- =========================================
                     Pagination
                     ========================================= -->
                @if (totalPages > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top gap-2">

                        <div class="text-muted small">
                            @((currentPage - 1) * pageSize + 1)
                            -
                            @(Math.Min(currentPage * pageSize, totalCount))
                            /
                            @totalCount
                        </div>

                        <div class="d-flex align-items-center gap-2">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@(currentPage <= 1)"
                                    @onclick="PreviousPage">

                                @LocalizationService["Previous"]
                            </button>

                            <span class="small">
                                @currentPage / @totalPages
                            </span>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@(currentPage >= totalPages)"
                                    @onclick="NextPage">

                                @LocalizationService["Next"]
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>

}

@code {

    private sealed class StockSummary
    {
        public int ItemId { get; init; }
        public int? CustomerId { get; init; }
        public string ItemCode { get; init; } = "";
        public string ItemName { get; init; } = "";
        public string? CustomerName { get; init; }
        public bool AlertEnabled { get; init; }
        public decimal OnHandQuantity { get; init; }
        public decimal ReservedQuantity { get; init; }
        public decimal AvailableQuantity { get; init; }
    }

    private List<StockSummary>? balances;
    private bool checkingAccess = true, canViewStock;

    private string stockArea = "storage";

    private InventoryOwnerFilter ownerFilter =
        InventoryOwnerFilter.All;

    private string searchText = "";

    private Dictionary<int, decimal> companyAvailableByItem = new();

    private Dictionary<int, decimal> thresholdByItem = new();

    private List<int>? lowStockItems;

    // =========================================
    // Pagination
    // =========================================

    private const int pageSize = 20;

    private int currentPage = 1;

    private int totalCount;

    private int totalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(
                totalCount / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User;
            canViewStock = await Permissions.HasPermissionAsync(user, "Inventory.Stock.View");
            if (canViewStock) await LoadBalances();
        }
        finally { checkingAccess = false; }
    }

    private async Task LoadBalances()
    {
        if (!canViewStock) return;
        var day = DateTime.Today;
        var query = Db.InventoryBalances.AsNoTracking()
            .Include(x => x.Item)
            .Include(x => x.Customer)
            .Where(x => x.OnHandQuantity > 0)
            .AsQueryable();

        query = stockArea switch
        {
            "materials" => query.Where(x => x.InventoryLocation.IsActive && x.InventoryLocation.Type == InventoryLocationType.Warehouse),
            "finished" => query.Where(x => x.InventoryLocation.IsActive && x.InventoryLocation.Type == InventoryLocationType.FinishedGoods),
            "production" => query.Where(x => x.InventoryLocation.IsActive &&
                (x.InventoryLocation.Type == InventoryLocationType.Production || x.InventoryLocation.Type == InventoryLocationType.Machine)),
            _ => query.Stored()
        };

        // =========================================
        // Inventory Owner Filter
        // =========================================

        query = ownerFilter switch
        {
            InventoryOwnerFilter.Company =>
                query.Where(x => x.CustomerId == null),

            InventoryOwnerFilter.Customer =>
                query.Where(x => x.CustomerId != null),

            _ =>
                query
        };

        // =========================================
        // Item Search
        // ID / Code / Name
        // =========================================

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();

            query = query.Where(x =>
                x.Item.Id.ToString().Contains(search) ||
                x.Item.Code.Contains(search) ||
                x.Item.Name.Contains(search));
        }

        // =========================================
        // Total record count
        // =========================================

        var grouped = query.GroupBy(x => new
        {
            x.ItemId, x.Item.Code, x.Item.Name, x.CustomerId,
            CustomerName = x.Customer == null ? null : x.Customer.Name,
            x.Item.EnableLowStockAlert
        }).Select(g => new StockSummary
        {
            ItemId = g.Key.ItemId,
            ItemCode = g.Key.Code,
            ItemName = g.Key.Name,
            CustomerId = g.Key.CustomerId,
            CustomerName = g.Key.CustomerName,
            AlertEnabled = g.Key.EnableLowStockAlert,
            OnHandQuantity = g.Sum(x => x.OnHandQuantity),
            ReservedQuantity = g.Sum(x => x.ReservedQuantity),
            AvailableQuantity = g.Sum(x => x.Item.IsActive && (!x.Item.RequiresLotTracking ||
                (x.InventoryLot != null && !x.InventoryLot.IsClosed && (!x.InventoryLot.ExpirationDate.HasValue || x.InventoryLot.ExpirationDate.Value >= day)))
                ? x.OnHandQuantity - x.ReservedQuantity : 0m)
        });
        totalCount = await grouped.CountAsync();

        // =========================================
        // Make sure current page is still valid
        // =========================================

        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }

        if (totalPages == 0)
        {
            currentPage = 1;
        }

        // =========================================
        // Load only current page
        // =========================================

        balances = await grouped
            .OrderBy(x => x.ItemName)
            .ThenBy(x => x.CustomerName)
            .ThenBy(x => x.ItemId)
            .ThenBy(x => x.CustomerId)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        await LoadLowStockAlerts();
    }

    private async Task ChangeStockArea(string area)
    {
        stockArea = area;
        currentPage = 1;
        await LoadBalances();
    }

    private async Task LoadLowStockAlerts()
    {
        var monitored = await InventoryAlerts.GetMonitoredStockAsync();
        companyAvailableByItem = monitored.ToDictionary(x => x.ItemId, x => x.AvailableQuantity);
        thresholdByItem = monitored.ToDictionary(x => x.ItemId, x => x.Threshold);
        lowStockItems = monitored.Where(x => x.AvailableQuantity <= x.Threshold).Select(x => x.ItemId).ToList();
    }

    private bool IsLowStock(int itemId)
    {
        if (!thresholdByItem.TryGetValue(
                itemId,
                out var threshold))
        {
            return false;
        }

        if (!companyAvailableByItem.TryGetValue(
                itemId,
                out var available))
        {
            return false;
        }

        return available <= threshold;
    }

    private decimal GetThreshold(int itemId)
    {
        return thresholdByItem.TryGetValue(
            itemId,
            out var threshold)
            ? threshold
            : 0;
    }

    // =========================================
    // Pagination actions
    // =========================================

    private async Task PreviousPage()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;

        await LoadBalances();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;

        await LoadBalances();
    }

    // =========================================
    // Filter actions
    // =========================================

    private async Task SearchChanged()
    {
        currentPage = 1;

        await LoadBalances();
    }

    private async Task FilterChanged()
    {
        currentPage = 1;

        await LoadBalances();
    }

    private async Task ClearFilters()
    {
        searchText = "";
        ownerFilter = InventoryOwnerFilter.All;
        currentPage = 1;

        await LoadBalances();
    }
}