@page "/inventory/transactions"

@using Microsoft.EntityFrameworkCore
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Inventory

@inject ApplicationDbContext Db
@inject HamiChap_MES_ERP.Services.LocalizationService LocalizationService

<PageTitle>@LocalizationService["InventoryTransactions"]</PageTitle>

<div class="page-container">

    <div class="erp-page-header">

        <div>
            <h3 class="erp-page-title">
                @LocalizationService["InventoryTransactions"]
            </h3>
        </div>

    </div>


    <!-- Filters -->

    <div class="card mb-3">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- From Date -->

                <div class="col-md-3">

                    <label class="form-label">
                        @LocalizationService["FromDate"]
                    </label>

                    <input type="date"
                           class="form-control"
                           @bind="fromDate" />

                </div>


                <!-- To Date -->

                <div class="col-md-3">

                    <label class="form-label">
                        @LocalizationService["ToDate"]
                    </label>

                    <input type="date"
                           class="form-control"
                           @bind="toDate" />

                </div>


                <!-- Item -->

                <div class="col-md-4">

                    <label class="form-label">
                        @LocalizationService["Item"]
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="@LocalizationService["Search"]"
                           @bind="itemSearch" />

                </div>


                <!-- Buttons -->

                <div class="col-md-2 d-flex gap-2">

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SearchTransactions">

                        @LocalizationService["Search"]

                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="ClearFilters">

                        @LocalizationService["Clear"]

                    </button>

                </div>

            </div>

        </div>

    </div>


    @if (transactions == null)
    {
        <p>@LocalizationService["Loading"]</p>
    }
    else if (totalCount == 0)
    {
        <div class="alert alert-info">
            @LocalizationService["NoRecordsFound"]
        </div>
    }
    else
    {

        <!-- Transactions Table -->

        <div class="card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-striped table-bordered table-responsive-cards mb-0">

                        <thead>

                            <tr>

                                <th>@LocalizationService["Date"]</th>
                                <th>@LocalizationService["Type"]</th>
                                <th>@LocalizationService["Item"]</th>
                                <th>@LocalizationService["Quantity"]</th>
                                <th>@LocalizationService["Unit"]</th>
                                <th>@LocalizationService["From"]</th>
                                <th>@LocalizationService["To"]</th>
                                <th>@LocalizationService["Lot"]</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var transaction in transactions)
                            {
                                <tr>

                                    <td>
                                        @transaction.TransactionDate.ToShortDateString()
                                    </td>

                                    <td>
                                        @transaction.TransactionType
                                    </td>

                                    <td>
                                        @transaction.Item.Name
                                    </td>

                                    <td class="text-end">
                                        @transaction.Quantity
                                    </td>

                                    <td>
                                        @transaction.Unit.Symbol
                                    </td>

                                    <td>
                                        @(transaction.FromLocation?.Name ?? "-")
                                    </td>

                                    <td>
                                        @(transaction.ToLocation?.Name ?? "-")
                                    </td>

                                    <td>
                                        @(transaction.InventoryLot?.LotNumber ?? "-")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- Pagination -->
        @if (totalPages > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">

                <div class="text-muted small">

                    @((currentPage - 1) * pageSize + 1)
                    -
                    @(Math.Min(currentPage * pageSize, totalCount))
                    /
                    @totalCount

                </div>


                <div class="d-flex align-items-center gap-2">

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="PreviousPage"
                            disabled="@(currentPage <= 1)">

                        @LocalizationService["Previous"]

                    </button>


                    <span class="small">
                        @currentPage / @totalPages
                    </span>


                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="NextPage"
                            disabled="@(currentPage >= totalPages)">

                        @LocalizationService["Next"]

                    </button>

                </div>

            </div>
        }

    }

</div>


@code {

    private const int pageSize = 20;

    private List<InventoryTransaction>? transactions;

    private int currentPage = 1;

    private int totalCount;

    private int totalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(totalCount / (double)pageSize);


    // Filters

    private DateTime? fromDate;

    private DateTime? toDate;

    private string? itemSearch;


    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }


    private async Task LoadTransactions()
    {
        var query = Db.InventoryTransactions
            .Include(x => x.Item)
            .Include(x => x.Unit)
            .Include(x => x.InventoryLot)
            .Include(x => x.FromLocation)
            .Include(x => x.ToLocation)
            .AsQueryable();


        // From Date

        if (fromDate.HasValue)
        {
            query = query.Where(x =>
                x.TransactionDate >= fromDate.Value.Date);
        }


        // To Date

        if (toDate.HasValue)
        {
            var endDate = toDate.Value.Date.AddDays(1);

            query = query.Where(x =>
                x.TransactionDate < endDate);
        }


        // Item search
        // Searches both Item Code and Item Name

        if (!string.IsNullOrWhiteSpace(itemSearch))
        {
            var search = itemSearch.Trim();

            query = query.Where(x =>
                x.Item.Code.Contains(search) ||
                x.Item.Name.Contains(search));
        }


        // Count filtered records

        totalCount = await query.CountAsync();


        // Keep current page valid

        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }

        if (totalPages == 0)
        {
            currentPage = 1;
        }


        // Load current page only

        transactions = await query

            .OrderByDescending(x => x.TransactionDate)

            .ThenByDescending(x => x.Id)

            .Skip((currentPage - 1) * pageSize)

            .Take(pageSize)

            .ToListAsync();
    }


    private async Task SearchTransactions()
    {
        currentPage = 1;

        await LoadTransactions();
    }


    private async Task ClearFilters()
    {
        fromDate = null;

        toDate = null;

        itemSearch = null;

        currentPage = 1;

        await LoadTransactions();
    }


    private async Task PreviousPage()
    {
        if (currentPage <= 1)
            return;

        currentPage--;

        await LoadTransactions();
    }


    private async Task NextPage()
    {
        if (currentPage >= totalPages)
            return;

        currentPage++;

        await LoadTransactions();
    }

}