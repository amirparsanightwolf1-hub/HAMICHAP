@page "/inventory/documents/edit/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Inventory.Documents.View")]
@implements IAsyncDisposable

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Administration
@using HamiChap_MES_ERP.Models.Inventory
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Customers

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PermissionService Permissions
@inject LocalizationService LocalizationService

<PageTitle>
    @LocalizationService["EditInventoryDocument"]
</PageTitle>

@if (document == null)
{
    <div class="alert alert-warning">
        @(errorMessage ?? LocalizationService["Loading"])
    </div>
}
else
{
    <div class="page-container inventory-page inventory-documents">

        <div class="erp-page-header inventory-hero">
        <div class="inventory-hero-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></div>

            <div>
                <h3 class="erp-page-title">
                    @LocalizationService["EditInventoryDocument"]
                </h3>

                <p class="erp-page-subtitle">
                    @document.DocumentNumber
                </p>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-4">
                @errorMessage
            </div>
        }

        <!-- =========================================
             Document Information
             ========================================= -->

        <div class="card mb-4">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Number"]
                        </label>

                        <input class="form-control"
                               value="@document.DocumentNumber"
                               disabled />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Type"]
                        </label>

                        <input class="form-control"
                               value="@LocalizationService.TranslateEnum(document.DocumentType)"
                               disabled />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Date"]
                        </label>

                        <input class="form-control"
                               type="date"
                               @bind="document.DocumentDate"
                               disabled="@(!CanChangeDraft)" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Status"]
                        </label>

                        <input class="form-control"
                               value="@LocalizationService.TranslateEnum(document.Status)"
                               disabled />

                    </div>

                </div>

                <div class="row g-3 mt-1">

                    <div class="col-md-6">

                        <label class="form-label">
                            @LocalizationService["From"]
                        </label>

                        <select class="form-select"
                                @bind="document.FromLocationId"
                                disabled="@(!CanChangeDraft)">

                            <option value="">
                                -- @LocalizationService["SelectSource"] --
                            </option>

                            @foreach (var location in locations)
                            {
                                <option value="@location.Id">
                                    @location.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            @LocalizationService["To"]
                        </label>

                        <select class="form-select"
                                @bind="document.ToLocationId"
                                disabled="@(!CanChangeDraft)">

                            <option value="">
                                -- @LocalizationService["SelectDestination"] --
                            </option>

                            @foreach (var location in locations)
                            {
                                <option value="@location.Id">
                                    @location.Name
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <label class="form-label">
                        @LocalizationService["Notes"]
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              @bind="document.Notes"
                              disabled="@(!CanChangeDraft)">
                    </textarea>

                </div>

            </div>

        </div>

        <!-- =========================================
             Document Lines
             ========================================= -->

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h4 class="section-title mb-0">
                @LocalizationService["Lines"]
            </h4>

        </div>

        <div class="card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <div class="inventory-table-scroll">
<table class="table table-bordered table-striped table-responsive-cards mb-0">

                        <thead>

                            <tr>

                                <th>
                                    @LocalizationService["Item"]
                                </th>

                                <th>
                                    @LocalizationService["Customer"]
                                </th>

                                <th>
                                    @LocalizationService["QuantityShort"]
                                </th>

                                <th>
                                    @LocalizationService["Unit"]
                                </th>

                                <th>
                                    @LocalizationService["Lot"]
                                </th>

                                <th>
                                    @LocalizationService["Expiration"]
                                </th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var line in document.Lines)
                            {
                                <tr>

                                    <!-- Item -->

                                    <td>

                                        <select class="form-select"
                                                @bind="line.ItemId"
                                                disabled="@(!CanChangeDraft)"
                                                @bind:after="() => SetLineUnit(line)">

                                            <option value="0">
                                                -- @LocalizationService["SelectItem"] --
                                            </option>

                                            @foreach (var item in items)
                                            {
                                                <option value="@item.Id">
                                                    @item.Name
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    <!-- Customer -->

                                    <td>

                                        <select class="form-select"
                                                @bind="line.CustomerId"
                                                disabled="@(!CanChangeDraft)">

                                            <option value="">
                                                -- @LocalizationService["CompanyInventory"] --
                                            </option>

                                            @foreach (var customer in customers)
                                            {
                                                <option value="@customer.Id">
                                                    @customer.Name
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    <!-- Quantity -->

                                    <td>

                                        <input class="form-control"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               @bind="line.Quantity"
                                               disabled="@(!CanChangeDraft)" />

                                    </td>

                                    <!-- Unit -->

                                    <td>

                                        <input class="form-control"
                                               value="@GetItemUnitName(line.ItemId)"
                                               readonly />

                                    </td>

                                    <!-- Lot -->

                                    <td>

                                        @if (GetItem(line.ItemId)?.RequiresLotTracking == true)
                                        {
                                            <input class="form-control"
                                                   placeholder="@LocalizationService["LotNumber"]"
                                                   @bind="line.LotNumber"
                                                   disabled="@(!CanChangeDraft)" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- Expiration -->

                                    <td>

                                        @if (GetItem(line.ItemId)?.RequiresLotTracking == true)
                                        {
                                            <input class="form-control"
                                                   type="date"
                                                   @bind="line.LotExpirationDate"
                                                   disabled="@(!CanChangeDraft)" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- Remove -->

                                    <td>

                                        @if (canEdit && !IsPosted)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    @onclick="() => RemoveLine(line)"
                                                    disabled="@(!CanChangeDraft)">

                                                @LocalizationService["Remove"]

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
</div>

                </div>

            </div>

        </div>

        <!-- =========================================
             Actions
             ========================================= -->
        @if (!IsPosted)
        {
            @if (canEdit || canPost)
            {
                <div class="mt-4 d-flex gap-2">
                    @if (canEdit)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="AddLine" disabled="@(!CanChangeDraft)">
                            + @LocalizationService["AddLine"]
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(!CanChangeDraft)">
                            @LocalizationService["SaveChanges"]
                        </button>
                    }
                    @if (canPost)
                    {
                        <button type="button" class="btn btn-success" @onclick="Post" disabled="@(isSaving || isPosting)">
                            @LocalizationService["PostDocument"]
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <div class="alert alert-success mt-4">

                @(document.Status == InventoryDocumentStatus.Cancelled ? LocalizationService.TranslateEnum(document.Status) : LocalizationService["DocumentPostedReadOnly"])

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public long Id { get; set; }

    private ApplicationDbContext Db = default!;
    private InventoryDocument? document;

    private List<Item> items = new();

    private List<Unit> units = new();

    private List<Customer> customers = new();

    private List<InventoryLocation> locations = new();

    private bool isSaving;

    private bool isPosting;
    private bool canEdit;
    private bool canPost;

    private string? errorMessage;

    private bool IsPosted =>
        document?.Status is InventoryDocumentStatus.Posted or InventoryDocumentStatus.Cancelled;
    private bool CanChangeDraft => canEdit && !IsPosted && !isSaving && !isPosting;

    // =========================================================
    // Initialization
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        Db = await DbFactory.CreateDbContextAsync();
        items = await Db.Items.AsNoTracking()
            .Include(x => x.Unit)
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        units = await Db.Units.AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        customers = await Db.Customers.AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        locations = await Db.InventoryLocations.AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

    }

    protected override async Task OnParametersSetAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        canEdit = await Permissions.HasPermissionAsync(principal, "Inventory.Documents.Edit");
        canPost = await Permissions.HasPermissionAsync(principal, "Inventory.Documents.Post");
        Db.ChangeTracker.Clear();
        document = await Db.InventoryDocuments
            .Include(x => x.Lines)
                .ThenInclude(x => x.Item)
                    .ThenInclude(x => x.Unit)
            .FirstOrDefaultAsync(x => x.Id == Id);

        errorMessage = document is null ? "Inventory document not found." : null;
    }

    // =========================================================
    // Lines
    // =========================================================

    private void AddLine()
    {
        if (document == null || !CanChangeDraft)
            return;

        document.Lines.Add(
            new InventoryDocumentLine());
    }

    private void RemoveLine(
        InventoryDocumentLine line)
    {
        if (document == null || !CanChangeDraft)
            return;

        document.Lines.Remove(line);
    }

    // =========================================================
    // Item helpers
    // =========================================================

    private Item? GetItem(int itemId)
    {
        return items.FirstOrDefault(
            x => x.Id == itemId);
    }

    private void SetLineUnit(
        InventoryDocumentLine line)
    {
        var item = GetItem(line.ItemId);

        if (item == null)
        {
            line.UnitId = 0;
            return;
        }

        line.UnitId = item.UnitId;
    }

    private string GetItemUnitName(
        int itemId)
    {
        var item = GetItem(itemId);

        return item?.Unit?.Symbol ?? "";
    }

    // =========================================================
    // Save Draft
    // =========================================================

    private async Task Save()
    {
        if (document == null || IsPosted)
            return;

        if (isSaving || isPosting)
            return;

        errorMessage = null;

        try
        {
            isSaving = true;

            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await Permissions.HasPermissionAsync(principal, "Inventory.Documents.Edit"))
                throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);

            await SaveDraftAsync(document);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveDraftAsync(InventoryDocument draft)
    {
        foreach (var line in draft.Lines)
            SetLineUnit(line);

        if (!Db.ChangeTracker.HasChanges())
            return;

        // Check and advance the document's row version even when only lines changed.
        Db.Entry(draft).Property(x => x.Notes).IsModified = true;
        await Db.SaveChangesAsync();
    }

    // =========================================================
    // Post Document
    // =========================================================

    private async Task Post()
    {
        if (document == null || IsPosted)
            return;

        if (isSaving || isPosting)
            return;

        errorMessage = null;

        try
        {
            isPosting = true;

            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId) ||
                !await Permissions.HasPermissionAsync(principal, "Inventory.Documents.Post"))
                throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);

            if (Db.ChangeTracker.HasChanges())
            {
                if (!await Permissions.HasPermissionAsync(principal, "Inventory.Documents.Edit"))
                    throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);

                await SaveDraftAsync(document);
                if (!await Permissions.HasPermissionAsync(principal, "Inventory.Documents.Post"))
                    throw new UnauthorizedAccessException(LocalizationService["AccessDenied"]);
            }

            // Posting can stage stock changes before a later line fails. Its context is
            // separate from the draft editor so those changes cannot reach a later save.
            await using var postingDb = await DbFactory.CreateDbContextAsync();
            await new InventoryPostingService(postingDb).PostAsync(document.Id, userId, expectedRowVersion: document.RowVersion);

            Navigation.NavigateTo(
                "/inventory/documents");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isPosting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Db is not null)
            await Db.DisposeAsync();
    }
}
