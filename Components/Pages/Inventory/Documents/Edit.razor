@page "/inventory/documents/edit/{Id:long}"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Inventory.Documents.View")]

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using HamiChap_MES_ERP.Data
@using HamiChap_MES_ERP.Models.Administration
@using HamiChap_MES_ERP.Models.Inventory
@using HamiChap_MES_ERP.Services
@using HamiChap_MES_ERP.Models.Customers

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject InventoryPostingService PostingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject LocalizationService LocalizationService
@inject IAuthorizationService AuthorizationService

<PageTitle>
    @LocalizationService["EditInventoryDocument"]
</PageTitle>

@if (document == null)
{
    <div class="alert alert-warning">
        @LocalizationService["Loading"]
    </div>
}
else
{
    <div class="page-container">

        <div class="erp-page-header">

            <div>
                <h3 class="erp-page-title">
                    @LocalizationService["EditInventoryDocument"]
                </h3>

                <p class="erp-page-subtitle">
                    @document.DocumentNumber
                </p>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-4">
                @errorMessage
            </div>
        }

        <!-- =========================================
             Document Information
             ========================================= -->

        <div class="card mb-4">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Number"]
                        </label>

                        <input class="form-control"
                               value="@document.DocumentNumber"
                               disabled />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Type"]
                        </label>

                        <input class="form-control"
                               value="@LocalizationService.TranslateEnum(document.DocumentType)"
                               disabled />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Date"]
                        </label>

                        <input class="form-control"
                               type="date"
                               @bind="document.DocumentDate"
                               disabled="@IsPosted" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            @LocalizationService["Status"]
                        </label>

                        <input class="form-control"
                               value="@LocalizationService.TranslateEnum(document.Status)"
                               disabled />

                    </div>

                </div>

                <div class="row g-3 mt-1">

                    <div class="col-md-6">

                        <label class="form-label">
                            @LocalizationService["From"]
                        </label>

                        <select class="form-select"
                                @bind="document.FromLocationId"
                                disabled="@IsPosted">

                            <option value="">
                                -- @LocalizationService["SelectSource"] --
                            </option>

                            @foreach (var location in locations)
                            {
                                <option value="@location.Id">
                                    @location.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            @LocalizationService["To"]
                        </label>

                        <select class="form-select"
                                @bind="document.ToLocationId"
                                disabled="@IsPosted">

                            <option value="">
                                -- @LocalizationService["SelectDestination"] --
                            </option>

                            @foreach (var location in locations)
                            {
                                <option value="@location.Id">
                                    @location.Name
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <label class="form-label">
                        @LocalizationService["Notes"]
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              @bind="document.Notes"
                              disabled="@IsPosted">
                    </textarea>

                </div>

            </div>

        </div>

        <!-- =========================================
             Document Lines
             ========================================= -->

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h4 class="section-title mb-0">
                @LocalizationService["Lines"]
            </h4>

        </div>

        <div class="card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped table-responsive-cards mb-0">

                        <thead>

                            <tr>

                                <th>
                                    @LocalizationService["Item"]
                                </th>

                                <th>
                                    @LocalizationService["Customer"]
                                </th>

                                <th>
                                    @LocalizationService["QuantityShort"]
                                </th>

                                <th>
                                    @LocalizationService["Unit"]
                                </th>

                                <th>
                                    @LocalizationService["Lot"]
                                </th>

                                <th>
                                    @LocalizationService["Expiration"]
                                </th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var line in document.Lines)
                            {
                                <tr>

                                    <!-- Item -->

                                    <td>

                                        <select class="form-select"
                                                @bind="line.ItemId"
                                                disabled="@IsPosted"
                                                @bind:after="() => SetLineUnit(line)">

                                            <option value="0">
                                                -- @LocalizationService["SelectItem"] --
                                            </option>

                                            @foreach (var item in items)
                                            {
                                                <option value="@item.Id">
                                                    @item.Name
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    <!-- Customer -->

                                    <td>

                                        <select class="form-select"
                                                @bind="line.CustomerId"
                                                disabled="@IsPosted">

                                            <option value="">
                                                -- @LocalizationService["CompanyInventory"] --
                                            </option>

                                            @foreach (var customer in customers)
                                            {
                                                <option value="@customer.Id">
                                                    @customer.Name
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    <!-- Quantity -->

                                    <td>

                                        <input class="form-control"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               @bind="line.Quantity"
                                               disabled="@IsPosted" />

                                    </td>

                                    <!-- Unit -->

                                    <td>

                                        <input class="form-control"
                                               value="@GetItemUnitName(line.ItemId)"
                                               readonly />

                                    </td>

                                    <!-- Lot -->

                                    <td>

                                        @if (GetItem(line.ItemId)?.RequiresLotTracking == true)
                                        {
                                            <input class="form-control"
                                                   placeholder="@LocalizationService["LotNumber"]"
                                                   @bind="line.LotNumber"
                                                   disabled="@IsPosted" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- Expiration -->

                                    <td>

                                        @if (GetItem(line.ItemId)?.RequiresLotTracking == true)
                                        {
                                            <input class="form-control"
                                                   type="date"
                                                   @bind="line.LotExpirationDate"
                                                   disabled="@IsPosted" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- Remove -->

                                    <td>

                                        @if (!IsPosted)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    @onclick="() => RemoveLine(line)">

                                                @LocalizationService["Remove"]

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- =========================================
             Actions
             ========================================= -->
        @if (!IsPosted)
        {
            <div class="mt-4 d-flex gap-2">

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="AddLine">

                    + @LocalizationService["AddLine"]

                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="Save"
                        disabled="@isSaving">

                    @LocalizationService["SaveChanges"]

                </button>

                <button type="button"
                        class="btn btn-success"
                        @onclick="Post"
                        disabled="@isPosting">

                    @LocalizationService["PostDocument"]

                </button>

            </div>
        }
        else
        {
            <div class="alert alert-success mt-4">

                @LocalizationService["DocumentPostedReadOnly"]

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public long Id { get; set; }

    private InventoryDocument? document;

    private List<Item> items = new();

    private List<Unit> units = new();

    private List<Customer> customers = new();

    private List<InventoryLocation> locations = new();

    private bool isSaving;

    private bool isPosting;

    private string? errorMessage;

    private bool IsPosted =>
        document?.Status == InventoryDocumentStatus.Posted;

    // =========================================================
    // Initialization
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        items = await Db.Items
            .Include(x => x.Unit)
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        units = await Db.Units
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        customers = await Db.Customers
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        locations = await Db.InventoryLocations
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        document = await Db.InventoryDocuments
            .Include(x => x.Lines)
                .ThenInclude(x => x.Item)
                    .ThenInclude(x => x.Unit)
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (document == null)
        {
            errorMessage =
                "Inventory document not found.";
        }
    }

    // =========================================================
    // Lines
    // =========================================================

    private void AddLine()
    {
        if (document == null || IsPosted)
            return;

        document.Lines.Add(
            new InventoryDocumentLine());
    }

    private void RemoveLine(
        InventoryDocumentLine line)
    {
        if (document == null || IsPosted)
            return;

        document.Lines.Remove(line);
    }

    // =========================================================
    // Item helpers
    // =========================================================

    private Item? GetItem(int itemId)
    {
        return items.FirstOrDefault(
            x => x.Id == itemId);
    }

    private void SetLineUnit(
        InventoryDocumentLine line)
    {
        var item = GetItem(line.ItemId);

        if (item == null)
        {
            line.UnitId = 0;
            return;
        }

        line.UnitId = item.UnitId;
    }

    private string GetItemUnitName(
        int itemId)
    {
        var item = GetItem(itemId);

        return item?.Unit?.Symbol ?? "";
    }

    // =========================================================
    // Save Draft
    // =========================================================

    private async Task Save()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthorizationService.AuthorizeAsync(auth.User, "Inventory.Documents.Edit")).Succeeded)
        {
            errorMessage = "You are not authorized to edit inventory documents.";
            return;
        }

        if (document == null || IsPosted)
            return;

        if (isSaving || isPosting)
            return;

        errorMessage = null;

        try
        {
            isSaving = true;

            foreach (var line in document.Lines)
            {
                SetLineUnit(line);
            }

            await Db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    // =========================================================
    // Post Document
    // =========================================================

    private async Task Post()
    {
        var postingAuth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthorizationService.AuthorizeAsync(postingAuth.User, "Inventory.Documents.Post")).Succeeded)
        {
            errorMessage = "You are not authorized to post inventory documents.";
            return;
        }

        if (document == null || IsPosted)
            return;

        if (isSaving || isPosting)
            return;

        errorMessage = null;

        try
        {
            isPosting = true;

            var auth =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                await UserManager.GetUserAsync(
                    auth.User);

            if (user == null)
            {
                errorMessage =
                    "Authenticated user was not found.";

                return;
            }

            // IMPORTANT:
            // Use the generic posting engine.
            // This supports Material Transfer,
            // Goods Receipt, Production Issue, etc.
            await PostingService.PostAsync(
                document.Id,
                user.Id);

            Navigation.NavigateTo(
                "/inventory/documents");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isPosting = false;
        }
    }
}